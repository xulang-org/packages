@"github.com/xulang-org/packages/prometheus"

#net
#net/http
#crypto/tls
#errors
#strings
transport #github.com/xulang-org/packages/transport

pub struct Pusher {
    pub host string
    pub port int
    pub secure bool
    pub job string
}

fn parse_int_def(s string, def int) int {
    if s.len == 0 {
        << def
    }
    n := parse_int(s) or (err) {
        << def
    }
    << n
}

fn safe_close(fd int) {
    if fd >= 0 {
        net.conn_close(fd) or (e) {
            <<
        }
    }
}

pub fn new_pusher(endpoint string, job string) Pusher {
    if strings.has_prefix(&endpoint, "https://") {
        ep := transport.parse_endpoint(endpoint, 9091) or (err) { << Pusher{host: "127.0.0.1", port: 9091, secure: true, job: job + ""} }
        << Pusher{host: ep.host, port: ep.port, secure: true, job: job + ""}
    }
    mut ep := endpoint
    prefix_http := "http://"
    if ep.len >= prefix_http.len && ep[0:prefix_http.len] == prefix_http {
        ep = ep[prefix_http.len:ep.len]
    }
    mut host := "127.0.0.1"
    mut port := 9091
    mut colon := -1
    mut i := 0
    while i < ep.len {
        if (ep[i] & 255) == 58 {
            colon = i
            <-
        }
        i = i + 1
    }
    if colon >= 0 {
        host = ep[0:colon]
        p_str := ep[(colon + 1):ep.len]
        port = parse_int_def(p_str, 9091)
    } else {
        if ep.len > 0 {
            host = ep
        }
    }
    << Pusher{host: host, port: port, secure: false, job: job + ""}
}

pub fn (p &Pusher) push(metrics_text string) bool {
    if p.secure {
        path := "/metrics/job/" + p.job
        mut req := "POST " + path + " HTTP/1.1\r\n"
        req = req + "Host: " + p.host + ":" + str(p.port) + "\r\n"
        req = req + "Content-Type: text/plain; version=0.0.4; charset=utf-8\r\n"
        req = req + "Content-Length: " + str(metrics_text.len) + "\r\n"
        req = req + "Connection: close\r\n\r\n" + metrics_text
        ep := transport.Endpoint{scheme: "https", host: p.host + "", port: p.port, path: "", secure: true}
        cfg := tls.new_config(p.host + "")
        resp := transport.request_raw(ep, cfg, req, "POST") or (err) { << false }
        << resp.status_code >= 200 && resp.status_code < 300
    }
    addr := p.host + ":" + str(p.port)
    fd := net.dial(strings.clone(&addr)) or (err) { << false }
    mut reusable := false
    result := p.push_on_fd(fd, metrics_text, mut &reusable)
    safe_close(fd)
    << result
}

fn (p &Pusher) push_on_fd(fd int, metrics_text string, reusable &mut bool) bool {
    *reusable = false

    path := "/metrics/job/" + p.job
    mut req := "POST " + path + " HTTP/1.1\r\n"
    req = req + "Host: " + p.host + ":" + str(p.port) + "\r\n"
    req = req + "Content-Type: text/plain; version=0.0.4; charset=utf-8\r\n"
    req = req + "Content-Length: " + str(metrics_text.len) + "\r\n"
    req = req + "Connection: keep-alive\r\n\r\n"
    if metrics_text.len > 0 {
        req = req + metrics_text
    }

    mut off := 0
    while off < req.len {
        part := req[off:req.len]
        n := net.conn_write(fd, &part) or (err) {
            << false
        }
        if n <= 0 {
            << false
        }
        off = off + n
    }

    resp := http.read_response(fd, "POST") or (err) {
        << false
    }
    *reusable = resp.status_code >= 200 && resp.status_code < 300 && resp.reusable("POST")
    << resp.status_code >= 200 && resp.status_code < 300
}
