@"github.com/xulang-org/packages/mcp"

#encoding/json
#errors
#net
#net/http
#os
#os/exec
#strconv
#strings
#crypto/tls
transport #github.com/xulang-org/packages/transport

pub const PROTOCOL_VERSION = "2025-03-26"

pub struct ToolAnnotations {
    pub title string
    pub read_only_hint bool
    pub destructive_hint bool
    pub idempotent_hint bool
    pub open_world_hint bool
    pub has_annotations bool
}

pub fn empty_tool_annotations() ToolAnnotations {
    << ToolAnnotations{
        title: "",
        read_only_hint: false,
        destructive_hint: false,
        idempotent_hint: false,
        open_world_hint: false,
        has_annotations: false
    }
}

pub struct ToolInfo {
    pub name string
    pub description string
    pub input_schema_json string
    pub annotations ToolAnnotations
}

pub struct ResourceInfo {
    pub uri string
    pub name string
    pub description string
    pub mime_type string
}

pub struct ResourceTemplateInfo {
    pub uri_template string
    pub name string
    pub description string
    pub mime_type string
}

pub struct PromptInfo {
    pub name string
    pub description string
    pub arguments_json string
}

pub struct ContentItem {
    pub kind string
    pub text string
}

pub struct ToolResult {
    pub content []ContentItem
    pub is_error bool
}

pub fn text_result(text string) ToolResult {
    items := [ContentItem{kind: "text", text: text}]
    << ToolResult{content: ~items, is_error: false}
}

pub fn error_result(text string) ToolResult {
    items := [ContentItem{kind: "text", text: text}]
    << ToolResult{content: ~items, is_error: true}
}

fn default_completion_handler(ref_json &string, arg_name &string, arg_value &string) []string {
    << []string{}
}

pub struct Server {
    pub name string
    pub version string
    pub log_level string
    tools []ToolInfo
    tool_handlers []fn(&string) ToolResult
    resources []ResourceInfo
    res_handlers []fn(&string) string
    templates []ResourceTemplateInfo
    template_handlers []fn(&string, &string) string
    has_template_handler []bool
    prompts []PromptInfo
    prompt_handlers []fn(&string) string
    completion_handler fn(&string, &string, &string) []string
}

fn default_template_handler(uri &string, vars_json &string) string {
    << ""
}

pub fn new_server(name string, version string) Server {
    << Server{
        name: name,
        version: version,
        log_level: "info",
        tools: []ToolInfo{},
        tool_handlers: []fn(&string) ToolResult{},
        resources: []ResourceInfo{},
        res_handlers: []fn(&string) string{},
        templates: []ResourceTemplateInfo{},
        template_handlers: []fn(&string, &string) string{},
        has_template_handler: []bool{},
        prompts: []PromptInfo{},
        prompt_handlers: []fn(&string) string{},
        completion_handler: default_completion_handler
    }
}

fn add_tool_impl(s $&Server, name string, description string, input_schema_json string,
                 annotations ToolAnnotations, handler fn(&string) ToolResult) {
    $schema := input_schema_json + ""
    if schema.len == 0 {
        schema = "{\"type\":\"object\"}"
    }
    s.tools.push(ToolInfo{
        name: name,
        description: description,
        input_schema_json: schema,
        annotations: annotations
    })
    s.tool_handlers.push(handler)
}

pub fn (s $&Server) add_tool(name string, description string, input_schema_json string,
                             handler fn(&string) ToolResult) {
    add_tool_impl(s, name, description, input_schema_json, empty_tool_annotations(), handler)
}

pub fn (s $&Server) add_tool_annotated(name string, description string, input_schema_json string,
                                       annotations ToolAnnotations, handler fn(&string) ToolResult) {
    $ann := annotations
    ann.has_annotations = true
    add_tool_impl(s, name, description, input_schema_json, ann, handler)
}

pub fn (s $&Server) add_resource(uri string, name string, description string, mime_type string,
                                 handler fn(&string) string) {
    $mt := mime_type + ""
    if mt.len == 0 { mt = "text/plain" }
    s.resources.push(ResourceInfo{uri: uri, name: name, description: description, mime_type: mt})
    s.res_handlers.push(handler)
}

pub fn (s $&Server) add_resource_template(uri_template string, name string, description string,
                                          mime_type string) {
    $mt := mime_type + ""
    if mt.len == 0 { mt = "text/plain" }
    s.templates.push(ResourceTemplateInfo{
        uri_template: uri_template,
        name: name,
        description: description,
        mime_type: mt
    })
    s.template_handlers.push(default_template_handler)
    s.has_template_handler.push(false)
}

pub fn (s $&Server) add_resource_template_handler(uri_template string, name string, description string,
                                                  mime_type string, handler fn(&string, &string) string) {
    $mt := mime_type + ""
    if mt.len == 0 { mt = "text/plain" }
    s.templates.push(ResourceTemplateInfo{
        uri_template: uri_template,
        name: name,
        description: description,
        mime_type: mt
    })
    s.template_handlers.push(handler)
    s.has_template_handler.push(true)
}

pub fn (s $&Server) add_prompt(name string, description string, arguments_json string,
                               handler fn(&string) string) {
    $args := arguments_json + ""
    if args.len == 0 { args = "[]" }
    s.prompts.push(PromptInfo{name: name, description: description, arguments_json: args})
    s.prompt_handlers.push(handler)
}

pub fn (s $&Server) set_completion_handler(handler fn(&string, &string, &string) []string) {
    s.completion_handler = handler
}

fn json_str_or(doc &json.Doc, obj int, key string, def string) string {
    if !doc.is_dict(obj) || !doc.has(obj, key) { << def }
    n := doc.get(obj, key) >>> (_) { << def }
    if doc.is_string(n) {
        << doc.as_string(n) >>> (_) { << def }
    }
    << def
}

fn doc_get_or(doc &json.Doc, obj int, key string) int {
    << doc.get(obj, key) >>> (_) { << -1 }
}

fn doc_encode_or(doc &json.Doc, node int, def string) string {
    << doc.encode(node) >>> (_) { << def }
}

fn doc_bool_or(doc &json.Doc, node int, def bool) bool {
    << doc.as_bool(node) >>> (_) { << def }
}

fn fin_read_or(fin &os.File, max int) string {
    << fin.read(max) >>> (_) { << "" }
}

fn close_file_quiet(f $&os.File) int {
    _ := f.close() >>> (_) { << 0 }
    << 0
}

fn conn_close_quiet(fd int) int {
    _ := net.conn_close(fd) >>> (_) { << 0 }
    << 0
}

struct IdParse {
    has_id bool
    id_json string
}

struct RpcResult {
    doc json.Doc
    node int
}

fn extract_id_json(doc &json.Doc, root int) IdParse {
    if !doc.is_dict(root) || !doc.has(root, "id") {
        << IdParse{has_id: false, id_json: "null"}
    }
    idn := doc.get(root, "id") >>> (_) { << IdParse{has_id: false, id_json: "null"} }
    if doc.is_null(idn) {
        << IdParse{has_id: true, id_json: "null"}
    }
    encoded := doc.encode(idn) >>> (_) { << IdParse{has_id: true, id_json: "null"} }
    << IdParse{has_id: true, id_json: encoded}
}

fn rpc_ok(id_json &string, result_json string) string {
    << "{\"jsonrpc\":\"2.0\",\"id\":" + *id_json + ",\"result\":" + result_json + "}"
}

fn rpc_err(id_json &string, code int, msg string) string {
    << "{\"jsonrpc\":\"2.0\",\"id\":" + *id_json + ",\"error\":{\"code\":" + str(code) +
       ",\"message\":" + json.quote(&msg) + "}}"
}

fn encode_tool_result(res &ToolResult) string {
    $s := "{\"content\":["
    for i in 0:res.content.len {
        if i > 0 { s = s + "," }
        c := &res.content[i]
        $k := c.kind + ""
        if k.len == 0 { k = "text" }
        s = s + "{\"type\":" + json.quote(&k) + ",\"text\":" + json.quote(&c.text) + "}"
    }
    s = s + "]"
    if res.is_error {
        s = s + ",\"isError\":true"
    }
    << s + "}"
}

pub fn (s $&Server) handle_json_line(line &string) string {
    $trimmed := line + ""
    trimmed = strings.trim_space(&trimmed)
    if trimmed.len == 0 { << "" }
    doc := json.parse(&trimmed)
    null_id := "null"
    if !doc.ok() || !doc.is_dict(doc.root()) {
        << rpc_err(&null_id, -32700, "Parse error")
    }
    root := doc.root()
    idp := extract_id_json(&doc, root)
    has_id := idp.has_id
    id_json := idp.id_json
    method := json_str_or(&doc, root, "method", "")
    if method.len == 0 {
        if !has_id { << "" }
        << rpc_err(&id_json, -32600, "Invalid Request")
    }
    if strings.has_prefix(&method, "notifications/") && !has_id {
        << ""
    }
    if !has_id {
        << ""
    }

    if method == "initialize" {
        res := "{\"protocolVersion\":" + json.quote(&PROTOCOL_VERSION) +
               ",\"capabilities\":{\"tools\":{\"listChanged\":false},\"resources\":{\"listChanged\":false},\"prompts\":{\"listChanged\":false},\"completions\":{},\"logging\":{}}," +
               "\"serverInfo\":{\"name\":" + json.quote(&s.name) + ",\"version\":" + json.quote(&s.version) + "}}"
        << rpc_ok(&id_json, res)
    }
    if method == "ping" {
        << rpc_ok(&id_json, "{}")
    }
    if method == "tools/list" {
        $arr := "["
        for i in 0:s.tools.len {
            if i > 0 { arr = arr + "," }
            t := &s.tools[i]
            arr = arr + "{\"name\":" + json.quote(&t.name) +
                  ",\"description\":" + json.quote(&t.description) +
                  ",\"inputSchema\":" + t.input_schema_json
            if t.annotations.has_annotations {
                $ro := "false"
                if t.annotations.read_only_hint { ro = "true" }
                $dh := "false"
                if t.annotations.destructive_hint { dh = "true" }
                $ih := "false"
                if t.annotations.idempotent_hint { ih = "true" }
                $oh := "false"
                if t.annotations.open_world_hint { oh = "true" }
                arr = arr + ",\"annotations\":{\"title\":" + json.quote(&t.annotations.title) +
                      ",\"readOnlyHint\":" + ro +
                      ",\"destructiveHint\":" + dh +
                      ",\"idempotentHint\":" + ih +
                      ",\"openWorldHint\":" + oh + "}"
            }
            arr = arr + "}"
        }
        arr = arr + "]"
        << rpc_ok(&id_json, "{\"tools\":" + arr + "}")
    }
    if method == "tools/call" {
        if !doc.has(root, "params") {
            << rpc_err(&id_json, -32602, "missing params")
        }
        params := doc_get_or(&doc, root, "params")
        tname := json_str_or(&doc, params, "name", "")
        if tname.len == 0 {
            << rpc_err(&id_json, -32602, "missing tool name")
        }
        $args_json := "{}"
        if doc.is_dict(params) && doc.has(params, "arguments") {
            an := doc_get_or(&doc, params, "arguments")
            if an >= 0 { args_json = doc_encode_or(&doc, an, "{}") }
        }
        $idx := -1
        for i in 0:s.tools.len {
            if s.tools[i].name == tname {
                idx = i
                <-
            }
        }
        if idx < 0 {
            << rpc_err(&id_json, -32602, "unknown tool: " + tname)
        }
        handler := s.tool_handlers[idx]
        res := handler(&args_json)
        << rpc_ok(&id_json, encode_tool_result(&res))
    }
    if method == "resources/list" {
        $arr := "["
        for i in 0:s.resources.len {
            if i > 0 { arr = arr + "," }
            r := &s.resources[i]
            arr = arr + "{\"uri\":" + json.quote(&r.uri) +
                  ",\"name\":" + json.quote(&r.name) +
                  ",\"description\":" + json.quote(&r.description) +
                  ",\"mimeType\":" + json.quote(&r.mime_type) + "}"
        }
        arr = arr + "]"
        << rpc_ok(&id_json, "{\"resources\":" + arr + "}")
    }
    if method == "resources/read" {
        if !doc.has(root, "params") {
            << rpc_err(&id_json, -32602, "missing params")
        }
        params := doc_get_or(&doc, root, "params")
        uri := json_str_or(&doc, params, "uri", "")
        $idx := -1
        for i in 0:s.resources.len {
            if s.resources[i].uri == uri {
                idx = i
                <-
            }
        }
        if idx >= 0 {
            handler := s.res_handlers[idx]
            text := handler(&uri)
            mt := &s.resources[idx].mime_type
            << rpc_ok(&id_json, "{\"contents\":[{\"uri\":" + json.quote(&uri) + ",\"mimeType\":" +
                              json.quote(mt) + ",\"text\":" + json.quote(&text) + "}]}")
        }
        $tidx := -1
        $vars_json := "{}"
        for ti in 0:s.templates.len {
            if !s.has_template_handler[ti] { -> }
            if match_uri_template(&s.templates[ti].uri_template, &uri, $&vars_json) {
                tidx = ti
                <-
            }
        }
        if tidx >= 0 {
            thandler := s.template_handlers[tidx]
            ttext := thandler(&uri, &vars_json)
            tmt := &s.templates[tidx].mime_type
            << rpc_ok(&id_json, "{\"contents\":[{\"uri\":" + json.quote(&uri) + ",\"mimeType\":" +
                              json.quote(tmt) + ",\"text\":" + json.quote(&ttext) + "}]}")
        }
        << rpc_err(&id_json, -32602, "resource not found: " + uri)
    }
    if method == "prompts/list" {
        $arr := "["
        for i in 0:s.prompts.len {
            if i > 0 { arr = arr + "," }
            p := &s.prompts[i]
            arr = arr + "{\"name\":" + json.quote(&p.name) +
                  ",\"description\":" + json.quote(&p.description) +
                  ",\"arguments\":" + p.arguments_json + "}"
        }
        arr = arr + "]"
        << rpc_ok(&id_json, "{\"prompts\":" + arr + "}")
    }
    if method == "prompts/get" {
        if !doc.has(root, "params") {
            << rpc_err(&id_json, -32602, "missing params")
        }
        params := doc_get_or(&doc, root, "params")
        pname := json_str_or(&doc, params, "name", "")
        $args_json := "{}"
        if doc.is_dict(params) && doc.has(params, "arguments") {
            an := doc_get_or(&doc, params, "arguments")
            if an >= 0 { args_json = doc_encode_or(&doc, an, "{}") }
        }
        $idx := -1
        for i in 0:s.prompts.len {
            if s.prompts[i].name == pname {
                idx = i
                <-
            }
        }
        if idx < 0 {
            << rpc_err(&id_json, -32602, "prompt not found: " + pname)
        }
        handler := s.prompt_handlers[idx]
        text := handler(&args_json)
        << rpc_ok(&id_json, "{\"messages\":[{\"role\":\"user\",\"content\":{\"type\":\"text\",\"text\":" +
                          json.quote(&text) + "}}]}")
    }
    if method == "resources/templates/list" {
        $arr := "["
        for i in 0:s.templates.len {
            if i > 0 { arr = arr + "," }
            rt := &s.templates[i]
            arr = arr + "{\"uriTemplate\":" + json.quote(&rt.uri_template) +
                  ",\"name\":" + json.quote(&rt.name) +
                  ",\"description\":" + json.quote(&rt.description) +
                  ",\"mimeType\":" + json.quote(&rt.mime_type) + "}"
        }
        arr = arr + "]"
        << rpc_ok(&id_json, "{\"resourceTemplates\":" + arr + "}")
    }
    if method == "completion/complete" {
        if !doc.has(root, "params") {
            << rpc_err(&id_json, -32602, "missing params")
        }
        params := doc_get_or(&doc, root, "params")
        $ref_json := "{}"
        if doc.is_dict(params) && doc.has(params, "ref") {
            rn := doc_get_or(&doc, params, "ref")
            if rn >= 0 { ref_json = doc_encode_or(&doc, rn, "{}") }
        }
        $arg_name := ""
        $arg_value := ""
        if doc.is_dict(params) && doc.has(params, "argument") {
            an := doc_get_or(&doc, params, "argument")
            if doc.is_dict(an) {
                arg_name = json_str_or(&doc, an, "name", "")
                arg_value = json_str_or(&doc, an, "value", "")
            }
        }
        handler := s.completion_handler
        vals := handler(&ref_json, &arg_name, &arg_value)
        $varr := "["
        for i in 0:vals.len {
            if i > 0 { varr = varr + "," }
            varr = varr + json.quote(&vals[i])
        }
        varr = varr + "]"
        << rpc_ok(&id_json, "{\"completion\":{\"values\":" + varr + ",\"total\":" + str(vals.len) + ",\"hasMore\":false}}")
    }
    if method == "logging/setLevel" {
        if !doc.has(root, "params") {
            << rpc_err(&id_json, -32602, "missing params")
        }
        params := doc_get_or(&doc, root, "params")
        lvl := json_str_or(&doc, params, "level", "")
        if !is_valid_log_level(&lvl) {
            << rpc_err(&id_json, -32602, "invalid log level: " + lvl)
        }
        s.log_level = lvl
        << rpc_ok(&id_json, "{}")
    }
    << rpc_err(&id_json, -32601, "Method not found: " + method)
}

fn is_valid_log_level(lvl &string) bool {
    << *lvl == "debug" || *lvl == "info" || *lvl == "notice" || *lvl == "warning" ||
       *lvl == "error" || *lvl == "critical" || *lvl == "alert" || *lvl == "emergency"
}

fn match_uri_template(tmpl &string, uri &string, vars_json $&string) bool {
    $ti := 0
    $ui := 0
    $keys := []string{}
    $vals := []string{}
    while ti < tmpl.len {
        if (*tmpl)[ti] == 123 {
            $close := -1
            for k in (ti + 1):tmpl.len {
                if (*tmpl)[k] == 125 {
                    close = k
                    <-
                }
            }
            if close < 0 { << false }
            vname := (*tmpl)[ti + 1:close]
            ti = close + 1
            $stop_ch := -1
            if ti < tmpl.len { stop_ch = (*tmpl)[ti] & 255 }
            u_start := ui
            while ui < uri.len {
                ch := (*uri)[ui] & 255
                if ch == 47 || (stop_ch >= 0 && ch == stop_ch) { <- }
                ui += 1
            }
            if ui <= u_start { << false }
            keys.push(vname)
            vals.push((*uri)[u_start:ui])
        } else {
            if ui >= uri.len || (*uri)[ui] != (*tmpl)[ti] { << false }
            ti += 1
            ui += 1
        }
    }
    if ui != uri.len { << false }
    $vj := "{"
    for i in 0:keys.len {
        if i > 0 { vj = vj + "," }
        vj = vj + json.quote(&keys[i]) + ":" + json.quote(&vals[i])
    }
    *vars_json = vj + "}"
    << true
}

fn is_exit_notification(line &string) bool {
    $trimmed := line + ""
    trimmed = strings.trim_space(&trimmed)
    if trimmed.len == 0 { << false }
    doc := json.parse(&trimmed)
    if !doc.ok() || !doc.is_dict(doc.root()) { << false }
    method := json_str_or(&doc, doc.root(), "method", "")
    << method == "notifications/exit" || method == "exit"
}

pub fn (s $&Server) serve_stdio() int {
    $fin := os.open("/dev/stdin") >>>
    $buf := ""
    $should_exit := false
    for {
        $consumed := 0
        for {
            $nl := -1
            for i in consumed:buf.len {
                if buf[i] == 10 {
                    nl = i
                    <-
                }
            }
            if nl < 0 { <- }
            $line := buf[consumed:nl]
            if line.len > 0 && line[line.len - 1] == 13 {
                line = line[0:line.len - 1]
            }
            consumed = nl + 1
            if is_exit_notification(&line) {
                should_exit = true
                <-
            }
            resp := s.handle_json_line(&line)
            if resp.len > 0 {
                println(resp)
            }
        }
        if should_exit { <- }
        if consumed > 0 {
            buf = buf[consumed:buf.len]
        }
        chunk := fin_read_or(&fin, 8192)
        if chunk.len == 0 {
            if buf.len > 0 && !is_exit_notification(&buf) {
                resp := s.handle_json_line(&buf)
                if resp.len > 0 {
                    println(resp)
                }
            }
            <-
        }
        buf = buf + chunk
    }
    _ := close_file_quiet($&fin)
    << 0
}

fn accept_fd_or(lfd int) int {
    << net.accept(lfd) >>> (_) { << -1 }
}

fn read_http_req(fd int, hreq $&http.Request) bool {
    _ := hreq.read(fd) >>> (_) { << false }
    << true
}

fn conn_write_all_quiet(fd int, data &string) int {
    $off := 0
    while off < data.len {
        part := data[off:data.len]
        n := net.conn_write(fd, &part) >>> (_) { << 0 }
        if n <= 0 { << 0 }
        off += n
    }
    << 1
}

fn write_http_raw(fd int, status_line string, extra_headers string, ctype string, body &string) int {
    $raw := status_line + "\r\n" + extra_headers
    if ctype.len > 0 {
        raw = raw + "Content-Type: " + ctype + "\r\n"
    }
    raw = raw + "Content-Length: " + str(body.len) + "\r\nConnection: close\r\n\r\n"
    if body.len > 0 {
        raw = raw + *body
    }
    << conn_write_all_quiet(fd, &raw)
}

fn is_initialize_body(body &string) bool {
    doc := json.parse(body)
    if !doc.ok() || !doc.is_dict(doc.root()) { << false }
    << json_str_or(&doc, doc.root(), "method", "") == "initialize"
}

// serve_http_server runs the Streamable HTTP MCP accept loop on a pre-bound
// http.Server (so callers can bind 127.0.0.1:0 and inspect srv.addr() first).
pub fn (s $&Server) serve_http_server(srv $&http.Server) int {
    if srv.lfd < 0 {
        >> errors.new("mcp: HTTP server is not listening")
    }
    $session_seq := 0
    for {
        fd := accept_fd_or(srv.lfd)
        if fd < 0 { <- }
        $hreq := http.new_request()
        if !read_http_req(fd, $&hreq) {
            _ := conn_close_quiet(fd)
            ->
        }
        method := hreq.method()
        cors := "Access-Control-Allow-Origin: *\r\nAccess-Control-Allow-Methods: POST, DELETE, OPTIONS\r\nAccess-Control-Allow-Headers: Content-Type, Accept, Mcp-Session-Id, Authorization\r\n"
        if method == "OPTIONS" {
            empty := ""
            _ := write_http_raw(fd, "HTTP/1.1 204 No Content", cors, "", &empty)
            _ := conn_close_quiet(fd)
            ->
        }
        if method == "DELETE" {
            empty := ""
            _ := write_http_raw(fd, "HTTP/1.1 200 OK", cors, "", &empty)
            _ := conn_close_quiet(fd)
            ->
        }
        if method != "POST" {
            msg := "{\"error\":\"method not allowed\"}"
            _ := write_http_raw(fd, "HTTP/1.1 405 Method Not Allowed", cors, "application/json", &msg)
            _ := conn_close_quiet(fd)
            ->
        }
        body := hreq.body()
        resp := s.handle_json_line(&body)
        if resp.len == 0 {
            empty := ""
            _ := write_http_raw(fd, "HTTP/1.1 202 Accepted", cors, "", &empty)
            _ := conn_close_quiet(fd)
            ->
        }
        $extra := cors + ""
        if is_initialize_body(&body) {
            session_seq += 1
            extra = extra + "Mcp-Session-Id: xu-mcp-" + str(session_seq) + "\r\n"
        }
        accept_hdr := hreq.header("Accept")
        want_sse := strings.contains(&accept_hdr, "text/event-stream") && !strings.contains(&accept_hdr, "application/json")
        if want_sse {
            sse_body := "event: message\ndata: " + resp + "\n\n"
            _ := write_http_raw(fd, "HTTP/1.1 200 OK", extra, "text/event-stream", &sse_body)
        } else {
            _ := write_http_raw(fd, "HTTP/1.1 200 OK", extra, "application/json", &resp)
        }
        _ := conn_close_quiet(fd)
    }
    << 0
}

pub fn (s $&Server) serve_http(addr string) int {
    $srv := http.new_server()
    _ := srv.listen(addr) >>>
    rc := s.serve_http_server($&srv) >>> (err) {
        _ := srv.close()
        >> err
    }
    _ := srv.close()
    << rc
}

pub struct Client {
    pub base_url string
    pub session_id string
    pub server_name string
    pub server_version string
    pub extra_headers []string
    next_id int
}

pub fn new_http_client(base_url string) Client {
    << Client{
        base_url: base_url,
        session_id: "",
        server_name: "",
        server_version: "",
        extra_headers: []string{},
        next_id: 1
    }
}

pub fn (c $&Client) add_header(name string, value string) {
    c.extra_headers.push(name + ": " + value)
}

pub fn (c $&Client) set_bearer_token(token string) {
    c.extra_headers.push("Authorization: Bearer " + token)
}

pub fn (c &Client) clone_client() Client {
    $hdrs := []string{}
    for i in 0:c.extra_headers.len {
        hdrs.push(c.extra_headers[i] + "")
    }
    << Client{
        base_url: c.base_url + "",
        session_id: c.session_id + "",
        server_name: c.server_name + "",
        server_version: c.server_version + "",
        extra_headers: ~hdrs,
        next_id: c.next_id + 1000
    }
}

fn default_port_for(raw &string) int {
    if strings.has_prefix(raw, "https://") { << 443 }
    << 80
}

fn parse_rpc_payload(ctype &string, body &string) string {
    if strings.has_prefix(ctype, "text/event-stream") || strings.has_prefix(body, "data:") || strings.has_prefix(body, "event:") {
        lines := strings.split(body, "\n")
        for i in 0:lines.len {
            $l := lines[i] + ""
            l = strings.trim_space(&l)
            if strings.has_prefix(&l, "data:") {
                $p := l[5:l.len]
                p = strings.trim_space(&p)
                if p.len > 0 { << p }
            }
        }
    }
    << *body
}

fn encode_rpc_request(id int, method &string, params_json &string, is_notif bool) string {
    $req_json := "{\"jsonrpc\":\"2.0\""
    if !is_notif {
        req_json = req_json + ",\"id\":" + str(id)
    }
    req_json = req_json + ",\"method\":" + json.quote(method)
    if params_json.len > 0 {
        req_json = req_json + ",\"params\":" + *params_json
    }
    << req_json + "}"
}

fn parse_rpc_response_json(payload &string) RpcResult {
    doc := json.parse(payload)
    if !doc.ok() || !doc.is_dict(doc.root()) {
        >> errors.new("mcp: invalid JSON-RPC response")
    }
    root := doc.root()
    if doc.has(root, "error") {
        en := doc.get(root, "error") >>>
        emsg := json_str_or(&doc, en, "message", "RPC error")
        >> errors.new("mcp: " + emsg)
    }
    if !doc.has(root, "result") {
        >> errors.new("mcp: missing result")
    }
    res_node := doc.get(root, "result") >>>
    << RpcResult{doc: ~doc, node: res_node}
}

fn parse_tool_annotations(doc &json.Doc, item int) ToolAnnotations {
    $ann := empty_tool_annotations()
    if !doc.is_dict(item) || !doc.has(item, "annotations") { << ann }
    an := doc_get_or(doc, item, "annotations")
    if an < 0 || !doc.is_dict(an) { << ann }
    ann.has_annotations = true
    ann.title = json_str_or(doc, an, "title", "")
    if doc.has(an, "readOnlyHint") {
        n := doc_get_or(doc, an, "readOnlyHint")
        if n >= 0 && doc.is_bool(n) { ann.read_only_hint = doc_bool_or(doc, n, false) }
    }
    if doc.has(an, "destructiveHint") {
        n := doc_get_or(doc, an, "destructiveHint")
        if n >= 0 && doc.is_bool(n) { ann.destructive_hint = doc_bool_or(doc, n, false) }
    }
    if doc.has(an, "idempotentHint") {
        n := doc_get_or(doc, an, "idempotentHint")
        if n >= 0 && doc.is_bool(n) { ann.idempotent_hint = doc_bool_or(doc, n, false) }
    }
    if doc.has(an, "openWorldHint") {
        n := doc_get_or(doc, an, "openWorldHint")
        if n >= 0 && doc.is_bool(n) { ann.open_world_hint = doc_bool_or(doc, n, false) }
    }
    << ann
}

fn parse_tools_result(doc &json.Doc, res int) []ToolInfo {
    $out := []ToolInfo{}
    if doc.is_dict(res) && doc.has(res, "tools") {
        arr := doc.get(res, "tools") >>>
        if doc.is_list(arr) {
            cnt := doc.count(arr)
            for i in 0:cnt {
                item := doc.at(arr, i) >>>
                $schema := "{}"
                if doc.is_dict(item) && doc.has(item, "inputSchema") {
                    sn := doc.get(item, "inputSchema") >>>
                    schema = doc.encode(sn) >>>
                }
                out.push(ToolInfo{
                    name: json_str_or(doc, item, "name", ""),
                    description: json_str_or(doc, item, "description", ""),
                    input_schema_json: schema,
                    annotations: parse_tool_annotations(doc, item)
                })
            }
        }
    }
    << out
}

fn parse_resource_templates_result(doc &json.Doc, res int) []ResourceTemplateInfo {
    $out := []ResourceTemplateInfo{}
    if doc.is_dict(res) && doc.has(res, "resourceTemplates") {
        arr := doc.get(res, "resourceTemplates") >>>
        if doc.is_list(arr) {
            cnt := doc.count(arr)
            for i in 0:cnt {
                item := doc.at(arr, i) >>>
                out.push(ResourceTemplateInfo{
                    uri_template: json_str_or(doc, item, "uriTemplate", ""),
                    name: json_str_or(doc, item, "name", ""),
                    description: json_str_or(doc, item, "description", ""),
                    mime_type: json_str_or(doc, item, "mimeType", "text/plain")
                })
            }
        }
    }
    << out
}

fn doc_str_or(doc &json.Doc, node int, def string) string {
    << doc.as_string(node) >>> (_) { << def }
}

fn parse_completion_result(doc &json.Doc, res int) []string {
    $out := []string{}
    if !doc.is_dict(res) || !doc.has(res, "completion") { << out }
    cn := doc_get_or(doc, res, "completion")
    if !doc.is_dict(cn) || !doc.has(cn, "values") { << out }
    arr := doc.get(cn, "values") >>>
    if !doc.is_list(arr) { << out }
    cnt := doc.count(arr)
    for i in 0:cnt {
        vn := doc.at(arr, i) >>>
        if doc.is_string(vn) {
            out.push(doc_str_or(doc, vn, ""))
        }
    }
    << out
}

fn encode_complete_params(ref_type &string, ref_id &string, arg_name &string, arg_value &string) string {
    $ref_obj := "{\"type\":" + json.quote(ref_type)
    if *ref_type == "ref/prompt" {
        ref_obj = ref_obj + ",\"name\":" + json.quote(ref_id) + "}"
    } else if *ref_type == "ref/resource" {
        ref_obj = ref_obj + ",\"uri\":" + json.quote(ref_id) + "}"
    } else {
        ref_obj = ref_obj + ",\"name\":" + json.quote(ref_id) + ",\"uri\":" + json.quote(ref_id) + "}"
    }
    << "{\"ref\":" + ref_obj + ",\"argument\":{\"name\":" + json.quote(arg_name) + ",\"value\":" + json.quote(arg_value) + "}}"
}

fn parse_tool_call_result(doc &json.Doc, res int) ToolResult {
    $items := []ContentItem{}
    if doc.is_dict(res) && doc.has(res, "content") {
        arr := doc.get(res, "content") >>>
        if doc.is_list(arr) {
            cnt := doc.count(arr)
            for i in 0:cnt {
                item := doc.at(arr, i) >>>
                items.push(ContentItem{
                    kind: json_str_or(doc, item, "type", "text"),
                    text: json_str_or(doc, item, "text", "")
                })
            }
        }
    }
    $is_err := false
    if doc.is_dict(res) && doc.has(res, "isError") {
        en := doc_get_or(doc, res, "isError")
        if en >= 0 && doc.is_bool(en) {
            is_err = doc_bool_or(doc, en, false)
        }
    }
    << ToolResult{content: ~items, is_error: is_err}
}

fn parse_resources_result(doc &json.Doc, res int) []ResourceInfo {
    $out := []ResourceInfo{}
    if doc.is_dict(res) && doc.has(res, "resources") {
        arr := doc.get(res, "resources") >>>
        if doc.is_list(arr) {
            cnt := doc.count(arr)
            for i in 0:cnt {
                item := doc.at(arr, i) >>>
                out.push(ResourceInfo{
                    uri: json_str_or(doc, item, "uri", ""),
                    name: json_str_or(doc, item, "name", ""),
                    description: json_str_or(doc, item, "description", ""),
                    mime_type: json_str_or(doc, item, "mimeType", "text/plain")
                })
            }
        }
    }
    << out
}

fn parse_resource_read_result(doc &json.Doc, res int) string {
    if doc.is_dict(res) && doc.has(res, "contents") {
        arr := doc.get(res, "contents") >>>
        if doc.is_list(arr) && doc.count(arr) > 0 {
            c0 := doc.at(arr, 0) >>>
            << json_str_or(doc, c0, "text", "")
        }
    }
    << ""
}

fn parse_prompts_result(doc &json.Doc, res int) []PromptInfo {
    $out := []PromptInfo{}
    if doc.is_dict(res) && doc.has(res, "prompts") {
        arr := doc.get(res, "prompts") >>>
        if doc.is_list(arr) {
            cnt := doc.count(arr)
            for i in 0:cnt {
                item := doc.at(arr, i) >>>
                $args := "[]"
                if doc.is_dict(item) && doc.has(item, "arguments") {
                    an := doc.get(item, "arguments") >>>
                    args = doc.encode(an) >>>
                }
                out.push(PromptInfo{
                    name: json_str_or(doc, item, "name", ""),
                    description: json_str_or(doc, item, "description", ""),
                    arguments_json: args
                })
            }
        }
    }
    << out
}

fn parse_prompt_get_result(doc &json.Doc, res int) string {
    if doc.is_dict(res) && doc.has(res, "messages") {
        arr := doc.get(res, "messages") >>>
        if doc.is_list(arr) && doc.count(arr) > 0 {
            m0 := doc.at(arr, 0) >>>
            if doc.is_dict(m0) && doc.has(m0, "content") {
                cn := doc.get(m0, "content") >>>
                << json_str_or(doc, cn, "text", "")
            }
        }
    }
    << ""
}

fn init_params_json() string {
    << "{\"protocolVersion\":" + json.quote(&PROTOCOL_VERSION) +
       ",\"capabilities\":{},\"clientInfo\":{\"name\":\"xu-mcp\",\"version\":\"1.5.0\"}}"
}

fn (c $&Client) rpc_call(method string, params_json string, is_notif bool) RpcResult {
    bu := c.base_url + ""
    def_port := default_port_for(&bu)
    ep := transport.parse_endpoint(bu + "", def_port) >>>
    $id := 0
    if !is_notif {
        id = c.next_id
        c.next_id += 1
    }
    req_json := encode_rpc_request(id, &method, &params_json, is_notif)

    $path := ep.path + ""
    if path.len == 0 { path = "/" }
    $raw := "POST " + path + " HTTP/1.1\r\n" +
            "Host: " + ep.host + ":" + str(ep.port) + "\r\n" +
            "Content-Type: application/json\r\n" +
            "Accept: application/json, text/event-stream\r\n"
    if c.session_id.len > 0 {
        raw = raw + "Mcp-Session-Id: " + c.session_id + "\r\n"
    }
    for hi in 0:c.extra_headers.len {
        raw = raw + c.extra_headers[hi] + "\r\n"
    }
    raw = raw + "Content-Length: " + str(req_json.len) + "\r\nConnection: close\r\n\r\n" + req_json
    cfg := tls.new_config(ep.host + "")
    resp := transport.request_raw(ep, cfg, raw, "POST") >>>
    if resp.status_code < 200 || resp.status_code >= 300 {
        >> errors.code(resp.status_code, "mcp: HTTP " + str(resp.status_code) + " " + resp.body)
    }
    sid := resp.header("Mcp-Session-Id")
    if sid.len > 0 { c.session_id = sid }
    if is_notif || resp.status_code == 202 || resp.body.len == 0 {
        empty := "{}"
        doc := json.parse(&empty)
        rt := doc.root()
        << RpcResult{doc: ~doc, node: rt}
    }
    ctype := resp.header("Content-Type")
    payload := parse_rpc_payload(&ctype, &resp.body)
    << parse_rpc_response_json(&payload) >>>
}

pub fn (c $&Client) initialize() int {
    rr := c.rpc_call("initialize", init_params_json(), false) >>>
    doc := &rr.doc
    res := rr.node
    if doc.is_dict(res) && doc.has(res, "serverInfo") {
        si := doc_get_or(doc, res, "serverInfo")
        c.server_name = json_str_or(doc, si, "name", "")
        c.server_version = json_str_or(doc, si, "version", "")
    }
    _ := c.rpc_call("notifications/initialized", "", true) >>>
    << 0
}

pub fn (c $&Client) close_session() int {
    bu := c.base_url + ""
    def_port := default_port_for(&bu)
    ep := transport.parse_endpoint(bu + "", def_port) >>>
    $path := ep.path + ""
    if path.len == 0 { path = "/" }
    $raw := "DELETE " + path + " HTTP/1.1\r\nHost: " + ep.host + ":" + str(ep.port) + "\r\n"
    if c.session_id.len > 0 {
        raw = raw + "Mcp-Session-Id: " + c.session_id + "\r\n"
    }
    for hi in 0:c.extra_headers.len {
        raw = raw + c.extra_headers[hi] + "\r\n"
    }
    raw = raw + "Connection: close\r\n\r\n"
    cfg := tls.new_config(ep.host + "")
    resp := transport.request_raw(ep, cfg, raw, "DELETE") >>>
    if resp.status_code < 200 || resp.status_code >= 300 {
        >> errors.code(resp.status_code, "mcp: DELETE HTTP " + str(resp.status_code))
    }
    c.session_id = ""
    << 0
}

pub fn (c $&Client) ping() bool {
    _ := c.rpc_call("ping", "", false) >>> (_) { << false }
    << true
}

pub fn (c $&Client) list_tools() []ToolInfo {
    rr := c.rpc_call("tools/list", "{}", false) >>>
    << parse_tools_result(&rr.doc, rr.node) >>>
}

pub fn (c $&Client) call_tool(name string, arguments_json string) ToolResult {
    $args := arguments_json + ""
    if args.len == 0 { args = "{}" }
    params := "{\"name\":" + json.quote(&name) + ",\"arguments\":" + args + "}"
    rr := c.rpc_call("tools/call", params, false) >>>
    << parse_tool_call_result(&rr.doc, rr.node) >>>
}

