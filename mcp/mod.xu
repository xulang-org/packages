pub fn (c $&Client) get_prompt(name string, arguments_json string) string {
    $args := arguments_json + ""
    if args.len == 0 { args = "{}" }
    params := "{\"name\":" + json.quote(&name) + ",\"arguments\":" + args + "}"
    rr := c.rpc_call("prompts/get", params, false) >>>
    << parse_prompt_get_result(&rr.doc, rr.node) >>>
}

pub fn (c $&Client) set_logging_level(level string) int {
    params := "{\"level\":" + json.quote(&level) + "}"
    _ := c.rpc_call("logging/setLevel", params, false) >>>
    << 0
}

pub struct StdioClient {
    pub server_name string
    pub server_version string
    cmd exec.Cmd
    stdin os.File
    stdout os.File
    buf string
    next_id int
    pub closed bool
}

pub fn closed_stdio_client() StdioClient {
    << StdioClient{
        server_name: "",
        server_version: "",
        cmd: exec.command(""),
        stdin: os.closed_file(),
        stdout: os.closed_file(),
        buf: "",
        next_id: 1,
        closed: true
    }
}

pub fn connect_stdio(command string, args []string) StdioClient {
    $cmd := exec.command(command)
    for i in 0:args.len {
        cmd.args.push(args[i] + "")
    }
    $sin := cmd.stdin_pipe() >>> (err) {
        cmd.close_unstarted_pipes()
        >> err
    }
    $sout := cmd.stdout_pipe() >>> (err) {
        _ := close_file_quiet($&sin)
        cmd.close_unstarted_pipes()
        >> err
    }
    _ := cmd.start() >>> (err) {
        _ := close_file_quiet($&sin)
        _ := close_file_quiet($&sout)
        >> err
    }
    << StdioClient{
        server_name: "",
        server_version: "",
        cmd: cmd,
        stdin: sin,
        stdout: sout,
        buf: "",
        next_id: 1,
        closed: false
    }
}

fn write_file_all(f $&os.File, data &string) int {
    $off := 0
    while off < data.len {
        part := data[off:data.len]
        n := f.write(part) >>>
        if n <= 0 { >> errors.new("mcp: stdio pipe closed during write") }
        off += n
    }
    << 0
}

fn (c $&StdioClient) read_line_nonempty() string {
    for {
        $nl := -1
        for i in 0:c.buf.len {
            if c.buf[i] == 10 {
                nl = i
                <-
            }
        }
        if nl >= 0 {
            $line := c.buf[0:nl]
            c.buf = c.buf[nl + 1:c.buf.len]
            if line.len > 0 && line[line.len - 1] == 13 {
                line = line[0:line.len - 1]
            }
            trimmed := strings.trim_space(&line)
            if trimmed.len > 0 { << trimmed }
            ->
        }
        chunk := c.stdout.read(8192) >>>
        if chunk.len == 0 {
            rem := strings.trim_space(&c.buf)
            c.buf = ""
            if rem.len > 0 { << rem }
            >> errors.new("mcp: stdio server closed (EOF)")
        }
        c.buf = c.buf + chunk
    }
    << ""
}

fn (c $&StdioClient) rpc_call(method string, params_json string, is_notif bool) RpcResult {
    if c.closed {
        >> errors.new("mcp: stdio client is closed")
    }
    $id := 0
    if !is_notif {
        id = c.next_id
        c.next_id += 1
    }
    line := encode_rpc_request(id, &method, &params_json, is_notif) + "\n"
    _ := write_file_all($&c.stdin, &line) >>>
    if is_notif {
        empty := "{}"
        doc := json.parse(&empty)
        rt := doc.root()
        << RpcResult{doc: ~doc, node: rt}
    }
    resp_line := c.read_line_nonempty() >>>
    << parse_rpc_response_json(&resp_line) >>>
}

pub fn (c $&StdioClient) initialize() int {
    rr := c.rpc_call("initialize", init_params_json(), false) >>>
    doc := &rr.doc
    res := rr.node
    if doc.is_dict(res) && doc.has(res, "serverInfo") {
        si := doc_get_or(doc, res, "serverInfo")
        c.server_name = json_str_or(doc, si, "name", "")
        c.server_version = json_str_or(doc, si, "version", "")
    }
    _ := c.rpc_call("notifications/initialized", "", true) >>>
    << 0
}

