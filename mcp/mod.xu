pub fn (c $&StdioClient) set_logging_level(level string) int {
    params := "{\"level\":" + json.quote(&level) + "}"
    _ := c.rpc_call("logging/setLevel", params, false) >>>
    << 0
}

fn write_file_quiet(f $&os.File, data &string) int {
    _ := write_file_all(f, data) >>> (_) { << 0 }
    << 0
}

pub fn (c $&StdioClient) close() int {
    if c.closed { << 0 }
    c.closed = true
    exit_line := "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/exit\"}\n"
    _ := write_file_quiet($&c.stdin, &exit_line)
    _ := close_file_quiet($&c.stdin)
    _ := close_file_quiet($&c.stdout)
    cmd_ref := $&c.cmd
    _ := cmd_ref.wait() >>>
    << 0
}

// close_nowait closes client pipes after sending notifications/exit without
// waiting on child exit; use this for external MCP servers that ignore
// notifications/exit while inherited non-FD_CLOEXEC pipes keep stdin open.
pub fn (c $&StdioClient) close_nowait() int {
    if c.closed { << 0 }
    c.closed = true
    exit_line := "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/exit\"}\n"
    _ := write_file_quiet($&c.stdin, &exit_line)
    _ := close_file_quiet($&c.stdin)
    _ := close_file_quiet($&c.stdout)
    << 0
}
