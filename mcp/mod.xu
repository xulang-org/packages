pub fn (c $&Client) complete(ref_type string, ref_id string, argument_name string, argument_value string) []string {
    params := encode_complete_params(&ref_type, &ref_id, &argument_name, &argument_value)
    rr := c.rpc_call("completion/complete", params, false) >>>
    << parse_completion_result(&rr.doc, rr.node) >>>
}

pub fn (c $&Client) read_resource(uri string) string {
    params := "{\"uri\":" + json.quote(&uri) + "}"
    rr := c.rpc_call("resources/read", params, false) >>>
    << parse_resource_read_result(&rr.doc, rr.node) >>>
}

pub fn (c $&Client) list_prompts() []PromptInfo {
    rr := c.rpc_call("prompts/list", "{}", false) >>>
    << parse_prompts_result(&rr.doc, rr.node) >>>
