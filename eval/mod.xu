@"github.com/xulang-org/packages/eval"

#encoding/json
#errors
#math
#os
#strconv
#strings
openai #github.com/xulang-org/packages/openai
anthropic #github.com/xulang-org/packages/anthropic
gemini #github.com/xulang-org/packages/gemini

pub struct JudgeResult {
    pub score f64
    pub passed bool
    pub reasoning string
}

pub struct EvalCase {
    pub id string
    pub input string
    pub expected string
}

pub struct EvalSummary {
    pub total int
    pub exact_match_avg f64
    pub token_f1_avg f64
    pub rouge_l_avg f64
}

pub struct RagasReport {
    pub context_precision f64
    pub context_recall f64
    pub faithfulness f64
    pub answer_relevancy f64
    pub overall f64
}

fn normalize_ws_lower(s &string) string {
    $out := ""
    $prev_sp := true
    for i in 0:s.len {
        ch := (*s)[i] & 255
        is_ws := ch == 32 || ch == 9 || ch == 10 || ch == 13
        is_punct := ch == 46 || ch == 44 || ch == 33 || ch == 63 || ch == 58 || ch == 59
        if is_ws || is_punct {
            if !prev_sp && out.len > 0 {
                out = out + " "
                prev_sp = true
            }
        } else {
            $c := ch
            if c >= 65 && c <= 90 { c += 32 }
            out.push_str(string_from_byte(c))
            prev_sp = false
        }
    }
    if out.len > 0 && (out[out.len - 1] & 255) == 32 {
        out = out[0:out.len - 1]
    }
    << out
}

fn eval_tokenize(s &string) []string {
    norm := normalize_ws_lower(s)
    $toks := []string{}
    $start := 0
    for i in 0:(norm.len + 1) {
        $is_end := i == norm.len
        if !is_end { is_end = (norm[i] & 255) == 32 }
        if is_end {
            if i > start { toks.push(norm[start:i]) }
            start = i + 1
        }
    }
    << toks
}

pub fn exact_match(pred &string, gold &string, normalize bool) f64 {
    if normalize {
        if normalize_ws_lower(pred) == normalize_ws_lower(gold) { << 1.0 }
        << 0.0
    }
    if strings.trim_space(pred) == strings.trim_space(gold) { << 1.0 }
    << 0.0
}

fn ngram_key(toks &[]string, start int, n int) string {
    $k := ""
    sep := string_from_byte(31)
    for j in 0:n {
        if j > 0 { k = k + sep }
        k = k + toks[start + j]
    }
    << k
}

fn count_overlap(a &[]string, b &[]string) int {
    $used := []bool{}
    for _ in 0:b.len { used.push(false) }
    $hits := 0
    for i in 0:a.len {
        for j in 0:b.len {
            if !used[j] && a[i] == b[j] {
                used[j] = true
                hits += 1
                <-
            }
        }
    }
    << hits
}

pub fn token_f1(pred &string, gold &string) f64 {
    ptoks := eval_tokenize(pred)
    gtoks := eval_tokenize(gold)
    if ptoks.len == 0 && gtoks.len == 0 { << 1.0 }
    if ptoks.len == 0 || gtoks.len == 0 { << 0.0 }
    hits := count_overlap(&ptoks, &gtoks)
    if hits == 0 { << 0.0 }
    prec := f64(hits) / f64(ptoks.len)
    rec := f64(hits) / f64(gtoks.len)
    << (2.0 * prec * rec) / (prec + rec)
}

pub fn rouge_n(pred &string, reference &string, n int) f64 {
    if n <= 0 { << 0.0 }
    ptoks := eval_tokenize(pred)
    rtoks := eval_tokenize(reference)
    if ptoks.len < n || rtoks.len < n {
        if ptoks.len == 0 && rtoks.len == 0 { << 1.0 }
        << 0.0
    }
    $png := []string{}
    $rng := []string{}
    for i in 0:(ptoks.len - n + 1) { png.push(ngram_key(&ptoks, i, n)) }
    for i in 0:(rtoks.len - n + 1) { rng.push(ngram_key(&rtoks, i, n)) }
    hits := count_overlap(&png, &rng)
    if hits == 0 { << 0.0 }
    prec := f64(hits) / f64(png.len)
    rec := f64(hits) / f64(rng.len)
    << (2.0 * prec * rec) / (prec + rec)
}

pub fn rouge_l(pred &string, reference &string) f64 {
    ptoks := eval_tokenize(pred)
    rtoks := eval_tokenize(reference)
    if ptoks.len == 0 && rtoks.len == 0 { << 1.0 }
    if ptoks.len == 0 || rtoks.len == 0 { << 0.0 }
    rows := ptoks.len + 1
    cols := rtoks.len + 1
    $dp := []int{}
    for _ in 0:(rows * cols) { dp.push(0) }
    for i in 1:rows {
        for j in 1:cols {
            if ptoks[i - 1] == rtoks[j - 1] {
                dp[i * cols + j] = dp[(i - 1) * cols + (j - 1)] + 1
            } else {
                up := dp[(i - 1) * cols + j]
                left := dp[i * cols + (j - 1)]
                if up >= left { dp[i * cols + j] = up }
                else { dp[i * cols + j] = left }
            }
        }
    }
    lcs := dp[ptoks.len * cols + rtoks.len]
    if lcs == 0 { << 0.0 }
    prec := f64(lcs) / f64(ptoks.len)
    rec := f64(lcs) / f64(rtoks.len)
    << (2.0 * prec * rec) / (prec + rec)
}

pub fn bleu_score(pred &string, reference &string, max_n int) f64 {
    ptoks := eval_tokenize(pred)
    rtoks := eval_tokenize(reference)
    if ptoks.len == 0 { << 0.0 }
    if rtoks.len == 0 { << 0.0 }
    $mn := max_n
    if mn <= 0 { mn = 4 }
    if ptoks.len < mn { mn = ptoks.len }
    if rtoks.len < mn { mn = rtoks.len }
    if mn <= 0 { << 0.0 }
    $log_sum := 0.0
    for n in 1:(mn + 1) {
        $png := []string{}
        $rng := []string{}
        for i in 0:(ptoks.len - n + 1) { png.push(ngram_key(&ptoks, i, n)) }
        for i in 0:(rtoks.len - n + 1) { rng.push(ngram_key(&rtoks, i, n)) }
        hits := count_overlap(&png, &rng)
        // Smoothing +1 for denominator/numerator when hits == 0 on short strings
        $p := f64(hits) / f64(png.len)
        if hits == 0 { p = 1.0 / (f64(png.len) + 1.0) }
        log_sum += math.log(p) / f64(mn)
    }
    $bp := 1.0
    if ptoks.len < rtoks.len {
        bp = math.exp(1.0 - f64(rtoks.len) / f64(ptoks.len))
    }
    << bp * math.exp(log_sum)
}

pub fn json_valid_score(output &string, required_keys &[]string) f64 {
    trimmed := strings.trim_space(output)
    doc := json.parse(&trimmed)
    if !doc.ok() || !doc.is_dict(doc.root()) { << 0.0 }
    root := doc.root()
    if required_keys.len == 0 { << 1.0 }
    $found := 0
    for i in 0:required_keys.len {
        if doc.has(root, required_keys[i] + "") { found += 1 }
    }
    << f64(found) / f64(required_keys.len)
}

fn eval_json_f64_or(doc &json.Doc, obj int, key string, def f64) f64 {
    if !doc.has(obj, key) { << def }
    sn := doc.get(obj, key) >>> (_) { << def }
    if !doc.is_number(sn) { << def }
    << doc.as_f64(sn) >>> (_) { << def }
}

fn eval_json_str_or(doc &json.Doc, obj int, key string, def string) string {
    if !doc.has(obj, key) { << def }
    rn := doc.get(obj, key) >>> (_) { << def }
    if !doc.is_string(rn) { << def }
    << doc.as_string(rn) >>> (_) { << def }
}

fn eval_parse_f64_or(s &string, def f64) f64 {
    << strconv.parse_float(s) >>> (_) { << def }
}

fn parse_judge_response(raw_text &string, pass_threshold f64) JudgeResult {
    $raw := strings.trim_space(raw_text)
    if strings.has_prefix(&raw, "```json") {
        raw = raw[7:raw.len]
        raw = strings.trim_space(&raw)
    } else if strings.has_prefix(&raw, "```") {
        raw = raw[3:raw.len]
        raw = strings.trim_space(&raw)
    }
    if strings.has_suffix(&raw, "```") && raw.len >= 3 {
        raw = raw[0:raw.len - 3]
        raw = strings.trim_space(&raw)
    }
    doc := json.parse(&raw)
    $sc := 0.0
    $reas := raw + ""
    if doc.ok() && doc.is_dict(doc.root()) {
        root := doc.root()
        sc = eval_json_f64_or(&doc, root, "score", 0.0)
        reas = eval_json_str_or(&doc, root, "reasoning", reas)
    } else {
        sc = eval_parse_f64_or(&raw, 0.0)
    }
    << JudgeResult{score: sc, passed: sc >= pass_threshold, reasoning: reas}
}

pub fn judge_openai(client &openai.Client, model string, question string,
                    answer string, rubric string, pass_threshold f64) JudgeResult {
    sys := "You are an impartial evaluator. Score the assistant answer from 0.0 to 1.0 against the rubric and respond ONLY with a JSON object: {\"score\": <number>, \"reasoning\": \"...\"}."
    usr := "Question:\n" + question + "\n\nAnswer:\n" + answer + "\n\nRubric:\n" + rubric
    $req := openai.chat_request(model, [openai.message("system", sys), openai.message("user", usr)])
    req.response_format_json = "{\"type\":\"json_object\"}"
    resp := client.chat(&req) >>>
    << parse_judge_response(&resp.content, pass_threshold)
}

pub fn judge_anthropic(client &anthropic.Client, model string, question string,
                       answer string, rubric string, pass_threshold f64) JudgeResult {
    sys := "You are an impartial evaluator. Score the assistant answer from 0.0 to 1.0 against the rubric and respond ONLY with a JSON object: {\"score\": <number>, \"reasoning\": \"...\"}."
    usr := "Question:\n" + question + "\n\nAnswer:\n" + answer + "\n\nRubric:\n" + rubric
    $req := anthropic.messages_request(model, [anthropic.message("user", usr)], 512)
    req.system = sys
    resp := client.messages(&req) >>>
    << parse_judge_response(&resp.content, pass_threshold)
}

pub fn judge_gemini(client &gemini.Client, model string, question string,
                    answer string, rubric string, pass_threshold f64) JudgeResult {
    sys := "You are an impartial evaluator. Score the assistant answer from 0.0 to 1.0 against the rubric and respond ONLY with a JSON object: {\"score\": <number>, \"reasoning\": \"...\"}."
    usr := "Question:\n" + question + "\n\nAnswer:\n" + answer + "\n\nRubric:\n" + rubric
    $req := gemini.generate_request(model, [gemini.user_text(usr)])
    req.system_instruction = sys
    req.response_mime_type = "application/json"
    resp := client.generate(&req) >>>
    << parse_judge_response(&resp.text, pass_threshold)
}

pub fn run_suite(cases &[]EvalCase, predictor fn(&string) string) EvalSummary {
    if cases.len == 0 {
        << EvalSummary{total: 0, exact_match_avg: 0.0, token_f1_avg: 0.0, rouge_l_avg: 0.0}
    }
    $em := 0.0
    $f1 := 0.0
    $rl := 0.0
    for i in 0:cases.len {
        c := &cases[i]
        inp := c.input + ""
        pred := predictor(&inp)
        em += exact_match(&pred, &c.expected, true)
        f1 += token_f1(&pred, &c.expected)
        rl += rouge_l(&pred, &c.expected)
    }
    n := f64(cases.len)
    << EvalSummary{total: cases.len, exact_match_avg: em / n, token_f1_avg: f1 / n, rouge_l_avg: rl / n}
}

fn eval_unique_content_tokens(s &string) []string {
    raw := eval_tokenize(s)
    $out := []string{}
    for i in 0:raw.len {
        w := &raw[i]
        if w.len < 3 { -> }
        if *w == "the" || *w == "and" || *w == "for" || *w == "are" ||
           *w == "was" || *w == "what" || *w == "how" || *w == "with" { -> }
        $seen := false
        for j in 0:out.len {
            if out[j] == *w {
                seen = true
                <-
            }
        }
        if !seen { out.push((*w) + "") }
    }
    << out
}

fn split_sentences_eval(s &string) []string {
    $out := []string{}
    $start := 0
    for i in 0:(s.len + 1) {
        $is_sep := i == s.len
        if !is_sep {
            ch := (*s)[i] & 255
            is_sep = ch == 46 || ch == 33 || ch == 63 || ch == 10
        }
        if is_sep {
            if i > start {
                raw_piece := (*s)[start:i]
                piece := strings.trim_space(&raw_piece)
                if piece.len > 0 { out.push(piece) }
            }
            start = i + 1
        }
    }
    << out
}

fn token_cov_ratio(needle_toks &[]string, haystack_toks &[]string) f64 {
    if needle_toks.len == 0 { << 1.0 }
    if haystack_toks.len == 0 { << 0.0 }
    $hits := 0
    for i in 0:needle_toks.len {
        nw := &needle_toks[i]
        for j in 0:haystack_toks.len {
            if haystack_toks[j] == *nw {
                hits += 1
                <-
            }
        }
    }
    << f64(hits) / f64(needle_toks.len)
}

pub fn rag_context_precision(retrieved_texts &[]string, ground_truth &string) f64 {
    if retrieved_texts.len == 0 { << 0.0 }
    gt_toks := eval_unique_content_tokens(ground_truth)
    if gt_toks.len == 0 { << 1.0 }
    $rel_hits := 0
    $prec_sum := 0.0
    for k in 0:retrieved_texts.len {
        c_toks := eval_unique_content_tokens(&retrieved_texts[k])
        if token_cov_ratio(&c_toks, &gt_toks) >= 0.25 || token_cov_ratio(&gt_toks, &c_toks) >= 0.25 {
            rel_hits += 1
            prec_sum += f64(rel_hits) / f64(k + 1)
        }
    }
    if rel_hits == 0 { << 0.0 }
    << prec_sum / f64(rel_hits)
}

pub fn rag_context_recall(retrieved_texts &[]string, ground_truth &string) f64 {
    gt_toks := eval_unique_content_tokens(ground_truth)
    if gt_toks.len == 0 { << 1.0 }
    if retrieved_texts.len == 0 { << 0.0 }
    $ctx_toks := []string{}
    for k in 0:retrieved_texts.len {
        ts := eval_unique_content_tokens(&retrieved_texts[k])
        for i in 0:ts.len { ctx_toks.push(ts[i] + "") }
    }
    << token_cov_ratio(&gt_toks, &ctx_toks)
}

pub fn rag_faithfulness(answer &string, retrieved_texts &[]string) f64 {
    sents := split_sentences_eval(answer)
    if sents.len == 0 { << 1.0 }
    if retrieved_texts.len == 0 { << 0.0 }
    $ctx_toks := []string{}
    for k in 0:retrieved_texts.len {
        ts := eval_unique_content_tokens(&retrieved_texts[k])
        for i in 0:ts.len { ctx_toks.push(ts[i] + "") }
    }
    $tot := 0.0
    $cnt := 0
    for si in 0:sents.len {
        stoks := eval_unique_content_tokens(&sents[si])
        if stoks.len > 0 {
            tot += token_cov_ratio(&stoks, &ctx_toks)
            cnt += 1
        }
    }
    if cnt == 0 { << 1.0 }
    << tot / f64(cnt)
}

pub fn rag_answer_relevancy(question &string, answer &string) f64 {
    atoks := eval_unique_content_tokens(answer)
    if atoks.len == 0 { << 0.0 }
    qtoks := eval_unique_content_tokens(question)
    if qtoks.len == 0 { << 1.0 }
    << token_cov_ratio(&qtoks, &atoks)
}

pub fn evaluate_rag_triad(question &string, answer &string,
                          retrieved_texts &[]string, ground_truth &string) RagasReport {
    cp := rag_context_precision(retrieved_texts, ground_truth)
    cr := rag_context_recall(retrieved_texts, ground_truth)
    fa := rag_faithfulness(answer, retrieved_texts)
    ar := rag_answer_relevancy(question, answer)
    << RagasReport{
        context_precision: cp,
        context_recall: cr,
        faithfulness: fa,
        answer_relevancy: ar,
        overall: (cp + cr + fa + ar) / 4.0
    }
}

pub fn evaluate_rag_judge_openai(client &openai.Client, model string, question string,
                                 answer string, retrieved_texts &[]string) RagasReport {
    sys := "You are a Ragas RAG evaluator. Score 0.0..1.0 and respond ONLY with JSON: {\"context_precision\":<num>,\"context_recall\":<num>,\"faithfulness\":<num>,\"answer_relevancy\":<num>}."
    $ctx := ""
    for i in 0:retrieved_texts.len {
        if i > 0 { ctx = ctx + "\n" }
        ctx = ctx + "[" + str(i + 1) + "] " + retrieved_texts[i]
    }
    usr := "Question:\n" + question + "\n\nContext:\n" + ctx + "\n\nAnswer:\n" + answer
    $req := openai.chat_request(model, [openai.message("system", sys), openai.message("user", usr)])
    req.response_format_json = "{\"type\":\"json_object\"}"
    resp := client.chat(&req) >>>
    raw := strings.trim_space(&resp.content)
    doc := json.parse(&raw)
    if !doc.ok() || !doc.is_dict(doc.root()) {
        >> errors.new("eval: judge returned non-JSON Ragas output")
    }
    root := doc.root()
    cp := eval_json_f64_or(&doc, root, "context_precision", 0.0)
    cr := eval_json_f64_or(&doc, root, "context_recall", 0.0)
    fa := eval_json_f64_or(&doc, root, "faithfulness", 0.0)
    ar := eval_json_f64_or(&doc, root, "answer_relevancy", 0.0)
    << RagasReport{
        context_precision: cp,
        context_recall: cr,
        faithfulness: fa,
        answer_relevancy: ar,
        overall: (cp + cr + fa + ar) / 4.0
    }
}

pub struct PairwiseResult {
    pub winner string
    pub reasoning string
}

pub fn pass_at_k(n int, c int, k int) f64 {
    if n <= 0 || c <= 0 || k <= 0 { << 0.0 }
    if n - c < k { << 1.0 }
    $prob_fail := 1.0
    for i in 0:k {
        prob_fail = prob_fail * (f64(n - c - i) / f64(n - i))
    }
    << 1.0 - prob_fail
}

pub fn compare_openai(client &openai.Client, model string, question string,
                      answer_a string, answer_b string, rubric string) PairwiseResult {
    sys := "You are an impartial pairwise evaluator. Compare Answer A and Answer B against the rubric and respond ONLY with JSON: {\"winner\": \"A\"|\"B\"|\"tie\", \"reasoning\": \"...\"}."
    usr := "Question:\n" + question + "\n\nAnswer A:\n" + answer_a + "\n\nAnswer B:\n" + answer_b + "\n\nRubric:\n" + rubric
    $req := openai.chat_request(model + "", [openai.message("system", sys), openai.message("user", usr)])
    req.response_format_json = "{\"type\":\"json_object\"}"
    resp := client.chat(&req) >>>
    $raw := strings.trim_space(&resp.content)
    if strings.has_prefix(&raw, "```json") {
        raw = strings.trim_space(&raw[7:raw.len])
    } else if strings.has_prefix(&raw, "```") {
        raw = strings.trim_space(&raw[3:raw.len])
    }
    if strings.has_suffix(&raw, "```") && raw.len >= 3 {
        raw = strings.trim_space(&raw[0:raw.len - 3])
    }
    doc := json.parse(&raw)
    if !doc.ok() || !doc.is_dict(doc.root()) {
        >> errors.new("eval: pairwise judge returned non-JSON output")
    }
    root := doc.root()
    $w := strings.trim_space(&eval_json_str_or(&doc, root, "winner", "tie"))
    if w == "a" || w == "A" { w = "A" }
    else if w == "b" || w == "B" { w = "B" }
    else { w = "tie" }
    << PairwiseResult{winner: w, reasoning: eval_json_str_or(&doc, root, "reasoning", "")}
}

pub fn load_cases_jsonl(path string) []EvalCase {
    raw := os.read(path + "") >>>
    lines := strings.split(&raw, "\n")
    $out := []EvalCase{}
    for i in 0:lines.len {
        ln := strings.trim_space(&lines[i])
        if ln.len == 0 { -> }
        doc := json.parse(&ln)
        if !doc.ok() || !doc.is_dict(doc.root()) {
            >> errors.new("eval: invalid JSONL line " + str(i + 1))
        }
        root := doc.root()
        $cid := eval_json_str_or(&doc, root, "id", "")
        if cid.len == 0 { cid = "case_" + str(out.len + 1) }
        $inp := eval_json_str_or(&doc, root, "input", "")
        if inp.len == 0 { inp = eval_json_str_or(&doc, root, "question", "") }
        $exp := eval_json_str_or(&doc, root, "expected", "")
        if exp.len == 0 { exp = eval_json_str_or(&doc, root, "ground_truth", "") }
        out.push(EvalCase{id: cid, input: inp, expected: exp})
    }
    << out
}

pub struct SchemaFieldRule {
    pub name string
    pub expected_type string
    pub required bool
}

pub struct SchemaCheckResult {
    pub valid bool
    pub pass_rate f64
    pub missing_fields []string
    pub type_mismatches []string
}

pub struct RawSchemaResult {
    pub valid bool
    pub errors []string
}

fn eval_utf8_len(s &string) int {
    $n := 0
    for i in 0:s.len {
        b := (*s)[i] & 255
        if (b & 192) != 128 { n += 1 }
    }
    << n
}

fn eval_doc_at_or(doc &json.Doc, arr int, idx int) int {
    << doc.at(arr, idx) >>> (_) { << -1 }
}

fn eval_str_in(xs &[]string, target &string) bool {
    for i in 0:xs.len {
        if xs[i] == *target { << true }
    }
    << false
}

fn eval_json_nodes_equal(a_doc &json.Doc, a int, b_doc &json.Doc, b int, depth int) bool {
    if depth > 32 { << false }
    if a_doc.is_null(a) { << b_doc.is_null(b) }
    if a_doc.is_bool(a) {
        if !b_doc.is_bool(b) { << false }
        ba := a_doc.as_bool(a) >>> (_) { << false }
        bb := b_doc.as_bool(b) >>> (_) { << false }
        << ba == bb
    }
    if a_doc.is_number(a) {
        if !b_doc.is_number(b) { << false }
        fa := a_doc.as_f64(a) >>> (_) { << false }
        fb := b_doc.as_f64(b) >>> (_) { << false }
        << fa == fb
    }
    if a_doc.is_string(a) {
        if !b_doc.is_string(b) { << false }
        sa := a_doc.as_string(a) >>> (_) { << false }
        sb := b_doc.as_string(b) >>> (_) { << false }
        << sa == sb
    }
    if a_doc.is_list(a) {
        if !b_doc.is_list(b) { << false }
        ca := a_doc.count(a)
        cb := b_doc.count(b)
        if ca != cb { << false }
        for i in 0:ca {
            ia := eval_doc_at_or(a_doc, a, i)
            ib := eval_doc_at_or(b_doc, b, i)
            if ia < 0 || ib < 0 || !eval_json_nodes_equal(a_doc, ia, b_doc, ib, depth + 1) { << false }
        }
        << true
    }
    if a_doc.is_dict(a) {
        if !b_doc.is_dict(b) { << false }
        ka := a_doc.dict_keys(a)
        kb := b_doc.dict_keys(b)
        if ka.len != kb.len { << false }
        for i in 0:ka.len {
            k := &ka[i]
            if !b_doc.has(b, (*k) + "") { << false }
            va := eval_doc_get_or(a_doc, a, (*k) + "")
            vb := eval_doc_get_or(b_doc, b, (*k) + "")
            if va < 0 || vb < 0 || !eval_json_nodes_equal(a_doc, va, b_doc, vb, depth + 1) { << false }
        }
        << true
    }
    << false
}

fn eval_unescape_ptr(seg &string) string {
    $out := ""
    $i := 0
    while i < seg.len {
        ch := (*seg)[i] & 255
        if ch == 126 && i + 1 < seg.len {
            nx := (*seg)[i + 1] & 255
            if nx == 48 {
                out.push_str("~")
                i += 2
                ->
            }
            if nx == 49 {
                out.push_str("/")
                i += 2
                ->
            }
        }
        out.push_str(string_from_byte(ch))
        i += 1
    }
    << out
}

fn resolve_schema_ref(sch_doc &json.Doc, sroot int, ref_str &string) int {
    if !strings.has_prefix(ref_str, "#/") { << -1 }
    tail := (*ref_str)[2:ref_str.len]
    parts := strings.split(&tail, "/")
    $cur := sroot
    for i in 0:parts.len {
        key := eval_unescape_ptr(&parts[i])
        if !sch_doc.is_dict(cur) || !sch_doc.has(cur, key + "") { << -1 }
        cur = eval_doc_get_or(sch_doc, cur, key + "")
        if cur < 0 { << -1 }
    }
    << cur
}

fn eval_node_as_bool(doc &json.Doc, n int, def bool) bool {
    << doc.as_bool(n) >>> (_) { << def }
}
fn eval_single_schema_type(doc &json.Doc, vnode int, ty &string) bool {
    if *ty == "string" { << doc.is_string(vnode) }
    if *ty == "number" { << doc.is_number(vnode) }
    if *ty == "integer" || *ty == "int" {
        if !doc.is_number(vnode) { << false }
        fv := doc.as_f64(vnode) >>> (_) { << false }
        << fv == math.floor(fv)
    }
    if *ty == "boolean" || *ty == "bool" { << doc.is_bool(vnode) }
    if *ty == "array" || *ty == "list" { << doc.is_list(vnode) }
    if *ty == "object" || *ty == "dict" { << doc.is_dict(vnode) }
    if *ty == "null" { << doc.is_null(vnode) }
    << true
}

fn validate_schema_node(val_doc &json.Doc, vnode int, sch_doc &json.Doc, sroot int, snode int,
                        path string, depth int, errs $&[]string) {
    if depth > 48 {
        errs.push(path + ": schema recursion depth exceeded")
        <<
    }
    if snode < 0 || !sch_doc.is_dict(snode) { << }

    // $ref
    if sch_doc.has(snode, "$$ref") {
        ref_str := eval_json_str_or(sch_doc, snode, "$$ref", "")
        target := resolve_schema_ref(sch_doc, sroot, &ref_str)
        if target < 0 {
            errs.push(path + ": unresolved $$ref " + ref_str)
            <<
        }
        validate_schema_node(val_doc, vnode, sch_doc, sroot, target, path, depth + 1, errs)
    }

    // allOf / anyOf / oneOf
    if sch_doc.has(snode, "allOf") {
        an := eval_doc_get_or(sch_doc, snode, "allOf")
        if an >= 0 && sch_doc.is_list(an) {
            cnt := sch_doc.count(an)
            for i in 0:cnt {
                sub := eval_doc_at_or(sch_doc, an, i)
                if sub >= 0 { validate_schema_node(val_doc, vnode, sch_doc, sroot, sub, path, depth + 1, errs) }
            }
        }
    }
    if sch_doc.has(snode, "anyOf") {
        an := eval_doc_get_or(sch_doc, snode, "anyOf")
        if an >= 0 && sch_doc.is_list(an) {
            cnt := sch_doc.count(an)
            $matched := false
            for i in 0:cnt {
                sub := eval_doc_at_or(sch_doc, an, i)
                $sub_errs := []string{}
                validate_schema_node(val_doc, vnode, sch_doc, sroot, sub, path, depth + 1, $&sub_errs)
                if sub_errs.len == 0 {
                    matched = true
                    <-
                }
            }
            if !matched { errs.push(path + ": failed all anyOf branches") }
        }
    }
    if sch_doc.has(snode, "oneOf") {
        an := eval_doc_get_or(sch_doc, snode, "oneOf")
        if an >= 0 && sch_doc.is_list(an) {
            cnt := sch_doc.count(an)
            $match_cnt := 0
            for i in 0:cnt {
                sub := eval_doc_at_or(sch_doc, an, i)
                $sub_errs := []string{}
                validate_schema_node(val_doc, vnode, sch_doc, sroot, sub, path, depth + 1, $&sub_errs)
                if sub_errs.len == 0 { match_cnt += 1 }
            }
            if match_cnt != 1 { errs.push(path + ": matched " + str(match_cnt) + " oneOf branches (expected 1)") }
        }
    }

    // const / enum
    if sch_doc.has(snode, "const") {
        cn := eval_doc_get_or(sch_doc, snode, "const")
        if cn >= 0 && !eval_json_nodes_equal(val_doc, vnode, sch_doc, cn, 0) {
            errs.push(path + ": const mismatch")
        }
    }
    if sch_doc.has(snode, "enum") {
        en := eval_doc_get_or(sch_doc, snode, "enum")
        if en >= 0 && sch_doc.is_list(en) {
            cnt := sch_doc.count(en)
            $ok := false
            for i in 0:cnt {
                item := eval_doc_at_or(sch_doc, en, i)
                if item >= 0 && eval_json_nodes_equal(val_doc, vnode, sch_doc, item, 0) {
                    ok = true
                    <-
                }
            }
            if !ok { errs.push(path + ": value not in enum") }
        }
    }

    // type (string or array of strings)
    if sch_doc.has(snode, "type") {
        tn := eval_doc_get_or(sch_doc, snode, "type")
        if tn >= 0 && sch_doc.is_string(tn) {
            ty := sch_doc.as_string(tn) >>> (_) { << }
            if !eval_single_schema_type(val_doc, vnode, &ty) {
                errs.push(path + ": expected type " + ty)
            }
        } else if tn >= 0 && sch_doc.is_list(tn) {
            cnt := sch_doc.count(tn)
            $ok := false
            for i in 0:cnt {
                it := eval_doc_at_or(sch_doc, tn, i)
                if it >= 0 && sch_doc.is_string(it) {
                    ty := sch_doc.as_string(it) >>> (_) { << }
                    if eval_single_schema_type(val_doc, vnode, &ty) {
                        ok = true
                        <-
                    }
                }
            }
            if !ok { errs.push(path + ": value matches none of allowed types") }
        }
    }

    // String constraints
    if val_doc.is_string(vnode) {
        sv := val_doc.as_string(vnode) >>> (_) { << }
        ulen := eval_utf8_len(&sv)
        if sch_doc.has(snode, "minLength") {
            mn := eval_doc_get_or(sch_doc, snode, "minLength")
            if mn >= 0 && sch_doc.is_number(mn) {
                mv := sch_doc.as_int(mn) >>> (_) { << }
                if ulen < mv { errs.push(path + ": string length " + str(ulen) + " < minLength " + str(mv)) }
            }
        }
        if sch_doc.has(snode, "maxLength") {
            mx := eval_doc_get_or(sch_doc, snode, "maxLength")
            if mx >= 0 && sch_doc.is_number(mx) {
                mv := sch_doc.as_int(mx) >>> (_) { << }
                if ulen > mv { errs.push(path + ": string length " + str(ulen) + " > maxLength " + str(mv)) }
            }
        }
    }

    // Number constraints
    if val_doc.is_number(vnode) {
        fv := val_doc.as_f64(vnode) >>> (_) { << }
        if sch_doc.has(snode, "minimum") {
            mn := eval_doc_get_or(sch_doc, snode, "minimum")
            if mn >= 0 && sch_doc.is_number(mn) {
                mv := sch_doc.as_f64(mn) >>> (_) { << }
                if fv < mv { errs.push(path + ": value < minimum") }
            }
        }
        if sch_doc.has(snode, "maximum") {
            mx := eval_doc_get_or(sch_doc, snode, "maximum")
            if mx >= 0 && sch_doc.is_number(mx) {
                mv := sch_doc.as_f64(mx) >>> (_) { << }
                if fv > mv { errs.push(path + ": value > maximum") }
            }
        }
        if sch_doc.has(snode, "exclusiveMinimum") {
            emn := eval_doc_get_or(sch_doc, snode, "exclusiveMinimum")
            if emn >= 0 && sch_doc.is_number(emn) {
                mv := sch_doc.as_f64(emn) >>> (_) { << }
                if fv <= mv { errs.push(path + ": value <= exclusiveMinimum") }
            }
        }
        if sch_doc.has(snode, "exclusiveMaximum") {
            emx := eval_doc_get_or(sch_doc, snode, "exclusiveMaximum")
            if emx >= 0 && sch_doc.is_number(emx) {
                mv := sch_doc.as_f64(emx) >>> (_) { << }
                if fv >= mv { errs.push(path + ": value >= exclusiveMaximum") }
            }
        }
    }

    // Array constraints
    if val_doc.is_list(vnode) {
        cnt := val_doc.count(vnode)
        if sch_doc.has(snode, "minItems") {
            mn := eval_doc_get_or(sch_doc, snode, "minItems")
            if mn >= 0 && sch_doc.is_number(mn) {
                mv := sch_doc.as_int(mn) >>> (_) { << }
                if cnt < mv { errs.push(path + ": array len " + str(cnt) + " < minItems " + str(mv)) }
            }
        }
        if sch_doc.has(snode, "maxItems") {
            mx := eval_doc_get_or(sch_doc, snode, "maxItems")
            if mx >= 0 && sch_doc.is_number(mx) {
                mv := sch_doc.as_int(mx) >>> (_) { << }
                if cnt > mv { errs.push(path + ": array len " + str(cnt) + " > maxItems " + str(mv)) }
            }
        }
        if sch_doc.has(snode, "items") {
            item_sch := eval_doc_get_or(sch_doc, snode, "items")
            if item_sch >= 0 && sch_doc.is_dict(item_sch) {
                for i in 0:cnt {
                    elem := eval_doc_at_or(val_doc, vnode, i)
                    if elem >= 0 {
                        validate_schema_node(val_doc, elem, sch_doc, sroot, item_sch, path + "[" + str(i) + "]", depth + 1, errs)
                    }
                }
            }
        }
    }

    // Object constraints
    if val_doc.is_dict(vnode) {
        if sch_doc.has(snode, "required") {
            rn := eval_doc_get_or(sch_doc, snode, "required")
            if rn >= 0 && sch_doc.is_list(rn) {
                rcnt := sch_doc.count(rn)
                for i in 0:rcnt {
                    kn := eval_doc_at_or(sch_doc, rn, i)
                    if kn >= 0 && sch_doc.is_string(kn) {
                        req_k := sch_doc.as_string(kn) >>> (_) { << }
                        if !val_doc.has(vnode, req_k + "") {
                            errs.push(path + ": missing required key '" + req_k + "'")
                        }
                    }
                }
            }
        }
        $prop_keys := []string{}
        $props_node := -1
        if sch_doc.has(snode, "properties") {
            props_node = eval_doc_get_or(sch_doc, snode, "properties")
            if props_node >= 0 && sch_doc.is_dict(props_node) {
                prop_keys = sch_doc.dict_keys(props_node)
                for i in 0:prop_keys.len {
                    pk := &prop_keys[i]
                    if val_doc.has(vnode, (*pk) + "") {
                        child_v := eval_doc_get_or(val_doc, vnode, (*pk) + "")
                        child_s := eval_doc_get_or(sch_doc, props_node, (*pk) + "")
                        if child_v >= 0 && child_s >= 0 {
                            validate_schema_node(val_doc, child_v, sch_doc, sroot, child_s, path + "." + (*pk), depth + 1, errs)
                        }
                    }
                }
            }
        }
        if sch_doc.has(snode, "additionalProperties") {
            ap := eval_doc_get_or(sch_doc, snode, "additionalProperties")
            if ap >= 0 {
                vkeys := val_doc.dict_keys(vnode)
                if sch_doc.is_bool(ap) {
                    allow_extra := eval_node_as_bool(sch_doc, ap, true)
                    if !allow_extra {
                        for vi in 0:vkeys.len {
                            vk := &vkeys[vi]
                            if !eval_str_in(&prop_keys, vk) {
                                errs.push(path + ": additional property not allowed: " + (*vk))
                            }
                        }
                    }
                } else if sch_doc.is_dict(ap) {
                    for vi in 0:vkeys.len {
                        vk := &vkeys[vi]
                        if !eval_str_in(&prop_keys, vk) {
                            child_v := eval_doc_get_or(val_doc, vnode, (*vk) + "")
                            if child_v >= 0 {
                                validate_schema_node(val_doc, child_v, sch_doc, sroot, ap, path + "." + (*vk), depth + 1, errs)
                            }
                        }
                    }
                }
            }
        }
    }
}

pub fn evaluate_json_schema_raw(output &string, schema_json &string) RawSchemaResult {
    raw := eval_strip_json_fence(output)
    val_doc := json.parse(&raw)
    if !val_doc.ok() {
        << RawSchemaResult{valid: false, errors: ["output is not valid JSON: " + val_doc.error()]}
    }
    sch_doc := json.parse(schema_json)
    if !sch_doc.ok() || !sch_doc.is_dict(sch_doc.root()) {
        << RawSchemaResult{valid: false, errors: ["invalid JSON Schema document"]}
    }
    $errs := []string{}
    validate_schema_node(&val_doc, val_doc.root(), &sch_doc, sch_doc.root(), sch_doc.root(), "$$", 0, $&errs)
    << RawSchemaResult{valid: errs.len == 0, errors: ~errs}
}

fn eval_type_matches(doc &json.Doc, node int, expected &string) bool {
    if *expected == "string" { << doc.is_string(node) }
    if *expected == "number" { << doc.is_number(node) }
    if *expected == "int" { << doc.is_number(node) }
    if *expected == "bool" { << doc.is_bool(node) }
    if *expected == "array" || *expected == "list" { << doc.is_list(node) }
    if *expected == "object" || *expected == "dict" { << doc.is_dict(node) }
    << true
}

fn eval_strip_json_fence(raw &string) string {
    $s := strings.trim_space(raw)
    if strings.has_prefix(&s, "```json") {
        s = strings.trim_space(&s[7:s.len])
    } else if strings.has_prefix(&s, "```") {
        s = strings.trim_space(&s[3:s.len])
    }
    if strings.has_suffix(&s, "```") && s.len >= 3 {
        s = strings.trim_space(&s[0:s.len - 3])
    }
    << s
}

fn eval_doc_get_or(doc &json.Doc, obj int, key string) int {
    << doc.get(obj, key) >>> (_) { << -1 }
}

pub fn evaluate_json_schema(output &string, rules &[]SchemaFieldRule) SchemaCheckResult {
    raw := eval_strip_json_fence(output)
    doc := json.parse(&raw)
    $missing := []string{}
    $mismatch := []string{}
    if !doc.ok() || !doc.is_dict(doc.root()) {
        for i in 0:rules.len {
            if rules[i].required { missing.push(rules[i].name + "") }
        }
        << SchemaCheckResult{
            valid: false, pass_rate: 0.0,
            missing_fields: ~missing, type_mismatches: ~mismatch
        }
    }
    root := doc.root()
    if rules.len == 0 {
        << SchemaCheckResult{
            valid: true, pass_rate: 1.0,
            missing_fields: ~missing, type_mismatches: ~mismatch
        }
    }
    $passed := 0
    for i in 0:rules.len {
        r := &rules[i]
        if !doc.has(root, r.name + "") {
            if r.required { missing.push(r.name + "") }
            else { passed += 1 }
            ->
        }
        n := eval_doc_get_or(&doc, root, r.name + "")
        if n < 0 {
            mismatch.push(r.name + ":unavailable")
            ->
        }
        if r.expected_type.len > 0 && !eval_type_matches(&doc, n, &r.expected_type) {
            mismatch.push(r.name + ":" + r.expected_type)
            ->
        }
        passed += 1
    }
    rate := f64(passed) / f64(rules.len)
    ok := missing.len == 0 && mismatch.len == 0
    << SchemaCheckResult{
        valid: ok, pass_rate: rate,
        missing_fields: ~missing, type_mismatches: ~mismatch
    }
}

pub fn expected_calibration_error(confidences &[]f64, correctness &[]bool, num_bins int) f64 {
    n := confidences.len
    if n == 0 || correctness.len != n { << 0.0 }
    $bins := num_bins
    if bins <= 0 { bins = 10 }
    $ece := 0.0
    for bi in 0:bins {
        lo := f64(bi) / f64(bins)
        hi := f64(bi + 1) / f64(bins)
        $cnt := 0
        $sum_conf := 0.0
        $sum_acc := 0.0
        for i in 0:n {
            $c := confidences[i]
            if c < 0.0 { c = 0.0 } else if c > 1.0 { c = 1.0 }
            $in_bin := false
            if bi == bins - 1 {
                in_bin = c >= lo && c <= hi
            } else {
                in_bin = c >= lo && c < hi
            }
            if in_bin {
                cnt += 1
                sum_conf += c
                if correctness[i] { sum_acc += 1.0 }
            }
        }
        if cnt > 0 {
            avg_c := sum_conf / f64(cnt)
            avg_a := sum_acc / f64(cnt)
            $diff := avg_a - avg_c
            if diff < 0.0 { diff = -diff }
            ece += (f64(cnt) / f64(n)) * diff
        }
    }
    << ece
}

pub struct RegressionGateResult {
    pub passed bool
    pub em_delta f64
    pub f1_delta f64
    pub rouge_delta f64
    pub summary string
}

fn eval_fmt_f64(v f64) string {
    << strconv.format_float(v, 102, 6) >>> (_) { << "0.0" }
}

pub fn compare_summaries(baseline &EvalSummary, candidate &EvalSummary, max_drop f64) RegressionGateResult {
    em_d := candidate.exact_match_avg - baseline.exact_match_avg
    f1_d := candidate.token_f1_avg - baseline.token_f1_avg
    rg_d := candidate.rouge_l_avg - baseline.rouge_l_avg
    $drop_lim := max_drop
    if drop_lim < 0.0 { drop_lim = 0.0 }
    ok := em_d >= -drop_lim && f1_d >= -drop_lim && rg_d >= -drop_lim
    $st := "PASS"
    if !ok { st = "FAIL" }
    msg := st + " (em_delta=" + eval_fmt_f64(em_d) + ", f1_delta=" + eval_fmt_f64(f1_d) + ", rouge_l_delta=" + eval_fmt_f64(rg_d) + ")"
    << RegressionGateResult{passed: ok, em_delta: em_d, f1_delta: f1_d, rouge_delta: rg_d, summary: msg}
}

pub fn format_summary_markdown(name string, s &EvalSummary) string {
    << "### Eval Summary: " + name + "\n" +
       "| Metric | Value |\n| --- | --- |\n" +
       "| total | " + str(s.total) + " |\n" +
       "| exact_match_avg | " + eval_fmt_f64(s.exact_match_avg) + " |\n" +
       "| token_f1_avg | " + eval_fmt_f64(s.token_f1_avg) + " |\n" +
       "| rouge_l_avg | " + eval_fmt_f64(s.rouge_l_avg) + " |\n"
}

pub fn format_summary_json(name string, s &EvalSummary) string {
    << "{\"name\":" + json.quote(&name) +
       ",\"total\":" + str(s.total) +
       ",\"exact_match_avg\":" + eval_fmt_f64(s.exact_match_avg) +
       ",\"token_f1_avg\":" + eval_fmt_f64(s.token_f1_avg) +
       ",\"rouge_l_avg\":" + eval_fmt_f64(s.rouge_l_avg) + "}"
}

