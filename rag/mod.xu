@"github.com/xulang-org/packages/rag"

#database/sql
#database/sql/driver
#encoding/json
#errors
#math
#os
#strconv
#strings
#tensor
cohere #github.com/xulang-org/packages/cohere
openai #github.com/xulang-org/packages/openai
postgres #github.com/xulang-org/packages/postgres
qdrant #github.com/xulang-org/packages/qdrant
sqlite #github.com/xulang-org/packages/sqlite

pub struct Chunk {
    pub id string
    pub doc_id string
    pub text string
    pub source string
    pub metadata_json string
    pub embedding []f32
}

pub struct SearchHit {
    pub chunk Chunk
    pub score f64
}

pub struct MemoryStore {
    pub dim int
    pub chunks []Chunk
}

pub struct ParentChildDoc {
    pub parents []Chunk
    pub children []Chunk
}

pub fn new_store(dim int) MemoryStore {
    << MemoryStore{dim: dim, chunks: []Chunk{}}
}

pub fn (s &MemoryStore) len() int {
    << s.chunks.len
}

pub fn chunk_text(text string, chunk_size int, overlap int) []string {
    $out := []string{}
    if text.len == 0 { << out }
    $cs := chunk_size
    if cs <= 0 { cs = 512 }
    $ov := overlap
    if ov < 0 { ov = 0 }
    if ov >= cs { ov = cs - 1 }
    if ov < 0 { ov = 0 }
    step := cs - ov
    $pos := 0
    while pos < text.len {
        $end := pos + cs
        if end > text.len { end = text.len }
        out.push(text[pos:end])
        if end >= text.len { <- }
        pos += step
    }
    << out
}

fn find_last_sep(text &string, start int, end int, sep string) int {
    if sep.len == 0 || end - start < sep.len { << -1 }
    $i := end - sep.len
    while i >= start {
        $ok := true
        for j in 0:sep.len {
            if ((*text)[i + j] & 255) != (sep[j] & 255) {
                ok = false
                <-
            }
        }
        if ok { << i + sep.len }
        i -= 1
    }
    << -1
}

pub fn chunk_recursive(text string, max_chars int, overlap int) []string {
    $out := []string{}
    if text.len == 0 { << out }
    $mc := max_chars
    if mc <= 0 { mc = 512 }
    $ov := overlap
    if ov < 0 { ov = 0 }
    if ov >= mc { ov = mc - 1 }
    if ov < 0 { ov = 0 }
    $pos := 0
    while pos < text.len {
        if text.len - pos <= mc {
            piece := strings.trim_space(&text[pos:text.len])
            if piece.len > 0 { out.push(piece) }
            <-
        }
        limit := pos + mc
        $cut := find_last_sep(&text, pos + 1, limit, "\n\n")
        if cut < 0 { cut = find_last_sep(&text, pos + 1, limit, "\n") }
        if cut < 0 { cut = find_last_sep(&text, pos + 1, limit, ". ") }
        if cut < 0 { cut = find_last_sep(&text, pos + 1, limit, " ") }
        if cut <= pos { cut = limit }
        piece := strings.trim_space(&text[pos:cut])
        if piece.len > 0 { out.push(piece) }
        $next_pos := cut - ov
        if next_pos <= pos { next_pos = cut }
        pos = next_pos
    }
    << out
}

fn copy_embedding(src &[]f32) []f32 {
    $out := []f32{}
    out.reserve(src.len)
    for i in 0:src.len {
        out.push(src[i])
    }
    << out
}

fn copy_chunk(c &Chunk) Chunk {
    << Chunk{
        id: c.id + "",
        doc_id: c.doc_id + "",
        text: c.text + "",
        source: c.source + "",
        metadata_json: c.metadata_json + "",
        embedding: copy_embedding(&c.embedding)
    }
}

pub fn (s $&MemoryStore) add_chunk(id string, doc_id string, text string, source string,
                                   metadata_json string, embedding &[]f64) int {
    if s.dim <= 0 {
        >> errors.new("rag: store dimension must be positive")
    }
    if embedding.len != s.dim {
        >> errors.new("rag: embedding dimension mismatch")
    }
    $vec := []f32{}
    vec.reserve(s.dim)
    for i in 0:s.dim {
        vec.push(f32(embedding[i]))
    }
    $meta := metadata_json + ""
    if meta.len == 0 { meta = "{}" }
    s.chunks.push(Chunk{
        id: id,
        doc_id: doc_id,
        text: text,
        source: source,
        metadata_json: meta,
        embedding: ~vec
    })
    << s.chunks.len - 1
}

pub fn (s &MemoryStore) search(query_emb &[]f64, top_k int, filter_doc_id string) []SearchHit {
    $hits := []SearchHit{}
    if s.dim <= 0 || top_k <= 0 || s.chunks.len == 0 { << hits }
    if query_emb.len != s.dim {
        >> errors.new("rag: query embedding dimension mismatch")
    }
    $matched := []int{}
    $corpus := []f32{}
    for i in 0:s.chunks.len {
        c := &s.chunks[i]
        if filter_doc_id.len > 0 && c.doc_id != filter_doc_id { -> }
        if c.embedding.len != s.dim { -> }
        matched.push(i)
        for j in 0:s.dim {
            corpus.push(c.embedding[j])
        }
    }
    if matched.len == 0 { << hits }
    $q_f32 := []f32{}
    q_f32.reserve(s.dim)
    for j in 0:s.dim {
        q_f32.push(f32(query_emb[j]))
    }
    $k := top_k
    if k > matched.len { k = matched.len }
    $out_idx := []int{}
    $out_scores := []f32{}
    for _ in 0:k {
        out_idx.push(0)
        out_scores.push(f32(0))
    }
    picked := tensor.topk_cosine_f32(&q_f32, &corpus, matched.len, s.dim, k, $&out_idx, $&out_scores)
    for r in 0:picked {
        m_i := out_idx[r]
        if m_i >= 0 && m_i < matched.len {
            orig := matched[m_i]
            hits.push(SearchHit{
                chunk: copy_chunk(&s.chunks[orig]),
                score: f64(out_scores[r])
            })
        }
    }
    << hits
}

fn fmt_f32_or(v f32) string {
    << strconv.format_float(f64(v), 102, 7) >>> (_) { << "0.0" }
}

pub fn (s &MemoryStore) save_json(path string) int {
    $out := "{\"dim\":" + str(s.dim) + ",\"chunks\":["
    for i in 0:s.chunks.len {
        if i > 0 { out = out + "," }
        c := &s.chunks[i]
        $meta := c.metadata_json + ""
        if meta.len == 0 { meta = "{}" }
        out = out + "{\"id\":" + json.quote(&c.id) +
            ",\"doc_id\":" + json.quote(&c.doc_id) +
            ",\"text\":" + json.quote(&c.text) +
            ",\"source\":" + json.quote(&c.source) +
            ",\"metadata\":" + meta +
            ",\"embedding\":["
        for j in 0:c.embedding.len {
            if j > 0 { out = out + "," }
            out = out + fmt_f32_or(c.embedding[j])
        }
        out = out + "]}"
    }
    out = out + "]}"
    _ := os.write(path, out) >>>
    << 0
}

fn json_str_or(doc &json.Doc, obj int, key string, def string) string {
    if !doc.is_dict(obj) || !doc.has(obj, key) { << def }
    n := doc.get(obj, key) >>> (_) { << def }
    if doc.is_string(n) {
        << doc.as_string(n) >>> (_) { << def }
    }
    << def
}

fn json_encode_or(doc &json.Doc, node int, def string) string {
    << doc.encode(node) >>> (_) { << def }
}

pub fn load_json(path string) MemoryStore {
    raw := os.read(path) >>>
    doc := json.parse(&raw)
    if !doc.ok() || !doc.is_dict(doc.root()) {
        >> errors.new("rag: invalid JSON store file")
    }
    root := doc.root()
    $dim := 0
    if doc.has(root, "dim") {
        dn := doc.get(root, "dim") >>>
        if doc.is_number(dn) { dim = doc.as_int(dn) >>> }
    }
    $store := new_store(dim)
    if doc.has(root, "chunks") {
        arr := doc.get(root, "chunks") >>>
        if doc.is_list(arr) {
            cnt := doc.count(arr)
            for i in 0:cnt {
                item := doc.at(arr, i) >>>
                $vec := []f64{}
                if doc.has(item, "embedding") {
                    en := doc.get(item, "embedding") >>>
                    if doc.is_list(en) {
                        ec := doc.count(en)
                        for j in 0:ec {
                            vn := doc.at(en, j) >>>
                            if doc.is_number(vn) {
                                vec.push(doc.as_f64(vn) >>>)
                            }
                        }
                    }
                }
                if store.dim <= 0 && vec.len > 0 { store.dim = vec.len }
                $meta := "{}"
                if doc.has(item, "metadata") {
                    mn := doc.get(item, "metadata") >>>
                    ms := json_encode_or(&doc, mn, "{}")
                    if ms.len > 0 { meta = ms }
                }
                _ := store.add_chunk(
                    json_str_or(&doc, item, "id", ""),
                    json_str_or(&doc, item, "doc_id", ""),
                    json_str_or(&doc, item, "text", ""),
                    json_str_or(&doc, item, "source", ""),
                    meta,
                    &vec
                ) >>>
            }
        }
    }
    << store
}

pub fn index_document(store $&MemoryStore, client &openai.Client, embed_model string,
                      doc_id string, source string, text string,
                      chunk_size int, overlap int, metadata_json string) int {
    pieces := chunk_text(text, chunk_size, overlap)
    if pieces.len == 0 { << 0 }
    $inputs := []string{}
    for i in 0:pieces.len {
        inputs.push(pieces[i] + "")
    }
    req := openai.embed_request(embed_model, ~inputs)
    resp := client.embeddings(&req) >>>
    if resp.embeddings.len != pieces.len {
        >> errors.new("rag: embedding count mismatch")
    }
    for i in 0:pieces.len {
        cid := doc_id + "#" + str(i)
        _ := store.add_chunk(cid, doc_id + "", pieces[i] + "", source + "", metadata_json + "", &resp.embeddings[i]) >>>
    }
    << pieces.len
}

pub fn retrieve(store &MemoryStore, client &openai.Client, embed_model string,
                query string, top_k int, filter_doc_id string) []SearchHit {
    req := openai.embed_request(embed_model, [query])
    resp := client.embeddings(&req) >>>
    if resp.embeddings.len == 0 { << []SearchHit{} }
    << store.search(&resp.embeddings[0], top_k, filter_doc_id) >>>
}

pub fn format_context(hits &[]SearchHit) string {
    $out := ""
    for i in 0:hits.len {
        h := &hits[i]
        if i > 0 { out = out + "\n\n" }
        sc := fmt_f64_or(h.score, "0.0")
        $hdr := "[" + str(i + 1) + "] "
        if h.chunk.source.len > 0 { hdr = hdr + h.chunk.source + " " }
        hdr = hdr + "(score=" + sc + ")"
        out = out + hdr + "\n" + h.chunk.text
    }
    << out
}

fn fmt_f64_or(v f64, def string) string {
    << strconv.format_float(v, 102, 4) >>> (_) { << def }
}

fn parse_md_heading(line &string, level_out $&int, title_out $&string) bool {
    trimmed := strings.trim_space(line)
    if trimmed.len == 0 || trimmed[0] != 35 { << false }
    $lvl := 0
    while lvl < trimmed.len && lvl < 6 && trimmed[lvl] == 35 {
        lvl += 1
    }
    if lvl >= trimmed.len || trimmed[lvl] != 32 { << false }
    rest := trimmed[lvl + 1:trimmed.len]
    *level_out = lvl
    *title_out = strings.trim_space(&rest)
    << true
}

fn join_heading_stack(levels &[]int, titles &[]string) string {
    $out := ""
    for i in 0:levels.len {
        if i > 0 { out = out + " > " }
        out = out + titles[i]
    }
    << out
}

fn emit_md_section(doc_id &string, source &string, crumb &string, body &string,
                   max_chars int, overlap int, out $&[]Chunk) {
    bt := strings.trim_space(body)
    if bt.len == 0 { << }
    $prefix := ""
    if crumb.len > 0 { prefix = "[" + (*crumb) + "]\n" }
    $piece_limit := max_chars
    if piece_limit <= 0 { piece_limit = 512 }
    $avail := piece_limit - prefix.len
    if avail < 32 { avail = piece_limit }
    pieces := chunk_text(bt, avail, overlap)
    meta := "{\"heading\":" + json.quote(crumb) + "}"
    for pi in 0:pieces.len {
        idx := out.len
        out.push(Chunk{
            id: (*doc_id) + "#md" + str(idx),
            doc_id: (*doc_id) + "",
            text: prefix + pieces[pi],
            source: (*source) + "",
            metadata_json: meta + "",
            embedding: []f32{}
        })
    }
}

pub fn chunk_markdown(doc_id string, source string, markdown string, max_chars int, overlap int) []Chunk {
    $out := []Chunk{}
    if markdown.len == 0 { << out }
    $h_levels := []int{}
    $h_titles := []string{}
    $buf := ""
    $pos := 0
    while pos <= markdown.len {
        $nl := pos
        while nl < markdown.len && markdown[nl] != 10 { nl += 1 }
        line := markdown[pos:nl]
        $lvl := 0
        $title := ""
        if parse_md_heading(&line, $&lvl, $&title) {
            crumb := join_heading_stack(&h_levels, &h_titles)
            emit_md_section(&doc_id, &source, &crumb, &buf, max_chars, overlap, $&out)
            buf = ""
            $nl_v := []int{}
            $nt_v := []string{}
            for hi in 0:h_levels.len {
                if h_levels[hi] < lvl {
                    nl_v.push(h_levels[hi])
                    nt_v.push(h_titles[hi])
                }
            }
            h_levels = ~nl_v
            h_titles = ~nt_v
            h_levels.push(lvl)
            h_titles.push(title)
        } else {
            if buf.len > 0 { buf = buf + "\n" }
            buf = buf + line
        }
        if nl >= markdown.len { <- }
        pos = nl + 1
    }
    crumb := join_heading_stack(&h_levels, &h_titles)
    emit_md_section(&doc_id, &source, &crumb, &buf, max_chars, overlap, $&out)
    << out
}

fn is_term_byte(b int) bool {
    << (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 95 || b >= 128
}

fn tokenize_terms(text &string) []string {
    $out := []string{}
    $cur := ""
    for i in 0:text.len {
        $b := (*text)[i]
        if is_term_byte(b) {
            if b >= 65 && b <= 90 { b += 32 }
            cur.push_str(string_from_byte(b))
        } else if cur.len > 0 {
            out.push(cur)
            cur = ""
        }
    }
    if cur.len > 0 { out.push(cur) }
    << out
}

fn bm25_scored_indices_filtered(s &MemoryStore, query &string, filter_doc_id &string,
                                 out_idx $&[]int, out_scores $&[]f64) {
    n_docs := s.chunks.len
    if n_docs == 0 { << }
    q_terms_raw := tokenize_terms(query)
    if q_terms_raw.len == 0 { << }
    $q_terms := []string{}
    $q_seen := map[string]bool{}
    for i in 0:q_terms_raw.len {
        qt := q_terms_raw[i]
        if !q_seen.get_or(qt, false) {
            q_seen[qt] = true
            q_terms.push(qt)
        }
    }
    $doc_lens := []int{}
    $doc_tfs := []map[string]int{}
    $df := map[string]int{}
    $total_len := 0
    for i in 0:n_docs {
        terms := tokenize_terms(&s.chunks[i].text)
        doc_lens.push(terms.len)
        total_len += terms.len
        $tf := map[string]int{}
        $d_seen := map[string]bool{}
        for j in 0:terms.len {
            t := terms[j]
            tf[t] = tf.get_or(t, 0) + 1
            if !d_seen.get_or(t, false) {
                d_seen[t] = true
                df[t] = df.get_or(t, 0) + 1
            }
        }
        doc_tfs.push(~tf)
    }
    avgdl := f64(total_len) / f64(n_docs)
    if avgdl <= 0.0 { << }
    k1 := 1.5
    b_param := 0.75
    $raw_idx := []int{}
    $raw_sc := []f32{}
    for i in 0:n_docs {
        if filter_doc_id.len > 0 && s.chunks[i].doc_id != *filter_doc_id { -> }
        $score := 0.0
        dl := f64(doc_lens[i])
        tf_map := &doc_tfs[i]
        for qi in 0:q_terms.len {
            qt := q_terms[qi]
            tf_v := tf_map.get_or(qt, 0)
            if tf_v <= 0 { -> }
            df_v := f64(df.get_or(qt, 0))
            idf := math.log((f64(n_docs) - df_v + 0.5) / (df_v + 0.5) + 1.0)
            tf_f := f64(tf_v)
            denom := tf_f + k1 * (1.0 - b_param + b_param * (dl / avgdl))
            score += idf * ((tf_f * (k1 + 1.0)) / denom)
        }
        if score > 0.0 {
            raw_idx.push(i)
            raw_sc.push(f32(score))
        }
    }
    if raw_idx.len == 0 { << }
    $t_idx := []int{}
    $t_val := []f32{}
    for _ in 0:raw_idx.len {
        t_idx.push(0)
        t_val.push(f32(0))
    }
    picked := tensor.topk_f32(&raw_sc, raw_sc.len, raw_sc.len, $&t_idx, $&t_val)
    for r in 0:picked {
        ri := t_idx[r]
        out_idx.push(raw_idx[ri])
        out_scores.push(f64(t_val[r]))
    }
}

pub fn (s &MemoryStore) search_bm25_filtered(query string, top_k int, filter_doc_id string) []SearchHit {
    $hits := []SearchHit{}
    if top_k <= 0 || s.chunks.len == 0 { << hits }
    $idxs := []int{}
    $scores := []f64{}
    bm25_scored_indices_filtered(s, &query, &filter_doc_id, $&idxs, $&scores)
    $lim := top_k
    if lim > idxs.len { lim = idxs.len }
    for r in 0:lim {
        ci := idxs[r]
        hits.push(SearchHit{chunk: copy_chunk(&s.chunks[ci]), score: scores[r]})
    }
    << hits
}

pub fn (s &MemoryStore) search_bm25(query string, top_k int) []SearchHit {
    << s.search_bm25_filtered(query, top_k, "")
}

pub fn (s &MemoryStore) search_hybrid_filtered(query string, query_emb &[]f64, top_k int,
                                              rrf_k int, filter_doc_id string) []SearchHit {
    $hits := []SearchHit{}
    n_docs := s.chunks.len
    if top_k <= 0 || n_docs == 0 { << hits }
    $rk := rrf_k
    if rk <= 0 { rk = 60 }
    $fused := []f32{}
    for _ in 0:n_docs { fused.push(f32(0.0)) }

    // Dense ranking via #tensor.topk_cosine_f32 (if query embedding supplied and store has vectors)
    if s.dim > 0 && query_emb.len == s.dim {
        $matched := []int{}
        $corpus := []f32{}
        for i in 0:n_docs {
            if filter_doc_id.len > 0 && s.chunks[i].doc_id != filter_doc_id { -> }
            if s.chunks[i].embedding.len != s.dim { -> }
            matched.push(i)
            for j in 0:s.dim { corpus.push(s.chunks[i].embedding[j]) }
        }
        if matched.len > 0 {
            $q_f32 := []f32{}
            q_f32.reserve(s.dim)
            for j in 0:s.dim { q_f32.push(f32(query_emb[j])) }
            $d_idx := []int{}
            $d_sc := []f32{}
            for _ in 0:matched.len {
                d_idx.push(0)
                d_sc.push(f32(0))
            }
            picked := tensor.topk_cosine_f32(&q_f32, &corpus, matched.len, s.dim, matched.len, $&d_idx, $&d_sc)
            for rank in 0:picked {
                mi := d_idx[rank]
                if mi >= 0 && mi < matched.len {
                    orig := matched[mi]
                    fused[orig] += f32(1.0 / f64(rk + rank + 1))
                }
            }
        }
    }

    // Sparse BM25 ranking
    $b_idx := []int{}
    $b_sc := []f64{}
    bm25_scored_indices_filtered(s, &query, &filter_doc_id, $&b_idx, $&b_sc)
    for rank in 0:b_idx.len {
        orig := b_idx[rank]
        fused[orig] += f32(1.0 / f64(rk + rank + 1))
    }

    $raw_idx := []int{}
    $raw_sc := []f32{}
    for i in 0:n_docs {
        if f64(fused[i]) > 0.0 {
            raw_idx.push(i)
            raw_sc.push(fused[i])
        }
    }
    if raw_idx.len == 0 { << hits }
    $lim := top_k
    if lim > raw_idx.len { lim = raw_idx.len }
    $t_idx := []int{}
    $t_val := []f32{}
    for _ in 0:lim {
        t_idx.push(0)
        t_val.push(f32(0))
    }
    picked := tensor.topk_f32(&raw_sc, raw_sc.len, lim, $&t_idx, $&t_val)
    for r in 0:picked {
        ri := t_idx[r]
        orig := raw_idx[ri]
        hits.push(SearchHit{chunk: copy_chunk(&s.chunks[orig]), score: f64(t_val[r])})
    }
    << hits
}

pub fn (s &MemoryStore) search_hybrid(query string, query_emb &[]f64, top_k int, rrf_k int) []SearchHit {
    << s.search_hybrid_filtered(query, query_emb, top_k, rrf_k, "")
}

pub fn (s &MemoryStore) retrieve_hybrid(query string, query_emb &[]f64, top_k int, rrf_k int) string {
    hits := s.search_hybrid(query, query_emb, top_k, rrf_k)
    << format_context(&hits)
}

fn cosine_f32_pair(a &[]f32, b &[]f32) f64 {
    $n := a.len
    if b.len < n { n = b.len }
    if n <= 0 { << 0.0 }
    $dot := 0.0
    $na := 0.0
    $nb := 0.0
    for i in 0:n {
        av := f64(a[i])
        bv := f64(b[i])
        dot += av * bv
        na += av * av
        nb += bv * bv
    }
    denom := math.sqrt(na) * math.sqrt(nb)
    if denom <= 0.0 { << 0.0 }
    << dot / denom
}

pub fn (s &MemoryStore) search_mmr(query_emb &[]f64, top_k int, lambda f64, filter_doc_id string) []SearchHit {
    $hits := []SearchHit{}
    if s.dim <= 0 || top_k <= 0 || s.chunks.len == 0 { << hits }
    if query_emb.len != s.dim {
        >> errors.new("rag: query embedding dimension mismatch")
    }
    $lam := lambda
    if lam < 0.0 { lam = 0.0 }
    if lam > 1.0 { lam = 1.0 }
    $q_f32 := []f32{}
    q_f32.reserve(s.dim)
    for j in 0:s.dim { q_f32.push(f32(query_emb[j])) }

    $cand_idx := []int{}
    $rel := []f32{}
    $used := []bool{}
    for i in 0:s.chunks.len {
        c := &s.chunks[i]
        if filter_doc_id.len > 0 && c.doc_id != filter_doc_id { -> }
        if c.embedding.len != s.dim { -> }
        cand_idx.push(i)
        rel.push(f32(cosine_f32_pair(&c.embedding, &q_f32)))
        used.push(false)
    }
    if cand_idx.len == 0 { << hits }
    $k := top_k
    if k > cand_idx.len { k = cand_idx.len }
    $picked_orig := []int{}
    for _ in 0:k {
        $best_m := -1
        $best_score := -1000000000.0
        for m in 0:cand_idx.len {
            if used[m] { -> }
            r_score := f64(rel[m])
            $mmr := r_score
            if picked_orig.len > 0 {
                $max_sim := -1000000000.0
                orig_m := cand_idx[m]
                c_emb := &s.chunks[orig_m].embedding
                for si in 0:picked_orig.len {
                    sel_orig := picked_orig[si]
                    sim := cosine_f32_pair(c_emb, &s.chunks[sel_orig].embedding)
                    if sim > max_sim { max_sim = sim }
                }
                mmr = lam * r_score - (1.0 - lam) * max_sim
            }
            if best_m < 0 || mmr > best_score {
                best_m = m
                best_score = mmr
            }
        }
        if best_m < 0 { <- }
        used[best_m] = true
        orig := cand_idx[best_m]
        picked_orig.push(orig)
        hits.push(SearchHit{chunk: copy_chunk(&s.chunks[orig]), score: best_score})
    }
    << hits
}

pub fn (s $&MemoryStore) delete_doc(doc_id string) int {
    $kept := []Chunk{}
    $removed := 0
    for i in 0:s.chunks.len {
        if s.chunks[i].doc_id == doc_id {
            removed += 1
        } else {
            kept.push(copy_chunk(&s.chunks[i]))
        }
    }
    s.chunks = ~kept
    << removed
}

fn chunk_matches_meta(c &Chunk, filter_doc_id &string, meta_key &string, meta_val &string) bool {
    if filter_doc_id.len > 0 && c.doc_id != *filter_doc_id { << false }
    if meta_key.len == 0 { << true }
    doc := json.parse(&c.metadata_json)
    if !doc.ok() || !doc.is_dict(doc.root()) { << false }
    root := doc.root()
    if !doc.has(root, *meta_key) { << false }
    vn := doc.get(root, *meta_key) >>> (_) { << false }
    if doc.is_string(vn) {
        sv := doc.as_string(vn) >>> (_) { << false }
        << sv == *meta_val
    }
    enc := doc.encode(vn) >>> (_) { << false }
    << enc == *meta_val
}

pub fn (s &MemoryStore) search_by_meta(query_emb &[]f64, top_k int, filter_doc_id string,
                                       meta_key string, meta_val string) []SearchHit {
    $hits := []SearchHit{}
    if s.dim <= 0 || top_k <= 0 || s.chunks.len == 0 { << hits }
    if query_emb.len != s.dim {
        >> errors.new("rag: query embedding dimension mismatch")
    }
    $matched := []int{}
    $corpus := []f32{}
    for i in 0:s.chunks.len {
        c := &s.chunks[i]
        if !chunk_matches_meta(c, &filter_doc_id, &meta_key, &meta_val) { -> }
        if c.embedding.len != s.dim { -> }
        matched.push(i)
        for j in 0:s.dim { corpus.push(c.embedding[j]) }
    }
    if matched.len == 0 { << hits }
    $q_f32 := []f32{}
    q_f32.reserve(s.dim)
    for j in 0:s.dim { q_f32.push(f32(query_emb[j])) }
    $k := top_k
    if k > matched.len { k = matched.len }
    $out_idx := []int{}
    $out_scores := []f32{}
    for _ in 0:k {
        out_idx.push(0)
        out_scores.push(f32(0))
    }
    picked := tensor.topk_cosine_f32(&q_f32, &corpus, matched.len, s.dim, k, $&out_idx, $&out_scores)
    for r in 0:picked {
        m_i := out_idx[r]
        if m_i >= 0 && m_i < matched.len {
            orig := matched[m_i]
            hits.push(SearchHit{chunk: copy_chunk(&s.chunks[orig]), score: f64(out_scores[r])})
        }
    }
    << hits
}

pub fn (s &MemoryStore) search_hybrid_by_meta(query string, query_emb &[]f64, top_k int, rrf_k int,
                                              filter_doc_id string, meta_key string, meta_val string) []SearchHit {
    $hits := []SearchHit{}
    n_docs := s.chunks.len
    if top_k <= 0 || n_docs == 0 { << hits }
    $rk := rrf_k
    if rk <= 0 { rk = 60 }
    $fused := []f32{}
    for _ in 0:n_docs { fused.push(f32(0.0)) }

    if s.dim > 0 && query_emb.len == s.dim {
        $matched := []int{}
        $corpus := []f32{}
        for i in 0:n_docs {
            if !chunk_matches_meta(&s.chunks[i], &filter_doc_id, &meta_key, &meta_val) { -> }
            if s.chunks[i].embedding.len != s.dim { -> }
            matched.push(i)
            for j in 0:s.dim { corpus.push(s.chunks[i].embedding[j]) }
        }
        if matched.len > 0 {
            $q_f32 := []f32{}
            q_f32.reserve(s.dim)
            for j in 0:s.dim { q_f32.push(f32(query_emb[j])) }
            $d_idx := []int{}
            $d_sc := []f32{}
            for _ in 0:matched.len {
                d_idx.push(0)
                d_sc.push(f32(0))
            }
            picked := tensor.topk_cosine_f32(&q_f32, &corpus, matched.len, s.dim, matched.len, $&d_idx, $&d_sc)
            for rank in 0:picked {
                mi := d_idx[rank]
                if mi >= 0 && mi < matched.len {
                    orig := matched[mi]
                    fused[orig] += f32(1.0 / f64(rk + rank + 1))
                }
            }
        }
    }

    $b_idx := []int{}
    $b_sc := []f64{}
    bm25_scored_indices_filtered(s, &query, &filter_doc_id, $&b_idx, $&b_sc)
    $b_rank := 0
    for bi in 0:b_idx.len {
        orig := b_idx[bi]
        if !chunk_matches_meta(&s.chunks[orig], &filter_doc_id, &meta_key, &meta_val) { -> }
        fused[orig] += f32(1.0 / f64(rk + b_rank + 1))
        b_rank += 1
    }

    $raw_idx := []int{}
    $raw_sc := []f32{}
    for i in 0:n_docs {
        if f64(fused[i]) > 0.0 {
            raw_idx.push(i)
            raw_sc.push(fused[i])
        }
    }
    if raw_idx.len == 0 { << hits }
    $lim := top_k
    if lim > raw_idx.len { lim = raw_idx.len }
    $t_idx := []int{}
    $t_val := []f32{}
    for _ in 0:lim {
        t_idx.push(0)
        t_val.push(f32(0))
    }
    picked := tensor.topk_f32(&raw_sc, raw_sc.len, lim, $&t_idx, $&t_val)
    for r in 0:picked {
        ri := t_idx[r]
        orig := raw_idx[ri]
        hits.push(SearchHit{chunk: copy_chunk(&s.chunks[orig]), score: f64(t_val[r])})
    }
    << hits
}

pub fn rerank_hits(hits &[]SearchHit, scores &[]f64, top_k int) []SearchHit {
    $out := []SearchHit{}
    if top_k <= 0 || hits.len == 0 || scores.len < hits.len { << out }
    $sc_f32 := []f32{}
    sc_f32.reserve(hits.len)
    for i in 0:hits.len { sc_f32.push(f32(scores[i])) }
    $lim := top_k
    if lim > hits.len { lim = hits.len }
    $t_idx := []int{}
    $t_val := []f32{}
    for _ in 0:lim {
        t_idx.push(0)
        t_val.push(f32(0))
    }
    picked := tensor.topk_f32(&sc_f32, sc_f32.len, lim, $&t_idx, $&t_val)
    for r in 0:picked {
        idx := t_idx[r]
        if idx >= 0 && idx < hits.len {
            out.push(SearchHit{chunk: copy_chunk(&hits[idx].chunk), score: f64(t_val[r])})
        }
    }
    << out
}

pub fn rerank_with_api(client &openai.Client, model string, query string,
                       hits &[]SearchHit, top_k int) []SearchHit {
    if top_k <= 0 || hits.len == 0 { << []SearchHit{} }
    $docs := []string{}
    for i in 0:hits.len {
        docs.push(hits[i].chunk.text + "")
    }
    res := client.rerank(model, query, &docs, top_k) >>>
    $out := []SearchHit{}
    for i in 0:res.len {
        r := &res[i]
        hidx := r.index
        if hidx >= 0 && hidx < hits.len {
            out.push(SearchHit{chunk: copy_chunk(&hits[hidx].chunk), score: r.relevance_score})
        }
    }
    << out
}

pub fn chunk_parent_child(doc_id string, source string, text string,
                          parent_chars int, child_chars int, overlap int) ParentChildDoc {
    ptexts := chunk_recursive(text, parent_chars, overlap)
    $parents := []Chunk{}
    $children := []Chunk{}
    for pi in 0:ptexts.len {
        pid := doc_id + "#p" + str(pi)
        parents.push(Chunk{
            id: pid + "",
            doc_id: doc_id + "",
            text: ptexts[pi] + "",
            source: source + "",
            metadata_json: "{}",
            embedding: []f32{}
        })
        ctexts := chunk_recursive(ptexts[pi] + "", child_chars, overlap)
        meta := "{\"parent_id\":" + json.quote(&pid) + "}"
        for ci in 0:ctexts.len {
            children.push(Chunk{
                id: pid + "#c" + str(ci),
                doc_id: doc_id + "",
                text: ctexts[ci] + "",
                source: source + "",
                metadata_json: meta + "",
                embedding: []f32{}
            })
        }
    }
    << ParentChildDoc{parents: ~parents, children: ~children}
}

pub fn expand_to_parents(child_hits &[]SearchHit, parents &[]Chunk) []SearchHit {
    $out := []SearchHit{}
    $seen_pids := []string{}
    for i in 0:child_hits.len {
        ch := &child_hits[i].chunk
        $pid := ""
        md := json.parse(&ch.metadata_json)
        if md.ok() && md.is_dict(md.root()) {
            pid = json_str_or(&md, md.root(), "parent_id", "")
        }
        if pid.len == 0 {
            out.push(SearchHit{chunk: copy_chunk(ch), score: child_hits[i].score})
            ->
        }
        $dup := false
        for si in 0:seen_pids.len {
            if seen_pids[si] == pid {
                dup = true
                <-
            }
        }
        if dup { -> }
        for pi in 0:parents.len {
            if parents[pi].id == pid {
                seen_pids.push(pid + "")
                out.push(SearchHit{chunk: copy_chunk(&parents[pi]), score: child_hits[i].score})
                <-
            }
        }
    }
    << out
}

pub fn expand_queries_openai(client &openai.Client, model string, query string, n int) []string {
    $cnt := n
    if cnt <= 0 { cnt = 3 }
    sys := "Generate " + str(cnt) + " alternative search queries for the user question. Output one query per line, no numbering."
    $qmsgs := []openai.Message{}
    qmsgs.push(openai.message("system", sys))
    qmsgs.push(openai.message("user", query + ""))
    req := openai.chat_request(model, ~qmsgs)
    resp := client.chat(&req) >>>
    $out := []string{}
    out.push(query + "")
    lines := strings.split(&resp.content, "\n")
    for i in 0:lines.len {
        if out.len >= cnt + 1 { <- }
        ln := strings.trim_space(&lines[i])
        if ln.len == 0 { -> }
        $dup := false
        for j in 0:out.len {
            if out[j] == ln {
                dup = true
                <-
            }
        }
        if !dup { out.push(ln) }
    }
    << out
}

pub fn hyde_document_openai(client &openai.Client, model string, query string) string {
    sys := "Write a concise factual passage (2-4 sentences) that directly answers the user's question for hypothetical document retrieval."
    req := openai.chat_request(model, [openai.message("system", sys), openai.message("user", query)])
    resp := client.chat(&req) >>>
    << strings.trim_space(&resp.content)
}

pub fn compress_context(query &string, hits &[]SearchHit, max_sentences_per_hit int) []SearchHit {
    $keep_n := max_sentences_per_hit
    if keep_n <= 0 { keep_n = 2 }
    qterms := tokenize_terms(query)
    $out := []SearchHit{}
    for hi in 0:hits.len {
        h := &hits[hi]
        $sents := []string{}
        $start := 0
        txt := &h.chunk.text
        for i in 0:(txt.len + 1) {
            $is_end := i == txt.len
            if !is_end {
                ch := (*txt)[i] & 255
                is_end = ch == 46 || ch == 33 || ch == 63 || ch == 10
            }
            if is_end {
                $end := i
                if end < txt.len && ((*txt)[end] & 255) != 10 { end += 1 }
                if end > start {
                    raw_pc := (*txt)[start:end]
                    pc := strings.trim_space(&raw_pc)
                    if pc.len > 0 { sents.push(pc) }
                }
                start = end
                if end == i { start = i + 1 }
            }
        }
        if sents.len <= keep_n {
            out.push(SearchHit{chunk: copy_chunk(&h.chunk), score: h.score})
            ->
        }
        $scores := []f32{}
        for si in 0:sents.len {
            sterms := tokenize_terms(&sents[si])
            $ov := 0
            for qi in 0:qterms.len {
                for ti in 0:sterms.len {
                    if sterms[ti] == qterms[qi] {
                        ov += 1
                        <-
                    }
                }
            }
            scores.push(f32(ov))
        }
        $selected := []bool{}
        for _ in 0:sents.len { selected.push(false) }
        for _ in 0:keep_n {
            $bi := -1
            $bs := f32(-1.0)
            for si in 0:sents.len {
                if !selected[si] && scores[si] > bs {
                    bs = scores[si]
                    bi = si
                }
            }
            if bi >= 0 { selected[bi] = true }
        }
        $comp := ""
        for si in 0:sents.len {
            if selected[si] {
                if comp.len > 0 { comp = comp + " " }
                comp = comp + sents[si]
            }
        }
        $nc := copy_chunk(&h.chunk)
        nc.text = comp
        out.push(SearchHit{chunk: ~nc, score: h.score})
    }
    << out
}

pub fn format_context_cited(hits &[]SearchHit) string {
    $out := ""
    for i in 0:hits.len {
        if i > 0 { out = out + "\n\n" }
        c := &hits[i].chunk
        $lbl := c.source + ""
        if lbl.len > 0 && c.id.len > 0 { lbl = lbl + "#" + c.id }
        else if c.id.len > 0 { lbl = c.id + "" }
        out = out + "[" + str(i + 1) + "] (" + lbl + ")\n" + c.text
    }
    << out
}

pub struct PgVectorStore {
    pub table string
    pub dim int
    pub metric string
}

fn rag_valid_pg_ident(s &string) bool {
    if s.len == 0 || s.len > 63 { << false }
    for i in 0:s.len {
        ch := (*s)[i] & 255
        is_alpha := (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 95
        is_digit := ch >= 48 && ch <= 57
        if i == 0 && !is_alpha { << false }
        if !is_alpha && !is_digit { << false }
    }
    << true
}

fn sql_quote_lit(s &string) string {
    $out := "'"
    for i in 0:s.len {
        ch := (*s)[i] & 255
        if ch == 39 {
            out.push_str("''")
        } else {
            out.push_str(string_from_byte(ch))
        }
    }
    out.push_str("'")
    << out
}

pub fn new_pgvector_store(table string, dim int, metric string) PgVectorStore {
    if !rag_valid_pg_ident(&table) {
        >> errors.new("rag: invalid PostgreSQL table identifier: " + table)
    }
    if dim <= 0 {
        >> errors.new("rag: pgvector dimension must be positive")
    }
    $met := metric + ""
    if met.len == 0 { met = "cosine" }
    _ := postgres.pgvector_distance_op(met + "") >>>
    << PgVectorStore{table: table, dim: dim, metric: met}
}

pub fn (s &PgVectorStore) create_table_sql() string {
    << postgres.pgvector_create_extension_sql() + "; CREATE TABLE IF NOT EXISTS " + s.table +
       " (id TEXT PRIMARY KEY, doc_id TEXT NOT NULL, text TEXT NOT NULL, source TEXT NOT NULL, metadata JSONB NOT NULL DEFAULT '{}'::jsonb, embedding vector(" +
       str(s.dim) + ") NOT NULL)"
}

pub fn (s &PgVectorStore) create_index_sql(index_name string, method string) string {
    << postgres.pgvector_create_index_sql(s.table + "", "embedding", index_name, method, s.metric + "") >>>
}

pub fn (s &PgVectorStore) upsert_chunk_sql(c &Chunk) string {
    if c.embedding.len != s.dim {
        >> errors.new("rag: pgvector chunk embedding dimension mismatch")
    }
    vec_lit := postgres.vector_encode(&c.embedding)
    $meta := c.metadata_json + ""
    if meta.len == 0 { meta = "{}" }
    << "INSERT INTO " + s.table + " (id, doc_id, text, source, metadata, embedding) VALUES (" +
       sql_quote_lit(&c.id) + ", " + sql_quote_lit(&c.doc_id) + ", " + sql_quote_lit(&c.text) + ", " +
       sql_quote_lit(&c.source) + ", " + sql_quote_lit(&meta) + "::jsonb, " + sql_quote_lit(&vec_lit) +
       "::vector) ON CONFLICT (id) DO UPDATE SET doc_id = EXCLUDED.doc_id, text = EXCLUDED.text, source = EXCLUDED.source, metadata = EXCLUDED.metadata, embedding = EXCLUDED.embedding"
}

pub fn (s &PgVectorStore) search_sql(query_emb &[]f64, top_k int, filter_doc_id string) string {
    if query_emb.len != s.dim {
        >> errors.new("rag: pgvector query embedding dimension mismatch")
    }
    if top_k <= 0 {
        >> errors.new("rag: pgvector top_k must be positive")
    }
    vec_lit := postgres.vector_encode_f64(query_emb)
    op := postgres.pgvector_distance_op(s.metric + "") >>>
    vec_expr := sql_quote_lit(&vec_lit) + "::vector"
    $where_clause := ""
    if filter_doc_id.len > 0 {
        where_clause = " WHERE doc_id = " + sql_quote_lit(&filter_doc_id)
    }
    << "SELECT id, doc_id, text, source, metadata::text, (embedding " + op + " " + vec_expr +
       ") AS distance FROM " + s.table + where_clause + " ORDER BY embedding " + op + " " + vec_expr +
       " LIMIT " + str(top_k)
}

pub fn chunk_code(code string, max_chars int, overlap int) []string {
    $out := []string{}
    if code.len == 0 { << out }
    $mc := max_chars
    if mc <= 0 { mc = 800 }
    $ov := overlap
    if ov < 0 { ov = 0 }
    if ov >= mc { ov = mc - 1 }
    if ov < 0 { ov = 0 }
    $pos := 0
    while pos < code.len {
        if code.len - pos <= mc {
            piece := strings.trim_space(&code[pos:code.len])
            if piece.len > 0 { out.push(piece) }
            <-
        }
        limit := pos + mc
        $cut := find_last_sep(&code, pos + 1, limit, "\npub fn ")
        if cut < 0 { cut = find_last_sep(&code, pos + 1, limit, "\nfn ") }
        if cut < 0 { cut = find_last_sep(&code, pos + 1, limit, "\npub struct ") }
        if cut < 0 { cut = find_last_sep(&code, pos + 1, limit, "\nstruct ") }
        if cut < 0 { cut = find_last_sep(&code, pos + 1, limit, "\ndef ") }
        if cut < 0 { cut = find_last_sep(&code, pos + 1, limit, "\nclass ") }
        if cut < 0 { cut = find_last_sep(&code, pos + 1, limit, "\nfunc ") }
        if cut < 0 { cut = find_last_sep(&code, pos + 1, limit, "\n\n") }
        if cut < 0 { cut = find_last_sep(&code, pos + 1, limit, "\n") }
        if cut <= pos { cut = limit }
        piece := strings.trim_space(&code[pos:cut])
        if piece.len > 0 { out.push(piece) }
        $next_pos := cut - ov
        if next_pos <= pos { next_pos = cut }
        pos = next_pos
    }
    << out
}

pub fn rerank_with_cohere(client &cohere.Client, model string, query string,
                          hits &[]SearchHit, top_k int) []SearchHit {
    if top_k <= 0 || hits.len == 0 { << []SearchHit{} }
    $docs := []string{}
    for i in 0:hits.len {
        docs.push(hits[i].chunk.text + "")
    }
    res := client.rerank(model, query, &docs, top_k) >>>
    $out := []SearchHit{}
    for i in 0:res.len {
        r := &res[i]
        hidx := r.index
        if hidx >= 0 && hidx < hits.len {
            out.push(SearchHit{chunk: copy_chunk(&hits[hidx].chunk), score: r.relevance_score})
        }
    }
    << out
}

pub struct Triple {
    pub subject string
    pub predicate string
    pub object string
    pub source string
}

pub struct KnowledgeGraph {
    pub triples []Triple
}

pub fn new_knowledge_graph() KnowledgeGraph {
    << KnowledgeGraph{triples: []Triple{}}
}

pub fn (kg &KnowledgeGraph) len() int {
    << kg.triples.len
}

pub fn (kg $&KnowledgeGraph) add_triple(subject string, predicate string, object string, source string) {
    kg.triples.push(Triple{
        subject: subject,
        predicate: predicate,
        object: object,
        source: source
    })
}

fn rag_ascii_lower(s &string) string {
    $out := ""
    for i in 0:s.len {
        ch := (*s)[i] & 255
        if ch >= 65 && ch <= 90 { out.push_str(string_from_byte(ch + 32)) }
        else { out.push_str(string_from_byte(ch)) }
    }
    << out
}

fn rag_str_in_list(list &[]string, val &string) bool {
    for i in 0:list.len {
        if list[i] == *val { << true }
    }
    << false
}

pub fn (kg &KnowledgeGraph) query_neighbors(entity string, max_hops int) []Triple {
    $out := []Triple{}
    if entity.len == 0 || kg.triples.len == 0 { << out }
    $hops := max_hops
    if hops <= 0 { hops = 1 }
    $visited_ent := [rag_ascii_lower(&entity)]
    $frontier := [rag_ascii_lower(&entity)]
    $seen_idx := []bool{}
    for _ in 0:kg.triples.len { seen_idx.push(false) }

    for _ in 0:hops {
        if frontier.len == 0 { <- }
        $next_frontier := []string{}
        for ti in 0:kg.triples.len {
            if seen_idx[ti] { -> }
            tr := &kg.triples[ti]
            ls := rag_ascii_lower(&tr.subject)
            lo := rag_ascii_lower(&tr.object)
            $hit := false
            if rag_str_in_list(&frontier, &ls) {
                hit = true
                if lo.len > 0 && !rag_str_in_list(&visited_ent, &lo) {
                    visited_ent.push(lo + "")
                    next_frontier.push(lo + "")
                }
            }
            if rag_str_in_list(&frontier, &lo) {
                hit = true
                if ls.len > 0 && !rag_str_in_list(&visited_ent, &ls) {
                    visited_ent.push(ls + "")
                    next_frontier.push(ls + "")
                }
            }
            if hit {
                seen_idx[ti] = true
                out.push(Triple{
                    subject: tr.subject + "",
                    predicate: tr.predicate + "",
                    object: tr.object + "",
                    source: tr.source + ""
                })
            }
        }
        frontier = ~next_frontier
    }
    << out
}

pub fn format_subgraph(triples &[]Triple) string {
    $out := ""
    for i in 0:triples.len {
        if i > 0 { out = out + "\n" }
        tr := &triples[i]
        out = out + "- " + tr.subject + " --[" + tr.predicate + "]--> " + tr.object
        if tr.source.len > 0 { out = out + " (" + tr.source + ")" }
    }
    << out
}

pub fn (kg &KnowledgeGraph) save_json(path string) int {
    $out := "{\"triples\":["
    for i in 0:kg.triples.len {
        if i > 0 { out = out + "," }
        tr := &kg.triples[i]
        out = out + "{\"subject\":" + json.quote(&tr.subject) +
              ",\"predicate\":" + json.quote(&tr.predicate) +
              ",\"object\":" + json.quote(&tr.object) +
              ",\"source\":" + json.quote(&tr.source) + "}"
    }
    out = out + "]}"
    _ := os.write(path + "", out) >>>
    << kg.triples.len
}

pub fn load_knowledge_graph_json(path string) KnowledgeGraph {
    raw := os.read(path + "") >>>
    doc := json.parse(&raw)
    if !doc.ok() || !doc.is_dict(doc.root()) {
        >> errors.new("rag: invalid KnowledgeGraph JSON file")
    }
    root := doc.root()
    $kg := new_knowledge_graph()
    if doc.has(root, "triples") {
        arr := doc.get(root, "triples") >>>
        if doc.is_list(arr) {
            cnt := doc.count(arr)
            for i in 0:cnt {
                item := doc.at(arr, i) >>>
                if doc.is_dict(item) {
                    kg.add_triple(
                        json_str_or(&doc, item, "subject", ""),
                        json_str_or(&doc, item, "predicate", ""),
                        json_str_or(&doc, item, "object", ""),
                        json_str_or(&doc, item, "source", "")
                    )
                }
            }
        }
    }
    << kg
}

pub fn contextualize_chunks_openai(client &openai.Client, model string, doc_title string,
                                     full_doc_summary string, chunks &[]string) []string {
    $out := []string{}
    sys := "You situate a document chunk within its broader document for search retrieval. Reply ONLY with 1 concise contextual sentence."
    for i in 0:chunks.len {
        usr := "Document: " + doc_title + "\nSummary: " + full_doc_summary + "\nChunk:\n" + chunks[i]
        req := openai.chat_request(model + "", [openai.message("system", sys), openai.message("user", usr)])
        resp := client.chat(&req) >>>
        ctx := strings.trim_space(&resp.content)
        if ctx.len > 0 {
            out.push("[Context: " + ctx + "]\n" + chunks[i])
        } else {
            out.push(chunks[i] + "")
        }
    }
    << out
}

pub struct HybridGraphResult {
    pub hits []SearchHit
    pub graph_triples []Triple
    pub formatted_context string
}

pub fn hybrid_graph_vector_search(store &MemoryStore, kg &KnowledgeGraph,
                                    query string, query_emb &[]f64,
                                    seed_entities &[]string,
                                    top_k int, graph_hops int) HybridGraphResult {
    hits := store.search_hybrid(query + "", query_emb, top_k, 60)
    $triples := []Triple{}
    for si in 0:seed_entities.len {
        nb := kg.query_neighbors(seed_entities[si] + "", graph_hops)
        for ni in 0:nb.len {
            cand := &nb[ni]
            $seen := false
            for ti in 0:triples.len {
                if triples[ti].subject == cand.subject && triples[ti].predicate == cand.predicate && triples[ti].object == cand.object {
                    seen = true
                    <-
                }
            }
            if !seen {
                triples.push(Triple{
                    subject: cand.subject + "",
                    predicate: cand.predicate + "",
                    object: cand.object + "",
                    source: cand.source + ""
                })
            }
        }
    }
    $ctx := format_context_cited(&hits)
    if triples.len > 0 {
        sg := format_subgraph(&triples)
        if ctx.len > 0 {
            ctx = ctx + "\n\nKnowledge Graph Context:\n" + sg
        } else {
            ctx = "Knowledge Graph Context:\n" + sg
        }
    }
    << HybridGraphResult{
        hits: ~hits,
        graph_triples: ~triples,
        formatted_context: ctx
    }
}

fn strip_driver_cell(cell &string) string {
    if cell.len < 2 { << (*cell) + "" }
    if (*cell)[0] == 110 && (*cell)[1] == 58 { << "" }
    if (*cell)[1] == 58 { << (*cell)[2:cell.len] }
    << (*cell) + ""
}

fn parse_driver_f64(cell &string) f64 {
    s := strip_driver_cell(cell)
    trimmed := strings.trim_space(&s)
    if trimmed.len == 0 { << 0.0 }
    << strconv.parse_float(&trimmed) >>> (_) { << 0.0 }
}

fn f32_to_f64_vec(src &[]f32) []f64 {
    $out := []f64{}
    out.reserve(src.len)
    for i in 0:src.len { out.push(f64(src[i])) }
    << out
}

fn sql_temp_strings(vals []temp) []string {
    $out := []string{}
    for i in 0:vals.len {
        if vals[i] is string {
            s := vals[i] as string
            out.push(s)
        } else if vals[i] is f64 {
            f := vals[i] as f64
            fs := strconv.format_float(f, 103, -1) >>> (_) { << []string{} }
            out.push(fs)
        } else if vals[i] is int {
            n := vals[i] as int
            out.push(str(n))
        } else if vals[i] is bool {
            b := vals[i] as bool
            if b { out.push("true") } else { out.push("false") }
        } else {
            out.push("")
        }
    }
    << out
}

pub struct PgVectorClient {
    pub store PgVectorStore
    conn driver.Conn
}

pub fn new_pgvector_client(conn driver.Conn, table string, dim int, metric string) PgVectorClient {
    st := new_pgvector_store(table, dim, metric) >>>
    << PgVectorClient{store: st, conn: conn}
}

pub fn open_pgvector_client(dsn string, table string, dim int, metric string) PgVectorClient {
    conn := postgres.open(dsn + "")
    << new_pgvector_client(conn, table, dim, metric) >>>
}

fn pg_table_ddl(table &string, dim int) string {
    << "CREATE TABLE IF NOT EXISTS " + (*table) +
       " (id TEXT PRIMARY KEY, doc_id TEXT NOT NULL, text TEXT NOT NULL, source TEXT NOT NULL, metadata JSONB NOT NULL DEFAULT '{}'::jsonb, embedding vector(" +
       str(dim) + ") NOT NULL)"
}

fn pg_upsert_param_sql(table &string) string {
    << "INSERT INTO " + (*table) +
       " (id, doc_id, text, source, metadata, embedding) VALUES ($$1, $$2, $$3, $$4, $$5::jsonb, $$6::vector) " +
       "ON CONFLICT (id) DO UPDATE SET doc_id = EXCLUDED.doc_id, text = EXCLUDED.text, source = EXCLUDED.source, metadata = EXCLUDED.metadata, embedding = EXCLUDED.embedding"
}

fn pg_upsert_args(store &PgVectorStore, ch &Chunk) []driver.NamedValue {
    if ch.embedding.len != store.dim {
        >> errors.new("rag: pgvector chunk embedding dimension mismatch")
    }
    vec_lit := postgres.vector_encode(&ch.embedding)
    $meta := ch.metadata_json + ""
    if meta.len == 0 { meta = "{}" }
    << [driver.NamedValue{name: "", ordinal: 1, value: ch.id + ""}, driver.NamedValue{name: "", ordinal: 2, value: ch.doc_id + ""}, driver.NamedValue{name: "", ordinal: 3, value: ch.text + ""}, driver.NamedValue{name: "", ordinal: 4, value: ch.source + ""}, driver.NamedValue{name: "", ordinal: 5, value: meta}, driver.NamedValue{name: "", ordinal: 6, value: vec_lit}]
}

fn pg_search_param_sql(store &PgVectorStore, top_k int, has_filter bool) string {
    if top_k <= 0 {
        >> errors.new("rag: pgvector top_k must be positive")
    }
    op := postgres.pgvector_distance_op(store.metric + "") >>>
    $where_clause := ""
    if has_filter {
        where_clause = " WHERE doc_id = $$2"
    }
    << "SELECT id, doc_id, text, source, metadata::text, (embedding " + op + " $$1::vector) AS distance FROM " +
       store.table + where_clause + " ORDER BY embedding " + op + " $$1::vector LIMIT " + str(top_k)
}

fn pg_search_args(store &PgVectorStore, query_emb &[]f64, filter_doc_id &string) []driver.NamedValue {
    if query_emb.len != store.dim {
        >> errors.new("rag: pgvector query embedding dimension mismatch")
    }
    vec_lit := postgres.vector_encode_f64(query_emb)
    if filter_doc_id.len > 0 {
        << [driver.NamedValue{name: "", ordinal: 1, value: vec_lit}, driver.NamedValue{name: "", ordinal: 2, value: (*filter_doc_id) + ""}]
    }
    << [driver.NamedValue{name: "", ordinal: 1, value: vec_lit}]
}

pub fn (c $&PgVectorClient) ensure_table() int {
    r1 := c.conn.exec(postgres.pgvector_create_extension_sql(), []driver.NamedValue{})
    if r1.err.len > 0 { >> errors.new("rag pgvector ensure extension failed: " + r1.err) }
    ddl := pg_table_ddl(&c.store.table, c.store.dim)
    r2 := c.conn.exec(ddl, []driver.NamedValue{})
    if r2.err.len > 0 { >> errors.new("rag pgvector ensure table failed: " + r2.err) }
    << 0
}

pub fn (c $&PgVectorClient) ensure_index(index_name string, method string) int {
    sql_txt := c.store.create_index_sql(index_name, method) >>>
    res := c.conn.exec(sql_txt, []driver.NamedValue{})
    if res.err.len > 0 { >> errors.new("rag pgvector ensure index failed: " + res.err) }
    << 0
}

pub fn (c $&PgVectorClient) upsert_chunk(ch &Chunk) int {
    sql_txt := pg_upsert_param_sql(&c.store.table)
    args := pg_upsert_args(&c.store, ch) >>>
    res := c.conn.exec(sql_txt, args)
    if res.err.len > 0 { >> errors.new("rag pgvector upsert failed: " + res.err) }
    << res.rows_affected
}

pub fn (c $&PgVectorClient) delete_doc(doc_id string) int {
    sql_txt := "DELETE FROM " + c.store.table + " WHERE doc_id = $$1"
    args := [driver.NamedValue{name: "", ordinal: 1, value: doc_id + ""}]
    res := c.conn.exec(sql_txt, args)
    if res.err.len > 0 { >> errors.new("rag pgvector delete failed: " + res.err) }
    << res.rows_affected
}

pub fn (c $&PgVectorClient) search(query_emb &[]f64, top_k int, filter_doc_id string) []SearchHit {
    sql_txt := pg_search_param_sql(&c.store, top_k, filter_doc_id.len > 0) >>>
    args := pg_search_args(&c.store, query_emb, &filter_doc_id) >>>
    rows := c.conn.query(sql_txt, args)
    if rows.err.len > 0 { >> errors.new("rag pgvector search failed: " + rows.err) }
    if rows.ncols < 6 { << []SearchHit{} }
    n_rows := rows.cells.len / rows.ncols
    $hits := []SearchHit{}
    for ri in 0:n_rows {
        base := ri * rows.ncols
        i1 := base + 1
        i2 := base + 2
        i3 := base + 3
        i4 := base + 4
        i5 := base + 5
        cid := strip_driver_cell(&rows.cells[base])
        did := strip_driver_cell(&rows.cells[i1])
        txt := strip_driver_cell(&rows.cells[i2])
        src := strip_driver_cell(&rows.cells[i3])
        $meta := strip_driver_cell(&rows.cells[i4])
        if meta.len == 0 { meta = "{}" }
        dist := parse_driver_f64(&rows.cells[i5])
        $score := -dist
        if c.store.metric == "cosine" { score = 1.0 - dist }
        hits.push(SearchHit{
            chunk: Chunk{
                id: cid,
                doc_id: did,
                text: txt,
                source: src,
                metadata_json: meta,
                embedding: []f32{}
            },
            score: score
        })
    }
    << hits
}

pub fn (c $&PgVectorClient) close() int {
    e := c.conn.close()
    if e.len > 0 { >> errors.new("rag pgvector close failed: " + e) }
    << 0
}

pub struct PgVectorPool {
    pub store PgVectorStore
    db sql.DB
}

pub fn new_pgvector_pool(db sql.DB, table string, dim int, metric string) PgVectorPool {
    st := new_pgvector_store(table, dim, metric) >>>
    << PgVectorPool{store: st, db: db}
}

pub fn open_pgvector_pool(dsn string, table string, dim int, metric string, max_open int, max_idle int) PgVectorPool {
    db := postgres.open_pool(dsn + "", max_open, max_idle)
    << new_pgvector_pool(db, table, dim, metric) >>>
}

pub fn (p &PgVectorPool) ensure_table() int {
    _ := p.db.exec(postgres.pgvector_create_extension_sql()) >>>
    ddl := pg_table_ddl(&p.store.table, p.store.dim)
    _ := p.db.exec(ddl) >>>
    << 0
}

pub fn (p &PgVectorPool) ensure_index(index_name string, method string) int {
    sql_txt := p.store.create_index_sql(index_name, method) >>>
    _ := p.db.exec(sql_txt) >>>
    << 0
}

pub fn (p &PgVectorPool) upsert_chunk(ch &Chunk) int {
    if ch.embedding.len != p.store.dim {
        >> errors.new("rag: pgvector chunk embedding dimension mismatch")
    }
    sql_txt := pg_upsert_param_sql(&p.store.table)
    vec_lit := postgres.vector_encode(&ch.embedding)
    $meta := ch.metadata_json + ""
    if meta.len == 0 { meta = "{}" }
    res := p.db.exec(sql_txt, ch.id + "", ch.doc_id + "", ch.text + "", ch.source + "", meta, vec_lit) >>>
    << res.rows_affected
}

pub fn (p &PgVectorPool) delete_doc(doc_id string) int {
    sql_txt := "DELETE FROM " + p.store.table + " WHERE doc_id = $$1"
    res := p.db.exec(sql_txt, doc_id + "") >>>
    << res.rows_affected
}

fn pg_parse_f64_or(s &string, def f64) f64 {
    << strconv.parse_float(s) >>> (_) { << def }
}

fn decode_pg_pool_rows(rs $&sql.Rows, metric &string) []SearchHit {
    $hits := []SearchHit{}
    while rs.next() {
        raw := rs.take() >>> (err) {
            rs.close()
            >> err
        }
        vals := sql_temp_strings(raw)
        if vals.len >= 6 {
            $meta := vals[4] + ""
            if meta.len == 0 { meta = "{}" }
            dtrimmed := strings.trim_space(&vals[5])
            dist := pg_parse_f64_or(&dtrimmed, 0.0)
            $score := -dist
            if *metric == "cosine" { score = 1.0 - dist }
            hits.push(SearchHit{
                chunk: Chunk{
                    id: vals[0] + "",
                    doc_id: vals[1] + "",
                    text: vals[2] + "",
                    source: vals[3] + "",
                    metadata_json: meta,
                    embedding: []f32{}
                },
                score: score
            })
        }
    }
    rs.close()
    << hits
}

pub fn (p &PgVectorPool) search(query_emb &[]f64, top_k int, filter_doc_id string) []SearchHit {
    if query_emb.len != p.store.dim {
        >> errors.new("rag: pgvector query embedding dimension mismatch")
    }
    sql_txt := pg_search_param_sql(&p.store, top_k, filter_doc_id.len > 0) >>>
    vec_lit := postgres.vector_encode_f64(query_emb)
    if filter_doc_id.len > 0 {
        $rs := p.db.query(sql_txt, vec_lit, filter_doc_id + "") >>>
        << decode_pg_pool_rows($&rs, &p.store.metric) >>>
    }
    $rs := p.db.query(sql_txt, vec_lit) >>>
    << decode_pg_pool_rows($&rs, &p.store.metric) >>>
}

pub fn (p $&PgVectorPool) close() int {
    db_ref := $&p.db
    _ := db_ref.close() >>>
    << 0
}

pub struct SqliteVectorStore {
    pub table string
    pub dim int
    conn driver.Conn
    cache MemoryStore
}

fn sqlite_load_rows_from_conn(conn driver.Conn, table &string, dim int, filter_doc_id string) MemoryStore {
    $sql_txt := "SELECT id, doc_id, text, source, metadata, embedding FROM " + (*table)
    $args := []driver.NamedValue{}
    if filter_doc_id.len > 0 {
        sql_txt = sql_txt + " WHERE doc_id = ?"
        args = [driver.NamedValue{name: "", ordinal: 1, value: filter_doc_id + ""}]
    }
    rows := conn.query(sql_txt, args)
    if rows.err.len > 0 { >> errors.new("rag sqlite load failed: " + rows.err) }
    $ms := new_store(dim)
    if rows.ncols < 6 { << ms }
    n_rows := rows.cells.len / rows.ncols
    for ri in 0:n_rows {
        base := ri * rows.ncols
        i1 := base + 1
        i2 := base + 2
        i3 := base + 3
        i4 := base + 4
        i5 := base + 5
        cid := strip_driver_cell(&rows.cells[base])
        did := strip_driver_cell(&rows.cells[i1])
        txt := strip_driver_cell(&rows.cells[i2])
        src := strip_driver_cell(&rows.cells[i3])
        $meta := strip_driver_cell(&rows.cells[i4])
        if meta.len == 0 { meta = "{}" }
        vec_lit := strip_driver_cell(&rows.cells[i5])
        vec_f32 := postgres.vector_decode(&vec_lit) >>>
        vec_f64 := f32_to_f64_vec(&vec_f32)
        _ := ms.add_chunk(cid, did, txt, src, meta, &vec_f64) >>>
    }
    << ms
}

pub fn new_sqlite_store(conn driver.Conn, table string, dim int) SqliteVectorStore {
    if !rag_valid_pg_ident(&table) {
        >> errors.new("rag: invalid SQLite table identifier: " + table)
    }
    if dim <= 0 {
        >> errors.new("rag: sqlite store dimension must be positive")
    }
    _ := conn.exec("PRAGMA journal_mode=WAL", []driver.NamedValue{})
    ddl := "CREATE TABLE IF NOT EXISTS " + table +
           " (id TEXT PRIMARY KEY, doc_id TEXT NOT NULL, text TEXT NOT NULL, source TEXT NOT NULL, metadata TEXT NOT NULL, embedding TEXT NOT NULL)"
    res := conn.exec(ddl, []driver.NamedValue{})
    if res.err.len > 0 {
        >> errors.new("rag sqlite init failed: " + res.err)
    }
    cache := sqlite_load_rows_from_conn(conn.dup(), &table, dim, "") >>>
    << SqliteVectorStore{table: table, dim: dim, conn: conn, cache: ~cache}
}

pub fn open_sqlite_store(path string, table string, dim int) SqliteVectorStore {
    conn := sqlite.open(path + "")
    << new_sqlite_store(conn, table, dim) >>>
}

pub fn (s $&SqliteVectorStore) upsert_chunk(c &Chunk) int {
    if c.embedding.len != s.dim {
        >> errors.new("rag: sqlite chunk embedding dimension mismatch")
    }
    vec_lit := postgres.vector_encode(&c.embedding)
    $meta := c.metadata_json + ""
    if meta.len == 0 { meta = "{}" }
    sql_txt := "INSERT OR REPLACE INTO " + s.table + " (id, doc_id, text, source, metadata, embedding) VALUES (?, ?, ?, ?, ?, ?)"
    args := [driver.NamedValue{name: "", ordinal: 1, value: c.id + ""}, driver.NamedValue{name: "", ordinal: 2, value: c.doc_id + ""}, driver.NamedValue{name: "", ordinal: 3, value: c.text + ""}, driver.NamedValue{name: "", ordinal: 4, value: c.source + ""}, driver.NamedValue{name: "", ordinal: 5, value: meta + ""}, driver.NamedValue{name: "", ordinal: 6, value: vec_lit}]
    res := s.conn.exec(sql_txt, args)
    if res.err.len > 0 { >> errors.new("rag sqlite upsert failed: " + res.err) }
    $replaced := false
    for i in 0:s.cache.chunks.len {
        if s.cache.chunks[i].id == c.id {
            s.cache.chunks[i].doc_id = c.doc_id + ""
            s.cache.chunks[i].text = c.text + ""
            s.cache.chunks[i].source = c.source + ""
            s.cache.chunks[i].metadata_json = meta + ""
            s.cache.chunks[i].embedding = copy_embedding(&c.embedding)
            replaced = true
            <-
        }
    }
    if !replaced {
        s.cache.chunks.push(Chunk{
            id: c.id + "",
            doc_id: c.doc_id + "",
            text: c.text + "",
            source: c.source + "",
            metadata_json: meta + "",
            embedding: copy_embedding(&c.embedding)
        })
    }
    << res.rows_affected
}

pub fn (s $&SqliteVectorStore) add_chunk(id string, doc_id string, text string, source string,
                                         metadata_json string, embedding &[]f64) int {
    if embedding.len != s.dim {
        >> errors.new("rag: sqlite embedding dimension mismatch")
    }
    $vec := []f32{}
    vec.reserve(s.dim)
    for i in 0:s.dim { vec.push(f32(embedding[i])) }
    ch := Chunk{
        id: id + "",
        doc_id: doc_id + "",
        text: text + "",
        source: source + "",
        metadata_json: metadata_json + "",
        embedding: ~vec
    }
    << s.upsert_chunk(&ch) >>>
}

pub fn (s $&SqliteVectorStore) delete_doc(doc_id string) int {
    sql_txt := "DELETE FROM " + s.table + " WHERE doc_id = ?"
    args := [driver.NamedValue{name: "", ordinal: 1, value: doc_id + ""}]
    res := s.conn.exec(sql_txt, args)
    if res.err.len > 0 { >> errors.new("rag sqlite delete failed: " + res.err) }
    $kept := []Chunk{}
    for i in 0:s.cache.chunks.len {
        if s.cache.chunks[i].doc_id != doc_id {
            kept.push(copy_chunk(&s.cache.chunks[i]))
        }
    }
    s.cache.chunks = ~kept
    << res.rows_affected
}

pub fn (s &SqliteVectorStore) cached_len() int {
    << s.cache.len()
}

pub fn (s $&SqliteVectorStore) refresh_cache() int {
    fresh := sqlite_load_rows_from_conn(s.conn.dup(), &s.table, s.dim, "") >>> (err) {
        >> err
    }
    s.cache = ~fresh
    << s.cache.len()
}

pub fn (s &SqliteVectorStore) count() int {
    sql_txt := "SELECT COUNT(*) FROM " + s.table
    rows := s.conn.query(sql_txt, []driver.NamedValue{})
    if rows.err.len > 0 { >> errors.new("rag sqlite count failed: " + rows.err) }
    if rows.cells.len == 0 { << 0 }
    raw := strip_driver_cell(&rows.cells[0])
    << strconv.atoi(&raw) >>> (_) { << 0 }
}

pub fn (s &SqliteVectorStore) load_memory_store(filter_doc_id string) MemoryStore {
    << sqlite_load_rows_from_conn(s.conn.dup(), &s.table, s.dim, filter_doc_id) >>>
}

pub fn (s &SqliteVectorStore) search(query_emb &[]f64, top_k int, filter_doc_id string) []SearchHit {
    << s.cache.search(query_emb, top_k, filter_doc_id) >>>
}

pub fn (s &SqliteVectorStore) search_hybrid(query string, query_emb &[]f64, top_k int, rrf_k int,
                                            filter_doc_id string) []SearchHit {
    << s.cache.search_hybrid_filtered(query, query_emb, top_k, rrf_k, filter_doc_id)
}

pub fn (s $&SqliteVectorStore) close() int {
    e := s.conn.close()
    if e.len > 0 { >> errors.new("rag sqlite close failed: " + e) }
    << 0
}

pub struct QdrantVectorStore {
    pub client qdrant.Client
    pub collection string
    pub dim int
}

pub fn new_qdrant_store(endpoint string, api_key string, collection string, dim int) QdrantVectorStore {
    if collection.len == 0 {
        >> errors.new("rag: qdrant collection must not be empty")
    }
    if dim <= 0 {
        >> errors.new("rag: qdrant store dimension must be positive")
    }
    << QdrantVectorStore{
        client: qdrant.new_client(endpoint, api_key),
        collection: collection,
        dim: dim
    }
}

pub fn (s $&QdrantVectorStore) ensure_collection(distance string) bool {
    cli := $&s.client
    << cli.create_collection(s.collection + "", s.dim, distance + "")
}

pub fn (s $&QdrantVectorStore) upsert_chunk(point_id int, c &Chunk) bool {
    if c.embedding.len != s.dim {
        >> errors.new("rag: qdrant chunk embedding dimension mismatch")
    }
    $vec_s := []string{}
    vec_s.reserve(s.dim)
    for i in 0:s.dim {
        vec_s.push(fmt_f32_or(c.embedding[i]))
    }
    $meta := c.metadata_json + ""
    if meta.len == 0 { meta = "{}" }
    payload := "{\"chunk_id\":" + json.quote(&c.id) +
               ",\"doc_id\":" + json.quote(&c.doc_id) +
               ",\"text\":" + json.quote(&c.text) +
               ",\"source\":" + json.quote(&c.source) +
               ",\"metadata\":" + meta + "}"
    cli := $&s.client
    << cli.upsert_point(s.collection + "", point_id, vec_s, payload)
}

fn rag_doc_get_or(doc &json.Doc, obj int, key string) int {
    << doc.get(obj, key) >>> (_) { << -1 }
}

fn rag_doc_at_or(doc &json.Doc, arr int, idx int) int {
    << doc.at(arr, idx) >>> (_) { << -1 }
}

fn fmt_f64_7_or(v f64, def string) string {
    << strconv.format_float(v, 103, 7) >>> (_) { << def }
}

fn rag_parse_f64_or(s &string, def f64) f64 {
    << strconv.parse_float(s) >>> (_) { << def }
}

pub fn (s $&QdrantVectorStore) search(query_emb &[]f64, top_k int) []SearchHit {
    if top_k <= 0 { << []SearchHit{} }
    if query_emb.len != s.dim {
        >> errors.new("rag: qdrant query embedding dimension mismatch")
    }
    $vec_s := []string{}
    vec_s.reserve(s.dim)
    for i in 0:s.dim {
        vec_s.push(fmt_f64_7_or(query_emb[i], "0.0"))
    }
    cli := $&s.client
    pts := cli.search(s.collection + "", vec_s, top_k) >>>
    $out := []SearchHit{}
    for i in 0:pts.len {
        pt := &pts[i]
        sc := rag_parse_f64_or(&pt.score, 0.0)
        $cid := str(pt.id)
        $did := ""
        $txt := pt.payload_json + ""
        $src := ""
        $meta := "{}"
        if pt.payload_json.len > 0 {
            doc := json.parse(&pt.payload_json)
            if doc.ok() && doc.is_dict(doc.root()) {
                root := doc.root()
                $pcid := json_str_or(&doc, root, "chunk_id", "")
                if pcid.len > 0 { cid = pcid }
                did = json_str_or(&doc, root, "doc_id", "")
                ptxt := json_str_or(&doc, root, "text", "")
                if ptxt.len > 0 { txt = ptxt }
                src = json_str_or(&doc, root, "source", "")
                if doc.has(root, "metadata") {
                    mn := rag_doc_get_or(&doc, root, "metadata")
                    if mn >= 0 { meta = json_encode_or(&doc, mn, "{}") }
                }
            }
        }
        out.push(SearchHit{
            chunk: Chunk{
                id: cid,
                doc_id: did,
                text: txt,
                source: src,
                metadata_json: meta,
                embedding: []f32{}
            },
            score: sc
        })
    }
    << out
}

fn extract_json_array_or_raw(raw &string) string {
    trimmed := strings.trim_space(raw)
    $lbr := -1
    $rbr := -1
    for i in 0:trimmed.len {
        if (trimmed[i] & 255) == 91 {
            lbr = i
            <-
        }
    }
    $j := trimmed.len - 1
    while j >= 0 {
        if (trimmed[j] & 255) == 93 {
            rbr = j
            <-
        }
        j -= 1
    }
    if lbr >= 0 && rbr > lbr {
        << trimmed[lbr:(rbr + 1)]
    }
    << trimmed
}

pub fn extract_triples_openai(client &openai.Client, model string, text string, source string) []Triple {
    sys := "Extract factual knowledge-graph triples from the text. Return ONLY a JSON array of objects with keys subject, predicate, object."
    req := openai.chat_request(model + "", [openai.message("system", sys), openai.message("user", text + "")])
    resp := client.chat(&req) >>>
    $out := []Triple{}
    $arr_node := -1
    $doc := json.parse(&resp.content)
    if doc.ok() {
        root := doc.root()
        if doc.is_list(root) {
            arr_node = root
        } else if doc.is_dict(root) && doc.has(root, "triples") {
            tn := rag_doc_get_or(&doc, root, "triples")
            if tn >= 0 && doc.is_list(tn) { arr_node = tn }
        }
    }
    if arr_node < 0 {
        sliced := extract_json_array_or_raw(&resp.content)
        doc = json.parse(&sliced)
        if doc.ok() && doc.is_list(doc.root()) {
            arr_node = doc.root()
        }
    }
    if arr_node < 0 { << out }
    cnt := doc.count(arr_node)
    for i in 0:cnt {
        item := rag_doc_at_or(&doc, arr_node, i)
        if item >= 0 && doc.is_dict(item) {
            subj := json_str_or(&doc, item, "subject", "")
            pred := json_str_or(&doc, item, "predicate", "")
            obj := json_str_or(&doc, item, "object", "")
            if subj.len > 0 && pred.len > 0 && obj.len > 0 {
                out.push(Triple{
                    subject: subj,
                    predicate: pred,
                    object: obj,
                    source: source + ""
                })
            }
        }
    }
    << out
}

pub fn (kg $&KnowledgeGraph) ingest_text_openai(client &openai.Client, model string,
                                                 text string, source string) int {
    extracted := extract_triples_openai(client, model, text, source) >>>
    $added := 0
    for i in 0:extracted.len {
        cand := &extracted[i]
        ls := rag_ascii_lower(&cand.subject)
        lp := rag_ascii_lower(&cand.predicate)
        lo := rag_ascii_lower(&cand.object)
        $dup := false
        for ti in 0:kg.triples.len {
            ex := &kg.triples[ti]
            if rag_ascii_lower(&ex.subject) == ls && rag_ascii_lower(&ex.predicate) == lp && rag_ascii_lower(&ex.object) == lo {
                dup = true
                <-
            }
        }
        if !dup {
            kg.add_triple(cand.subject + "", cand.predicate + "", cand.object + "", cand.source + "")
            added += 1
        }
    }
    << added
}

pub fn (kg &KnowledgeGraph) match_entities(text &string) []string {
    $seeds := []string{}
    if text.len == 0 || kg.triples.len == 0 { << seeds }
    lt := rag_ascii_lower(text)
    $seen_low := []string{}
    for i in 0:kg.triples.len {
        tr := &kg.triples[i]
        ls := rag_ascii_lower(&tr.subject)
        if ls.len >= 2 && strings.contains(&lt, ls + "") && !rag_str_in_list(&seen_low, &ls) {
            seen_low.push(ls)
            seeds.push(tr.subject + "")
        }
        lo := rag_ascii_lower(&tr.object)
        if lo.len >= 2 && strings.contains(&lt, lo + "") && !rag_str_in_list(&seen_low, &lo) {
            seen_low.push(lo)
            seeds.push(tr.object + "")
        }
    }
    << seeds
}

pub fn hybrid_graph_vector_search_auto(store &MemoryStore, kg &KnowledgeGraph,
                                          query string, query_emb &[]f64,
                                          top_k int, graph_hops int) HybridGraphResult {
    seeds := kg.match_entities(&query)
    << hybrid_graph_vector_search(store, kg, query, query_emb, &seeds, top_k, graph_hops)
}

