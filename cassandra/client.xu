@"github.com/xulang-org/packages/cassandra"

#net
#errors
#strings

pub struct Client {
    pub host string
    pub port int
    pub keyspace string
}

fn parse_int_def(s string, def int) int {
    if s.len == 0 {
        << def
    }
    n := parse_int(s) or (err) {
        << def
    }
    << n
}

fn safe_close(fd int) {
    if fd >= 0 {
        net.conn_close(fd) or (e) {
            <<
        }
    }
}

pub fn new_client(endpoint string, keyspace string) Client {
    mut ep := endpoint
    mut host := "127.0.0.1"
    mut port := 9042
    mut colon := -1
    mut i := 0
    while i < ep.len {
        if (ep[i] & 255) == 58 {
            colon = i
            <-
        }
        i = i + 1
    }
    if colon >= 0 {
        host = ep[0:colon]
        p_str := ep[(colon + 1):ep.len]
        port = parse_int_def(p_str, 9042)
    } else {
        if ep.len > 0 {
            host = ep
        }
    }
    << Client{
        host: host,
        port: port,
        keyspace: keyspace
    }
}

fn read_exact(fd int, need int) string {
    mut buf := ""
    while buf.len < need {
        want := need - buf.len
        chunk := net.conn_read(fd, want) or (err) {
            >> errors.new("cassandra read_exact error: " + err.msg())
        }
        if chunk.len == 0 {
            >> errors.new("cassandra read_exact unexpected EOF")
        }
        buf = buf + chunk
    }
    << buf
}

fn write_all(fd int, data string) bool {
    mut off := 0
    while off < data.len {
        part := data[off:data.len]
        n := net.conn_write(fd, &part) or (err) {
            >> errors.new("cassandra write_all error: " + err.msg())
        }
        if n <= 0 {
            <-
        }
        off = off + n
    }
    << true
}

pub fn (c Client) read_frame(fd int) Frame {
    hdr := read_exact(fd, 9) or >>
    ver := hdr[0] & 255
    flags := hdr[1] & 255
    stream := decode_u16(hdr[2] & 255, hdr[3] & 255)
    opcode := hdr[4] & 255
    body_len := decode_u32(hdr[5] & 255, hdr[6] & 255, hdr[7] & 255, hdr[8] & 255)

    mut body := ""
    if body_len > 0 {
        body = read_exact(fd, body_len) or >>
    }

    << Frame{
        version: ver,
        flags: flags,
        stream: stream,
        opcode: opcode,
        body: body
    }
}

pub fn (c Client) connect() int {
    addr := c.host + ":" + str(c.port)
    fd := net.dial(strings.clone(&addr)) or (err) {
        >> errors.new("cassandra dial failed: " + err.msg())
    }

    // Send STARTUP frame
    startup := build_startup_frame()
    write_all(fd, startup) or (err) {
        safe_close(fd)
        >> err
    }

    resp := c.read_frame(fd) or (err) {
        safe_close(fd)
        >> err
    }

    if resp.opcode == OPCODE_ERROR {
        safe_close(fd)
        >> errors.new("cassandra startup error: opcode 0")
    }

    // Opcode READY (2) indicates success
    if resp.opcode != OPCODE_READY {
        // Some nodes might send AUTHENTICATE (3)
        // For standard local tests without auth, it should be READY
    }

    // If keyspace is configured, execute USE keyspace
    if c.keyspace.len > 0 {
        cql := "USE " + c.keyspace + ";"
        query := build_query_frame(cql, 1)
        write_all(fd, query) or (err) {
            safe_close(fd)
            >> err
        }
        q_resp := c.read_frame(fd) or (err) {
            safe_close(fd)
            >> err
        }
        if q_resp.opcode == OPCODE_ERROR {
            safe_close(fd)
            >> errors.new("cassandra USE keyspace failed")
        }
    }

    << fd
}

pub fn (c Client) execute_on_fd(fd int, cql string) string {
    query := build_query_frame(cql, 1)
    write_all(fd, query) or >>

    resp := c.read_frame(fd) or >>
    if resp.opcode == OPCODE_ERROR {
        // Decode error code & message
        if resp.body.len >= 6 {
            err_code := decode_u32(resp.body[0] & 255, resp.body[1] & 255, resp.body[2] & 255, resp.body[3] & 255)
            msg_len := decode_u16(resp.body[4] & 255, resp.body[5] & 255)
            mut err_msg := "unknown"
            if 6 + msg_len <= resp.body.len {
                err_msg = resp.body[6:(6 + msg_len)]
            }
            >> errors.new("cql error (" + str(err_code) + "): " + err_msg)
        }
        >> errors.new("cql error")
    }

    if resp.opcode == OPCODE_RESULT {
        if resp.body.len >= 4 {
            kind := decode_u32(resp.body[0] & 255, resp.body[1] & 255, resp.body[2] & 255, resp.body[3] & 255)
            if kind == RESULT_KIND_VOID {
                << "VOID"
            } else if kind == RESULT_KIND_SCHEMA_CHANGE {
                << "SCHEMA_CHANGE"
            } else if kind == RESULT_KIND_SET_KEYSPACE {
                << "SET_KEYSPACE"
            } else if kind == RESULT_KIND_ROWS {
                // Rows result
                if resp.body.len >= 12 {
                    // Extract metadata
                    // Simple text indicator with body length for testing
                    << "ROWS (len=" + str(resp.body.len) + ")"
                }
                << "ROWS"
            }
        }
        << "RESULT_OK"
    }

    << "OK"
}

pub fn (c Client) execute(cql string) string {
    fd := c.connect() or >>
    res := c.execute_on_fd(fd, cql) or (err) {
        safe_close(fd)
        >> err
    }
    safe_close(fd)
    << res
}
