@"github.com/xulang-org/packages/neo4j"

#net
#net/pool
#errors
#strings

pub struct Pool {
    pub client Neo4jClient
    pub state chan pool.State
    pub max_idle int
}

pub fn new_pool(endpoint string, user string, pass string, db string, max_idle int) Pool {
    c := new_client(endpoint, user, pass, db)
    mut cap_val := max_idle
    if cap_val <= 0 {
        cap_val = 10
    }
    state := pool.new_state()
    << Pool{
        client: c,
        state: state,
        max_idle: cap_val
    }
}

fn client_copy(p &Pool) Neo4jClient {
    << Neo4jClient{host: strings.clone(&p.client.host), port: p.client.port, secure: p.client.secure, user: strings.clone(&p.client.user), password: strings.clone(&p.client.password), database: strings.clone(&p.client.database), auth_header: strings.clone(&p.client.auth_header)}
}

// Copies configuration while sharing the connection and close lifecycle.
pub fn (p &Pool) dup() Pool {
    c := Neo4jClient{
        host: strings.clone(&p.client.host),
        port: p.client.port,
        secure: p.client.secure,
        user: strings.clone(&p.client.user),
        password: strings.clone(&p.client.password),
        database: strings.clone(&p.client.database),
        auth_header: strings.clone(&p.client.auth_header)
    }
    << Pool{client: c, state: p.state, max_idle: p.max_idle}
}

pub fn (p &Pool) get_conn() int {
    if p.client.secure { << -1 }
    sockets := pool.SocketPool{state: p.state, max_idle: p.max_idle}
    cached := sockets.take()
    if cached == -2 { << -1 }
    if cached >= 0 { << cached }
    addr := p.client.host + ":" + str(p.client.port)
    fd := net.dial(strings.clone(&addr)) or (err) { << -1 }
    if !sockets.adopt(fd) { << -1 }
    << fd
}

pub fn (p &Pool) put_conn(fd int) {
    if p.client.secure { << }
    sockets := pool.SocketPool{state: p.state, max_idle: p.max_idle}
    sockets.release(fd, true)
}

pub fn (p &Pool) discard_conn(fd int) {
    if p.client.secure { << }
    sockets := pool.SocketPool{state: p.state, max_idle: p.max_idle}
    sockets.release(fd, false)
}

pub fn open_pool(endpoint string, user string, pass string, db string, max_idle int) Pool {
    << new_pool(endpoint, user, pass, db, max_idle)
}

pub fn (p &Pool) execute(stmt string) string {
    if p.client.secure {
        << p.client.execute(stmt) or >>
    }
    fd := p.get_conn()
    if fd < 0 { >> errors.new("neo4j: pool closed or dial failed") }
    mut reusable := false
    result := p.client.execute_response(fd, stmt, true, mut &reusable) or (err) {
        p.discard_conn(fd)
        >> err
    }
    if reusable { p.put_conn(fd) } else { p.discard_conn(fd) }
    << result
}

pub fn (p &Pool) close() {
    sockets := pool.SocketPool{state: p.state, max_idle: p.max_idle}
    sockets.close()
}
