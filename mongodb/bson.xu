@"github.com/xulang-org/packages/mongodb"

#errors

// Lightweight BSON Encoder & Decoder for MongoDB Wire Protocol.

pub fn encode_i32(v int) string {
    $b := ""
    b.push_byte(v & 255)
    b.push_byte((v >> 8) & 255)
    b.push_byte((v >> 16) & 255)
    b.push_byte((v >> 24) & 255)
    << b
}

pub fn encode_i64(v int) string {
    $b := ""
    b.push_byte(v & 255)
    b.push_byte((v >> 8) & 255)
    b.push_byte((v >> 16) & 255)
    b.push_byte((v >> 24) & 255)
    b.push_byte((v >> 32) & 255)
    b.push_byte((v >> 40) & 255)
    b.push_byte((v >> 48) & 255)
    b.push_byte((v >> 56) & 255)
    << b
}

pub fn decode_i32(s &string, off int) int {
    if off + 4 > s.len {
        << 0
    }
    b0 := s[off] & 255
    b1 := s[off + 1] & 255
    b2 := s[off + 2] & 255
    b3 := s[off + 3] & 255
    << b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)
}

pub fn build_doc(elements string) string {
    total_len := elements.len + 5 // 4 bytes length + elements + 1 byte 0x00
    $out := encode_i32(total_len)
    out = out + elements
    out.push_byte(0)
    << out
}

pub fn bson_string(name string, val string) string {
    $out := ""
    out.push_byte(2) // 0x02 = String
    out = out + name
    out.push_byte(0)
    out = out + encode_i32(val.len + 1)
    out = out + val
    out.push_byte(0)
    << out
}

pub fn bson_int32(name string, val int) string {
    $out := ""
    out.push_byte(16) // 0x10 = 32-bit int
    out = out + name
    out.push_byte(0)
    out = out + encode_i32(val)
    << out
}

pub fn bson_int64(name string, val int) string {
    $out := ""
    out.push_byte(18) // 0x12 = 64-bit int
    out = out + name
    out.push_byte(0)
    out = out + encode_i64(val)
    << out
}

pub fn bson_bool(name string, val bool) string {
    $out := ""
    out.push_byte(8) // 0x08 = Boolean
    out = out + name
    out.push_byte(0)
    if val {
        out.push_byte(1)
    } else {
        out.push_byte(0)
    }
    << out
}

pub fn bson_doc(name string, doc_bytes string) string {
    $out := ""
    out.push_byte(3) // 0x03 = Embedded Document
    out = out + name
    out.push_byte(0)
    out = out + doc_bytes
    << out
}

pub fn bson_array(name string, arr_bytes string) string {
    $out := ""
    out.push_byte(4) // 0x04 = Array Document
    out = out + name
    out.push_byte(0)
    out = out + arr_bytes
    << out
}

pub fn bson_object_id(name string, oid_bytes string) string {
    $out := ""
    out.push_byte(7) // 0x07 = ObjectId (12 bytes)
    out = out + name
    out.push_byte(0)
    if oid_bytes.len == 12 {
        out = out + oid_bytes
    } else {
        $pad := oid_bytes
        while pad.len < 12 {
            pad.push_byte(0)
        }
        out = out + pad[0:12]
    }
    << out
}

pub fn bson_utc_datetime(name string, millis int) string {
    $out := ""
    out.push_byte(9) // 0x09 = UTC datetime (64-bit int)
    out = out + name
    out.push_byte(0)
    out = out + encode_i64(millis)
    << out
}

pub fn bson_null(name string) string {
    $out := ""
    out.push_byte(10) // 0x0A = Null
    out = out + name
    out.push_byte(0)
    << out
}

// Field boundaries are walked from the document header. Bytes in strings,
// binary values and embedded documents are never mistaken for root fields.
struct BsonField {
    pub typ int
    pub name string
    pub start int
    pub end int
}

fn bson_invalid() BsonField {
    << BsonField{typ: -1, name: "", start: 0, end: 0}
}

fn bson_cstring_end(doc &string, off int, limit int) int {
    $i := off
    while i < limit {
        if (doc[i] & 255) == 0 { << i + 1 }
        i += 1
    }
    << -1
}

fn bson_next(doc &string, off int) BsonField {
    limit := doc.len - 1
    if off < 4 || off >= limit { << bson_invalid() }
    typ := doc[off] & 255
    name_end := bson_cstring_end(doc, off + 1, limit)
    if name_end < 0 { << bson_invalid() }
    $end := name_end
    if typ == 1 || typ == 9 || typ == 17 || typ == 18 { end += 8 }
    else if typ == 7 { end += 12 }
    else if typ == 8 { end += 1 }
    else if typ == 16 { end += 4 }
    else if typ == 19 { end += 16 }
    else if typ == 2 || typ == 13 || typ == 14 || typ == 12 {
        if end + 4 > limit { << bson_invalid() }
        n := decode_i32(doc, end)
        if n < 1 || n > limit - end - 4 { << bson_invalid() }
        end += 4 + n
        if (doc[end - 1] & 255) != 0 { << bson_invalid() }
        if typ == 12 { end += 12 }
    } else if typ == 3 || typ == 4 {
        if end + 4 > limit { << bson_invalid() }
        n := decode_i32(doc, end)
        if n < 5 || n > limit - end { << bson_invalid() }
        end += n
        if (doc[end - 1] & 255) != 0 { << bson_invalid() }
    } else if typ == 15 {
        if end + 8 > limit { << bson_invalid() }
        n := decode_i32(doc, end)
        code_n := decode_i32(doc, end + 4)
        if n < 14 || n > limit - end || code_n < 1 || code_n > n - 13 { << bson_invalid() }
        scope := end + 8 + code_n
        if (doc[scope - 1] & 255) != 0 || decode_i32(doc, scope) != n - 8 - code_n { << bson_invalid() }
        end += n
        if (doc[end - 1] & 255) != 0 { << bson_invalid() }
    } else if typ == 5 {
        if end + 5 > limit { << bson_invalid() }
        n := decode_i32(doc, end)
        if n < 0 || n > limit - end - 5 { << bson_invalid() }
        if (doc[end + 4] & 255) == 2 {
            if n < 4 || decode_i32(doc, end + 5) != n - 4 { << bson_invalid() }
        }
        end += n + 5
    } else if typ == 11 {
        end = bson_cstring_end(doc, end, limit)
        if end < 0 { << bson_invalid() }
        end = bson_cstring_end(doc, end, limit)
        if end < 0 { << bson_invalid() }
    } else if typ != 6 && typ != 10 && typ != 127 && typ != 255 {
        << bson_invalid()
    }
    if end > limit { << bson_invalid() }
    if typ == 8 && (doc[name_end] & 255) > 1 { << bson_invalid() }
    << BsonField{typ: typ, name: doc[off + 1:name_end - 1] + "", start: name_end, end: end}
}

fn valid_bson(doc &string) bool {
    << valid_bson_depth(doc, 0, false)
}

fn valid_bson_depth(doc &string, depth int, array bool) bool {
    if depth > 64 { << false }
    if doc.len < 5 || doc.len > 16777216 { << false }
    if decode_i32(doc, 0) != doc.len || (doc[doc.len - 1] & 255) != 0 { << false }
    $off := 4
    $index := 0
    $ok_count := 0
    $errors_count := 0
    $concern_count := 0
    while off < doc.len - 1 {
        f := bson_next(doc, off)
        if f.typ < 0 || f.end <= off { << false }
        if array && f.name != str(index) { << false }
        index += 1
        if f.name == "ok" { ok_count += 1 }
        if f.name == "writeErrors" { errors_count += 1 }
        if f.name == "writeConcernError" { concern_count += 1 }
        if ok_count > 1 || errors_count > 1 || concern_count > 1 { << false }
        if f.typ == 3 || f.typ == 4 {
            child := doc[f.start:f.end] + ""
            if !valid_bson_depth(&child, depth + 1, f.typ == 4) { << false }
        }
        if f.typ == 15 {
            scope := f.start + 8 + decode_i32(doc, f.start + 4)
            child := doc[scope:f.end] + ""
            if !valid_bson_depth(&child, depth + 1, false) { << false }
        }
        off = f.end
    }
    << off == doc.len - 1
}

fn bson_field(doc &string, name string) BsonField {
    if !valid_bson(doc) { << bson_invalid() }
    $off := 4
    $found := bson_invalid()
    while off < doc.len - 1 {
        f := bson_next(doc, off)
        if f.name == name {
            // Ambiguous duplicate fields must not decide command success.
            if found.typ >= 0 { << bson_invalid() }
            found = BsonField{typ: f.typ, name: f.name + "", start: f.start, end: f.end}
        }
        off = f.end
    }
    << found
}

pub fn find_bson_string(doc string, target_field string) string {
    f := bson_field(&doc, target_field)
    if f.typ != 2 { << "" }
    << doc[f.start + 4:f.end - 1] + ""
}

fn find_bson_document(doc string, target_field string) string {
    f := bson_field(&doc, target_field)
    if f.typ != 3 && f.typ != 4 { << "" }
    << doc[f.start:f.end] + ""
}

pub fn is_bson_ok(doc string) bool {
    f := bson_field(&doc, "ok")
    if f.typ == 8 { << (doc[f.start] & 255) == 1 }
    if f.typ == 16 { << decode_i32(&doc, f.start) == 1 }
    if f.typ == 18 { << doc[f.start:f.end] == encode_i64(1) }
    if f.typ == 1 {
        // IEEE-754 little-endian double 1.0, not merely a matching tail byte.
        one := string_from_byte(0) + string_from_byte(0) + string_from_byte(0) + string_from_byte(0) + string_from_byte(0) + string_from_byte(0) + string_from_byte(240) + string_from_byte(63)
        << doc[f.start:f.end] == one
    }
    << false
}
