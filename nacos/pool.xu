        << result
    }
    fd := p.get_conn()
    if fd < 0 { << false }
    $reusable := false
    result := p.client.publish_config_at(fd, data_id, group, content, $&reusable)
    if reusable && result { p.put_conn(fd) } else { p.discard_conn(fd) }
    << result
