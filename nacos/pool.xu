    if p.client.secure {
        c := client_copy(p)
        result := c.get_config(data_id, group) or (err) { << "" }
        << result
    }
    fd := p.get_conn()
    if fd < 0 { >> errors.new("nacos: pool closed or dial failed") }
    $reusable := false
    result := p.client.get_config_at(fd, data_id, group, $&reusable) or (err) {
        p.discard_conn(fd)
        >> err
    }
    if reusable { p.put_conn(fd) } else { p.discard_conn(fd) }
    << result
}

pub fn (p &Pool) remove_config(data_id string, group string) bool {
    if p.client.secure {
        c := client_copy(p)
        result := c.remove_config(data_id, group) or (err) { << false }
        << result
    }
    fd := p.get_conn()
    if fd < 0 { << false }
    $reusable := false
    result := p.client.remove_config_at(fd, data_id, group, $&reusable)
    if reusable && result { p.put_conn(fd) } else { p.discard_conn(fd) }
    << result
}

pub fn (p &Pool) close() {
    sockets := pool.SocketPool{state: p.state, max_idle: p.max_idle}
    sockets.close()
}
