@"github.com/xulang-org/packages/nacos"

#net
#net/http
#crypto/tls
#errors
#strings
transport #github.com/xulang-org/packages/transport

pub struct Response {
    pub status_code int
    pub headers string
    pub body string
}

pub struct Client {
    pub host string
    pub port int
    pub secure bool
    pub namespace_id string
}

fn parse_int_def(s string, def int) int {
    if s.len == 0 {
        << def
    }
    n := parse_int(s) or (err) {
        << def
    }
    << n
}

fn safe_close(fd int) {
    if fd >= 0 {
        net.conn_close(fd) or (e) {
            <<
        }
    }
}

pub fn new_client(endpoint string, namespace string) Client {
    if strings.has_prefix(&endpoint, "https://") {
        ep := transport.parse_endpoint(endpoint, 8848) or (err) {
            << Client{host: "127.0.0.1", port: 8848, secure: true, namespace_id: namespace}
        }
        << Client{host: ep.host, port: ep.port, secure: true, namespace_id: namespace}
    }
    mut ep := endpoint
    prefix_http := "http://"
    if ep.len >= prefix_http.len && ep[0:prefix_http.len] == prefix_http {
        ep = ep[prefix_http.len:ep.len]
    }
    mut host := "127.0.0.1"
    mut port := 8848
    mut colon := -1
    mut i := 0
    while i < ep.len {
        if (ep[i] & 255) == 58 {
            colon = i
            <-
        }
        i = i + 1
    }
    if colon >= 0 {
        host = ep[0:colon]
        p_str := ep[(colon + 1):ep.len]
        port = parse_int_def(p_str, 8848)
    } else {
        if ep.len > 0 {
            host = ep
        }
    }
    << Client{
        host: host,
        port: port,
        secure: false,
        namespace_id: namespace
    }
}

pub fn (c Client) request(method string, path string, body string) Response {
    if c.secure {
        mut req := method + " " + path + " HTTP/1.1\r\n"
        req = req + "Host: " + c.host + ":" + str(c.port) + "\r\n"
        req = req + "Content-Type: application/x-www-form-urlencoded\r\n"
        req = req + "Content-Length: " + str(body.len) + "\r\n"
        req = req + "Connection: close\r\n\r\n"
        if body.len > 0 { req = req + body }
        ep := transport.Endpoint{scheme: "https", host: c.host + "", port: c.port, path: "", secure: true}
        cfg := tls.new_config(c.host + "")
        resp := transport.request_raw(ep, cfg, req, method + "") or >>
        << Response{status_code: resp.status_code, headers: resp.headers, body: resp.body}
    }
    addr := c.host + ":" + str(c.port)
    fd := net.dial(strings.clone(&addr)) or (err) {
        >> errors.new("nacos dial failed: " + err.msg())
    }
    mut reusable := false
    result := c.request_on_fd(fd, method, path, body, mut &reusable) or (err) {
        safe_close(fd)
        >> err
    }
    safe_close(fd)
    << result
}

fn (c Client) request_at(fd int, method string, path string, body string, reusable &mut bool) Response {
    if c.secure {
        *reusable = false
        << c.request(method, path, body) or >>
    }
    if fd < 0 { << c.request(method, path, body) or >> }
    << c.request_on_fd(fd, method, path, body, reusable) or >>
}

fn (c Client) request_on_fd(fd int, method string, path string, body string, reusable &mut bool) Response {
    *reusable = false

    mut req := method + " " + path + " HTTP/1.1\r\n"
    req = req + "Host: " + c.host + ":" + str(c.port) + "\r\n"
    req = req + "Content-Type: application/x-www-form-urlencoded\r\n"
    req = req + "Content-Length: " + str(body.len) + "\r\n"
    req = req + "Connection: keep-alive\r\n\r\n"
    if body.len > 0 {
        req = req + body
    }

    mut off := 0
    while off < req.len {
        part := req[off:req.len]
        n := net.conn_write(fd, &part) or (err) {
            >> errors.new("nacos write failed: " + err.msg())
        }
        if n <= 0 {
            >> errors.new("nacos: connection closed during write")
        }
        off = off + n
    }

    resp := http.read_response(fd, method + "") or (err) {
        >> err
    }
    *reusable = resp.status_code >= 200 && resp.status_code < 300 && resp.reusable(method)
    << Response{status_code: resp.status_code, headers: resp.headers, body: resp.body}
}
