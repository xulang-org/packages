@"github.com/xulang-org/packages/nacos"

#errors
#strings

pub fn (c Client) publish_config(data_id string, group string, content string) bool {
    $reusable := false
    << c.publish_config_at(-1, data_id, group, content, $&reusable)
}

fn (c Client) publish_config_at(fd int, data_id string, group string, content string, reusable $&bool) bool {
    $g := group
    if g.len == 0 {
        g = "DEFAULT_GROUP"
    }
    path := "/nacos/v1/cs/configs"
    body := "dataId=" + data_id + "&group=" + g + "&content=" + content
    resp := c.request_at(fd, "POST", path, body, reusable) or (err) {
        << false
    }
    << resp.status_code == 200
}

pub fn (c Client) get_config(data_id string, group string) string {
    $reusable := false
    << c.get_config_at(-1, data_id, group, $&reusable) or >>
}

fn (c Client) get_config_at(fd int, data_id string, group string, reusable $&bool) string {
    $g := group
    if g.len == 0 {
        g = "DEFAULT_GROUP"
    }
    path := "/nacos/v1/cs/configs?dataId=" + data_id + "&group=" + g
    resp := c.request_at(fd, "GET", path, "", reusable) or >>
    if resp.status_code != 200 {
        >> errors.new("nacos: config not found (status " + str(resp.status_code) + ")")
    }
    << resp.body
}

pub fn (c Client) remove_config(data_id string, group string) bool {
    $reusable := false
    << c.remove_config_at(-1, data_id, group, $&reusable)
}

fn (c Client) remove_config_at(fd int, data_id string, group string, reusable $&bool) bool {
    $g := group
    if g.len == 0 {
        g = "DEFAULT_GROUP"
    }
    path := "/nacos/v1/cs/configs?dataId=" + data_id + "&group=" + g
    resp := c.request_at(fd, "DELETE", path, "", reusable) or (err) {
        << false
    }
    << resp.status_code == 200
}
