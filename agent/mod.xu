pub struct ResponsesSession {
    pub agent ResponsesAgent
    pub prev_response_id string
}

pub fn new_responses_session(agent ResponsesAgent) ResponsesSession {
    << ResponsesSession{agent: agent, prev_response_id: ""}
}

pub fn (s $&ResponsesSession) clear() {
    s.prev_response_id = ""
}

pub fn (s &ResponsesSession) last_response_id() string {
    << s.prev_response_id + ""
}

pub fn (s $&ResponsesSession) send(user_prompt string) RunResult {
    $dummy_http := mcp.new_http_client("http://127.0.0.1:0")
    $dummy_stdio := mcp.closed_stdio_client()
    pid_ref := $&s.prev_response_id
    << run_resp_loop_impl(&s.agent, pid_ref, user_prompt, false, $&dummy_http, false, $&dummy_stdio, false, ignore_agent_ev) >>>
}

