// ---------- ResponsesAgent & ResponsesSession ----------

pub struct ResponsesAgent {
    pub client openai.Client
    pub model string
    pub instructions string
    pub max_turns int
    pub temperature f64
    pub has_temperature bool
    pub max_output_tokens int
    pub max_total_tokens int
    pub tool_choice string
    pub parallel_tools bool
    local_tools []LocalTool
    tool_hook fn(&string, &string) string
}

pub fn new_responses_agent(client openai.Client, model string) ResponsesAgent {
    << ResponsesAgent{
        client: ~client,
        model: model,
        instructions: "",
        max_turns: 8,
        temperature: 0.0,
        has_temperature: false,
        max_output_tokens: 0,
        max_total_tokens: 0,
        tool_choice: "",
        parallel_tools: false,
        local_tools: []LocalTool{},
        tool_hook: default_tool_hook
    }
}

pub fn (a $&ResponsesAgent) set_instructions(s string) { a.instructions = s + "" }
pub fn (a $&ResponsesAgent) set_max_turns(n int) { if n > 0 { a.max_turns = n } }
pub fn (a $&ResponsesAgent) set_temperature(t f64) {
    a.temperature = t
    a.has_temperature = true
}
pub fn (a $&ResponsesAgent) set_max_output_tokens(n int) { if n > 0 { a.max_output_tokens = n } }
pub fn (a $&ResponsesAgent) set_max_total_tokens(n int) { if n >= 0 { a.max_total_tokens = n } }
pub fn (a $&ResponsesAgent) set_tool_choice(c string) { a.tool_choice = c + "" }
pub fn (a $&ResponsesAgent) set_parallel_tools(enabled bool) { a.parallel_tools = enabled }
pub fn (a $&ResponsesAgent) set_tool_hook(hook fn(&string, &string) string) { a.tool_hook = hook }

pub fn (a $&ResponsesAgent) add_tool(name string, description string, parameters_json string,
                                      handler fn(&string) string) {
    $params := parameters_json + ""
    if params.len == 0 { params = "{\"type\":\"object\"}" }
    a.local_tools.push(LocalTool{
        name: name, description: description, parameters_json: params, handler: handler
    })
}

fn empty_resp_api_out() openai.ResponsesResponse {
    << openai.ResponsesResponse{
        id: "", model: "", status: "", output_text: "",
        tool_calls: []openai.ResponsesToolCall{},
        usage: openai.Usage{prompt_tokens: 0, completion_tokens: 0, total_tokens: 0}
    }
}

struct RespStreamOutcome {
    ok bool
    err_msg string
    resp openai.ResponsesResponse
}

fn resp_stream_worker(c openai.Client, req openai.ResponsesRequest,
                      ech chan openai.ResponsesStreamEvent, rch chan RespStreamOutcome) {
    resp := c.responses_stream_chan(&req, ech) >>> (err) {
        ech <- openai.ResponsesStreamEvent{
            event_type: "done", text_delta: "", response_id: "", status: "",
            tool_calls: []openai.ResponsesToolCall{}, has_usage: false,
            usage: openai.Usage{prompt_tokens: 0, completion_tokens: 0, total_tokens: 0}, done: true
        }
        rch <- RespStreamOutcome{ok: false, err_msg: err.msg(), resp: empty_resp_api_out()}
        <<
    }
    rch <- RespStreamOutcome{ok: true, err_msg: "", resp: ~resp}
}

fn run_resp_loop_impl(a &ResponsesAgent, prev_id_ref $&string, user_prompt string,
                      use_http_mcp bool, http_mc $&mcp.Client,
                      use_stdio_mcp bool, stdio_mc $&mcp.StdioClient,
                      use_stream bool, on_event fn(AgentEvent) bool) RunResult {
    $extra_tools := []mcp.ToolInfo{}
    if use_http_mcp {
        extra_tools = http_mc.list_tools() >>>
    } else if use_stdio_mcp {
        extra_tools = stdio_mc.list_tools() >>>
    }
    $steps := []Step{}
    $turns := 0
    $pt := 0
    $ct := 0
    $tt := 0
    $last_content := ""
    $last_status := ""
    $limit := a.max_turns
    if limit <= 0 { >>> errors.new("agent: max_turns must be positive") }

    $cur_input := user_prompt + ""
    $cur_input_json := ""
    while turns < limit {
        turns += 1
        $req := openai.new_responses_request(a.model + "", cur_input)
        req.input_json = cur_input_json + ""
        req.instructions = a.instructions + ""
        req.previous_response_id = (*prev_id_ref) + ""
        req.tools = build_tool_defs(&a.local_tools, &extra_tools)
        if a.has_temperature {
            req.temperature = a.temperature
            req.has_temperature = true
        }
        if a.max_output_tokens > 0 {
            req.max_output_tokens = a.max_output_tokens
        }
        if a.tool_choice.len > 0 {
            req.tool_choice = a.tool_choice + ""
        }
        $resp := empty_resp_api_out()
        if use_stream {
            ech := chan openai.ResponsesStreamEvent{cap: 64}
            rch := chan RespStreamOutcome{cap: 1}
            c_copy := a.client.clone_client()
            xu resp_stream_worker(~c_copy, ~req, ech, rch)
            for {
                ev := <-ech
                if ev.text_delta.len > 0 {
                    emit_agent_ev(on_event, AgentEvent{
                        kind: "text_delta", turn: turns, text_delta: ev.text_delta + "",
                        reasoning_delta: "", tool_name: "", arguments_json: "",
                        tool_output: "", is_error: false, finish_reason: ""
                    })
                }
                if ev.done { <- }
            }
            outc := <-rch
            if !outc.ok { >>> errors.new(outc.err_msg) }
            resp = ~outc.resp
        } else {
            resp = a.client.responses(&req) >>>
        }
        if resp.id.len > 0 { *prev_id_ref = resp.id + "" }
        pt += resp.usage.prompt_tokens
        ct += resp.usage.completion_tokens
        tt += resp.usage.total_tokens
        if a.max_total_tokens > 0 && ((pt + ct) > a.max_total_tokens || tt > a.max_total_tokens) {
            >>> errors.new("agent: token budget exceeded")
        }
        last_content = resp.output_text + ""
        last_status = resp.status + ""
        if resp.tool_calls.len == 0 {
            if use_stream {
                emit_agent_ev(on_event, AgentEvent{
                    kind: "turn_end", turn: turns, text_delta: "", reasoning_delta: "",
                    tool_name: "", arguments_json: "", tool_output: "", is_error: false,
                    finish_reason: last_status + ""
                })
                emit_agent_ev(on_event, AgentEvent{
                    kind: "done", turn: turns, text_delta: last_content + "", reasoning_delta: "",
                    tool_name: "", arguments_json: "", tool_output: "", is_error: false,
                    finish_reason: last_status + ""
                })
            }
            << RunResult{
                content: last_content, reasoning_content: "", steps: ~steps, turns: turns,
                prompt_tokens: pt, completion_tokens: ct, total_tokens: tt, finish_reason: last_status
            }
        }
        $specs := []ToolExecSpec{}
        for ti in 0:resp.tool_calls.len {
            tc := &resp.tool_calls[ti]
            specs.push(ToolExecSpec{name: tc.name + "", arguments: tc.arguments + ""})
            if use_stream {
                emit_agent_ev(on_event, AgentEvent{
                    kind: "tool_start", turn: turns, text_delta: "", reasoning_delta: "",
                    tool_name: tc.name + "", arguments_json: tc.arguments + "",
                    tool_output: "", is_error: false, finish_reason: ""
                })
            }
        }
        results := execute_tools_batch(&a.local_tools, &specs, a.parallel_tools, use_http_mcp, http_mc, use_stdio_mcp, stdio_mc, a.tool_hook)
        $out_items := []string{}
        for ti in 0:resp.tool_calls.len {
            tc := &resp.tool_calls[ti]
            res := &results[ti]
            steps.push(Step{
                turn: turns, tool_name: tc.name + "", arguments_json: tc.arguments + "",
                output: res.output + "", is_error: res.is_error
            })
            if use_stream {
                emit_agent_ev(on_event, AgentEvent{
                    kind: "tool_end", turn: turns, text_delta: "", reasoning_delta: "",
                    tool_name: tc.name + "", arguments_json: tc.arguments + "",
                    tool_output: res.output + "", is_error: res.is_error, finish_reason: ""
                })
            }
            $cid := tc.call_id + ""
            if cid.len == 0 { cid = tc.id + "" }
            out_items.push(openai.responses_function_call_output_item(cid, res.output + ""))
        }
        cur_input = ""
        cur_input_json = openai.responses_input_array(&out_items)
        if use_stream {
            emit_agent_ev(on_event, AgentEvent{
                kind: "turn_end", turn: turns, text_delta: "", reasoning_delta: "",
                tool_name: "", arguments_json: "", tool_output: "", is_error: false,
                finish_reason: last_status + ""
            })
        }
    }
    if use_stream {
        emit_agent_ev(on_event, AgentEvent{
            kind: "done", turn: turns, text_delta: last_content + "", reasoning_delta: "",
            tool_name: "", arguments_json: "", tool_output: "", is_error: false,
            finish_reason: last_status + ""
        })
    }
    << RunResult{
        content: last_content, reasoning_content: "", steps: ~steps, turns: turns,
        prompt_tokens: pt, completion_tokens: ct, total_tokens: tt, finish_reason: last_status
    }
}

pub fn (a &ResponsesAgent) run(user_prompt string) RunResult {
    $pid := ""
    $dummy_http := mcp.new_http_client("http://127.0.0.1:0")
    $dummy_stdio := mcp.closed_stdio_client()
    << run_resp_loop_impl(a, $&pid, user_prompt, false, $&dummy_http, false, $&dummy_stdio, false, ignore_agent_ev) >>>
}

