pub struct GeminiSession {
    pub agent GeminiAgent
    messages []gemini.Content
}

pub fn new_gemini_session(agent GeminiAgent) GeminiSession {
    << GeminiSession{agent: agent, messages: []gemini.Content{}}
}

pub fn (s $&GeminiSession) clear() {
    s.messages = []gemini.Content{}
}

pub fn (s &GeminiSession) history() []gemini.Content {
    << copy_gem_contents(&s.messages)
}

pub fn (s $&GeminiSession) send(user_prompt string) RunResult {
    $dummy_http := mcp.new_http_client("http://127.0.0.1:0")
    $dummy_stdio := mcp.closed_stdio_client()
    msgs_ref := $&s.messages
    msgs_ref.push(gemini.user_text(user_prompt))
    << run_gem_loop_history_impl(&s.agent, msgs_ref, false, $&dummy_http, false, $&dummy_stdio, false, ignore_agent_ev) >>>
}

