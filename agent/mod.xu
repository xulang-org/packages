fn mini_int(a int, b int) int {
    if a < b { << a }
    << b
}

fn agent_ascii_lower(s &string) string {
    $out := ""
    for i in 0:s.len {
        ch := (*s)[i] & 255
        if ch >= 65 && ch <= 90 { out.push_str(string_from_byte(ch + 32)) }
        else { out.push_str(string_from_byte(ch)) }
    }
    << out
}

pub fn parse_skill_markdown(raw &string, path string) Skill {
    $name := ""
    $desc := ""
    $body := (*raw) + ""
    $trimmed := strings.trim_space(raw)
    if strings.has_prefix(&trimmed, "---") {
        // Parse YAML frontmatter between first '---' line and closing '---' line
        $start_body := -1
        $pos := 3
        while pos < trimmed.len && (trimmed[pos] & 255) != 10 { pos += 1 }
        if pos < trimmed.len { pos += 1 }
        while pos < trimmed.len {
            $lend := pos
            while lend < trimmed.len && (trimmed[lend] & 255) != 10 { lend += 1 }
            $line := trimmed[pos:lend]
            if line.len > 0 && (line[line.len - 1] & 255) == 13 { line = line[0:line.len - 1] }
            tline := strings.trim_space(&line)
            if tline == "---" {
                start_body = lend + 1
                <-
            }
            if strings.has_prefix(&tline, "name:") {
                $v := strings.trim_space(&tline[5:tline.len])
                if v.len >= 2 && ((v[0] & 255) == 34 || (v[0] & 255) == 39) { v = v[1:v.len - 1] }
                name = v
            } else if strings.has_prefix(&tline, "description:") {
                $v := strings.trim_space(&tline[12:tline.len])
                if v.len >= 2 && ((v[0] & 255) == 34 || (v[0] & 255) == 39) { v = v[1:v.len - 1] }
                desc = v
            }
            pos = lend + 1
        }
        if start_body >= 0 && start_body <= trimmed.len {
            body = strings.trim_space(&trimmed[start_body:trimmed.len])
        }
    }
    if name.len == 0 { name = path + "" }
    << Skill{name: name, description: desc, body: body, path: path}
}

pub fn load_skill_file(path string) Skill {
    raw := os.read(path + "") >>>
    << parse_skill_markdown(&raw, path + "")
}

pub fn format_skills_prompt(skills &[]Skill, user_prompt &string) string {
    if skills.len == 0 { << "" }
    lp := agent_ascii_lower(user_prompt)
    $out := ""
    for i in 0:skills.len {
        sk := &skills[i]
        lname := agent_ascii_lower(&sk.name)
        ldesc := agent_ascii_lower(&sk.description)
        $matched := strings.contains(&lp, lname)
        if !matched && ldesc.len > 0 {
            // Check if any >=4-char keyword in description appears in prompt
            $start := -1
            for k in 0:(ldesc.len + 1) {
                $ok := false
                if k < ldesc.len {
                    ch := ldesc[k] & 255
                    ok = (ch >= 97 && ch <= 122) || (ch >= 48 && ch <= 57) || ch >= 128
                }
                if ok {
                    if start < 0 { start = k }
                } else if start >= 0 {
                    if k - start >= 4 {
                        kw := ldesc[start:k]
                        if strings.contains(&lp, kw) {
                            matched = true
                            <-
                        }
                    }
                    start = -1
                }
            }
        }
        if matched || user_prompt.len == 0 {
            if out.len > 0 { out = out + "\n\n" }
            out = out + "<skill name=" + json.quote(&sk.name) + ">\n" + sk.body + "\n</skill>"
        }
    }
    << out
}

pub fn format_skills_catalog(skills &[]Skill) string {
    if skills.len == 0 { << "" }
    $out := "<available_skills>\nTo load full instructions for a skill, call tool `load_skill` with {\"name\":\"<skill_name>\"}."
    for i in 0:skills.len {
        sk := &skills[i]
        out = out + "\n- " + sk.name + ": " + sk.description
    }
    out = out + "\n</available_skills>"
    << out
}

pub fn lookup_skill_body(skills &[]Skill, name &string) string {
    for i in 0:skills.len {
        if skills[i].name == *name {
            sk := &skills[i]
            << "<skill name=" + json.quote(&sk.name) + ">\n" + sk.body + "\n</skill>"
        }
    }
    low_t := agent_ascii_lower(name)
    for i in 0:skills.len {
        if agent_ascii_lower(&skills[i].name) == low_t {
            sk := &skills[i]
            << "<skill name=" + json.quote(&sk.name) + ">\n" + sk.body + "\n</skill>"
        }
    }
    << ""
}

pub fn new_memory(dim int) AgentMemory {
    << AgentMemory{store: rag.new_store(dim), next_id: 1}
}

pub fn (m $&AgentMemory) remember(text string, tag string, embedding &[]f64) string {
    id := "mem_" + str(m.next_id)
    m.next_id += 1
    meta := "{\"tag\":" + json.quote(&tag) + "}"
    st := $&m.store
    _ := st.add_chunk(id + "", "memory", text, tag, meta, embedding) >>>
    << id
}

pub fn (m &AgentMemory) recall(query string, query_emb &[]f64, top_k int) []rag.SearchHit {
    << m.store.search_hybrid(query, query_emb, top_k, 60)
}

pub fn (m &AgentMemory) format_memories(hits &[]rag.SearchHit) string {
    << rag.format_context(hits)
}

pub fn (m $&AgentMemory) forget(id string) bool {
    $kept := []rag.Chunk{}
    $removed := 0
    for i in 0:m.store.chunks.len {
        c := &m.store.chunks[i]
        if c.id == id {
            removed += 1
        } else {
            $emb := []f32{}
            emb.reserve(c.embedding.len)
            for j in 0:c.embedding.len { emb.push(c.embedding[j]) }
            kept.push(rag.Chunk{
                id: c.id + "",
                doc_id: c.doc_id + "",
                text: c.text + "",
                source: c.source + "",
                metadata_json: c.metadata_json + "",
                embedding: ~emb
            })
        }
    }
    m.store.chunks = ~kept
    << removed > 0
}

pub fn (m $&AgentMemory) update(id string, text string, tag string, embedding &[]f64) bool {
    if embedding.len != m.store.dim {
        >> errors.new("agent: memory embedding dimension mismatch")
    }
    for i in 0:m.store.chunks.len {
        if m.store.chunks[i].id == id {
            $emb := []f32{}
            emb.reserve(m.store.dim)
            for j in 0:m.store.dim { emb.push(f32(embedding[j])) }
            m.store.chunks[i].text = text + ""
            m.store.chunks[i].source = tag + ""
            m.store.chunks[i].metadata_json = "{\"tag\":" + json.quote(&tag) + "}"
            m.store.chunks[i].embedding = ~emb
            << true
        }
    }
    << false
}

pub fn (m &AgentMemory) save_json(path string) int {
    << m.store.save_json(path) >>>
}

pub fn load_memory_json(path string) AgentMemory {
    st := rag.load_json(path) >>>
    n := st.len() + 1
    << AgentMemory{store: ~st, next_id: n}
}

fn ag_strip_cell(cell &string) string {
    if cell.len >= 2 && (*cell)[1] == 58 {
        if (*cell)[0] == 110 { << "" }
        << (*cell)[2:cell.len]
    }
    << (*cell) + ""
}

fn ag_open_sqlite_wal(path &string) driver.Conn {
    conn := sqlite.open((*path) + "")
    _ := conn.exec("PRAGMA journal_mode=WAL", []driver.NamedValue{})
    << conn
}

pub fn (m &AgentMemory) save_sqlite(path string) int {
    conn := ag_open_sqlite_wal(&path)
    r1 := conn.exec("CREATE TABLE IF NOT EXISTS agent_memory (id TEXT PRIMARY KEY, doc_id TEXT NOT NULL, text TEXT NOT NULL, source TEXT NOT NULL, metadata TEXT NOT NULL, embedding TEXT NOT NULL)", []driver.NamedValue{})
    if r1.err.len > 0 {
        _ := conn.close()
        >> errors.new("agent: memory sqlite init failed: " + r1.err)
    }
    r2 := conn.exec("CREATE TABLE IF NOT EXISTS agent_memory_meta (k TEXT PRIMARY KEY, v TEXT NOT NULL)", []driver.NamedValue{})
    if r2.err.len > 0 {
        _ := conn.close()
        >> errors.new("agent: memory sqlite meta init failed: " + r2.err)
    }
    tx := conn.begin()
    _ := conn.exec("DELETE FROM agent_memory", []driver.NamedValue{})
    for i in 0:m.store.chunks.len {
        c := &m.store.chunks[i]
        vec_lit := postgres.vector_encode(&c.embedding)
        $meta := c.metadata_json + ""
        if meta.len == 0 { meta = "{}" }
        args := [driver.NamedValue{name: "", ordinal: 1, value: c.id + ""}, driver.NamedValue{name: "", ordinal: 2, value: c.doc_id + ""}, driver.NamedValue{name: "", ordinal: 3, value: c.text + ""}, driver.NamedValue{name: "", ordinal: 4, value: c.source + ""}, driver.NamedValue{name: "", ordinal: 5, value: meta}, driver.NamedValue{name: "", ordinal: 6, value: vec_lit}]
        ri := conn.exec("INSERT OR REPLACE INTO agent_memory (id, doc_id, text, source, metadata, embedding) VALUES (?, ?, ?, ?, ?, ?)", args)
        if ri.err.len > 0 {
            _ := tx.rollback()
            _ := conn.close()
            >> errors.new("agent: memory sqlite insert failed: " + ri.err)
        }
    }
    _ := conn.exec("INSERT OR REPLACE INTO agent_memory_meta (k, v) VALUES ('dim', ?)", [driver.NamedValue{name: "", ordinal: 1, value: str(m.store.dim)}])
    _ := conn.exec("INSERT OR REPLACE INTO agent_memory_meta (k, v) VALUES ('next_id', ?)", [driver.NamedValue{name: "", ordinal: 1, value: str(m.next_id)}])
    ce := tx.commit()
    _ := conn.close()
    if ce.len > 0 { >> errors.new("agent: memory sqlite commit failed: " + ce) }
    << m.store.chunks.len
}

fn ag_parse_int_or(s &string, def int) int {
    << strconv.atoi(s) >>> (_) { << def }
}

pub fn load_memory_sqlite(path string) AgentMemory {
    conn := ag_open_sqlite_wal(&path)
    rdim := conn.query("SELECT k, v FROM agent_memory_meta", []driver.NamedValue{})
    if rdim.err.len > 0 {
        _ := conn.close()
        >> errors.new("agent: memory sqlite load meta failed: " + rdim.err)
    }
    $dim := 0
    $nid := 1
    if rdim.ncols >= 2 {
        nmeta := rdim.cells.len / rdim.ncols
        for i in 0:nmeta {
            kidx := i * rdim.ncols
            vidx := kidx + 1
            k := ag_strip_cell(&rdim.cells[kidx])
            v := ag_strip_cell(&rdim.cells[vidx])
            if k == "dim" { dim = ag_parse_int_or(&v, 0) }
            else if k == "next_id" { nid = ag_parse_int_or(&v, 1) }
        }
    }
    $st := rag.new_store(dim)
    rows := conn.query("SELECT id, doc_id, text, source, metadata, embedding FROM agent_memory", []driver.NamedValue{})
    if rows.err.len > 0 {
        _ := conn.close()
        >> errors.new("agent: memory sqlite load chunks failed: " + rows.err)
    }
    if rows.ncols >= 6 {
        nrows := rows.cells.len / rows.ncols
        for ri in 0:nrows {
            base := ri * rows.ncols
            i1 := base + 1
            i2 := base + 2
            i3 := base + 3
            i4 := base + 4
            i5 := base + 5
            cid := ag_strip_cell(&rows.cells[base])
            did := ag_strip_cell(&rows.cells[i1])
            txt := ag_strip_cell(&rows.cells[i2])
            src := ag_strip_cell(&rows.cells[i3])
            $meta := ag_strip_cell(&rows.cells[i4])
            if meta.len == 0 { meta = "{}" }
            vec_lit := ag_strip_cell(&rows.cells[i5])
            vec32 := postgres.vector_decode(&vec_lit) >>>
            if st.dim == 0 && vec32.len > 0 { st.dim = vec32.len }
            $vec64 := []f64{}
            for vi in 0:vec32.len { vec64.push(f64(vec32[vi])) }
            _ := st.add_chunk(cid, did, txt, src, meta, &vec64) >>>
        }
    }
    _ := conn.close()
    if nid <= st.len() { nid = st.len() + 1 }
    << AgentMemory{store: ~st, next_id: nid}
}

pub fn estimate_tokens(text &string) int {
    if text.len == 0 { << 0 }
    $ascii := 0
    $cjk := 0
    $other := 0
    $i := 0
    while i < text.len {
        b := (*text)[i] & 255
        if b < 128 {
            ascii += 1
            i += 1
        } else if b >= 224 && b <= 239 {
            cjk += 1
            i += 3
        } else if b >= 240 {
            other += 1
            i += 4
        } else if b >= 192 {
            other += 1
            i += 2
        } else {
            i += 1
        }
    }
    $toks := (ascii + 3) / 4 + (cjk * 2 + 2) / 3 + (other + 1) / 2
    if toks <= 0 { toks = 1 }
    << toks
}

pub fn compact_messages_with(messages &[]openai.Message, max_tokens int, keep_recent int, counter fn(&string) int) []openai.Message {
    if max_tokens <= 0 || messages.len == 0 { << copy_messages(messages) }
    $kr := keep_recent
    if kr < 1 { kr = 1 }
    $total := 0
    for i in 0:messages.len {
        total += counter(&messages[i].content) + 4
    }
    if total <= max_tokens || messages.len <= kr + 1 {
        << copy_messages(messages)
    }
    $keep := []bool{}
    for _ in 0:messages.len { keep.push(false) }
    $sys_idx := -1
    if messages[0].role == "system" {
        keep[0] = true
        sys_idx = 0
    }
    $tail_kept := 0
    $bi := messages.len - 1
    while bi >= 0 && tail_kept < kr {
        if bi != sys_idx {
            keep[bi] = true
            tail_kept += 1
        }
        bi -= 1
    }
    $out := []openai.Message{}
    for i in 0:messages.len {
        if keep[i] {
            m := &messages[i]
            out.push(openai.Message{
                role: m.role + "",
                content: m.content + "",
                parts: copy_parts(&m.parts),
                tool_call_id: m.tool_call_id + "",
                tool_calls: copy_tool_calls(&m.tool_calls)
            })
        }
    }
    // Trim remaining non-system older tail items if still over max_tokens
    $cur_toks := 0
    for i in 0:out.len { cur_toks += counter(&out[i].content) + 4 }
    while cur_toks > max_tokens && out.len > 2 {
        $drop_i := 0
        if out[0].role == "system" { drop_i = 1 }
        cur_toks -= counter(&out[drop_i].content) + 4
        $next_out := []openai.Message{}
        for j in 0:out.len {
            if j != drop_i { next_out.push(copy_message(&out[j])) }
        }
        out = ~next_out
    }
    << out
}

pub fn compact_messages(messages &[]openai.Message, max_tokens int, keep_recent int) []openai.Message {
    << compact_messages_with(messages, max_tokens, keep_recent, estimate_tokens)
}

pub fn summarize_messages_openai(client &openai.Client, model string,
                                     messages &[]openai.Message, keep_recent int) []openai.Message {
    $kr := keep_recent
    if kr < 1 { kr = 1 }
    if messages.len == 0 { << []openai.Message{} }
    $start_mid := 0
    $has_sys := messages[0].role == "system"
    if has_sys { start_mid = 1 }
    tail_start := messages.len - kr
    if tail_start <= start_mid {
        << copy_messages(messages)
    }
    $transcript := ""
    for i in start_mid:tail_start {
        m := &messages[i]
        if transcript.len > 0 { transcript = transcript + "\n" }
        transcript = transcript + m.role + ": " + m.content
    }
    sys_msg := "Summarize the conversation history concisely while preserving all key facts, decisions, entities, and constraints."
    req := openai.chat_request(model + "", [openai.message("system", sys_msg), openai.message("user", transcript)])
    resp := client.chat(&req) >>>
    summary := strings.trim_space(&resp.content)
    $out := []openai.Message{}
    if has_sys {
        out.push(copy_message(&messages[0]))
    }
    out.push(openai.message("system", "Conversation summary:\n" + summary))
    for i in tail_start:messages.len {
        out.push(copy_message(&messages[i]))
    }
    << out
}

pub fn format_trace_jsonl(spans &[]TraceSpan) string {
    $out := ""
    for i in 0:spans.len {
        sp := &spans[i]
        out = out + "{\"trace_id\":" + json.quote(&sp.trace_id) +
              ",\"kind\":" + json.quote(&sp.kind) +
              ",\"name\":" + json.quote(&sp.name) +
              ",\"turn\":" + str(sp.turn) +
              ",\"duration_ms\":" + str(sp.duration_ms) +
              ",\"tokens\":" + str(sp.tokens) +
              ",\"is_error\":"
        if sp.is_error { out = out + "true" } else { out = out + "false" }
        out = out + ",\"detail\":" + json.quote(&sp.detail) + "}\n"
    }
    << out
}

pub fn run_sequential_workflow(agents &[]Agent, names &[]string, initial_prompt string) []WorkflowStepResult {
    $out := []WorkflowStepResult{}
    $cur_inp := initial_prompt + ""
    for i in 0:agents.len {
        res := agents[i].run(cur_inp + "") >>>
        $aname := "step_" + str(i)
        if i < names.len && names[i].len > 0 { aname = names[i] + "" }
        cur_inp = res.content + ""
        out.push(WorkflowStepResult{agent_name: aname, result: ~res})
    }
    << out
}

pub fn run_router_workflow(router &Agent, specialists &[]Agent, specialist_names &[]string,
                           user_prompt string) WorkflowStepResult {
    if specialists.len == 0 {
        >> errors.new("agent: router workflow needs at least one specialist")
    }
    $route_prompt := "Route this request to exactly one specialist name ("
    for i in 0:specialist_names.len {
        if i > 0 { route_prompt = route_prompt + ", " }
        route_prompt = route_prompt + specialist_names[i]
    }
    route_prompt = route_prompt + "):\n" + user_prompt
    decision := router.run(route_prompt) >>>
    ldec := agent_ascii_lower(&decision.content)
    $picked := 0
    for i in 0:specialist_names.len {
        if i < specialists.len {
            ln := agent_ascii_lower(&specialist_names[i])
            if ln.len > 0 && strings.contains(&ldec, ln) {
                picked = i
                <-
            }
        }
    }
    res := specialists[picked].run(user_prompt + "") >>>
    $pname := "specialist_" + str(picked)
    if picked < specialist_names.len && specialist_names[picked].len > 0 {
        pname = specialist_names[picked] + ""
    }
    << WorkflowStepResult{agent_name: pname, result: ~res}
}

fn ck_str_or(doc &json.Doc, obj int, key string, def string) string {
    if !doc.is_dict(obj) || !doc.has(obj, key) { << def }
    n := doc.get(obj, key) >>> (_) { << def }
    if doc.is_string(n) {
        << doc.as_string(n) >>> (_) { << def }
    }
    << def
}

fn session_to_checkpoint_json(s &Session) string {
    $out := "{\"version\":1,\"messages\":["
    for i in 0:s.messages.len {
        if i > 0 { out = out + "," }
        m := &s.messages[i]
        out = out + "{\"role\":" + json.quote(&m.role) +
              ",\"content\":" + json.quote(&m.content) +
              ",\"tool_call_id\":" + json.quote(&m.tool_call_id) +
              ",\"tool_calls\":["
        for j in 0:m.tool_calls.len {
            if j > 0 { out = out + "," }
            tc := &m.tool_calls[j]
            out = out + "{\"id\":" + json.quote(&tc.id) +
                  ",\"kind\":" + json.quote(&tc.kind) +
                  ",\"name\":" + json.quote(&tc.name) +
                  ",\"arguments\":" + json.quote(&tc.arguments) + "}"
        }
        out = out + "]}"
    }
    out = out + "]}"
    << out
}

fn parse_session_checkpoint_str(agent Agent, raw &string) Session {
    doc := json.parse(raw)
    if !doc.ok() || !doc.is_dict(doc.root()) {
        >> errors.new("agent: invalid session checkpoint JSON")
    }
    root := doc.root()
    if !doc.has(root, "messages") {
        >> errors.new("agent: session checkpoint missing messages")
    }
    arr := doc.get(root, "messages") >>>
    if !doc.is_list(arr) {
        >> errors.new("agent: session checkpoint messages is not a list")
    }
    $msgs := []openai.Message{}
    cnt := doc.count(arr)
    for i in 0:cnt {
        mnode := doc.at(arr, i) >>>
        if doc.is_dict(mnode) {
            role := ck_str_or(&doc, mnode, "role", "user")
            content := ck_str_or(&doc, mnode, "content", "")
            tc_id := ck_str_or(&doc, mnode, "tool_call_id", "")
            $tcs := []openai.ToolCall{}
            if doc.has(mnode, "tool_calls") {
                tarr := doc.get(mnode, "tool_calls") >>>
                if doc.is_list(tarr) {
                    tcnt := doc.count(tarr)
                    for j in 0:tcnt {
                        tn := doc.at(tarr, j) >>>
                        if doc.is_dict(tn) {
                            tcs.push(openai.ToolCall{
                                id: ck_str_or(&doc, tn, "id", ""),
                                kind: ck_str_or(&doc, tn, "kind", "function"),
                                name: ck_str_or(&doc, tn, "name", ""),
                                arguments: ck_str_or(&doc, tn, "arguments", "{}")
                            })
                        }
                    }
                }
            }
            msgs.push(openai.Message{
                role: role,
                content: content,
                parts: []openai.ContentPart{},
                tool_call_id: tc_id,
                tool_calls: ~tcs
            })
        }
    }
    << Session{agent: agent, messages: ~msgs}
}

pub fn (s &Session) save_checkpoint_json(path string) int {
    out := session_to_checkpoint_json(s)
    _ := os.write(path, out) >>>
    << s.messages.len
}

pub fn load_session_checkpoint(agent Agent, path string) Session {
    raw := os.read(path) >>>
    << parse_session_checkpoint_str(agent, &raw) >>>
}

pub fn (s &Session) save_checkpoint_sqlite(path string, session_id string) int {
    $sid := session_id + ""
    if sid.len == 0 { sid = "default" }
    out := session_to_checkpoint_json(s)
    conn := ag_open_sqlite_wal(&path)
    r1 := conn.exec("CREATE TABLE IF NOT EXISTS agent_sessions (session_id TEXT PRIMARY KEY, payload_json TEXT NOT NULL, updated_at INTEGER NOT NULL)", []driver.NamedValue{})
    if r1.err.len > 0 {
        _ := conn.close()
        >> errors.new("agent: session sqlite init failed: " + r1.err)
    }
    tx := conn.begin()
    args := [driver.NamedValue{name: "", ordinal: 1, value: sid}, driver.NamedValue{name: "", ordinal: 2, value: out}, driver.NamedValue{name: "", ordinal: 3, value: time.now()}]
    ri := conn.exec("INSERT OR REPLACE INTO agent_sessions (session_id, payload_json, updated_at) VALUES (?, ?, ?)", args)
    if ri.err.len > 0 {
        _ := tx.rollback()
        _ := conn.close()
        >> errors.new("agent: session sqlite save failed: " + ri.err)
    }
    ce := tx.commit()
    _ := conn.close()
    if ce.len > 0 { >> errors.new("agent: session sqlite commit failed: " + ce) }
    << s.messages.len
}

pub fn load_session_checkpoint_sqlite(agent Agent, path string, session_id string) Session {
    $sid := session_id + ""
    if sid.len == 0 { sid = "default" }
    conn := ag_open_sqlite_wal(&path)
    rows := conn.query("SELECT payload_json FROM agent_sessions WHERE session_id = ?", [driver.NamedValue{name: "", ordinal: 1, value: sid + ""}])
    _ := conn.close()
    if rows.err.len > 0 { >> errors.new("agent: session sqlite load failed: " + rows.err) }
    if rows.cells.len == 0 { >> errors.new("agent: session checkpoint not found in sqlite: " + sid) }
    raw := ag_strip_cell(&rows.cells[0])
    << parse_session_checkpoint_str(agent, &raw) >>>
}

fn clone_agent_for_worker(src &Agent) Agent {
    $tools := []LocalTool{}
    for i in 0:src.local_tools.len {
        lt := &src.local_tools[i]
        tools.push(LocalTool{
            name: lt.name + "",
            description: lt.description + "",
            parameters_json: lt.parameters_json + "",
            handler: lt.handler
        })
    }
    $skills := []Skill{}
    for i in 0:src.skills.len {
        sk := &src.skills[i]
        skills.push(Skill{
            name: sk.name + "",
            description: sk.description + "",
            body: sk.body + "",
            path: sk.path + ""
        })
    }
    $terms := []string{}
    for i in 0:src.guard_policy.blocked_terms.len {
        terms.push(src.guard_policy.blocked_terms[i] + "")
    }
    pol := guardrails.Policy{
        block_injection: src.guard_policy.block_injection,
        block_secrets: src.guard_policy.block_secrets,
        redact_pii: src.guard_policy.redact_pii,
        blocked_terms: ~terms,
        strict_mode: src.guard_policy.strict_mode
    }
    << Agent{
        client: clone_openai_client(&src.client),
        model: src.model + "",
        system_prompt: src.system_prompt + "",
        max_turns: src.max_turns,
        temperature: src.temperature,
        has_temperature: src.has_temperature,
        max_tokens: src.max_tokens,
        max_total_tokens: src.max_total_tokens,
        tool_choice: src.tool_choice + "",
        response_format_json: src.response_format_json + "",
        parallel_tools: src.parallel_tools,
        context_max_tokens: src.context_max_tokens,
        max_tool_output_chars: src.max_tool_output_chars,
        progressive_skills: src.progressive_skills,
        local_tools: tools,
        skills: skills,
        tool_hook: src.tool_hook,
        guard_policy: pol,
        has_guardrails: src.has_guardrails,
        trace_hook: src.trace_hook,
        has_trace_hook: src.has_trace_hook,
        approval_hook: src.approval_hook,
        has_approval_hook: src.has_approval_hook,
        token_counter: src.token_counter
    }
}

struct ParallelOutcome {
    idx int
    name string
    result RunResult
    err_msg string
}

fn empty_run_result() RunResult {
    << RunResult{
        content: "",
        reasoning_content: "",
        steps: []Step{},
        turns: 0,
        prompt_tokens: 0,
        completion_tokens: 0,
        total_tokens: 0,
        finish_reason: "error"
    }
}

fn run_parallel_worker(idx int, name string, ag Agent, prompt_text string, ch chan ParallelOutcome) {
    res := ag.run(prompt_text) >>> (err) {
        ch <- ParallelOutcome{idx: idx, name: name, result: empty_run_result(), err_msg: err.msg()}
        <<
    }
    ch <- ParallelOutcome{idx: idx, name: name, result: ~res, err_msg: ""}
}

pub fn run_parallel_workflow(agents &[]Agent, names &[]string, prompts &[]string) []WorkflowStepResult {
    n := agents.len
    if n == 0 { << []WorkflowStepResult{} }
    ch := chan ParallelOutcome{cap: n}
    $out := []WorkflowStepResult{}
    for i in 0:n {
        $aname := "worker_" + str(i)
        if i < names.len && names[i].len > 0 { aname = names[i] + "" }
        $pr := ""
        if i < prompts.len {
            pr = prompts[i] + ""
        } else if prompts.len > 0 {
            pr = prompts[0] + ""
        }
        out.push(WorkflowStepResult{agent_name: aname + "", result: empty_run_result()})
        ag_copy := clone_agent_for_worker(&agents[i])
        xu run_parallel_worker(i, aname, ag_copy, pr, ch)
    }
    $first_err := ""
    for _ in 0:n {
        item := <-ch
        if item.err_msg.len > 0 && first_err.len == 0 {
            first_err = item.err_msg
        }
        if item.idx >= 0 && item.idx < out.len {
            out[item.idx] = WorkflowStepResult{agent_name: item.name, result: ~item.result}
        }
    }
    if first_err.len > 0 {
        >> errors.new(first_err)
    }
    << out
}

pub struct EvalOptResult {
    pub content string
    pub passed bool
    pub rounds int
    pub last_feedback string
    pub history []WorkflowStepResult
}

pub fn run_evaluator_optimizer(generator &Agent, evaluator &Agent, task string,
                                   max_rounds int, pass_marker string) EvalOptResult {
    $limit := max_rounds
    if limit <= 0 { limit = 3 }
    $marker := pass_marker + ""
    if marker.len == 0 { marker = "PASS" }
    low_marker := agent_ascii_lower(&marker)

    $hist := []WorkflowStepResult{}
    $cur_task := task + ""
    $best := ""
    $last_fb := ""
    $passed := false
    $rounds := 0

    for r in 0:limit {
        rounds = r + 1
        gres := generator.run(cur_task + "") >>>
        best = gres.content + ""
        hist.push(WorkflowStepResult{agent_name: "generator", result: ~gres})

        ep := "Task:\n" + task + "\n\nCandidate Output:\n" + best +
              "\n\nIf completely satisfactory, include '" + marker + "'; otherwise provide specific improvements."
        eres := evaluator.run(ep) >>>
        last_fb = eres.content + ""
        low_fb := agent_ascii_lower(&last_fb)
        hist.push(WorkflowStepResult{agent_name: "evaluator", result: ~eres})

        if strings.contains(&low_fb, low_marker) {
            passed = true
            <-
        }
        cur_task = task + "\n\nPrevious Draft:\n" + best + "\n\nReviewer Feedback:\n" + last_fb +
                   "\n\nRevise the draft to address every point."
    }

    << EvalOptResult{
        content: best,
        passed: passed,
        rounds: rounds,
        last_feedback: last_fb,
        history: ~hist
    }
}

fn safe_extract_json(s &string) string {
    << prompt.extract_json_block(s) >>> (_) { << (*s) + "" }
}

pub fn (a &Agent) run_json_checked(user_prompt string, required_keys &[]string, max_retries int) RunResult {
    $retries := max_retries
    if retries < 0 { retries = 0 }
    $cur_prompt := user_prompt + ""
    $last_err := "invalid JSON"

    for attempt in 0:(retries + 1) {
        $res := a.run(cur_prompt + "") >>>
        raw_json := safe_extract_json(&res.content)
        doc := json.parse(&raw_json)
        $valid := doc.ok() && doc.is_dict(doc.root())
        $missing := ""
        if valid {
            root := doc.root()
            for ki in 0:required_keys.len {
                k := required_keys[ki] + ""
                if !doc.has(root, k + "") {
                    valid = false
                    if missing.len > 0 { missing = missing + ", " }
                    missing = missing + k
                }
            }
            if valid {
                res.content = raw_json + ""
                << res
            } else {
                last_err = "missing required keys: " + missing
            }
        } else {
            last_err = "output is not a valid JSON object"
        }
        cur_prompt = user_prompt + "\n\nPrevious output failed schema check (" + last_err +
                     "). Return ONLY a valid JSON object containing all required keys."
    }
    >> errors.new("agent: run_json_checked failed (" + last_err + ")")
}

fn split_nl_entries(raw &string) []string {
    $out := []string{}
    $start := 0
    for i in 0:(raw.len + 1) {
        $is_end := i == raw.len
        if !is_end {
            ch := (*raw)[i] & 255
            is_end = ch == 10 || ch == 13
        }
        if is_end {
            if i > start {
                raw_item := (*raw)[start:i]
                item := strings.trim_space(&raw_item)
                if item.len > 0 && item != "." && item != ".." {
                    out.push(item)
                }
            }
            start = i + 1
        }
    }
    << out
}

fn str_ascii_lt(a &string, b &string) bool {
    $n := a.len
    if b.len < n { n = b.len }
    for i in 0:n {
        ca := (*a)[i] & 255
        cb := (*b)[i] & 255
        if ca < cb { << true }
        if ca > cb { << false }
    }
    << a.len < b.len
}

fn sort_names_asc(names $&[]string) {
    for i in 0:names.len {
        for j in (i + 1):names.len {
            if str_ascii_lt(&names[j], &names[i]) {
                swp := names[i] + ""
                names[i] = names[j] + ""
                names[j] = swp
            }
        }
    }
}

fn try_load_skill_or_empty(path string) Skill {
    raw := os.read(path + "") >>> (_) {
        << Skill{name: "", description: "", body: "", path: ""}
    }
    << parse_skill_markdown(&raw, path + "")
}

pub fn discover_skills_dir(dir_path string) []Skill {
    $base := dir_path + ""
    while base.len > 1 && (base[base.len - 1] & 255) == 47 {
        base = base[0:base.len - 1]
    }
    listing := os.read_dir(base + "") >>>
    $entries := split_nl_entries(&listing)
    sort_names_asc($&entries)
    $out := []Skill{}
    for i in 0:entries.len {
        ent := entries[i] + ""
        child := base + "/" + ent
        if os.is_dir(child + "") {
            sk := try_load_skill_or_empty(child + "/SKILL.md")
            if sk.name.len > 0 { out.push(~sk) }
        } else if ent == "SKILL.md" || strings.has_suffix(&ent, ".md") {
            sk := load_skill_file(child + "") >>>
            out.push(~sk)
        }
    }
    << out
}

pub fn (a $&Agent) load_skills_dir(dir_path string) int {
    found := discover_skills_dir(dir_path) >>>
    for i in 0:found.len {
        s := &found[i]
        a.skills.push(Skill{
            name: s.name + "",
            description: s.description + "",
            body: s.body + "",
            path: s.path + ""
        })
    }
    << found.len
}

pub struct GraphNode {
    pub name string
    pub handler fn(&string) string
}

pub struct GraphEdge {
    pub from string
    pub to string
}

pub struct GraphCondEdge {
    pub from string
    pub router fn(&string) string
}

pub struct GraphParallelBranch {
    pub name string
    pub handler fn(&string) string
}

pub struct GraphFanOutNode {
    pub name string
    pub branches []GraphParallelBranch
    pub reducer fn(&string, &[]string) string
}

pub struct StateGraph {
    pub entry string
    nodes []GraphNode
    fanout_nodes []GraphFanOutNode
    edges []GraphEdge
    cond_edges []GraphCondEdge
    interrupt_before []string
}

pub struct GraphStep {
    pub step int
    pub node string
    pub input string
    pub output string
}

pub struct GraphRunResult {
    pub final_state string
    pub steps []GraphStep
    pub finished bool
    pub last_node string
    pub interrupted bool
    pub next_node string
}

pub struct GraphCheckpoint {
    pub next_node string
    pub state string
    pub last_node string
    pub steps []GraphStep
}

pub fn new_state_graph(entry string) StateGraph {
    << StateGraph{
        entry: entry,
        nodes: []GraphNode{},
        fanout_nodes: []GraphFanOutNode{},
        edges: []GraphEdge{},
        cond_edges: []GraphCondEdge{},
        interrupt_before: []string{}
    }
}

pub fn (g $&StateGraph) add_interrupt_before(node string) {
    if node.len > 0 { g.interrupt_before.push(node) }
}

pub fn (g $&StateGraph) add_node(name string, handler fn(&string) string) {
    g.nodes.push(GraphNode{name: name, handler: handler})
}

pub fn (g $&StateGraph) add_parallel_node(name string, branch_names []string,
                                          branch_handlers []fn(&string) string,
                                          reducer fn(&string, &[]string) string) {
    $branches := []GraphParallelBranch{}
    for i in 0:branch_handlers.len {
        $bname := "branch_" + str(i)
        if i < branch_names.len && branch_names[i].len > 0 { bname = branch_names[i] + "" }
        branches.push(GraphParallelBranch{name: bname, handler: branch_handlers[i]})
    }
    g.fanout_nodes.push(GraphFanOutNode{name: name, branches: branches, reducer: reducer})
}

pub fn (g $&StateGraph) add_edge(from string, to string) {
    g.edges.push(GraphEdge{from: from, to: to})
}

pub fn (g $&StateGraph) add_conditional_edge(from string, router fn(&string) string) {
    g.cond_edges.push(GraphCondEdge{from: from, router: router})
}

fn find_graph_node_idx(nodes &[]GraphNode, name &string) int {
    for i in 0:nodes.len {
        if nodes[i].name == *name { << i }
    }
    << -1
}

fn find_graph_fanout_idx(nodes &[]GraphFanOutNode, name &string) int {
    for i in 0:nodes.len {
        if nodes[i].name == *name { << i }
    }
    << -1
}

struct GraphBranchOutcome {
    idx int
    name string
    output string
}

fn run_graph_branch_worker(idx int, name string, h fn(&string) string, inp string, ch chan GraphBranchOutcome) {
    $in_s := inp + ""
    out := h(&in_s)
    ch <- GraphBranchOutcome{idx: idx, name: name, output: out}
}

pub fn graph_state_get(state_json &string, key string, def string) string {
    doc := json.parse(state_json)
    if !doc.ok() || !doc.is_dict(doc.root()) { << def }
    << ck_str_or(&doc, doc.root(), key, def)
}

fn ck_get_or(doc &json.Doc, obj int, key string) int {
    << doc.get(obj, key) >>> (_) { << -1 }
}

fn ck_encode_or(doc &json.Doc, n int, def string) string {
    if n < 0 { << def }
    << doc.encode(n) >>> (_) { << def }
}

pub fn graph_state_set(state_json &string, key string, value string) string {
    doc := json.parse(state_json)
    $parts := []string{}
    $replaced := false
    if doc.ok() && doc.is_dict(doc.root()) {
        root := doc.root()
        keys := doc.dict_keys(root)
        for i in 0:keys.len {
            k := keys[i]
            if k == key {
                parts.push(json.quote(&key) + ":" + json.quote(&value))
                replaced = true
            } else {
                kn := ck_get_or(&doc, root, k)
                kenc := ck_encode_or(&doc, kn, "null")
                parts.push(json.quote(&k) + ":" + kenc)
            }
        }
    }
    if !replaced {
        parts.push(json.quote(&key) + ":" + json.quote(&value))
    }
    $out := "{"
    for i in 0:parts.len {
        if i > 0 { out = out + "," }
        out = out + parts[i]
    }
    << out + "}"
}

fn graph_has_interrupt(list &[]string, node &string) bool {
    for i in 0:list.len {
        if list[i] == *node { << true }
    }
    << false
}

fn copy_graph_steps(src &[]GraphStep) []GraphStep {
    $out := []GraphStep{}
    out.reserve(src.len)
    for i in 0:src.len {
        s := &src[i]
        out.push(GraphStep{
            step: s.step,
            node: s.node + "",
            input: s.input + "",
            output: s.output + ""
        })
    }
    << out
}

fn run_graph_from(g &StateGraph, start_node string, initial_state string,
                  prev_steps &[]GraphStep, initial_last_node string,
                  max_steps int, skip_first_interrupt bool) GraphRunResult {
    $limit := max_steps
    if limit <= 0 { limit = 32 }
    $cur := start_node + ""
    $state := initial_state + ""
    $steps := copy_graph_steps(prev_steps)
    $last_node := initial_last_node + ""
    $finished := false

    for s in 0:limit {
        if cur.len == 0 || cur == "END" {
            finished = true
            <-
        }
        if !(skip_first_interrupt && s == 0) && graph_has_interrupt(&g.interrupt_before, &cur) {
            << GraphRunResult{
                final_state: state,
                steps: ~steps,
                finished: false,
                last_node: last_node,
                interrupted: true,
                next_node: cur
            }
        }
        ni := find_graph_node_idx(&g.nodes, &cur)
        inp := state + ""
        $next_state := ""
        if ni >= 0 {
            h := g.nodes[ni].handler
            next_state = h(&inp)
            steps.push(GraphStep{
                step: steps.len + 1,
                node: cur + "",
                input: inp,
                output: next_state + ""
            })
        } else {
            fi := find_graph_fanout_idx(&g.fanout_nodes, &cur)
            if fi < 0 {
                >> errors.new("agent: unknown StateGraph node: " + cur)
            }
            fo := &g.fanout_nodes[fi]
            nb := fo.branches.len
            $branch_outputs := []string{}
            for _ in 0:nb { branch_outputs.push("") }
            if nb > 0 {
                bch := chan GraphBranchOutcome{cap: nb}
                for bi in 0:nb {
                    br := &fo.branches[bi]
                    xu run_graph_branch_worker(bi, br.name + "", br.handler, inp + "", bch)
                }
                for _ in 0:nb {
                    res := <-bch
                    if res.idx >= 0 && res.idx < nb {
                        branch_outputs[res.idx] = res.output + ""
                    }
                }
                for bi in 0:nb {
                    steps.push(GraphStep{
                        step: steps.len + 1,
                        node: cur + "/" + fo.branches[bi].name,
                        input: inp + "",
                        output: branch_outputs[bi] + ""
                    })
                }
            }
            red := fo.reducer
            next_state = red(&inp, &branch_outputs)
            steps.push(GraphStep{
                step: steps.len + 1,
                node: cur + "",
                input: inp,
                output: next_state + ""
            })
        }
        last_node = cur + ""
        state = next_state

        $nxt := ""
        $has_cond := false
        for ci in 0:g.cond_edges.len {
            if g.cond_edges[ci].from == cur {
                rfn := g.cond_edges[ci].router
                nxt = rfn(&state)
                has_cond = true
                <-
            }
        }
        if !has_cond {
            for ei in 0:g.edges.len {
                if g.edges[ei].from == cur {
                    nxt = g.edges[ei].to + ""
                    <-
                }
            }
        }
        cur = nxt
        if cur.len == 0 || cur == "END" {
            finished = true
            <-
        }
    }

    << GraphRunResult{
        final_state: state,
        steps: ~steps,
        finished: finished,
        last_node: last_node,
        interrupted: false,
        next_node: cur
    }
}

pub fn (g &StateGraph) run(initial_state string, max_steps int) GraphRunResult {
    if g.entry.len == 0 {
        >> errors.new("agent: StateGraph entry node is empty")
    }
    empty := []GraphStep{}
    << run_graph_from(g, g.entry + "", initial_state, &empty, "", max_steps, false) >>>
}

pub fn checkpoint_from_result(res &GraphRunResult) GraphCheckpoint {
    << GraphCheckpoint{
        next_node: res.next_node + "",
        state: res.final_state + "",
        last_node: res.last_node + "",
        steps: copy_graph_steps(&res.steps)
    }
}

fn graph_checkpoint_to_json(ckpt &GraphCheckpoint) string {
    $out := "{\"version\":1,\"next_node\":" + json.quote(&ckpt.next_node) +
            ",\"state\":" + json.quote(&ckpt.state) +
            ",\"last_node\":" + json.quote(&ckpt.last_node) +
            ",\"steps\":["
    for i in 0:ckpt.steps.len {
        if i > 0 { out = out + "," }
        st := &ckpt.steps[i]
        out = out + "{\"step\":" + str(st.step) +
              ",\"node\":" + json.quote(&st.node) +
              ",\"input\":" + json.quote(&st.input) +
              ",\"output\":" + json.quote(&st.output) + "}"
    }
    out = out + "]}"
    << out
}

fn parse_graph_checkpoint_str(raw &string) GraphCheckpoint {
    doc := json.parse(raw)
    if !doc.ok() || !doc.is_dict(doc.root()) {
        >> errors.new("agent: invalid StateGraph checkpoint JSON")
    }
    root := doc.root()
    $steps := []GraphStep{}
    if doc.has(root, "steps") {
        arr := doc.get(root, "steps") >>>
        if doc.is_list(arr) {
            cnt := doc.count(arr)
            for i in 0:cnt {
                item := doc.at(arr, i) >>>
                if doc.is_dict(item) {
                    steps.push(GraphStep{
                        step: ck_int_or(&doc, item, "step", i + 1),
                        node: ck_str_or(&doc, item, "node", ""),
                        input: ck_str_or(&doc, item, "input", ""),
                        output: ck_str_or(&doc, item, "output", "")
                    })
                }
            }
        }
    }
    << GraphCheckpoint{
        next_node: ck_str_or(&doc, root, "next_node", ""),
        state: ck_str_or(&doc, root, "state", ""),
        last_node: ck_str_or(&doc, root, "last_node", ""),
        steps: ~steps
    }
}

pub fn save_graph_checkpoint(ckpt &GraphCheckpoint, path string) int {
    out := graph_checkpoint_to_json(ckpt)
    _ := os.write(path + "", out) >>>
    << ckpt.steps.len
}

fn ck_int_or(doc &json.Doc, obj int, key string, def int) int {
    if !doc.is_dict(obj) || !doc.has(obj, key) { << def }
    n := doc.get(obj, key) >>> (_) { << def }
    if doc.is_number(n) {
        << doc.as_int(n) >>> (_) { << def }
    }
    << def
}

pub fn load_graph_checkpoint(path string) GraphCheckpoint {
    raw := os.read(path + "") >>>
    << parse_graph_checkpoint_str(&raw) >>>
}

pub fn save_graph_checkpoint_sqlite(ckpt &GraphCheckpoint, path string, thread_id string) int {
    $tid := thread_id + ""
    if tid.len == 0 { tid = "default" }
    out := graph_checkpoint_to_json(ckpt)
    conn := ag_open_sqlite_wal(&path)
    r1 := conn.exec("CREATE TABLE IF NOT EXISTS agent_graph_checkpoints (thread_id TEXT PRIMARY KEY, payload_json TEXT NOT NULL, updated_at INTEGER NOT NULL)", []driver.NamedValue{})
    if r1.err.len > 0 {
        _ := conn.close()
        >> errors.new("agent: graph sqlite init failed: " + r1.err)
    }
    tx := conn.begin()
    args := [driver.NamedValue{name: "", ordinal: 1, value: tid}, driver.NamedValue{name: "", ordinal: 2, value: out}, driver.NamedValue{name: "", ordinal: 3, value: time.now()}]
    ri := conn.exec("INSERT OR REPLACE INTO agent_graph_checkpoints (thread_id, payload_json, updated_at) VALUES (?, ?, ?)", args)
    if ri.err.len > 0 {
        _ := tx.rollback()
        _ := conn.close()
        >> errors.new("agent: graph sqlite save failed: " + ri.err)
    }
    ce := tx.commit()
    _ := conn.close()
    if ce.len > 0 { >> errors.new("agent: graph sqlite commit failed: " + ce) }
    << ckpt.steps.len
}

pub fn load_graph_checkpoint_sqlite(path string, thread_id string) GraphCheckpoint {
    $tid := thread_id + ""
    if tid.len == 0 { tid = "default" }
    conn := ag_open_sqlite_wal(&path)
    rows := conn.query("SELECT payload_json FROM agent_graph_checkpoints WHERE thread_id = ?", [driver.NamedValue{name: "", ordinal: 1, value: tid + ""}])
    _ := conn.close()
    if rows.err.len > 0 { >> errors.new("agent: graph sqlite load failed: " + rows.err) }
    if rows.cells.len == 0 { >> errors.new("agent: graph checkpoint not found in sqlite: " + tid) }
    raw := ag_strip_cell(&rows.cells[0])
    << parse_graph_checkpoint_str(&raw) >>>
}

pub fn (g &StateGraph) resume(ckpt &GraphCheckpoint, override_state string, max_steps int) GraphRunResult {
    $st := ckpt.state + ""
    if override_state.len > 0 { st = override_state + "" }
    << run_graph_from(g, ckpt.next_node + "", st, &ckpt.steps, ckpt.last_node + "", max_steps, true) >>>
}

fn otlp_hex_id(src &string, width int) string {
    hex := "0123456789abcdef"
    $out := ""
    for i in 0:width {
        $v := (i * 13 + 7) & 15
        if src.len > 0 {
            ch := (*src)[i % src.len] & 255
            v = (ch + i * 31) & 15
        }
        out.push_str(hex[v:(v + 1)])
    }
    << out
}

pub fn format_trace_otlp_json(service_name string, spans &[]TraceSpan) string {
    $svc := service_name + ""
    if svc.len == 0 { svc = "xulang-agent" }
    $arr := "["
    $base_ns := 1700000000000000000
    for i in 0:spans.len {
        if i > 0 { arr = arr + "," }
        sp := &spans[i]
        tid := otlp_hex_id(&sp.trace_id, 32)
        seed := sp.trace_id + ":" + str(i) + ":" + sp.name
        sid := otlp_hex_id(&seed, 16)
        start_ns := base_ns
        $dur_ms := sp.duration_ms
        if dur_ms < 0 { dur_ms = 0 }
        end_ns := start_ns + dur_ms * 1000000
        base_ns = end_ns
        $sc := 1
        if sp.is_error { sc = 2 }
        start_s := str(start_ns)
        end_s := str(end_ns)
        turn_s := str(sp.turn)
        tok_s := str(sp.tokens)
        arr = arr + "{\"traceId\":" + json.quote(&tid) +
              ",\"spanId\":" + json.quote(&sid) +
              ",\"name\":" + json.quote(&sp.name) +
              ",\"kind\":1" +
              ",\"startTimeUnixNano\":" + json.quote(&start_s) +
              ",\"endTimeUnixNano\":" + json.quote(&end_s) +
              ",\"attributes\":[" +
              "{\"key\":\"agent.kind\",\"value\":{\"stringValue\":" + json.quote(&sp.kind) + "}}," +
              "{\"key\":\"agent.turn\",\"value\":{\"intValue\":" + json.quote(&turn_s) + "}}," +
              "{\"key\":\"agent.tokens\",\"value\":{\"intValue\":" + json.quote(&tok_s) + "}}," +
              "{\"key\":\"agent.detail\",\"value\":{\"stringValue\":" + json.quote(&sp.detail) + "}}" +
              "],\"status\":{\"code\":" + str(sc) + "}}"
    }
    arr = arr + "]"
    << "{\"resourceSpans\":[{\"resource\":{\"attributes\":[{\"key\":\"service.name\",\"value\":{\"stringValue\":" +
       json.quote(&svc) + "}}]},\"scopeSpans\":[{\"scope\":{\"name\":\"xulang.packages.agent\",\"version\":\"1.15.0\"},\"spans\":" +
       arr + "}]}]}"
}

fn prom_escape_label(s &string) string {
    $out := ""
    for i in 0:s.len {
        ch := (*s)[i] & 255
        if ch == 92 { out = out + "\\\\" }
        else if ch == 34 { out = out + "\\\"" }
        else if ch == 10 { out = out + "\\n" }
        else { out.push_str(string_from_byte(ch)) }
    }
    << out
}

pub fn format_trace_prometheus(service_name string, spans &[]TraceSpan) string {
    $svc := service_name + ""
    if svc.len == 0 { svc = "xulang-agent" }
    esvc := prom_escape_label(&svc)
    $kinds := []string{}
    $statuses := []string{}
    $counts := []int{}
    $toks := []int{}
    $durs := []int{}
    for i in 0:spans.len {
        sp := &spans[i]
        $st := "ok"
        if sp.is_error { st = "error" }
        $found := -1
        for bi in 0:kinds.len {
            if kinds[bi] == sp.kind && statuses[bi] == st {
                found = bi
                <-
            }
        }
        if found < 0 {
            kinds.push(sp.kind + "")
            statuses.push(st)
            counts.push(1)
            toks.push(sp.tokens)
            durs.push(sp.duration_ms)
        } else {
            counts[found] = counts[found] + 1
            toks[found] = toks[found] + sp.tokens
            durs[found] = durs[found] + sp.duration_ms
        }
    }
    $out := "# HELP agent_spans_total Total traced agent spans.\n# TYPE agent_spans_total counter\n"
    for bi in 0:kinds.len {
        ek := prom_escape_label(&kinds[bi])
        out = out + "agent_spans_total{service=\"" + esvc + "\",kind=\"" + ek + "\",status=\"" + statuses[bi] + "\"} " + str(counts[bi]) + "\n"
    }
    out = out + "# HELP agent_tokens_total Total tokens recorded across traced spans.\n# TYPE agent_tokens_total counter\n"
    for bi in 0:kinds.len {
        ek := prom_escape_label(&kinds[bi])
        out = out + "agent_tokens_total{service=\"" + esvc + "\",kind=\"" + ek + "\"} " + str(toks[bi]) + "\n"
    }
    out = out + "# HELP agent_duration_ms_total Total elapsed milliseconds across traced spans.\n# TYPE agent_duration_ms_total counter\n"
    for bi in 0:kinds.len {
        ek := prom_escape_label(&kinds[bi])
        out = out + "agent_duration_ms_total{service=\"" + esvc + "\",kind=\"" + ek + "\"} " + str(durs[bi]) + "\n"
    }
    << out
}

pub fn export_traces_otlp_http(endpoint string, service_name string, spans &[]TraceSpan) int {
    payload := format_trace_otlp_json(service_name, spans)
    $def_port := 80
    if strings.has_prefix(&endpoint, "https://") { def_port = 443 }
    ep := transport.parse_endpoint(endpoint + "", def_port) >>>
    $full_path := ep.path + ""
    if full_path.len == 0 || full_path == "/" { full_path = "/v1/traces" }
    $raw := "POST " + full_path + " HTTP/1.1\r\n"
    raw = raw + "Host: " + ep.host + ":" + str(ep.port) + "\r\n"
    raw = raw + "Accept: application/json\r\n"
    raw = raw + "Content-Type: application/json\r\n"
    raw = raw + "Content-Length: " + str(payload.len) + "\r\n"
    raw = raw + "Connection: close\r\n\r\n" + payload
    cfg := tls.new_config(ep.host + "")
    resp := transport.request_raw(ep, cfg, raw, "POST") >>>
    if resp.status_code < 200 || resp.status_code >= 300 {
        >> errors.code(resp.status_code, "agent: OTLP HTTP export status " + str(resp.status_code))
    }
    << resp.status_code
}

pub struct HandoffAgent {
    pub name string
    pub instructions string
}

pub struct HandoffTeam {
    pub entry string
    pub agents []HandoffAgent
}

pub struct HandoffResult {
    pub final_agent string
    pub content string
    pub route_trace []string
    pub handoffs int
    pub turns int
}

pub fn new_handoff_team(entry_agent string) HandoffTeam {
    << HandoffTeam{entry: entry_agent + "", agents: []HandoffAgent{}}
}

pub fn (t $&HandoffTeam) add_agent(name string, instructions string) {
    t.agents.push(HandoffAgent{name: name + "", instructions: instructions + ""})
}

fn find_handoff_agent_idx(agents &[]HandoffAgent, name &string) int {
    for i in 0:agents.len {
        if agents[i].name == *name { << i }
    }
    << -1
}

fn parse_handoff_directive(text &string) []string {
    // Returns [target_agent, remaining_note] if HANDOFF:<target> is present; else []string{}.
    lines := strings.split(text, "\n")
    for i in 0:lines.len {
        ln := strings.trim_space(&lines[i])
        if strings.has_prefix(&ln, "HANDOFF:") {
            rest := strings.trim_space(&ln[8:ln.len])
            $tgt := ""
            $note := ""
            $sp := -1
            for ci in 0:rest.len {
                ch := rest[ci] & 255
                if ch == 32 || ch == 9 || ch == 58 {
                    sp = ci
                    <-
                }
            }
            if sp >= 0 {
                tgt = strings.trim_space(&rest[0:sp])
                note = strings.trim_space(&rest[(sp + 1):rest.len])
            } else {
                tgt = rest
            }
            if tgt.len > 0 {
                << [tgt, note]
            }
        }
    }
    << []string{}
}

pub fn run_handoff_openai(team &HandoffTeam, client &openai.Client, model string,
                          user_prompt string, max_handoffs int) HandoffResult {
    if team.agents.len == 0 {
        >> errors.new("agent: HandoffTeam has no agents")
    }
    $cur := team.entry + ""
    if cur.len == 0 { cur = team.agents[0].name + "" }
    $limit := max_handoffs
    if limit < 0 { limit = 0 }
    $roster := "Team agents available for delegation:"
    for i in 0:team.agents.len {
        ag := &team.agents[i]
        roster = roster + "\n- " + ag.name + ": " + ag.instructions
    }
    roster = roster + "\nTo hand off control, respond ONLY with: HANDOFF:<agent_name> <reason>"

    $trace := []string{}
    $msgs := [openai.message("user", user_prompt + "")]
    $handoffs := 0
    $turns := 0
    $final_content := ""

    while turns <= limit {
        idx := find_handoff_agent_idx(&team.agents, &cur)
        if idx < 0 {
            >> errors.new("agent: unknown HandoffAgent: " + cur)
        }
        trace.push(cur + "")
        ag := &team.agents[idx]
        sys := "You are agent '" + ag.name + "'. " + ag.instructions + "\n" + roster
        $req_msgs := [openai.message("system", sys)]
        for mi in 0:msgs.len {
            req_msgs.push(openai.message(msgs[mi].role + "", msgs[mi].content + ""))
        }
        req := openai.chat_request(model + "", ~req_msgs)
        resp := client.chat(&req) >>>
        turns += 1
        out_txt := strings.trim_space(&resp.content)
        hd := parse_handoff_directive(&out_txt)
        if hd.len == 2 {
            next_name := hd[0]
            note := hd[1]
            if find_handoff_agent_idx(&team.agents, &next_name) < 0 {
                final_content = out_txt
                <-
            }
            if handoffs >= limit {
                final_content = out_txt
                <-
            }
            handoffs += 1
            msgs.push(openai.message("assistant", "[" + cur + " handed off to " + next_name + "] " + note))
            cur = next_name
            ->
        }
        final_content = out_txt
        <-
    }

    << HandoffResult{
        final_agent: cur,
        content: final_content,
        route_trace: ~trace,
        handoffs: handoffs,
        turns: turns
    }
}

pub fn discover_a2a_skills_prompt(base_url string) string {
    cli := a2a.new_client(base_url + "")
    card := cli.discover() >>>
    $out := "Remote A2A Agent: " + card.name + " (" + card.version + ") - " + card.description
    for i in 0:card.skills.len {
        sk := &card.skills[i]
        out = out + "\n- [" + sk.id + "] " + sk.name + ": " + sk.description
    }
    << out
}

pub fn delegate_to_a2a(base_url string, auth_token string, task_id string, prompt string) string {
    $cli := a2a.new_client(base_url + "")
    if auth_token.len > 0 { cli.set_auth_token(auth_token + "") }
    task := cli.send_task(task_id + "", prompt + "") >>>
    if task.output.len > 0 { << task.output }
    if task.artifacts.len > 0 { << task.artifacts[0].text }
    if task.history.len > 0 { << task.history[task.history.len - 1].text }
    << ""
}

pub struct SwarmMember {
    pub name string
    pub description string
    pub provider string
    pub agent Agent
    pub anthropic_agent AnthropicAgent
    pub gemini_agent GeminiAgent
    pub responses_agent ResponsesAgent
}

pub struct AgentSwarm {
    pub entry string
    pub members []SwarmMember
}

pub struct SwarmResult {
    pub final_agent string
    pub content string
    pub route_trace []string
    pub handoffs int
    pub turns int
    pub steps []Step
    pub total_tokens int
}

fn swarm_dummy_openai() Agent { << new_agent(openai.new_client("http://127.0.0.1:0", ""), "") }
fn swarm_dummy_anth() AnthropicAgent { << new_anthropic_agent(anthropic.new_client_with_base("http://127.0.0.1:0", ""), "") }
fn swarm_dummy_gem() GeminiAgent { << new_gemini_agent(gemini.new_client_with_base("http://127.0.0.1:0", ""), "") }
fn swarm_dummy_resp() ResponsesAgent { << new_responses_agent(openai.new_client("http://127.0.0.1:0", ""), "") }

pub fn new_agent_swarm(entry string) AgentSwarm {
    << AgentSwarm{entry: entry + "", members: []SwarmMember{}}
}

pub fn (s $&AgentSwarm) add_member(name string, description string, agent Agent) {
    s.members.push(SwarmMember{
        name: name + "", description: description + "", provider: "openai",
        agent: agent, anthropic_agent: swarm_dummy_anth(), gemini_agent: swarm_dummy_gem(), responses_agent: swarm_dummy_resp()
    })
}

pub fn (s $&AgentSwarm) add_anthropic_member(name string, description string, agent AnthropicAgent) {
    s.members.push(SwarmMember{
        name: name + "", description: description + "", provider: "anthropic",
        agent: swarm_dummy_openai(), anthropic_agent: agent, gemini_agent: swarm_dummy_gem(), responses_agent: swarm_dummy_resp()
    })
}

pub fn (s $&AgentSwarm) add_gemini_member(name string, description string, agent GeminiAgent) {
    s.members.push(SwarmMember{
        name: name + "", description: description + "", provider: "gemini",
        agent: swarm_dummy_openai(), anthropic_agent: swarm_dummy_anth(), gemini_agent: agent, responses_agent: swarm_dummy_resp()
    })
}

pub fn (s $&AgentSwarm) add_responses_member(name string, description string, agent ResponsesAgent) {
    s.members.push(SwarmMember{
        name: name + "", description: description + "", provider: "responses",
        agent: swarm_dummy_openai(), anthropic_agent: swarm_dummy_anth(), gemini_agent: swarm_dummy_gem(), responses_agent: agent
    })
}

fn find_swarm_member_idx(members &[]SwarmMember, name &string) int {
    for i in 0:members.len {
        if members[i].name == *name { << i }
    }
    << -1
}

struct SwarmTurnResp {
    content string
    finish_reason string
    tokens int
    tool_calls []openai.ToolCall
}

fn swarm_build_system_prompt(name &string, desc &string, base_sys &string, skills &[]Skill, prog bool, user_prompt &string, roster &string) string {
    $sys := "You are specialist agent '" + (*name) + "'."
    if desc.len > 0 { sys = sys + " Role: " + (*desc) }
    if base_sys.len > 0 { sys = sys + "\n" + (*base_sys) }
    if skills.len > 0 {
        $sk_txt := ""
        if prog { sk_txt = format_skills_catalog(skills) }
        else { sk_txt = format_skills_prompt(skills, user_prompt) }
        if sk_txt.len > 0 { sys = sys + "\n\n" + sk_txt }
    }
    << sys + "\n\n" + (*roster)
}

fn swarm_shared_to_transcript(msgs &[]openai.Message) string {
    $out := ""
    for i in 0:msgs.len {
        m := &msgs[i]
        if out.len > 0 { out = out + "\n" }
        $body := m.content + ""
        if body.len == 0 && m.tool_calls.len > 0 {
            body = "[called tool: " + m.tool_calls[0].name + "]"
        }
        out = out + m.role + ": " + body
    }
    << out
}

fn swarm_call_provider_turn(mb &SwarmMember, sys &string, shared_msgs &[]openai.Message) SwarmTurnResp {
    xfer_schema := "{\"type\":\"object\",\"properties\":{\"agent\":{\"type\":\"string\"},\"reason\":{\"type\":\"string\"}},\"required\":[\"agent\"]}"
    xfer_desc := "Delegate control and conversation context to another specialist agent in the swarm."
    empty_mcp := []mcp.ToolInfo{}

    if mb.provider == "anthropic" {
        ag := &mb.anthropic_agent
        $amsgs := []anthropic.Message{}
        for i in 0:shared_msgs.len {
            m := &shared_msgs[i]
            if m.role == "tool" {
                amsgs.push(anthropic.message("user", "[tool_result] " + m.content))
            } else if m.role == "assistant" {
                $txt := m.content + ""
                if txt.len == 0 && m.tool_calls.len > 0 { txt = "[calling " + m.tool_calls[0].name + "]" }
                amsgs.push(anthropic.message("assistant", txt))
            } else {
                amsgs.push(anthropic.message("user", m.content + ""))
            }
        }
        if ag.context_max_tokens > 0 {
            amsgs = compact_anthropic_messages_with(&amsgs, ag.context_max_tokens, 6, ag.token_counter)
        }
        $req := anthropic.messages_request(ag.model + "", ~amsgs, ag.max_tokens)
        req.system = (*sys) + ""
        req.tools = build_anth_tools_ex(&ag.local_tools, &empty_mcp, ag.progressive_skills && ag.skills.len > 0)
        req.tools.push(anthropic.tool("transfer_to_agent", xfer_desc, xfer_schema))
        if ag.has_temperature {
            req.temperature = ag.temperature
            req.has_temperature = true
        }
        resp := ag.client.messages(&req) >>>
        $tcs := []openai.ToolCall{}
        for i in 0:resp.tool_uses.len {
            tu := &resp.tool_uses[i]
            tcs.push(openai.ToolCall{id: tu.id + "", kind: "function", name: tu.name + "", arguments: tu.input_json + ""})
        }
        << SwarmTurnResp{
            content: resp.content + "", finish_reason: resp.stop_reason + "",
            tokens: resp.usage.input_tokens + resp.usage.output_tokens, tool_calls: ~tcs
        }
    }

    if mb.provider == "gemini" {
        ag := &mb.gemini_agent
        $gmsgs := []gemini.Content{}
        for i in 0:shared_msgs.len {
            m := &shared_msgs[i]
            if m.role == "assistant" {
                $txt := m.content + ""
                if txt.len == 0 && m.tool_calls.len > 0 { txt = "[calling " + m.tool_calls[0].name + "]" }
                gmsgs.push(gemini.model_text(txt))
            } else {
                $txt := m.content + ""
                if m.role == "tool" { txt = "[tool_result] " + txt }
                gmsgs.push(gemini.user_text(txt))
            }
        }
        if ag.context_max_tokens > 0 {
            gmsgs = compact_gemini_contents_with(&gmsgs, ag.context_max_tokens, 6, ag.token_counter)
        }
        $req := gemini.generate_request(ag.model + "", ~gmsgs)
        req.system_instruction = (*sys) + ""
        req.tools = build_gem_tools_ex(&ag.local_tools, &empty_mcp, ag.progressive_skills && ag.skills.len > 0)
        req.tools.push(gemini.function_decl("transfer_to_agent", xfer_desc, xfer_schema))
        if ag.has_temperature {
            req.temperature = ag.temperature
            req.has_temperature = true
        }
        resp := ag.client.generate(&req) >>>
        $tcs := []openai.ToolCall{}
        for i in 0:resp.function_calls.len {
            fc := &resp.function_calls[i]
            tcs.push(openai.ToolCall{id: "gem_call_" + str(i + 1), kind: "function", name: fc.name + "", arguments: fc.args_json + ""})
        }
        << SwarmTurnResp{
            content: resp.text + "", finish_reason: resp.finish_reason + "",
            tokens: resp.usage.total_token_count, tool_calls: ~tcs
        }
    }

    if mb.provider == "responses" {
        ag := &mb.responses_agent
        $inp := swarm_shared_to_transcript(shared_msgs)
        if ag.context_max_tokens > 0 {
            tc := ag.token_counter
            if tc(&inp) > ag.context_max_tokens {
                max_ch := ag.context_max_tokens * 4
                if inp.len > max_ch { inp = inp[inp.len - max_ch:inp.len] }
            }
        }
        $req := openai.new_responses_request(ag.model + "", inp)
        req.instructions = (*sys) + ""
        req.tools = build_tool_defs_ex(&ag.local_tools, &empty_mcp, ag.progressive_skills && ag.skills.len > 0)
        req.tools.push(openai.tool("transfer_to_agent", xfer_desc, xfer_schema))
        if ag.has_temperature {
            req.temperature = ag.temperature
            req.has_temperature = true
        }
        if ag.max_output_tokens > 0 { req.max_output_tokens = ag.max_output_tokens }
        resp := ag.client.responses(&req) >>>
        $tcs := []openai.ToolCall{}
        for i in 0:resp.tool_calls.len {
            tc := &resp.tool_calls[i]
            $cid := tc.call_id + ""
            if cid.len == 0 { cid = tc.id + "" }
            tcs.push(openai.ToolCall{id: cid, kind: "function", name: tc.name + "", arguments: tc.arguments + ""})
        }
        << SwarmTurnResp{
            content: resp.output_text + "", finish_reason: resp.status + "",
            tokens: resp.usage.total_tokens, tool_calls: ~tcs
        }
    }

    ag := &mb.agent
    $req_msgs := [openai.message("system", (*sys) + "")]
    for mi in 0:shared_msgs.len {
        req_msgs.push(copy_message(&shared_msgs[mi]))
    }
    if ag.context_max_tokens > 0 {
        req_msgs = compact_messages_with(&req_msgs, ag.context_max_tokens, 6, ag.token_counter)
    }
    $req := openai.chat_request(ag.model + "", ~req_msgs)
    req.tools = build_tool_defs_ex(&ag.local_tools, &empty_mcp, ag.progressive_skills && ag.skills.len > 0)
    req.tools.push(openai.tool("transfer_to_agent", xfer_desc, xfer_schema))
    if ag.has_temperature {
        req.temperature = ag.temperature
        req.has_temperature = true
    }
    if ag.max_tokens > 0 {
        req.max_tokens = ag.max_tokens
    }
    resp := ag.client.chat(&req) >>>
    << SwarmTurnResp{
        content: resp.content + "", finish_reason: resp.finish_reason + "",
        tokens: resp.usage.total_tokens, tool_calls: copy_tool_calls(&resp.tool_calls)
    }
}

pub fn (s &AgentSwarm) run(user_prompt string, max_handoffs int) SwarmResult {
    if s.members.len == 0 {
        >> errors.new("agent: AgentSwarm has no members")
    }
    $cur := s.entry + ""
    if cur.len == 0 { cur = s.members[0].name + "" }
    $limit := max_handoffs
    if limit < 0 { limit = 0 }

    $roster := "Swarm specialists available (call tool `transfer_to_agent` with {\"agent\":\"<name>\",\"reason\":\"...\"} to delegate):"
    for i in 0:s.members.len {
        mb := &s.members[i]
        roster = roster + "\n- " + mb.name + ": " + mb.description
    }

    $shared_msgs := [openai.message("user", user_prompt + "")]
    entry_idx := find_swarm_member_idx(&s.members, &cur)
    if entry_idx < 0 {
        >> errors.new("agent: unknown AgentSwarm entry member: " + cur)
    }
    emb := &s.members[entry_idx]
    $entry_has_guard := emb.agent.has_guardrails
    $entry_guard := &emb.agent.guard_policy
    if emb.provider == "anthropic" {
        entry_has_guard = emb.anthropic_agent.has_guardrails
        entry_guard = &emb.anthropic_agent.guard_policy
    } else if emb.provider == "gemini" {
        entry_has_guard = emb.gemini_agent.has_guardrails
        entry_guard = &emb.gemini_agent.guard_policy
    } else if emb.provider == "responses" {
        entry_has_guard = emb.responses_agent.has_guardrails
        entry_guard = &emb.responses_agent.guard_policy
    }
    if entry_has_guard {
        g_in := guardrails.check_input(entry_guard, &shared_msgs[0].content)
        if !g_in.allowed {
            >> errors.new("agent swarm guardrails input blocked: " + g_in.reason)
        }
        shared_msgs[0].content = g_in.sanitized_text + ""
    }

    $trace := [cur + ""]
    $steps := []Step{}
    $handoffs := 0
    $turns := 0
    $tt := 0
    $final_content := ""
    trace_id := "sw_" + str(time.now_time().unix_nano())

    $max_loop := 32
    while turns < max_loop {
        idx := find_swarm_member_idx(&s.members, &cur)
        if idx < 0 {
            >> errors.new("agent: unknown AgentSwarm member: " + cur)
        }
        mb := &s.members[idx]
        $model_name := mb.agent.model + ""
        $base_sys := &mb.agent.system_prompt
        $skills := &mb.agent.skills
        $prog_skills := mb.agent.progressive_skills
        $local_tools := &mb.agent.local_tools
        $parallel_tools := mb.agent.parallel_tools
        $tool_hook := mb.agent.tool_hook
        $has_appr := mb.agent.has_approval_hook
        $appr_hook := mb.agent.approval_hook
        $has_guard := mb.agent.has_guardrails
        $guard_pol := &mb.agent.guard_policy
        $has_trace := mb.agent.has_trace_hook
        $trace_hook := mb.agent.trace_hook
        $max_tot := mb.agent.max_total_tokens
        $max_tchars := mb.agent.max_tool_output_chars

        if mb.provider == "anthropic" {
            model_name = mb.anthropic_agent.model + ""
            base_sys = &mb.anthropic_agent.system_prompt
            skills = &mb.anthropic_agent.skills
            prog_skills = mb.anthropic_agent.progressive_skills
            local_tools = &mb.anthropic_agent.local_tools
            parallel_tools = mb.anthropic_agent.parallel_tools
            tool_hook = mb.anthropic_agent.tool_hook
            has_appr = mb.anthropic_agent.has_approval_hook
            appr_hook = mb.anthropic_agent.approval_hook
            has_guard = mb.anthropic_agent.has_guardrails
            guard_pol = &mb.anthropic_agent.guard_policy
            has_trace = mb.anthropic_agent.has_trace_hook
            trace_hook = mb.anthropic_agent.trace_hook
            max_tot = mb.anthropic_agent.max_total_tokens
            max_tchars = mb.anthropic_agent.max_tool_output_chars
        } else if mb.provider == "gemini" {
            model_name = mb.gemini_agent.model + ""
            base_sys = &mb.gemini_agent.system_prompt
            skills = &mb.gemini_agent.skills
            prog_skills = mb.gemini_agent.progressive_skills
            local_tools = &mb.gemini_agent.local_tools
            parallel_tools = mb.gemini_agent.parallel_tools
            tool_hook = mb.gemini_agent.tool_hook
            has_appr = mb.gemini_agent.has_approval_hook
            appr_hook = mb.gemini_agent.approval_hook
            has_guard = mb.gemini_agent.has_guardrails
            guard_pol = &mb.gemini_agent.guard_policy
            has_trace = mb.gemini_agent.has_trace_hook
            trace_hook = mb.gemini_agent.trace_hook
            max_tot = mb.gemini_agent.max_total_tokens
            max_tchars = mb.gemini_agent.max_tool_output_chars
        } else if mb.provider == "responses" {
            model_name = mb.responses_agent.model + ""
            base_sys = &mb.responses_agent.instructions
            skills = &mb.responses_agent.skills
            prog_skills = mb.responses_agent.progressive_skills
            local_tools = &mb.responses_agent.local_tools
            parallel_tools = mb.responses_agent.parallel_tools
            tool_hook = mb.responses_agent.tool_hook
            has_appr = mb.responses_agent.has_approval_hook
            appr_hook = mb.responses_agent.approval_hook
            has_guard = mb.responses_agent.has_guardrails
            guard_pol = &mb.responses_agent.guard_policy
            has_trace = mb.responses_agent.has_trace_hook
            trace_hook = mb.responses_agent.trace_hook
            max_tot = mb.responses_agent.max_total_tokens
            max_tchars = mb.responses_agent.max_tool_output_chars
        }

        sys := swarm_build_system_prompt(&mb.name, &mb.description, base_sys, skills, prog_skills, &user_prompt, &roster)
        turn_t0 := time.now()
        resp := swarm_call_provider_turn(mb, &sys, &shared_msgs) >>>
        turn_ms := time.since(turn_t0) / 1000000
        turns += 1
        tt += resp.tokens
        if has_trace {
            trace_hook(TraceSpan{
                trace_id: trace_id + "", kind: "llm_turn", name: cur + "/" + model_name,
                turn: turns, duration_ms: turn_ms, tokens: resp.tokens,
                is_error: false, detail: resp.finish_reason + ""
            })
        }
        if max_tot > 0 && tt > max_tot {
            >> errors.new("agent swarm: token budget exceeded")
        }

        if resp.tool_calls.len == 0 {
            out_txt := strings.trim_space(&resp.content)
            hd := parse_handoff_directive(&out_txt)
            if hd.len == 2 && find_swarm_member_idx(&s.members, &hd[0]) >= 0 && handoffs < limit {
                handoffs += 1
                steps.push(Step{turn: turns, tool_name: "transfer_to_agent", arguments_json: "{\"agent\":" + json.quote(&hd[0]) + "}", output: "transferred to " + hd[0], is_error: false})
                shared_msgs.push(openai.message("assistant", "[" + cur + " handed off to " + hd[0] + "] " + hd[1]))
                cur = hd[0] + ""
                trace.push(cur + "")
                ->
            }
            $fin := resp.content + ""
            if has_guard {
                g_out := guardrails.check_output(guard_pol, &fin)
                if !g_out.allowed {
                    >> errors.new("agent swarm guardrails output blocked: " + g_out.reason)
                }
                fin = g_out.sanitized_text + ""
            }
            final_content = fin
            <-
        }

        shared_msgs.push(openai.Message{
            role: "assistant",
            content: resp.content + "",
            parts: []openai.ContentPart{},
            tool_call_id: "",
            tool_calls: copy_tool_calls(&resp.tool_calls)
        })

        $non_xfer := []ToolExecSpec{}
        for ti in 0:resp.tool_calls.len {
            tc := &resp.tool_calls[ti]
            if tc.name != "transfer_to_agent" {
                non_xfer.push(ToolExecSpec{name: tc.name + "", arguments: tc.arguments + ""})
            }
        }
        $dummy_http := mcp.new_http_client("http://127.0.0.1:0")
        $dummy_stdio := mcp.closed_stdio_client()
        $non_xfer_res := []ToolExecItem{}
        $tool_ms := 0
        if non_xfer.len > 0 {
            tool_t0 := time.now()
            non_xfer_res = execute_agent_tools(local_tools, &non_xfer, parallel_tools, false, $&dummy_http, false, $&dummy_stdio, tool_hook, has_appr, appr_hook, skills, prog_skills)
            tool_ms = time.since(tool_t0) / 1000000
        }

        $next_member := ""
        $nx_i := 0
        for ti in 0:resp.tool_calls.len {
            tc := &resp.tool_calls[ti]
            if tc.name == "transfer_to_agent" {
                doc := json.parse(&tc.arguments)
                $tgt := ""
                $reason := ""
                if doc.ok() && doc.is_dict(doc.root()) {
                    tgt = ck_str_or(&doc, doc.root(), "agent", "")
                    reason = ck_str_or(&doc, doc.root(), "reason", "")
                }
                $tout := ""
                $terr := false
                if tgt.len == 0 || find_swarm_member_idx(&s.members, &tgt) < 0 {
                    tout = "unknown swarm agent: " + tgt
                    terr = true
                } else if handoffs >= limit {
                    tout = "handoff limit reached"
                    terr = true
                } else {
                    next_member = tgt + ""
                    tout = "transferred from " + cur + " to " + tgt
                    if reason.len > 0 { tout = tout + " (" + reason + ")" }
                }
                steps.push(Step{turn: turns, tool_name: tc.name + "", arguments_json: tc.arguments + "", output: tout + "", is_error: terr})
                shared_msgs.push(openai.tool_message(tc.id + "", tout + ""))
            } else {
                res := &non_xfer_res[nx_i]
                nx_i += 1
                $tout := res.output + ""
                $terr := res.is_error
                if has_guard {
                    g_tool := guardrails.check_tool_output(guard_pol, &tc.name, &tout)
                    if !g_tool.allowed {
                        tout = "blocked by guardrails: " + g_tool.reason
                        terr = true
                    } else {
                        tout = g_tool.sanitized_text + ""
                    }
                }
                if max_tchars > 0 && tout.len > max_tchars {
                    tout = tout[0:max_tchars] + "\n...[truncated]"
                }
                if has_trace {
                    trace_hook(TraceSpan{
                        trace_id: trace_id + "", kind: "tool_call", name: tc.name + "",
                        turn: turns, duration_ms: tool_ms, tokens: 0,
                        is_error: terr, detail: tout[0:mini_int(tout.len, 64)]
                    })
                }
                steps.push(Step{turn: turns, tool_name: tc.name + "", arguments_json: tc.arguments + "", output: tout + "", is_error: terr})
                shared_msgs.push(openai.tool_message(tc.id + "", tout + ""))
            }
        }
        if next_member.len > 0 {
            handoffs += 1
            cur = next_member
            trace.push(cur + "")
        }
    }

    << SwarmResult{
        final_agent: cur,
        content: final_content,
        route_trace: ~trace,
        handoffs: handoffs,
        turns: turns,
        steps: ~steps,
        total_tokens: tt
    }
}

