@"github.com/xulang-org/packages/postgres"

#errors
#strconv
#strings

pub struct Config {
    pub host string
    pub port int
    pub user string
    pub password string
    pub database string
    pub ssl_mode string
    pub root_cert_file string
}

fn empty_config() Config {
    << Config{host: "127.0.0.1", port: 5432, user: "", password: "", database: "", ssl_mode: "disable", root_cert_file: ""}
}

pub fn new_config() Config {
    << empty_config()
}

fn unescape_part(s string) string {
    $out := ""
    $i := 0
    while i < s.len {
        if (s[i] & 255) == 37 && i + 2 < s.len {
            $hi := s[i + 1] & 255
            $lo := s[i + 2] & 255
            if hi >= 97 && hi <= 102 { hi = hi - 87 }
            else if hi >= 65 && hi <= 70 { hi = hi - 55 }
            else if hi >= 48 && hi <= 57 { hi = hi - 48 }
            else {
                out.push_byte(s[i] & 255)
                i += 1
                ->
            }
            if lo >= 97 && lo <= 102 { lo = lo - 87 }
            else if lo >= 65 && lo <= 70 { lo = lo - 55 }
            else if lo >= 48 && lo <= 57 { lo = lo - 48 }
            else {
                out.push_byte(s[i] & 255)
                i += 1
                ->
            }
            out.push_byte((hi * 16 + lo) & 255)
            i += 3
        } else {
            out.push_byte(s[i] & 255)
            i += 1
        }
    }
    << out
}

fn set_option(c $&Config, key string, value string) {
    k := strings.to_lower(&key)
    v := unescape_part(value)
    if k == "host" { c.host = v }
    if k == "port" {
        c.port = parse_port_or_default(v)
    }
    if k == "user" { c.user = v }
    if k == "username" { c.user = v }
    if k == "password" { c.password = v }
    if k == "dbname" { c.database = v }
    if k == "database" { c.database = v }
    if k == "sslmode" { c.ssl_mode = v }
    if k == "sslrootcert" { c.root_cert_file = v }
}

fn parse_port_or_default(v string) int {
    n := strconv.atoi(&v) or (err) { << 5432 }
    << n
}

fn parse_keyword_dsn(dsn string) Config {
    $c := empty_config()
    $i := 0
    while i < dsn.len {
        while i < dsn.len && ((dsn[i] & 255) == 32 || (dsn[i] & 255) == 9) { i += 1 }
        if i >= dsn.len { <- }
        $j := i
        while j < dsn.len && (dsn[j] & 255) != 32 && (dsn[j] & 255) != 9 && (dsn[j] & 255) != 61 { j += 1 }
        if j == i || j >= dsn.len || (dsn[j] & 255) != 61 { >> errors.new("postgres: invalid keyword DSN") }
        key := dsn[i:j] + ""
        j += 1
        $value := ""
        if j < dsn.len && (dsn[j] & 255) == 39 {
            j += 1
            $going := 1
            while j < dsn.len && going == 1 {
                if (dsn[j] & 255) == 39 {
                    if j + 1 < dsn.len && (dsn[j + 1] & 255) == 39 {
                        value.push_byte(39)
                        j += 2
                    } else {
                        going = 0
                        j += 1
                    }
                } else {
                    value.push_byte(dsn[j] & 255)
                    j += 1
                }
            }
            if going != 0 { >> errors.new("postgres: unterminated quoted DSN value") }
        } else {
            $escaped := 0
            while j < dsn.len {
                c := dsn[j] & 255
                if escaped != 0 {
                    value.push_byte(c)
                    escaped = 0
                    j += 1
                    ->
                }
                if c == 92 {
                    escaped = 1
                    j += 1
                    ->
                }
                if c == 32 || c == 9 { <- }
                value.push_byte(c)
                j += 1
            }
        }
        set_option($&c, key, value)
        i = j
    }
    << c
}

fn parse_url_dsn(dsn string) Config {
    $c := empty_config()
    $start := 0
    if strings.has_prefix(&dsn, "postgres://") { start = 11 }
    else if strings.has_prefix(&dsn, "postgresql://") { start = 13 }
    else { >> errors.new("postgres: unsupported DSN scheme") }
    $end := dsn.len
    qpos := strings.index_byte(&dsn, 63)
    if qpos >= 0 { end = qpos }
    authority_tail := dsn[start:end] + ""
    slash := strings.index_byte(&authority_tail, 47)
    $auth_end := end
    if slash >= 0 { auth_end = start + slash }
    authority := dsn[start:auth_end] + ""
    at := strings.last_index_byte(&authority, 64)
    $hostport := authority + ""
    if at >= 0 {
        ui := authority[0:at] + ""
        colon := strings.last_index_byte(&ui, 58)
        if colon >= 0 {
            c.user = unescape_part(ui[0:colon] + "")
            c.password = unescape_part(ui[colon + 1:ui.len] + "")
        } else { c.user = unescape_part(ui) }
        hostport = authority[at + 1:authority.len] + ""
    }
    if hostport.len > 0 && (hostport[0] & 255) == 91 {
        close := strings.index_byte(&hostport, 93)
        if close < 0 { >> errors.new("postgres: invalid IPv6 host") }
        c.host = hostport[1:close] + ""
        if close + 1 < hostport.len && (hostport[close + 1] & 255) == 58 {
            ps := hostport[close + 2:hostport.len] + ""
            c.port = strconv.atoi(&ps) or >> errors.new("postgres: invalid port")
        }
    } else if hostport.len > 0 {
        colon := strings.last_index_byte(&hostport, 58)
        if colon >= 0 {
            c.host = hostport[0:colon] + ""
            ps := hostport[colon + 1:hostport.len] + ""
            c.port = strconv.atoi(&ps) or >> errors.new("postgres: invalid port")
        } else { c.host = hostport + "" }
    }
    if slash >= 0 {
        path_end := end
        c.database = unescape_part(dsn[start + slash + 1:path_end] + "")
    }
    if qpos >= 0 {
        query := dsn[qpos + 1:dsn.len] + ""
        pairs := strings.split(&query, "&")
        for i in 0:pairs.len {
            p := pairs[i] + ""
            eq := strings.index_byte(&p, 61)
            if eq >= 0 { set_option($&c, p[0:eq] + "", p[eq + 1:p.len] + "") }
        }
    }
    << c
}

pub fn parse_dsn(dsn string) Config {
    if dsn.len == 0 { >> errors.new("postgres: empty DSN") }
    $c := empty_config()
    if strings.has_prefix(&dsn, "postgres://") || strings.has_prefix(&dsn, "postgresql://") {
        c = parse_url_dsn(dsn)
    } else {
        c = parse_keyword_dsn(dsn)
    }
    if c.host.len == 0 { c.host = "127.0.0.1" }
    if c.port <= 0 || c.port > 65535 { >> errors.new("postgres: invalid port") }
    if c.user.len == 0 { c.user = "postgres" }
    if c.database.len == 0 { c.database = c.user + "" }
    if c.ssl_mode.len == 0 { c.ssl_mode = "disable" }
    if c.ssl_mode != "disable" && c.ssl_mode != "require" && c.ssl_mode != "verify-ca" && c.ssl_mode != "verify-full" {
        >> errors.new("postgres: unsupported sslmode")
    }
    << c
}
