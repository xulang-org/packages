@"github.com/xulang-org/packages/grpc"

#net
#errors
#strings

pub struct Pool {
    pub client GrpcClient
    pub idle chan int
    pub max_idle int
}

pub fn new_pool(endpoint string, max_idle int) Pool {
    cli := new_client(endpoint)
    mut cap_val := max_idle
    if cap_val <= 0 {
        cap_val = 10
    }
    ch := chan int{cap: cap_val}
    << Pool{
        client: cli,
        idle: ch,
        max_idle: cap_val
    }
}

pub fn open_pool(endpoint string, max_idle int) Pool {
    << new_pool(endpoint, max_idle)
}

pub fn (p &Pool) get_conn() int {
    select {
        fd := <-p.idle {
            if fd >= 0 {
                << fd
            }
        }
        else {
            fd := p.client.connect() or (err) {
                << -1
            }
            << fd
        }
    }
    << -1
}

pub fn (p &Pool) put_conn(fd int) {
    if fd < 0 {
        <<
    }
    select {
        p.idle <- fd {
            <<
        }
        else {
            safe_close(fd)
        }
    }
}

pub fn (p &Pool) call_unary(path string, req_bytes string) Response {
    << p.client.call_unary(path, req_bytes) or >>
}

pub fn (p &Pool) close() {
    mut done := false
    while !done {
        select {
            fd := <-p.idle {
                safe_close(fd)
            }
            else {
                done = true
                <-
            }
        }
    }
}
