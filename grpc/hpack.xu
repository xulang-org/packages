@"github.com/xulang-org/packages/grpc"

#errors

fn decode_huffman(raw string) string {
    codes := huffman_codes()
    lengths := huffman_lengths()
    mut out := ""
    mut bits := 0
    mut word := 0
    for i in 0:raw.len {
        for shift in 0:8 {
            word = (word << 1) | ((raw[i] >> (7 - shift)) & 1)
            bits += 1
            mut matched := -1
            for symbol in 0:257 {
                if lengths[symbol] == bits && codes[symbol] == word { matched = symbol
                    <- }
            }
            if matched >= 0 {
                if matched == 256 { >> errors.new("grpc: HPACK Huffman EOS in string") }
                out.push_byte(matched)
                bits = 0
                word = 0
                if out.len > 65536 { >> errors.new("grpc: HPACK string too large") }
            } else if bits >= 30 { >> errors.new("grpc: invalid HPACK Huffman code") }
        }
    }
    if bits > 7 || word != (1 << bits) - 1 { >> errors.new("grpc: invalid HPACK Huffman padding") }
    << out
}

struct HpackReader {
    pub raw string
    pub i int
}

struct HpackHeaders {
    pub names []string
    pub values []string
}

fn (r &mut HpackReader) integer(prefix int) int {
    if r.i >= r.raw.len { >> errors.new("grpc: truncated HPACK integer") }
    mask := (1 << prefix) - 1
    mut n := r.raw[r.i] & mask
    r.i += 1
    if n < mask { << n }
    mut shift := 0
    while r.i < r.raw.len {
        b := r.raw[r.i] & 255
        r.i += 1
        n += (b & 127) << shift
        if n > 2147483647 { >> errors.new("grpc: HPACK integer too large") }
        if (b & 128) == 0 { << n }
        shift += 7
        if shift > 28 { >> errors.new("grpc: HPACK integer too large") }
    }
    >> errors.new("grpc: truncated HPACK integer")
}

fn (r &mut HpackReader) text() string {
    if r.i >= r.raw.len { >> errors.new("grpc: truncated HPACK string") }
    huffman := (r.raw[r.i] & 128) != 0
    n := r.integer(7) or >>
    if n > 65536 || n > r.raw.len - r.i { >> errors.new("grpc: truncated HPACK string") }
    text := r.raw[r.i:r.i + n] + ""
    r.i += n
    if huffman { << decode_huffman(text) or >> }
    << text
}

fn decode_hpack(raw string) HpackHeaders {
    names := hpack_static_names()
    values := hpack_static_values()
    mut r := HpackReader{raw: raw, i: 0}
    mut out := HpackHeaders{names: []string{}, values: []string{}}
    mut saw_field := false
    while r.i < r.raw.len {
        b := r.raw[r.i] & 255
        if (b & 224) == 32 {
            if saw_field { >> errors.new("grpc: HPACK table update after field") }
            size := r.integer(5) or >>
            if size != 0 { >> errors.new("grpc: HPACK exceeds advertised table size") }
            ->
        }
        mut name := ""
        mut value := ""
        if (b & 128) != 0 {
            idx := r.integer(7) or >>
            if idx < 1 || idx > 61 { >> errors.new("grpc: invalid HPACK index") }
            name = names[idx - 1] + ""
            value = values[idx - 1] + ""
        } else {
            mut prefix := 4
            if (b & 64) != 0 { prefix = 6 }
            idx := r.integer(prefix) or >>
            if idx == 0 { name = r.text() or >> }
            else {
                if idx > 61 { >> errors.new("grpc: invalid HPACK name index") }
                name = names[idx - 1] + ""
            }
            value = r.text() or >>
        }
        if name.len == 0 { >> errors.new("grpc: empty HPACK header name") }
        out.names.push(name)
        out.values.push(value)
        if out.names.len > 1024 { >> errors.new("grpc: too many headers") }
        saw_field = true
    }
    << out
}

// RFC 7541 Appendices A/B: https://www.rfc-editor.org/rfc/rfc7541.txt
// HEADER_TABLE_SIZE=0 keeps independent unary calls free of dynamic entries.

fn hpack_static_names() []string {
    << [":authority", ":method", ":method", ":path", ":path", ":scheme", ":scheme", ":status", ":status", ":status", ":status", ":status", ":status", ":status", "accept-charset", "accept-encoding", "accept-language", "accept-ranges", "accept", "access-control-allow-origin", "age", "allow", "authorization", "cache-control", "content-disposition", "content-encoding", "content-language", "content-length", "content-location", "content-range", "content-type", "cookie", "date", "etag", "expect", "expires", "from", "host", "if-match", "if-modified-since", "if-none-match", "if-range", "if-unmodified-since", "last-modified", "link", "location", "max-forwards", "proxy-authenticate", "proxy-authorization", "range", "referer", "refresh", "retry-after", "server", "set-cookie", "strict-transport-security", "transfer-encoding", "user-agent", "vary", "via", "www-authenticate"]
}
fn hpack_static_values() []string {
    << ["", "GET", "POST", "/", "/index.html", "http", "https", "200", "204", "206", "304", "400", "404", "500", "", "gzip, deflate", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""]
}
