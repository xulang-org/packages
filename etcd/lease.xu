@"github.com/xulang-org/packages/etcd"

#errors

pub fn (c &mut Client) lease_grant(ttl_seconds int) int {
    mut reusable := false
    << c.lease_grant_at(-1, ttl_seconds, mut &reusable) or >>
}

fn (c &mut Client) lease_grant_at(fd int, ttl_seconds int, reusable &mut bool) int {
    body := "{\"TTL\":\"" + str(ttl_seconds) + "\",\"ID\":\"0\"}"
    resp := c.request_at(fd, "/v3/lease/grant", body, reusable) or >>
    if resp.status_code != 200 {
        >> errors.new("etcd: lease_grant failed (" + str(resp.status_code) + "): " + resp.body)
    }
    id_str := extract_json_value(resp.body, "ID")
    if id_str.len == 0 {
        >> errors.new("etcd: missing lease ID in response")
    }
    id_val := parse_int(id_str) or (err) {
        >> errors.new("etcd: invalid lease ID: " + err.msg())
    }
    << id_val
}

pub fn (c &mut Client) lease_revoke(lease_id int) int {
    mut reusable := false
    << c.lease_revoke_at(-1, lease_id, mut &reusable) or >>
}

fn (c &mut Client) lease_revoke_at(fd int, lease_id int, reusable &mut bool) int {
    body := "{\"ID\":\"" + str(lease_id) + "\"}"
    resp := c.request_at(fd, "/v3/lease/revoke", body, reusable) or >>
    if resp.status_code != 200 {
        >> errors.new("etcd: lease_revoke failed (" + str(resp.status_code) + "): " + resp.body)
    }
    << 0
}

pub fn (c &mut Client) lease_keepalive(lease_id int) int {
    mut reusable := false
    << c.lease_keepalive_at(-1, lease_id, mut &reusable) or >>
}

fn (c &mut Client) lease_keepalive_at(fd int, lease_id int, reusable &mut bool) int {
    body := "{\"ID\":\"" + str(lease_id) + "\"}"
    resp := c.request_at(fd, "/v3/lease/keepalive", body, reusable) or >>
    if resp.status_code != 200 {
        >> errors.new("etcd: lease_keepalive failed (" + str(resp.status_code) + "): " + resp.body)
    }
    << 0
}
