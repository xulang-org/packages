@"github.com/xulang-org/packages/etcd"

#encoding/base64
#errors

fn extract_json_value(json_str string, key_field string) string {
    target := "\"" + key_field + "\":\""
    $pos := -1
    $i := 0
    while i + target.len <= json_str.len {
        if json_str[i:(i + target.len)] == target {
            pos = i + target.len
            <-
        }
        i = i + 1
    }
    if pos < 0 {
        << ""
    }
    $end_pos := -1
    $j := pos
    while j < json_str.len {
        if (json_str[j] & 255) == 34 { // double quote '"'
            end_pos = j
            <-
        }
        j = j + 1
    }
    if end_pos < 0 {
        << ""
    }
    << json_str[pos:end_pos]
}

pub fn (c $&Client) put(key string, value string) int {
    $reusable := false
    << c.put_at(-1, key, value, $&reusable) or >>
}

fn (c $&Client) put_at(fd int, key string, value string, reusable $&bool) int {
    k_b64 := base64.encode_to_string(key)
    v_b64 := base64.encode_to_string(value)
    body := "{\"key\":\"" + k_b64 + "\",\"value\":\"" + v_b64 + "\"}"
    resp := c.request_at(fd, "/v3/kv/put", body, reusable) or >>
    if resp.status_code != 200 {
        >> errors.new("etcd: put failed (" + str(resp.status_code) + "): " + resp.body)
    }
    << 0
}

pub fn (c $&Client) put_with_lease(key string, value string, lease_id int) int {
    $reusable := false
    << c.put_with_lease_at(-1, key, value, lease_id, $&reusable) or >>
}

fn (c $&Client) put_with_lease_at(fd int, key string, value string, lease_id int, reusable $&bool) int {
    k_b64 := base64.encode_to_string(key)
    v_b64 := base64.encode_to_string(value)
    body := "{\"key\":\"" + k_b64 + "\",\"value\":\"" + v_b64 + "\",\"lease\":\"" + str(lease_id) + "\"}"
    resp := c.request_at(fd, "/v3/kv/put", body, reusable) or >>
    if resp.status_code != 200 {
        >> errors.new("etcd: put_with_lease failed (" + str(resp.status_code) + "): " + resp.body)
    }
    << 0
}

fn contains_kvs(body string) bool {
    target := "\"kvs\":"
    $i := 0
    while i + target.len <= body.len {
        if body[i:(i + target.len)] == target {
            << true
        }
        i = i + 1
    }
    << false
}

pub fn (c $&Client) get(key string) string {
    $reusable := false
    << c.get_at(-1, key, $&reusable) or >>
}

fn (c $&Client) get_at(fd int, key string, reusable $&bool) string {
    k_b64 := base64.encode_to_string(key)
    body := "{\"key\":\"" + k_b64 + "\"}"
    resp := c.request_at(fd, "/v3/kv/range", body, reusable) or >>
    if resp.status_code != 200 {
        >> errors.new("etcd: get failed (" + str(resp.status_code) + "): " + resp.body)
    }
    if !contains_kvs(resp.body) {
        >> errors.new("etcd: key not found")
    }
    v_b64 := extract_json_value(resp.body, "value")
    if v_b64.len == 0 {
        << ""
    }
    raw := base64.decode_string(v_b64) or (err) {
        >> errors.new("etcd: base64 decode failed: " + err.msg())
    }
    << raw
}

pub fn (c $&Client) exists(key string) bool {
    $reusable := false
    << c.exists_at(-1, key, $&reusable)
}

fn (c $&Client) exists_at(fd int, key string, reusable $&bool) bool {
    k_b64 := base64.encode_to_string(key)
    body := "{\"key\":\"" + k_b64 + "\"}"
    resp := c.request_at(fd, "/v3/kv/range", body, reusable) or (err) {
        << false
    }
    if resp.status_code != 200 {
        << false
    }
    << contains_kvs(resp.body)
}

pub fn (c $&Client) delete(key string) int {
    $reusable := false
    << c.delete_at(-1, key, $&reusable) or >>
}

fn (c $&Client) delete_at(fd int, key string, reusable $&bool) int {
    k_b64 := base64.encode_to_string(key)
    body := "{\"key\":\"" + k_b64 + "\"}"
    resp := c.request_at(fd, "/v3/kv/deleterange", body, reusable) or >>
    if resp.status_code != 200 {
        >> errors.new("etcd: delete failed (" + str(resp.status_code) + "): " + resp.body)
    }
    << 0
}
