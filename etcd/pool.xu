@"github.com/xulang-org/packages/etcd"

#net
#net/pool
#errors
#strings

// Connection Pool for etcd v3.
// Manages reusable TCP/HTTP socket connections.
pub struct Pool {
    pub host string
    pub port int
    pub secure bool
    pub endpoint string
    pub state chan pool.State
    pub max_idle int
}

pub fn new_pool(endpoint string, max_idle int) Pool {
    c := new_client(endpoint + "")
    mut cap_val := max_idle
    if cap_val <= 0 {
        cap_val = 10
    }
    ch := pool.new_state()
    << Pool{
        host: c.host,
        port: c.port,
        secure: c.secure,
        endpoint: endpoint,
        state: ch,
        max_idle: cap_val
    }
}

pub fn (p &Pool) get() Client {
    << Client{host: p.host + "", port: p.port, secure: p.secure}
}

// Shares sockets and close state; clones configuration strings.
pub fn (p &Pool) dup() Pool {
    << Pool{host: strings.clone(&p.host), port: p.port, secure: p.secure, endpoint: strings.clone(&p.endpoint), state: p.state, max_idle: p.max_idle}
}

pub fn (p &Pool) get_conn() int {
    if p.secure { << -1 }
    sockets := pool.SocketPool{state: p.state, max_idle: p.max_idle}
    cached := sockets.take()
    if cached == -2 { << -1 }
    if cached >= 0 { << cached }
    addr := p.host + ":" + str(p.port)
    fd := net.dial(strings.clone(&addr)) or (err) { << -1 }
    if !sockets.adopt(fd) { << -1 }
    << fd
}

pub fn (p &Pool) put_conn(fd int) {
    if p.secure { << }
    sockets := pool.SocketPool{state: p.state, max_idle: p.max_idle}
    sockets.release(fd, true)
}

pub fn (p &Pool) discard_conn(fd int) {
    if p.secure { << }
    sockets := pool.SocketPool{state: p.state, max_idle: p.max_idle}
    sockets.release(fd, false)
}

pub fn (p &Pool) put(key string, value string) int {
    if p.secure {
        mut c := p.get()
        result := c.put(key, value) or (err) { << 0 }
        << result
    }
    fd := p.get_conn()
    if fd < 0 { >> errors.new("etcd: pool closed or dial failed") }
    mut reusable := false
    mut c := p.get()
    result := c.put_at(fd, key, value, mut &reusable) or (err) {
        p.discard_conn(fd)
        >> err
    }
    if reusable { p.put_conn(fd) } else { p.discard_conn(fd) }
    << result
}

pub fn (p &Pool) get_key(key string) string {
    if p.secure {
        mut c := p.get()
        result := c.get(key) or (err) { << "" }
        << result
    }
    fd := p.get_conn()
    if fd < 0 { >> errors.new("etcd: pool closed or dial failed") }
    mut reusable := false
    mut c := p.get()
    result := c.get_at(fd, key, mut &reusable) or (err) {
        p.discard_conn(fd)
        >> err
    }
    if reusable { p.put_conn(fd) } else { p.discard_conn(fd) }
    << result
}

pub fn (p &Pool) delete(key string) int {
    if p.secure {
        mut c := p.get()
        result := c.delete(key) or (err) { << 0 }
        << result
    }
    fd := p.get_conn()
    if fd < 0 { >> errors.new("etcd: pool closed or dial failed") }
    mut reusable := false
    mut c := p.get()
    result := c.delete_at(fd, key, mut &reusable) or (err) {
        p.discard_conn(fd)
        >> err
    }
    if reusable { p.put_conn(fd) } else { p.discard_conn(fd) }
    << result
}

pub fn (p &Pool) exists(key string) bool {
    if p.secure {
        mut c := p.get()
        result := c.exists(key) or (err) { << false }
        << result
    }
    fd := p.get_conn()
    if fd < 0 { << false }
    mut reusable := false
    mut c := p.get()
    result := c.exists_at(fd, key, mut &reusable)
    if reusable && result { p.put_conn(fd) } else { p.discard_conn(fd) }
    << result
}

pub fn (p &Pool) close() {
    sockets := pool.SocketPool{state: p.state, max_idle: p.max_idle}
    sockets.close()
}
