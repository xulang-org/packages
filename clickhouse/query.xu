@"github.com/xulang-org/packages/clickhouse"

#errors

pub fn (c $&Client) exec(sql_query string) int {
    $reusable := false
    << c.exec_at(-1, sql_query, $&reusable) or >>
}

fn (c $&Client) exec_at(fd int, sql_query string, reusable $&bool) int {
    resp := c.request_at(fd, sql_query, reusable) or >>
    if resp.status_code != 200 {
        >> errors.new("clickhouse: exec failed (status " + str(resp.status_code) + "): " + resp.body)
    }
    << 0
}

pub fn (c $&Client) query(sql_query string) string {
    $reusable := false
    << c.query_at(-1, sql_query, $&reusable) or >>
}

fn (c $&Client) query_at(fd int, sql_query string, reusable $&bool) string {
    resp := c.request_at(fd, sql_query, reusable) or >>
    if resp.status_code != 200 {
        >> errors.new("clickhouse: query failed (status " + str(resp.status_code) + "): " + resp.body)
    }
    << resp.body
}

pub fn (c $&Client) query_tsv(sql_query string) [][]string {
    $reusable := false
    << c.query_tsv_at(-1, sql_query, $&reusable) or >>
}

fn (c $&Client) query_tsv_at(fd int, sql_query string, reusable $&bool) [][]string {
    raw := c.query_at(fd, sql_query, reusable) or >>
    << parse_tsv(raw)
}

pub fn (c $&Client) ping() bool {
    resp := c.request("SELECT 1") or (err) {
        << false
    }
    << resp.status_code == 200
}

pub fn (c $&Client) insert(table string, values_sql string) int {
    sql_text := "INSERT INTO " + table + " VALUES " + values_sql
    << c.exec(sql_text)
}
