@"github.com/xulang-org/packages/mysql"

#database/sql/driver
#context
#encoding/hex
#net
#strconv
#strings
#time
#crypto/tls
#crypto/x509
transport #github.com/xulang-org/packages/transport

pub struct MysqlDriver {
    pub tag int
    pub dsn string
}

struct MysqlState {
    pub fd int
    pub secure int
    pub tc_chan chan transport.Conn
    pub closed int
    pub open_err string
    pub tx int
}

struct MysqlConn {
    pub st chan MysqlState
}

struct MysqlStmt {
    pub st chan MysqlState
    pub q string
}

struct MysqlTx {
    pub st chan MysqlState
}

fn quote_string(s &string) string {
    $out := "'"
    for i in 0:s.len {
        c := s[i] & 255
        if c == 0 { out = out + "\\0" }
        else if c == 10 { out = out + "\\n" }
        else if c == 13 { out = out + "\\r" }
        else if c == 92 { out = out + "\\\\" }
        else if c == 39 { out = out + "''" }
        else if c == 34 { out = out + "\\\"" }
        else if c == 26 { out = out + "\\Z" }
        else { out.push_byte(c) }
    }
    << out + "'"
}

fn mysql_arg_val(args &[]driver.NamedValue, i int) string {
    if i < 0 || i >= args.len {
        << "NULL"
    }
    if args[i].value is int {
        x := args[i].value as int
        << str(x)
    }
    if args[i].value is string {
        x := args[i].value as string
        << quote_string(&x)
    }
    if args[i].value is bool {
        x := args[i].value as bool
        if x { << "1" }
        << "0"
    }
    if args[i].value is f64 {
        x := args[i].value as f64
        << strconv.format_float(x, 103, -1) or (err) { << "0" }
    }
    if args[i].value is time.Time {
        x := args[i].value as time.Time
        ts := x.format_rfc3339()
        << quote_string(&ts)
    }
    if args[i].value is []u8 {
        bs := args[i].value as []u8
        $raw := ""
        for k in 0:bs.len { raw.push_byte(int(bs[k]) & 255) }
        << "X'" + hex.encode_to_string(raw) + "'"
    }
    << "NULL"
}

fn arg_at(args &[]driver.NamedValue, i int) string {
    << mysql_arg_val(args, i)
}

fn interpolate(q string, args &[]driver.NamedValue) string {
    if args.len == 0 { << strings.clone(&q) }
    $out := ""
    $i := 0
    $ai := 0
    $quote := 0
    $line_comment := false
    $block_comment := false
    while i < q.len {
        c := q[i] & 255
        if line_comment {
            out.push_byte(c)
            if c == 10 || c == 13 { line_comment = false }
            i += 1
            ->
        }
        if block_comment {
            out.push_byte(c)
            if c == 42 && i + 1 < q.len && (q[i + 1] & 255) == 47 {
                out.push_byte(47)
                i += 2
                block_comment = false
            } else { i += 1 }
            ->
        }
        if quote != 0 {
            out.push_byte(c)
            if c == 92 && i + 1 < q.len {
                out.push_byte(q[i + 1] & 255)
                i += 2
                ->
            }
            if c == quote {
                if i + 1 < q.len && (q[i + 1] & 255) == quote {
                    out.push_byte(quote)
                    i += 2
                    ->
                }
                quote = 0
            }
            i += 1
            ->
        }
        if c == 39 || c == 34 || c == 96 {
            quote = c
            out.push_byte(c)
            i += 1
            ->
        }
        if c == 35 {
            line_comment = true
            out.push_byte(c)
            i += 1
            ->
        }
        if c == 45 && i + 2 < q.len && (q[i + 1] & 255) == 45 && ((q[i + 2] & 255) == 32 || (q[i + 2] & 255) == 9) {
            line_comment = true
            out.push_byte(45)
            out.push_byte(45)
            i += 2
            ->
        }
        if c == 47 && i + 1 < q.len && (q[i + 1] & 255) == 42 {
            block_comment = true
            out.push_byte(47)
            out.push_byte(42)
            i += 2
            ->
        }
        if c == 63 && ai < args.len {
            out = out + arg_at(args, ai)
            ai += 1
            i += 1
            ->
        }
        out.push_byte(c)
        i += 1
    }
    if ai != args.len { << "" }
    << out
}

fn parse_coldef(body string) ColumnDef {
    $off := 0
    $name := ""
    for i in 0:6 {
        r := read_len(&body, off)
        if r.err.len > 0 || r.null != 0 || r.next + r.n > body.len { << ColumnDef{name: "", kind: -1} }
        if i == 4 { name = body[r.next:r.next + r.n] }
        off = r.next + r.n
    }
    fixed := read_len(&body, off)
    if fixed.err.len > 0 || fixed.next + fixed.n > body.len || fixed.n < 7 { << ColumnDef{name: "", kind: -1} }
    kind_off := fixed.next + 2 + 4
    if kind_off >= body.len { << ColumnDef{name: "", kind: -1} }
    << ColumnDef{name: name, kind: body[kind_off] & 255}
}

fn is_eof(body &string) bool {
    << body.len > 0 && (body[0] & 255) == 254 && body.len < 9
}

fn mysql_cell(kind int, payload string) string {
    if kind == 1 || kind == 2 || kind == 3 || kind == 8 || kind == 9 || kind == 13 { << "i:" + payload }
    if kind == 4 || kind == 5 || kind == 246 { << "f:" + payload }
    if kind == 249 || kind == 250 || kind == 251 || kind == 252 || kind == 255 {
        $bs := []u8{}
        for i in 0:payload.len { bs.push(u8(payload[i] & 255)) }
        << driver.encode_value(bs)
    }
    << "s:" + payload
}

fn parse_ok(body string) QueryResult {
    $qr := empty_query()
    if body.len == 0 || (body[0] & 255) != 0 {
        qr.err = "mysql: malformed OK packet"
        << qr
    }
    a := read_len(&body, 1)
    if a.err.len > 0 {
        qr.err = a.err
        << qr
    }
    b := read_len(&body, a.next)
    if b.err.len > 0 {
        qr.err = b.err
        << qr
    }
    qr.rows_affected = a.n
    qr.last_id = b.n
    << qr
}

fn parse_result(fd int, first string) QueryResult {
    if first.len == 0 {
        $q := empty_query()
        q.err = "mysql: empty response"
        << q
    }
    tag := first[0] & 255
    if tag == 0 { << parse_ok(first) }
    if tag == 255 {
        $q := empty_query()
        q.err = err_text(first)
        << q
    }
    cnt := read_len(&first, 0)
    if cnt.err.len > 0 || cnt.null != 0 || cnt.n < 0 || cnt.n > 4096 {
        $q := empty_query()
        q.err = "mysql: malformed result set"
        << q
    }
    $qr := empty_query()
    qr.ncols = cnt.n
    $kinds := []int{}
    for i in 0:cnt.n {
        p := recv_packet(fd)
        if p.err.len > 0 {
            qr.err = p.err
            << qr
        }
        if p.payload.len > 0 && (p.payload[0] & 255) == 255 {
            qr.err = err_text(p.payload)
            << qr
        }
        d := parse_coldef(p.payload)
        if d.kind < 0 {
            qr.err = "mysql: malformed column definition"
            << qr
        }
        qr.columns.push(d.name)
        kinds.push(d.kind)
    }
    eof := recv_packet(fd)
    if eof.err.len > 0 {
        qr.err = eof.err
        << qr
    }
    eof_payload := eof.payload
    if !is_eof(&eof_payload) && eof_payload.len > 0 && (eof_payload[0] & 255) == 255 {
        qr.err = err_text(eof_payload)
        << qr
    }
    $done := false
    while !done {
        p := recv_packet(fd)
        if p.err.len > 0 {
            qr.err = p.err
            << qr
        }
        if is_eof(&p.payload) {
            done = true
            ->
        }
        if p.payload.len > 0 && (p.payload[0] & 255) == 255 {
            qr.err = err_text(p.payload)
            << qr
        }
        $off := 0
        for i in 0:cnt.n {
            r := read_len(&p.payload, off)
            if r.err.len > 0 {
                qr.err = r.err
                << qr
            }
            off = r.next
            if r.null != 0 { qr.cells.push("n:") }
            else {
                if off + r.n > p.payload.len {
                    qr.err = "mysql: malformed row"
                    << qr
                }
                value := p.payload[off:off + r.n]
                off += r.n
                qr.cells.push(mysql_cell(kinds[i], value))
            }
        }
    }
    << qr
}

fn query_wire(fd int, q string, args &[]driver.NamedValue) QueryResult {
    sql := interpolate(strings.clone(&q), args)
    $qr := empty_query()
    if sql.len == 0 && (q.len > 0 || args.len > 0) {
        qr.err = "mysql: parameter count mismatch"
        << qr
    }
    e := send_packet(fd, 0, string_from_byte(3) + sql)
    if e.len > 0 {
        qr.err = e
        << qr
    }
    p := recv_packet(fd)
    if p.err.len > 0 {
        qr.err = p.err
        << qr
    }
    << parse_result(fd, p.payload)
}

fn command_ok(fd int, command int) string {
    e := send_packet(fd, 0, string_from_byte(command))
    if e.len > 0 { << e }
    p := recv_packet(fd)
    if p.err.len > 0 { << p.err }
    if p.payload.len == 0 { << "mysql: empty response" }
    if (p.payload[0] & 255) == 0 { << "" }
    if (p.payload[0] & 255) == 255 { << err_text(p.payload) }
    << "mysql: unexpected command response"
}

fn parse_result_tls(tc $&transport.Conn, first string) QueryResult {
    if first.len == 0 {
        $q := empty_query()
        q.err = "mysql: empty response"
        << q
    }
    tag := first[0] & 255
    if tag == 0 { << parse_ok(first) }
    if tag == 255 {
        $q := empty_query()
        q.err = err_text(first)
        << q
    }
    cnt := read_len(&first, 0)
    if cnt.err.len > 0 || cnt.null != 0 || cnt.n < 0 || cnt.n > 4096 {
        $q := empty_query()
        q.err = "mysql: malformed result set"
        << q
    }
    $qr := empty_query()
    qr.ncols = cnt.n
    $kinds := []int{}
    for i in 0:cnt.n {
        p := recv_packet_tls(tc)
        if p.err.len > 0 {
            qr.err = p.err
            << qr
        }
        if p.payload.len > 0 && (p.payload[0] & 255) == 255 {
            qr.err = err_text(p.payload)
            << qr
        }
        d := parse_coldef(p.payload)
        if d.kind < 0 {
            qr.err = "mysql: malformed column definition"
            << qr
        }
        qr.columns.push(d.name)
        kinds.push(d.kind)
    }
    eof := recv_packet_tls(tc)
    if eof.err.len > 0 {
        qr.err = eof.err
        << qr
    }
    eof_payload := eof.payload
    if !is_eof(&eof_payload) && eof_payload.len > 0 && (eof_payload[0] & 255) == 255 {
        qr.err = err_text(eof_payload)
        << qr
    }
    $done := false
    while !done {
        p := recv_packet_tls(tc)
        if p.err.len > 0 {
            qr.err = p.err
            << qr
        }
        if is_eof(&p.payload) {
            done = true
            ->
        }
        if p.payload.len > 0 && (p.payload[0] & 255) == 255 {
            qr.err = err_text(p.payload)
            << qr
        }
        $off := 0
        for i in 0:cnt.n {
            r := read_len(&p.payload, off)
            if r.err.len > 0 {
                qr.err = r.err
                << qr
            }
            off = r.next
            if r.null != 0 { qr.cells.push("n:") }
            else {
                if off + r.n > p.payload.len {
                    qr.err = "mysql: malformed row"
                    << qr
                }
                value := p.payload[off:off + r.n]
                off += r.n
                qr.cells.push(mysql_cell(kinds[i], value))
            }
        }
    }
    << qr
}

fn query_wire_tls(tc $&transport.Conn, q string, args &[]driver.NamedValue) QueryResult {
    sql := interpolate(strings.clone(&q), args)
    $qr := empty_query()
    if sql.len == 0 && (q.len > 0 || args.len > 0) {
        qr.err = "mysql: parameter count mismatch"
        << qr
    }
    e := send_packet_tls(tc, 0, string_from_byte(3) + sql)
    if e.len > 0 {
        qr.err = e
        << qr
    }
    p := recv_packet_tls(tc)
    if p.err.len > 0 {
        qr.err = p.err
        << qr
    }
    << parse_result_tls(tc, p.payload)
}

fn command_ok_tls(tc $&transport.Conn, command int) string {
    e := send_packet_tls(tc, 0, string_from_byte(command))
    if e.len > 0 { << e }
    p := recv_packet_tls(tc)
    if p.err.len > 0 { << p.err }
    if p.payload.len == 0 { << "mysql: empty response" }
    if (p.payload[0] & 255) == 0 { << "" }
    if (p.payload[0] & 255) == 255 { << err_text(p.payload) }
    << "mysql: unexpected command response"
}

fn take_st(c &MysqlConn) MysqlState { << <- c.st }
fn put_st(c &MysqlConn, s MysqlState) { c.st <- s }

fn closed_tc_chan() chan transport.Conn {
    ch := chan transport.Conn{cap: 1}
    ch <- transport.closed_conn()
    << ch
}

fn query_state(s $&MysqlState, q string, args &[]driver.NamedValue) QueryResult {
    if s.secure != 0 {
        $tc := <-s.tc_chan
        qr := query_wire_tls($&tc, q, args)
        s.tc_chan <- tc
        << qr
    }
    << query_wire(s.fd, q, args)
}

fn command_state(s $&MysqlState, command int) string {
    if s.secure != 0 {
        $tc := <-s.tc_chan
        e := command_ok_tls($&tc, command)
        s.tc_chan <- tc
        << e
    }
    << command_ok(s.fd, command)
}

fn close_fd(fd int) {
    net.conn_close(fd) or (err) { << }
    <<
}

fn close_tls_quiet(tc $&transport.Conn) int {
    tc.close() or (err) { << 0 }
    << 0
}

fn failed_conn(msg string) driver.Conn {
    ch := chan MysqlState{cap: 1}
    ch <- MysqlState{fd: -1, secure: 0, tc_chan: closed_tc_chan(), closed: 1, open_err: msg, tx: 0}
    << driver.Conn(MysqlConn{st: ch})
}

fn read_greeting(raw $&net.Conn) Packet {
    $hdr := raw.read(4) or (err) { << Packet{payload: "", seq: 0, err: err.msg()} }
    if hdr.len != 4 { << Packet{payload: "", seq: 0, err: "mysql: short greeting header"} }
    n := le24_at(&hdr, 0)
    if n < 0 || n > 16777216 { << Packet{payload: "", seq: 0, err: "mysql: invalid greeting length"} }
    payload := raw.read(n) or (err) { << Packet{payload: "", seq: 0, err: err.msg()} }
    if payload.len != n { << Packet{payload: "", seq: 0, err: "mysql: short greeting"} }
    << Packet{payload: payload, seq: hdr[3] & 255, err: ""}
}

fn server_caps(greeting string) int {
    if greeting.len < 1 { << -1 }
    $off := 1
    while off < greeting.len && (greeting[off] & 255) != 0 { off += 1 }
    off += 1 + 4 + 8 + 1
    if off + 2 > greeting.len { << -1 }
    low := le16_at(&greeting, off)
    off += 2
    if off + 1 + 2 + 2 > greeting.len { << low }
    off += 1 + 2
    high := le16_at(&greeting, off)
    if high < 0 { << low }
    << low | (high << 16)
}

fn new_conn_tls(cfg Config) driver.Conn {
    port_text := str(cfg.port)
    addr := net.join_host_port(&cfg.host, &port_text)
    $raw := net.dial_to("tcp", addr) or (err) { << failed_conn(err.msg()) }
    greeting := read_greeting($&raw)
    if greeting.err.len > 0 {
        raw.close() or (e) { << failed_conn(greeting.err) }
        << failed_conn(greeting.err)
    }
    caps := server_caps(greeting.payload)
    if caps < 0 || (caps & 2048) == 0 {
        raw.close() or (e) { << failed_conn("mysql: server does not advertise CLIENT_SSL") }
        << failed_conn("mysql: server does not advertise CLIENT_SSL")
    }
    ssl_req := le32(caps | 1 | 8 | 512 | 32768) + le32(16777216) + string_from_byte(45)
    $req := ssl_req
    for i in 0:23 { req = req + string_from_byte(0) }
    frame := le24(req.len) + string_from_byte(1) + req
    raw.write(&frame) or (err) {
        raw.close() or (e) { << failed_conn(err.msg()) }
        << failed_conn(err.msg())
    }
    $tc_cfg := tls.new_config(cfg.host + "")
    if cfg.root_cert_file.len > 0 {
        pem := read_file(cfg.root_cert_file) or (err) { << failed_conn(err.msg()) }
        ncert := x509.append_certificates($&tc_cfg.root_cas, &pem) or (err) { << failed_conn(err.msg()) }
        if ncert <= 0 { << failed_conn("mysql: no certificates in tlsrootcert") }
    }
    tls_raw := tls.client(raw, &tc_cfg) or (err) { << failed_conn(err.msg()) }
    $tr := transport.Conn{fd: -1, tls_conn: tls_raw, secure: true, closed: false, eof: false, buf: ""}
    auth_err := handshake_tls_greeting($&tr, &cfg, greeting)
    tcch := chan transport.Conn{cap: 1}
    tcch <- tr
    ch := chan MysqlState{cap: 1}
    if auth_err.len > 0 {
        ch <- MysqlState{fd: -1, secure: 0, tc_chan: closed_tc_chan(), closed: 1, open_err: auth_err, tx: 0}
    } else {
        ch <- MysqlState{fd: -1, secure: 1, tc_chan: tcch, closed: 0, open_err: "", tx: 0}
    }
    << driver.Conn(MysqlConn{st: ch})
}

fn new_conn(cfg Config) driver.Conn {
    if cfg.tls_mode != "false" && cfg.tls_mode != "0" && cfg.tls_mode != "disabled" {
        << new_conn_tls(cfg)
    }
    fd := net.dial(cfg.host + ":" + str(cfg.port)) or (err) {
        ch := chan MysqlState{cap: 1}
        ch <- MysqlState{fd: -1, secure: 0, tc_chan: closed_tc_chan(), closed: 1, open_err: err.msg(), tx: 0}
        << driver.Conn(MysqlConn{st: ch})
    }
    err := handshake(fd, &cfg)
    ch := chan MysqlState{cap: 1}
    if err.len > 0 {
        close_fd(fd)
        ch <- MysqlState{fd: -1, secure: 0, tc_chan: closed_tc_chan(), closed: 1, open_err: err, tx: 0}
    } else { ch <- MysqlState{fd: fd, secure: 0, tc_chan: closed_tc_chan(), closed: 0, open_err: "", tx: 0} }
    << driver.Conn(MysqlConn{st: ch})
}

fn (d MysqlDriver) open(name string) driver.Conn {
    cfg := parse_dsn(name) or (err) {
        ch := chan MysqlState{cap: 1}
        ch <- MysqlState{fd: -1, secure: 0, tc_chan: closed_tc_chan(), closed: 1, open_err: err.msg(), tx: 0}
        << driver.Conn(MysqlConn{st: ch})
    }
    << new_conn(cfg)
}

fn (d MysqlDriver) connect(ctx &context.Context) driver.Conn {
    _ := ctx
    << d.open(d.dsn)
}

fn (d MysqlDriver) dup() driver.Driver { << driver.Driver(MysqlDriver{tag: d.tag, dsn: d.dsn}) }
fn (d MysqlDriver) driver() driver.Driver { << driver.Driver(MysqlDriver{tag: d.tag, dsn: d.dsn}) }

fn (c MysqlConn) dup() driver.Conn { << driver.Conn(MysqlConn{st: c.st}) }

fn fail_exec(msg string) driver.ExecResult { << driver.exec_err(msg) }
fn fail_rows(msg string) driver.RowsResult { << driver.rows_err(msg) }

fn copy_strings(src &[]string) []string {
    $out := []string{}
    for i in 0:src.len { out.push(src[i]) }
    << out
}

fn (c MysqlConn) ping() string {
    $s := take_st(&c)
    if s.open_err.len > 0 {
        msg := s.open_err
        put_st(&c, s)
        << msg
    }
    if s.closed != 0 {
        put_st(&c, s)
        << "sql: connection is closed"
    }
    e := command_state($&s, 14)
    if e.len > 0 {
        s.closed = 1
        put_st(&c, s)
        << driver.err_bad_conn()
    }
    put_st(&c, s)
    << ""
}

fn (c MysqlConn) close() string {
    $s := take_st(&c)
    if s.closed != 0 {
        put_st(&c, s)
        << ""
    }
    fd := s.fd
    s.closed = 1
    s.fd = -1
    if s.secure != 0 {
        $tc := <-s.tc_chan
        close_tls_quiet($&tc)
        s.tc_chan <- transport.closed_conn()
    } else if fd >= 0 {
        _ := send_packet(fd, 0, string_from_byte(1))
        close_fd(fd)
    }
    put_st(&c, s)
    << ""
}

fn (c MysqlConn) is_valid() bool {
    $s := take_st(&c)
    ok := s.closed == 0 && s.open_err.len == 0 && s.tx == 0
    put_st(&c, s)
    << ok
}

fn (c MysqlConn) reset_session(ctx &context.Context) string {
    _ := ctx
    $s := take_st(&c)
    if s.closed != 0 {
        put_st(&c, s)
        << driver.err_bad_conn()
    }
    noargs := []driver.NamedValue{}
    qr := query_state($&s, "ROLLBACK", &noargs)
    if qr.err.len > 0 {
        s.closed = 1
        put_st(&c, s)
        << driver.err_bad_conn()
    }
    s.tx = 0
    put_st(&c, s)
    << ""
}

fn (c MysqlConn) exec(q string, args []driver.NamedValue) driver.ExecResult {
    $s := take_st(&c)
    if s.open_err.len > 0 {
        msg := s.open_err
        put_st(&c, s)
        << fail_exec(msg)
    }
    if s.closed != 0 {
        put_st(&c, s)
        << fail_exec("sql: connection is closed")
    }
    qr := query_state($&s, q, &args)
    if qr.err.len > 0 {
        if strings.contains(&qr.err, "connection") {
            s.closed = 1
            put_st(&c, s)
            << fail_exec(driver.err_bad_conn())
        }
        put_st(&c, s)
        << fail_exec(qr.err)
    }
    put_st(&c, s)
    << driver.exec_ok(qr.last_id, qr.rows_affected)
}

fn (c MysqlConn) query(q string, args []driver.NamedValue) driver.RowsResult {
    $s := take_st(&c)
    if s.open_err.len > 0 {
        msg := s.open_err
        put_st(&c, s)
        << fail_rows(msg)
    }
    if s.closed != 0 {
        put_st(&c, s)
        << fail_rows("sql: connection is closed")
    }
    qr := query_state($&s, q, &args)
    if qr.err.len > 0 {
        if strings.contains(&qr.err, "connection") {
            s.closed = 1
            put_st(&c, s)
            << fail_rows(driver.err_bad_conn())
        }
        put_st(&c, s)
        << fail_rows(qr.err)
    }
    cols := copy_strings(&qr.columns)
    cells := copy_strings(&qr.cells)
    ncols := qr.ncols
    put_st(&c, s)
    << driver.RowsResult{columns: cols, cells: cells, ncols: ncols, err: ""}
}

fn (c MysqlConn) prepare(q string) driver.Stmt { << driver.Stmt(MysqlStmt{st: c.st, q: strings.clone(&q)}) }
fn (c MysqlConn) prepare_context(ctx &context.Context, q string) driver.Stmt {
    _ := ctx
    << c.prepare(q)
}

fn (c MysqlConn) begin() driver.Tx { << c.begin_tx(0, false) }
fn (c MysqlConn) begin_tx(iso int, ro bool) driver.Tx {
    $s := take_st(&c)
    if s.closed != 0 || s.open_err.len > 0 {
        put_st(&c, s)
        << driver.Tx(MysqlTx{st: c.st})
    }
    $q := "START TRANSACTION"
    if ro { q = "START TRANSACTION READ ONLY" }
    _ := iso
    noargs := []driver.NamedValue{}
    qr := query_state($&s, q, &noargs)
    if qr.err.len == 0 { s.tx = 1 }
    put_st(&c, s)
    << driver.Tx(MysqlTx{st: c.st})
}

fn (t MysqlTx) commit() string {
    $c := MysqlConn{st: t.st}
    $s := take_st(&c)
    if s.closed != 0 {
        put_st(&c, s)
        << "sql: connection is closed"
    }
    noargs := []driver.NamedValue{}
    qr := query_state($&s, "COMMIT", &noargs)
    s.tx = 0
    put_st(&c, s)
    << qr.err
}

fn (t MysqlTx) rollback() string {
    $c := MysqlConn{st: t.st}
    $s := take_st(&c)
    if s.closed != 0 {
        put_st(&c, s)
        << "sql: connection is closed"
    }
    noargs := []driver.NamedValue{}
    qr := query_state($&s, "ROLLBACK", &noargs)
    s.tx = 0
    put_st(&c, s)
    << qr.err
}

fn count_params(q string) int {
    $n := 0
    $quote := 0
    $i := 0
    while i < q.len {
        c := q[i] & 255
        if quote != 0 {
            if c == 92 && i + 1 < q.len {
                i += 2
                ->
            }
            if c == quote { quote = 0 }
        } else if c == 39 || c == 34 || c == 96 { quote = c }
        else if c == 63 { n += 1 }
        i += 1
    }
    << n
}

fn (s MysqlStmt) num_input() int { << count_params(s.q) }
fn (s MysqlStmt) exec(args []driver.NamedValue) driver.ExecResult {
    c := MysqlConn{st: s.st}
    << c.exec(s.q, args)
}
fn (s MysqlStmt) query(args []driver.NamedValue) driver.RowsResult {
    c := MysqlConn{st: s.st}
    << c.query(s.q, args)
}
fn (s MysqlStmt) close() string { << "" }
