@"github.com/xulang-org/packages/mysql"

#database/sql/driver
#context
#encoding/hex
#net
#strconv
#strings
#time

pub struct MysqlDriver {
    pub tag int
    pub dsn string
}

struct MysqlState {
    pub fd int
    pub closed int
    pub open_err string
    pub tx int
}

struct MysqlConn {
    pub st chan MysqlState
}

struct MysqlStmt {
    pub st chan MysqlState
    pub q string
}

struct MysqlTx {
    pub st chan MysqlState
}

fn quote_string(s &string) string {
    mut out := "'"
    for i in 0:s.len {
        c := s[i] & 255
        if c == 0 { out = out + "\\0" }
        else if c == 10 { out = out + "\\n" }
        else if c == 13 { out = out + "\\r" }
        else if c == 92 { out = out + "\\\\" }
        else if c == 39 { out = out + "''" }
        else if c == 34 { out = out + "\\\"" }
        else if c == 26 { out = out + "\\Z" }
        else { out.push_byte(c) }
    }
    << out + "'"
}

fn mysql_arg_val(args &[]driver.NamedValue, i int) string {
    if i < 0 || i >= args.len {
        << "NULL"
    }
    if args[i].value is int {
        x := args[i].value as int
        << str(x)
    }
    if args[i].value is string {
        x := args[i].value as string
        << quote_string(&x)
    }
    if args[i].value is bool {
        x := args[i].value as bool
        if x { << "1" }
        << "0"
    }
    if args[i].value is f64 {
        x := args[i].value as f64
        << strconv.format_float(x, 103, -1) or (err) { << "0" }
    }
    if args[i].value is time.Time {
        x := args[i].value as time.Time
        ts := x.format_rfc3339()
        << quote_string(&ts)
    }
    if args[i].value is []u8 {
        bs := args[i].value as []u8
        mut raw := ""
        for k in 0:bs.len { raw.push_byte(int(bs[k]) & 255) }
        << "X'" + hex.encode_to_string(raw) + "'"
    }
    << "NULL"
}

fn arg_at(args &[]driver.NamedValue, i int) string {
    << mysql_arg_val(args, i)
}

fn interpolate(q string, args &[]driver.NamedValue) string {
    if args.len == 0 { << strings.clone(&q) }
    mut out := ""
    mut i := 0
    mut ai := 0
    mut quote := 0
    mut line_comment := false
    mut block_comment := false
    while i < q.len {
        c := q[i] & 255
        if line_comment {
            out.push_byte(c)
            if c == 10 || c == 13 { line_comment = false }
            i += 1
            ->
        }
        if block_comment {
            out.push_byte(c)
            if c == 42 && i + 1 < q.len && (q[i + 1] & 255) == 47 {
                out.push_byte(47)
                i += 2
                block_comment = false
            } else { i += 1 }
            ->
        }
        if quote != 0 {
            out.push_byte(c)
            if c == 92 && i + 1 < q.len {
                out.push_byte(q[i + 1] & 255)
                i += 2
                ->
            }
            if c == quote {
                if i + 1 < q.len && (q[i + 1] & 255) == quote {
                    out.push_byte(quote)
                    i += 2
                    ->
                }
                quote = 0
            }
            i += 1
            ->
        }
        if c == 39 || c == 34 || c == 96 {
            quote = c
            out.push_byte(c)
            i += 1
            ->
        }
        if c == 35 {
            line_comment = true
            out.push_byte(c)
            i += 1
            ->
        }
        if c == 45 && i + 2 < q.len && (q[i + 1] & 255) == 45 && ((q[i + 2] & 255) == 32 || (q[i + 2] & 255) == 9) {
            line_comment = true
            out.push_byte(45)
            out.push_byte(45)
            i += 2
            ->
        }
        if c == 47 && i + 1 < q.len && (q[i + 1] & 255) == 42 {
            block_comment = true
            out.push_byte(47)
            out.push_byte(42)
            i += 2
            ->
        }
        if c == 63 && ai < args.len {
            out = out + arg_at(args, ai)
            ai += 1
            i += 1
            ->
        }
        out.push_byte(c)
        i += 1
    }
    if ai != args.len { << "" }
    << out
}

fn parse_coldef(body string) ColumnDef {
    mut off := 0
    mut name := ""
    for i in 0:6 {
        r := read_len(&body, off)
        if r.err.len > 0 || r.null != 0 || r.next + r.n > body.len { << ColumnDef{name: "", kind: -1} }
        if i == 4 { name = body[r.next:r.next + r.n] }
        off = r.next + r.n
    }
    fixed := read_len(&body, off)
    if fixed.err.len > 0 || fixed.next + fixed.n > body.len || fixed.n < 7 { << ColumnDef{name: "", kind: -1} }
    kind_off := fixed.next + 2 + 4
    if kind_off >= body.len { << ColumnDef{name: "", kind: -1} }
    << ColumnDef{name: name, kind: body[kind_off] & 255}
}

fn is_eof(body &string) bool {
    << body.len > 0 && (body[0] & 255) == 254 && body.len < 9
}

fn mysql_cell(kind int, payload string) string {
    if kind == 1 || kind == 2 || kind == 3 || kind == 8 || kind == 9 || kind == 13 { << "i:" + payload }
    if kind == 4 || kind == 5 || kind == 246 { << "f:" + payload }
    if kind == 249 || kind == 250 || kind == 251 || kind == 252 || kind == 255 {
        mut bs := []u8{}
        for i in 0:payload.len { bs.push(u8(payload[i] & 255)) }
        << driver.encode_value(bs)
    }
    << "s:" + payload
}

fn parse_ok(body string) QueryResult {
    mut qr := empty_query()
    if body.len == 0 || (body[0] & 255) != 0 {
        qr.err = "mysql: malformed OK packet"
        << qr
    }
    a := read_len(&body, 1)
    if a.err.len > 0 {
        qr.err = a.err
        << qr
    }
    b := read_len(&body, a.next)
    if b.err.len > 0 {
        qr.err = b.err
        << qr
    }
    qr.rows_affected = a.n
    qr.last_id = b.n
    << qr
}

fn parse_result(fd int, first string) QueryResult {
    if first.len == 0 {
        mut q := empty_query()
        q.err = "mysql: empty response"
        << q
    }
    tag := first[0] & 255
    if tag == 0 { << parse_ok(first) }
    if tag == 255 {
        mut q := empty_query()
        q.err = err_text(first)
        << q
    }
    cnt := read_len(&first, 0)
    if cnt.err.len > 0 || cnt.null != 0 || cnt.n < 0 || cnt.n > 4096 {
        mut q := empty_query()
        q.err = "mysql: malformed result set"
        << q
    }
    mut qr := empty_query()
    qr.ncols = cnt.n
    mut kinds := []int{}
    for i in 0:cnt.n {
        p := recv_packet(fd)
        if p.err.len > 0 {
            qr.err = p.err
            << qr
        }
        if p.payload.len > 0 && (p.payload[0] & 255) == 255 {
            qr.err = err_text(p.payload)
            << qr
        }
        d := parse_coldef(p.payload)
        if d.kind < 0 {
            qr.err = "mysql: malformed column definition"
            << qr
        }
        qr.columns.push(d.name)
        kinds.push(d.kind)
    }
    eof := recv_packet(fd)
    if eof.err.len > 0 {
        qr.err = eof.err
        << qr
    }
    eof_payload := eof.payload
    if !is_eof(&eof_payload) && eof_payload.len > 0 && (eof_payload[0] & 255) == 255 {
        qr.err = err_text(eof_payload)
        << qr
    }
    mut done := false
    while !done {
        p := recv_packet(fd)
        if p.err.len > 0 {
            qr.err = p.err
            << qr
        }
        if is_eof(&p.payload) {
            done = true
            ->
        }
        if p.payload.len > 0 && (p.payload[0] & 255) == 255 {
            qr.err = err_text(p.payload)
            << qr
        }
        mut off := 0
        for i in 0:cnt.n {
            r := read_len(&p.payload, off)
            if r.err.len > 0 {
                qr.err = r.err
                << qr
            }
            off = r.next
            if r.null != 0 { qr.cells.push("n:") }
            else {
                if off + r.n > p.payload.len {
                    qr.err = "mysql: malformed row"
                    << qr
                }
                value := p.payload[off:off + r.n]
                off += r.n
                qr.cells.push(mysql_cell(kinds[i], value))
            }
        }
    }
    << qr
}

fn query_wire(fd int, q string, args &[]driver.NamedValue) QueryResult {
    sql := interpolate(strings.clone(&q), args)
    mut qr := empty_query()
    if sql.len == 0 && (q.len > 0 || args.len > 0) {
        qr.err = "mysql: parameter count mismatch"
        << qr
    }
    e := send_packet(fd, 0, string_from_byte(3) + sql)
    if e.len > 0 {
        qr.err = e
        << qr
    }
    p := recv_packet(fd)
    if p.err.len > 0 {
        qr.err = p.err
        << qr
    }
    << parse_result(fd, p.payload)
}

fn command_ok(fd int, command int) string {
    e := send_packet(fd, 0, string_from_byte(command))
    if e.len > 0 { << e }
    p := recv_packet(fd)
    if p.err.len > 0 { << p.err }
    if p.payload.len == 0 { << "mysql: empty response" }
    if (p.payload[0] & 255) == 0 { << "" }
    if (p.payload[0] & 255) == 255 { << err_text(p.payload) }
    << "mysql: unexpected command response"
}

fn take_st(c &MysqlConn) MysqlState { << <- c.st }
fn put_st(c &MysqlConn, s MysqlState) { c.st <- s }

fn close_fd(fd int) {
    net.conn_close(fd) or (err) { << }
    <<
}

fn new_conn(cfg Config) driver.Conn {
    fd := net.dial(cfg.host + ":" + str(cfg.port)) or (err) {
        ch := chan MysqlState{cap: 1}
        ch <- MysqlState{fd: -1, closed: 1, open_err: err.msg(), tx: 0}
        << driver.Conn(MysqlConn{st: ch})
    }
    err := handshake(fd, &cfg)
    ch := chan MysqlState{cap: 1}
    if err.len > 0 {
        close_fd(fd)
        ch <- MysqlState{fd: -1, closed: 1, open_err: err, tx: 0}
    } else { ch <- MysqlState{fd: fd, closed: 0, open_err: "", tx: 0} }
    << driver.Conn(MysqlConn{st: ch})
}

fn (d MysqlDriver) open(name string) driver.Conn {
    cfg := parse_dsn(name) or (err) {
        ch := chan MysqlState{cap: 1}
        ch <- MysqlState{fd: -1, closed: 1, open_err: err.msg(), tx: 0}
        << driver.Conn(MysqlConn{st: ch})
    }
    << new_conn(cfg)
}

fn (d MysqlDriver) connect(ctx &context.Context) driver.Conn {
    _ := ctx
    << d.open(d.dsn)
}

fn (d MysqlDriver) dup() driver.Driver { << driver.Driver(MysqlDriver{tag: d.tag, dsn: d.dsn}) }
fn (d MysqlDriver) driver() driver.Driver { << driver.Driver(MysqlDriver{tag: d.tag, dsn: d.dsn}) }

fn (c MysqlConn) dup() driver.Conn { << driver.Conn(MysqlConn{st: c.st}) }

fn fail_exec(msg string) driver.ExecResult { << driver.exec_err(msg) }
fn fail_rows(msg string) driver.RowsResult { << driver.rows_err(msg) }

fn copy_strings(src &[]string) []string {
    mut out := []string{}
    for i in 0:src.len { out.push(src[i]) }
    << out
}

fn (c MysqlConn) ping() string {
    mut s := take_st(&c)
    if s.open_err.len > 0 {
        msg := s.open_err
        put_st(&c, s)
        << msg
    }
    if s.closed != 0 {
        put_st(&c, s)
        << "sql: connection is closed"
    }
    e := command_ok(s.fd, 14)
    if e.len > 0 {
        s.closed = 1
        put_st(&c, s)
        << driver.err_bad_conn()
    }
    put_st(&c, s)
    << ""
}

fn (c MysqlConn) close() string {
    mut s := take_st(&c)
    if s.closed != 0 {
        put_st(&c, s)
        << ""
    }
    fd := s.fd
    s.closed = 1
    s.fd = -1
    put_st(&c, s)
    if fd >= 0 {
        _ := send_packet(fd, 0, string_from_byte(1))
        close_fd(fd)
    }
    << ""
}

fn (c MysqlConn) is_valid() bool {
    mut s := take_st(&c)
    ok := s.closed == 0 && s.open_err.len == 0 && s.tx == 0
    put_st(&c, s)
    << ok
}

fn (c MysqlConn) reset_session(ctx &context.Context) string {
    _ := ctx
    mut s := take_st(&c)
    if s.closed != 0 {
        put_st(&c, s)
        << driver.err_bad_conn()
    }
    noargs := []driver.NamedValue{}
    qr := query_wire(s.fd, "ROLLBACK", &noargs)
    if qr.err.len > 0 {
        s.closed = 1
        put_st(&c, s)
        << driver.err_bad_conn()
    }
    s.tx = 0
    put_st(&c, s)
    << ""
}

fn (c MysqlConn) exec(q string, args []driver.NamedValue) driver.ExecResult {
    mut s := take_st(&c)
    if s.open_err.len > 0 {
        msg := s.open_err
        put_st(&c, s)
        << fail_exec(msg)
    }
    if s.closed != 0 {
        put_st(&c, s)
        << fail_exec("sql: connection is closed")
    }
    qr := query_wire(s.fd, q, &args)
    if qr.err.len > 0 {
        if strings.contains(&qr.err, "connection") {
            s.closed = 1
            put_st(&c, s)
            << fail_exec(driver.err_bad_conn())
        }
        put_st(&c, s)
        << fail_exec(qr.err)
    }
    put_st(&c, s)
    << driver.exec_ok(qr.last_id, qr.rows_affected)
}

fn (c MysqlConn) query(q string, args []driver.NamedValue) driver.RowsResult {
    mut s := take_st(&c)
    if s.open_err.len > 0 {
        msg := s.open_err
        put_st(&c, s)
        << fail_rows(msg)
    }
    if s.closed != 0 {
        put_st(&c, s)
        << fail_rows("sql: connection is closed")
    }
    qr := query_wire(s.fd, q, &args)
    if qr.err.len > 0 {
        if strings.contains(&qr.err, "connection") {
            s.closed = 1
            put_st(&c, s)
            << fail_rows(driver.err_bad_conn())
        }
        put_st(&c, s)
        << fail_rows(qr.err)
    }
    cols := copy_strings(&qr.columns)
    cells := copy_strings(&qr.cells)
    ncols := qr.ncols
    put_st(&c, s)
    << driver.RowsResult{columns: cols, cells: cells, ncols: ncols, err: ""}
}

fn (c MysqlConn) prepare(q string) driver.Stmt { << driver.Stmt(MysqlStmt{st: c.st, q: strings.clone(&q)}) }
fn (c MysqlConn) prepare_context(ctx &context.Context, q string) driver.Stmt {
    _ := ctx
    << c.prepare(q)
}

fn (c MysqlConn) begin() driver.Tx { << c.begin_tx(0, false) }
fn (c MysqlConn) begin_tx(iso int, ro bool) driver.Tx {
    mut s := take_st(&c)
    if s.closed != 0 || s.open_err.len > 0 {
        put_st(&c, s)
        << driver.Tx(MysqlTx{st: c.st})
    }
    mut q := "START TRANSACTION"
    if ro { q = "START TRANSACTION READ ONLY" }
    _ := iso
    noargs := []driver.NamedValue{}
    qr := query_wire(s.fd, q, &noargs)
    if qr.err.len == 0 { s.tx = 1 }
    put_st(&c, s)
    << driver.Tx(MysqlTx{st: c.st})
}

fn (t MysqlTx) commit() string {
    mut c := MysqlConn{st: t.st}
    mut s := take_st(&c)
    if s.closed != 0 {
        put_st(&c, s)
        << "sql: connection is closed"
    }
    noargs := []driver.NamedValue{}
    qr := query_wire(s.fd, "COMMIT", &noargs)
    s.tx = 0
    put_st(&c, s)
    << qr.err
}

fn (t MysqlTx) rollback() string {
    mut c := MysqlConn{st: t.st}
    mut s := take_st(&c)
    if s.closed != 0 {
        put_st(&c, s)
        << "sql: connection is closed"
    }
    noargs := []driver.NamedValue{}
    qr := query_wire(s.fd, "ROLLBACK", &noargs)
    s.tx = 0
    put_st(&c, s)
    << qr.err
}

fn count_params(q string) int {
    mut n := 0
    mut quote := 0
    mut i := 0
    while i < q.len {
        c := q[i] & 255
        if quote != 0 {
            if c == 92 && i + 1 < q.len {
                i += 2
                ->
            }
            if c == quote { quote = 0 }
        } else if c == 39 || c == 34 || c == 96 { quote = c }
        else if c == 63 { n += 1 }
        i += 1
    }
    << n
}

fn (s MysqlStmt) num_input() int { << count_params(s.q) }
fn (s MysqlStmt) exec(args []driver.NamedValue) driver.ExecResult {
    c := MysqlConn{st: s.st}
    << c.exec(s.q, args)
}
fn (s MysqlStmt) query(args []driver.NamedValue) driver.RowsResult {
    c := MysqlConn{st: s.st}
    << c.query(s.q, args)
}
fn (s MysqlStmt) close() string { << "" }
