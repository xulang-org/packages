@"github.com/xulang-org/packages/redis"

#errors

pub const TYPE_STR = 1
pub const TYPE_INT = 2
pub const TYPE_ARR = 3
pub const TYPE_NIL = 4
pub const TYPE_ERR = 5
pub const TYPE_BOOL = 6
pub const TYPE_MAP = 7
pub const TYPE_SET = 8
pub const TYPE_PUSH = 9
pub const TYPE_DOUBLE = 10
pub const TYPE_BIG_NUMBER = 11
pub const TYPE_VERBATIM = 12

pub struct Value {
    pub typ int
    pub str_val string
    pub int_val int
    pub arr_val []string
    pub is_null bool
    // Complete RESP encoding preserves typed children without recursive structs.
    pub raw string
}

pub fn nil_value() Value {
    << Value{typ: TYPE_NIL, str_val: "", int_val: 0, arr_val: []string{}, is_null: true, raw: "_\r\n"}
}

pub fn str_value(s string) Value {
    raw := "$$" + str(s.len) + "\r\n" + s + "\r\n"
    << Value{typ: TYPE_STR, str_val: s, int_val: 0, arr_val: []string{}, is_null: false, raw: raw}
}

pub fn int_value(n int) Value {
    << Value{typ: TYPE_INT, str_val: "", int_val: n, arr_val: []string{}, is_null: false, raw: ":" + str(n) + "\r\n"}
}

pub fn arr_value(arr []string) Value {
    mut raw := "*" + str(arr.len) + "\r\n"
    for i in 0:arr.len { raw = raw + "$$" + str(arr[i].len) + "\r\n" + arr[i] + "\r\n" }
    << Value{typ: TYPE_ARR, str_val: "", int_val: 0, arr_val: arr, is_null: false, raw: raw}
}

pub fn err_value(msg string) Value {
    raw := "!" + str(msg.len) + "\r\n" + msg + "\r\n"
    << Value{typ: TYPE_ERR, str_val: msg, int_val: 0, arr_val: []string{}, is_null: false, raw: raw}
}

pub fn bool_value(b bool) Value {
    mut n := 0
    mut raw := "#f\r\n"
    if b {
        n = 1
        raw = "#t\r\n"
    }
    << Value{typ: TYPE_BOOL, str_val: "", int_val: n, arr_val: []string{}, is_null: false, raw: raw}
}

pub fn (v &Value) is_nil() bool {
    << v.is_null || v.typ == TYPE_NIL
}

pub fn (v &Value) is_err() bool {
    << v.typ == TYPE_ERR
}

pub fn (v &Value) as_string() string {
    if v.is_null {
        >> errors.new("redis: value is nil")
    }
    if v.typ == TYPE_ERR {
        >> errors.new(v.str_val)
    }
    if v.typ != TYPE_STR && v.typ != TYPE_VERBATIM { >> errors.new("redis: not a string") }
    << v.str_val + ""
}

pub fn (v &Value) as_string_or(def string) string {
    if v.is_null || v.typ == TYPE_NIL {
        << def
    }
    if v.typ == TYPE_ERR {
        >> errors.new(v.str_val)
    }
    if v.typ != TYPE_STR && v.typ != TYPE_VERBATIM { >> errors.new("redis: not a string") }
    << v.str_val + ""
}

pub fn (v &Value) as_int() int {
    if v.is_null {
        >> errors.new("redis: value is nil")
    }
    if v.typ == TYPE_ERR {
        >> errors.new(v.str_val)
    }
    if v.typ != TYPE_INT { >> errors.new("redis: not an integer") }
    << v.int_val
}

pub fn (v &Value) as_bool() bool {
    if v.is_null {
        >> errors.new("redis: value is nil")
    }
    if v.typ == TYPE_ERR { >> errors.new(v.str_val) }
    if v.typ != TYPE_BOOL && v.typ != TYPE_INT { >> errors.new("redis: not a bool") }
    << v.int_val != 0
}

// Map elements are alternating keys and values; set/push/array elements keep
// their own types. Null, error, nested aggregates and empty strings differ.
pub fn (v &Value) elements() []Value {
    if v.typ != TYPE_ARR && v.typ != TYPE_MAP && v.typ != TYPE_SET && v.typ != TYPE_PUSH {
        >> errors.new("redis: not an aggregate")
    }
    mut c := Client{fd: -1, addr: "", buf: v.raw + ""}
    line := c.read_line() or >>
    count := parse_int(line[1:line.len]) or >>
    mut total := count
    if v.typ == TYPE_MAP { total = count * 2 }
    mut out := []Value{}
    for i in 0:total { out.push(c.read_value() or >>) }
    << out
}

pub fn (v &Value) as_strings() []string {
    if v.typ != TYPE_ARR && v.typ != TYPE_SET { >> errors.new("redis: not a string array") }
    values := v.elements() or >>
    mut out := []string{}
    for i in 0:values.len { out.push(values[i].as_string() or >>) }
    << out
}
