@"github.com/xulang-org/packages/redis"

pub fn encode_cmd(args []string) string {
    $out := "*" + str(args.len) + "\r\n"
    $i := 0
    while i < args.len {
        s := args[i]
        out = out + "$$" + str(s.len) + "\r\n" + s + "\r\n"
        i = i + 1
    }
    << out
}

pub fn find_crlf(s &string) int {
    if s.len < 2 {
        << -1
    }
    $i := 0
    while i + 1 < s.len {
        if (s[i] & 255) == 13 && (s[i + 1] & 255) == 10 {
            << i
        }
        i = i + 1
    }
    << -1
}
