@"github.com/xulang-org/packages/s3"

#net
#net/http
#time
#errors
#strings

pub struct Response {
    pub status_code int
    pub body string
}

pub struct Client {
    pub host string
    pub port int
    pub access_key string
    pub secret_key string
    pub region string
}

fn parse_int_def(s string, def int) int {
    if s.len == 0 {
        << def
    }
    n := parse_int(s) or (err) {
        << def
    }
    << n
}

fn safe_close(fd int) {
    if fd >= 0 {
        net.conn_close(fd) or (e) {
            <<
        }
    }
}

fn parse_endpoint(raw string) []string {
    mut ep := raw
    prefix_http := "http://"
    if ep.len >= prefix_http.len && ep[0:prefix_http.len] == prefix_http {
        ep = ep[prefix_http.len:ep.len]
    }
    mut host := "127.0.0.1"
    mut port := 9000
    mut colon := -1
    mut i := 0
    while i < ep.len {
        if (ep[i] & 255) == 58 {
            colon = i
            <-
        }
        i = i + 1
    }
    if colon >= 0 {
        host = ep[0:colon]
        p_str := ep[(colon + 1):ep.len]
        port = parse_int_def(p_str, 9000)
    } else {
        if ep.len > 0 {
            host = ep
        }
    }
    << [host, str(port)]
}

pub fn new_client(endpoint string, access_key string, secret_key string, region string) Client {
    ep_parts := parse_endpoint(endpoint)
    host := ep_parts[0]
    port := parse_int_def(ep_parts[1], 9000)
    mut reg := region
    if reg.len == 0 {
        reg = "us-east-1"
    }
    << Client{
        host: host,
        port: port,
        access_key: access_key,
        secret_key: secret_key,
        region: reg
    }
}

fn pad2(n int) string {
    if n < 10 {
        << "0" + str(n)
    }
    << str(n)
}

fn get_amz_dates() []string {
    t := time.now_time()
    y := t.year()
    mo := t.month()
    d := t.day()
    h := t.hour()
    mi := t.minute()
    s := t.second()
    date_stamp := str(y) + pad2(mo) + pad2(d)
    amz_date := date_stamp + "T" + pad2(h) + pad2(mi) + pad2(s) + "Z"
    << [amz_date, date_stamp]
}

pub fn (c &mut Client) request(method string, path string, body string, content_type string) Response {
    addr := c.host + ":" + str(c.port)
    fd := net.dial(strings.clone(&addr)) or (err) {
        >> errors.new("s3: dial failed: " + err.msg())
    }
    mut reusable := false
    result := c.request_on_fd(fd, method, path, body, content_type, mut &reusable) or (err) {
        safe_close(fd)
        >> err
    }
    safe_close(fd)
    << result
}

fn (c &mut Client) request_at(fd int, method string, path string, body string, content_type string, reusable &mut bool) Response {
    if fd < 0 { << c.request(method, path, body, content_type) or >> }
    << c.request_on_fd(fd, method, path, body, content_type, reusable) or >>
}

fn (c &mut Client) request_on_fd(fd int, method string, path string, body string, content_type string, reusable &mut bool) Response {
    *reusable = false

    mut p := path
    if p.len == 0 || (p[0] & 255) != 47 {
        p = "/" + p
    }

    dates := get_amz_dates()
    amz_date := dates[0]
    date_stamp := dates[1]
    payload_hash := sha256_hex(body + "")

    host_hdr := c.host + ":" + str(c.port)
    auth_hdr := compute_auth_header(
        method + "",
        p + "",
        host_hdr + "",
        c.access_key + "",
        c.secret_key + "",
        c.region + "",
        amz_date + "",
        date_stamp,
        payload_hash + ""
    )

    mut req := method + " " + p + " HTTP/1.1\r\n"
    req = req + "Host: " + host_hdr + "\r\n"
    req = req + "x-amz-date: " + amz_date + "\r\n"
    req = req + "x-amz-content-sha256: " + payload_hash + "\r\n"
    req = req + "Authorization: " + auth_hdr + "\r\n"
    if content_type.len > 0 {
        req = req + "Content-Type: " + content_type + "\r\n"
    }
    req = req + "Content-Length: " + str(body.len) + "\r\n"
    req = req + "Connection: keep-alive\r\n\r\n"
    if body.len > 0 {
        req = req + body
    }

    // Send request
    mut off := 0
    while off < req.len {
        part := req[off:req.len]
        n := net.conn_write(fd, &part) or (err) {
            >> errors.new("s3: write failed: " + err.msg())
        }
        if n <= 0 {
            >> errors.new("s3: connection closed during write")
        }
        off = off + n
    }

    // Read response
    resp := http.read_response(fd, method + "") or (err) {
        >> err
    }
    *reusable = resp.status_code >= 200 && resp.status_code < 300 && resp.reusable(method)
    << Response{status_code: resp.status_code, body: resp.body}
}
