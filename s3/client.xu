@"github.com/xulang-org/packages/s3"

#net
#net/http
#crypto/tls
#time
#errors
#strings
transport #github.com/xulang-org/packages/transport

pub struct Response {
    pub status_code int
    pub body string
}

pub struct Client {
    pub host string
    pub port int
    pub secure bool
    pub access_key string
    pub secret_key string
    pub region string
}

fn parse_int_def(s string, def int) int {
    if s.len == 0 {
        << def
    }
    n := parse_int(s) or (err) {
        << def
    }
    << n
}

fn safe_close(fd int) {
    if fd >= 0 {
        net.conn_close(fd) or (e) {
            <<
        }
    }
}

fn parse_endpoint(raw string) []string {
    ep := transport.parse_endpoint(raw, 9000) or (err) {
        << ["127.0.0.1", "9000", "false"]
    }
    << [ep.host, str(ep.port), if_secure(ep.secure)]
}

fn if_secure(v bool) string {
    if v { << "true" }
    << "false"
}

pub fn new_client(endpoint string, access_key string, secret_key string, region string) Client {
    ep_parts := parse_endpoint(endpoint)
    host := ep_parts[0]
    port := parse_int_def(ep_parts[1], 9000)
    secure := ep_parts[2] == "true"
    $reg := region
    if reg.len == 0 {
        reg = "us-east-1"
    }
    << Client{
        host: host,
        port: port,
        secure: secure,
        access_key: access_key,
        secret_key: secret_key,
        region: reg
    }
}

fn pad2(n int) string {
    if n < 10 {
        << "0" + str(n)
    }
    << str(n)
}

fn get_amz_dates() []string {
    t := time.now_time()
    y := t.year()
    mo := t.month()
    d := t.day()
    h := t.hour()
    mi := t.minute()
    s := t.second()
    date_stamp := str(y) + pad2(mo) + pad2(d)
    amz_date := date_stamp + "T" + pad2(h) + pad2(mi) + pad2(s) + "Z"
    << [amz_date, date_stamp]
}

pub fn (c $&Client) request(method string, path string, body string, content_type string) Response {
    if c.secure {
        ep := transport.Endpoint{scheme: "https", host: c.host + "", port: c.port, path: "", secure: true}
        cfg := tls.new_config(c.host + "")
        $tc := transport.dial(ep, cfg, transport.DEFAULT_TIMEOUT_NS) or (err) {
            >> errors.new("s3: TLS dial failed: " + err.msg())
        }
        $reusable := false
        result := c.request_on_transport($&tc, method, path, body, content_type, $&reusable) or (err) {
            tc.close()
            >> err
        }
        tc.close()
        << result
    }
    addr := c.host + ":" + str(c.port)
    fd := net.dial(strings.clone(&addr)) or (err) {
        >> errors.new("s3: dial failed: " + err.msg())
    }
    $reusable := false
    result := c.request_on_fd(fd, method, path, body, content_type, $&reusable) or (err) {
        safe_close(fd)
        >> err
    }
    safe_close(fd)
    << result
}

fn (c $&Client) request_at(fd int, method string, path string, body string, content_type string, reusable $&bool) Response {
    if c.secure { << c.request(method, path, body, content_type) or >> }
    if fd < 0 { << c.request(method, path, body, content_type) or >> }
    << c.request_on_fd(fd, method, path, body, content_type, reusable) or >>
}

fn (c $&Client) build_request(method string, path string, body string, content_type string) string {
    $p := path
    if p.len == 0 || (p[0] & 255) != 47 { p = "/" + p }
    dates := get_amz_dates()
    amz_date := dates[0]
    date_stamp := dates[1]
    payload_hash := sha256_hex(body + "")
    host_hdr := c.host + ":" + str(c.port)
    auth_hdr := compute_auth_header(method + "", p + "", host_hdr + "", c.access_key + "", c.secret_key + "", c.region + "", amz_date + "", date_stamp, payload_hash + "")
    $req := method + " " + p + " HTTP/1.1\r\n"
    req = req + "Host: " + host_hdr + "\r\n"
    req = req + "x-amz-date: " + amz_date + "\r\n"
    req = req + "x-amz-content-sha256: " + payload_hash + "\r\n"
    req = req + "Authorization: " + auth_hdr + "\r\n"
    if content_type.len > 0 { req = req + "Content-Type: " + content_type + "\r\n" }
    req = req + "Content-Length: " + str(body.len) + "\r\n"
    req = req + "Connection: keep-alive\r\n\r\n"
    if body.len > 0 { req = req + body }
    << req
}

fn (c $&Client) request_on_transport(tc $&transport.Conn, method string, path string, body string, content_type string, reusable $&bool) Response {
    *reusable = false
    req := c.build_request(method + "", path, body, content_type)
    tc.write_all(req) or (err) { >> errors.new("s3: TLS write failed: " + err.msg()) }
    resp := transport.read_response(tc, method + "") or >>
    *reusable = resp.status_code >= 200 && resp.status_code < 300 && resp.reusable(method + "")
    << Response{status_code: resp.status_code, body: resp.body}
}

fn (c $&Client) request_on_fd(fd int, method string, path string, body string, content_type string, reusable $&bool) Response {
    *reusable = false
    req := c.build_request(method + "", path, body, content_type)

    // Send request
    $off := 0
    while off < req.len {
        part := req[off:req.len]
        n := net.conn_write(fd, &part) or (err) {
            >> errors.new("s3: write failed: " + err.msg())
        }
        if n <= 0 {
            >> errors.new("s3: connection closed during write")
        }
        off = off + n
    }

    // Read response
    resp := http.read_response(fd, method + "") or (err) {
        >> err
    }
    *reusable = resp.status_code >= 200 && resp.status_code < 300 && resp.reusable(method + "")
    << Response{status_code: resp.status_code, body: resp.body}
}
