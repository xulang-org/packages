@"github.com/xulang-org/packages/chroma"

#net
#net/http
#crypto/tls
#errors
#strings
transport #github.com/xulang-org/packages/transport

pub struct Response {
    pub status_code int
    pub headers string
    pub body string
}

pub struct Client {
    pub host string
    pub port int
    pub secure bool
    pub tenant string
    pub database string
}

fn parse_int_def(s string, def int) int {
    if s.len == 0 {
        << def
    }
    n := parse_int(s) or (err) {
        << def
    }
    << n
}

fn safe_close(fd int) {
    if fd >= 0 {
        net.conn_close(fd) or (e) {
            <<
        }
    }
}

pub fn new_client(endpoint string) Client {
    if strings.has_prefix(&endpoint, "https://") {
        ep := transport.parse_endpoint(endpoint, 8000) or (err) {
            << Client{host: "127.0.0.1", port: 8000, secure: true, tenant: "default_tenant", database: "default_database"}
        }
        << Client{host: ep.host, port: ep.port, secure: true, tenant: "default_tenant", database: "default_database"}
    }
    $ep := endpoint
    prefix_http := "http://"
    if ep.len >= prefix_http.len && ep[0:prefix_http.len] == prefix_http {
        ep = ep[prefix_http.len:ep.len]
    }
    $host := "127.0.0.1"
    $port := 8000
    $colon := -1
    $i := 0
    while i < ep.len {
        if (ep[i] & 255) == 58 {
            colon = i
            <-
        }
        i = i + 1
    }
    if colon >= 0 {
        host = ep[0:colon]
        p_str := ep[(colon + 1):ep.len]
        port = parse_int_def(p_str, 8000)
    } else {
        if ep.len > 0 {
            host = ep
        }
    }
    << Client{
        host: host,
        port: port,
        secure: false,
        tenant: "default_tenant",
        database: "default_database"
    }
}

pub fn (c Client) request(method string, path string, body string) Response {
    if c.secure {
        $req := method + " " + path + " HTTP/1.1\r\n"
        req = req + "Host: " + c.host + ":" + str(c.port) + "\r\n"
        req = req + "Content-Type: application/json\r\n"
        req = req + "Content-Length: " + str(body.len) + "\r\n"
        req = req + "Connection: close\r\n\r\n"
        if body.len > 0 { req = req + body }
        ep := transport.Endpoint{scheme: "https", host: c.host + "", port: c.port, path: "", secure: true}
        cfg := tls.new_config(c.host + "")
        resp := transport.request_raw(ep, cfg, req, method + "") or >>
        << Response{status_code: resp.status_code, headers: resp.headers, body: resp.body}
    }
    addr := c.host + ":" + str(c.port)
    fd := net.dial(strings.clone(&addr)) or (err) { >> err }
    $reusable := false
    result := c.request_on_fd(fd, method, path, body, $&reusable) or (err) {
        safe_close(fd)
        >> err
    }
    safe_close(fd)
    << result
}

fn (c Client) request_on_fd(fd int, method string, path string, body string, reusable $&bool) Response {
    $req := method + " " + path + " HTTP/1.1\r\n"
    req = req + "Host: " + c.host + ":" + str(c.port) + "\r\n"
    req = req + "Content-Type: application/json\r\n"
    req = req + "Content-Length: " + str(body.len) + "\r\n"
    req = req + "Connection: keep-alive\r\n\r\n"
    if body.len > 0 {
        req = req + body
    }

    $off := 0
    while off < req.len {
        part := req[off:req.len]
        n := net.conn_write(fd, &part) or (err) {
            >> errors.new("chroma write failed: " + err.msg())
        }
        if n <= 0 {
            >> errors.new("chroma: connection closed during write") }
        off = off + n
    }

    resp := http.read_response(fd, method + "") or (err) {
        >> err
    }
    *reusable = resp.reusable(method) && resp.status_code >= 200 && resp.status_code < 300
    << Response{status_code: resp.status_code, headers: resp.headers, body: resp.body}

}

fn (c Client) request_at(fd int, method string, path string, body string, reusable $&bool) Response {
    if c.secure {
        *reusable = false
        << c.request(method, path, body) or >>
    }
    if fd < 0 { << c.request(method, path, body) or >> }
    << c.request_on_fd(fd, method, path, body, reusable) or >>
}

pub fn (c Client) heartbeat() bool {
    $reusable := false
    result := c.heartbeat_at(-1, $&reusable) or (err) { << false }
    << result
}

fn (c Client) heartbeat_at(fd int, reusable $&bool) bool {
    resp := c.request_at(fd, "GET", "/api/v1/heartbeat", "", reusable) or >>
    << resp.status_code == 200
}

pub fn (c Client) create_collection(name string) string {
    $reusable := false
    << c.create_collection_at(-1, name, $&reusable) or >>
}

fn (c Client) create_collection_at(fd int, name string, reusable $&bool) string {
    body := "{\"name\":\"" + name + "\"}"
    resp := c.request_at(fd, "POST", "/api/v1/collections", body, reusable) or >>
    if resp.status_code != 200 && resp.status_code != 201 {
        >> errors.new("chroma: create_collection failed (" + str(resp.status_code) + "): " + resp.body)
    }
    // Extract "id" from {"name":"...","id":"uuid",...}
    needle := "\"id\":\""
    $id_pos := -1
    $i := 0
    while i + needle.len <= resp.body.len {
        if resp.body[i:(i + needle.len)] == needle {
            id_pos = i + needle.len
            <-
        }
        i = i + 1
    }
    if id_pos >= 0 {
        $end_pos := -1
        $j := id_pos
        while j < resp.body.len {
            if (resp.body[j] & 255) == 34 { // quote
                end_pos = j
                <-
            }
            j = j + 1
        }
        if end_pos > id_pos {
            << resp.body[id_pos:end_pos]
        }
    }
    << resp.body
}

pub fn (c Client) add(col_id string, ids_json string, embeddings_json string, documents_json string) bool {
    $reusable := false
    result := c.add_at(-1, col_id, ids_json, embeddings_json, documents_json, $&reusable) or (err) { << false }
    << result
}

fn (c Client) add_at(fd int, col_id string, ids_json string, embeddings_json string, documents_json string, reusable $&bool) bool {
    $body := "{\"ids\":" + ids_json + ",\"embeddings\":" + embeddings_json
    if documents_json.len > 0 {
        body = body + ",\"documents\":" + documents_json
    }
    body = body + "}"
    path := "/api/v1/collections/" + col_id + "/add"
    resp := c.request_at(fd, "POST", path, body, reusable) or >>
    << resp.status_code == 200 || resp.status_code == 201
}

pub fn (c Client) query(col_id string, query_embeddings_json string, n_results int) string {
    $reusable := false
    << c.query_at(-1, col_id, query_embeddings_json, n_results, $&reusable) or >>
}

fn (c Client) query_at(fd int, col_id string, query_embeddings_json string, n_results int, reusable $&bool) string {
    body := "{\"query_embeddings\":" + query_embeddings_json + ",\"n_results\":" + str(n_results) + "}"
    path := "/api/v1/collections/" + col_id + "/query"
    resp := c.request_at(fd, "POST", path, body, reusable) or >>
    if resp.status_code != 200 {
        >> errors.new("chroma: query failed (" + str(resp.status_code) + "): " + resp.body)
    }
    << resp.body
}

pub fn (c Client) delete_collection(name string) bool {
    $reusable := false
    result := c.delete_collection_at(-1, name, $&reusable) or (err) { << false }
    << result
}

fn (c Client) delete_collection_at(fd int, name string, reusable $&bool) bool {
    path := "/api/v1/collections/" + name
    resp := c.request_at(fd, "DELETE", path, "", reusable) or >>
    << resp.status_code == 200
}
