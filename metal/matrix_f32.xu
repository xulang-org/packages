@"github.com/xulang-org/packages/metal"

metal_native #"github.com/xulang-org/packages/metal_native"
#errors
#math

// Host arrays hold canonical uint32 IEEE 754 binary32 bits in each Xu int.
// These owners are distinct from Xu f64 and from integer GPU buffers.
pub struct F32Matrix { handle int }
pub struct F32Snapshot { handle int }

pub fn (d &Device) supports_f32_gemm() bool {
    value := checked(metal_native.device_info(d.handle, 7)) >>>
    << value == 1
}
pub fn (d &Device) matrix_kernel_count() int { << checked(metal_native.device_info(d.handle, 5)) >>> }
pub fn (d &Device) matrix_cache_size() int { << checked(metal_native.device_info(d.handle, 6)) >>> }

// Row-major logical shape; MPS row padding is owned by the runtime.
// Dimensions <=262144; at most 536870912 logical elements per matrix.
pub fn (d &Device) matrix_f32(rows int, columns int) F32Matrix {
    handle := checked(metal_native.matrix_f32_new(d.handle, rows, columns)) >>>
    << F32Matrix{handle: handle}
}
pub fn (m &F32Matrix) rows() int { << checked(metal_native.matrix_f32_info(m.handle, 1)) >>> }
pub fn (m &F32Matrix) columns() int { << checked(metal_native.matrix_f32_info(m.handle, 2)) >>> }
pub fn (m &F32Matrix) row_bytes() int { << checked(metal_native.matrix_f32_info(m.handle, 3)) >>> }

// Exact storage transfer, including NaN payloads. Rejects noncanonical upper
// bits and mismatched lengths before any write; storage is never retained.
pub fn (m $&F32Matrix) write_bits(values &[]int) int {
    << checked(metal_native.matrix_f32_write(m.handle, values)) >>>
}
pub fn (m $&F32Matrix) write_bytes(bytes &string) int {
    << checked(metal_native.matrix_f32_write_bytes(m.handle, bytes)) >>>
}
pub fn (m &F32Matrix) snapshot() F32Snapshot {
    handle := checked(metal_native.matrix_f32_snapshot(m.handle)) >>>
    << F32Snapshot{handle: handle}
}
pub fn (m &F32Matrix) bits() []int {
    count := checked(metal_native.matrix_f32_info(m.handle, 4)) >>>
    $out := []int{}
    for i in 0:count { out.push(0) }
    m.copy_bits($&out) >>>
    << out
}
// Synchronous read into existing elements, without a temporary Snapshot.
// Wait first; rejected reads leave all destination elements unchanged.
pub fn (m &F32Matrix) copy_bits(out $&[]int) int {
    << checked(metal_native.matrix_f32_copy(m.handle, out)) >>>
}
pub fn (m $&F32Matrix) close() int {
    if m.handle == 0 { << 0 }
    checked(metal_native.matrix_f32_close(m.handle)) >>>
    m.handle = 0
    << 0
}
fn (m $&F32Matrix) drop() {
    if m.handle > 0 { metal_native.matrix_f32_release(m.handle) m.handle = 0 }
}

pub fn (s &F32Snapshot) bits() []int {
    bytes := checked(metal_native.snapshot_len(s.handle)) >>>
    if (bytes & 3) != 0 { >>> errors.code(BOUNDS, "metal: snapshot is not a binary32 matrix") }
    $out := []int{}
    for i in 0:bytes/4 { out.push(0) }
    s.copy_bits($&out) >>>
    << out
}
// Writes existing elements only; trailing destination elements stay intact.
pub fn (s &F32Snapshot) copy_bits(out $&[]int) int {
    << checked(metal_native.snapshot_f32_copy(s.handle, out)) >>>
}
pub fn (s $&F32Snapshot) close() int {
    if s.handle == 0 { << 0 }
    checked(metal_native.snapshot_close(s.handle)) >>>
    s.handle = 0
    << 0
}
fn (s $&F32Snapshot) drop() {
    if s.handle > 0 { metal_native.snapshot_close(s.handle) s.handle = 0 }
}

// Explicit MPS C=A*B, alpha=1, beta=0, no transpose. Approximate f32 math:
// reduction order/FMA may differ from sequential CPU evaluation. Inputs must
// be finite normal binary32 values or signed zero; subnormal/nonfinite inputs
// are rejected before dispatch. Results may overflow/underflow in binary32.
// Storage transfer above preserves all bits, without f64 narrowing.
pub fn gemm_f32(dst $&F32Matrix, a &F32Matrix, b &F32Matrix) Fence {
    handle := checked(metal_native.gemm_f32(dst.handle, a.handle, b.handle)) >>>
    << Fence{handle: handle}
}

// gemm_f32_nt computes dst = a @ b^T where a is [M, K], b is [N, K], dst is [M, N].
pub fn gemm_f32_nt(dst $&F32Matrix, a &F32Matrix, b &F32Matrix) Fence {
    handle := checked(metal_native.gemm_f32_nt(dst.handle, a.handle, b.handle)) >>>
    << Fence{handle: handle}
}

// gemm_f32_tn computes dst = a^T @ b where a is [K, M], b is [K, N], dst is [M, N].
pub fn gemm_f32_tn(dst $&F32Matrix, a &F32Matrix, b &F32Matrix) Fence {
    handle := checked(metal_native.gemm_f32_tn(dst.handle, a.handle, b.handle)) >>>
    << Fence{handle: handle}
}

// rmsnorm_f32 computes row-wise RMSNorm(x, eps) * weight for x [M, N] and weight [1, N].
pub fn rmsnorm_f32(dst $&F32Matrix, x &F32Matrix, weight &F32Matrix, eps f64) Fence {
    handle := checked(metal_native.rmsnorm_f32(dst.handle, x.handle, weight.handle, math.float32_bits(eps))) >>>
    << Fence{handle: handle}
}

// softmax_f32 computes row-wise numerically stable softmax over x [M, N].
pub fn softmax_f32(dst $&F32Matrix, x &F32Matrix) Fence {
    handle := checked(metal_native.softmax_f32(dst.handle, x.handle)) >>>
    << Fence{handle: handle}
}

// swiglu_f32 computes element-wise SiLU(gate) * up over [M, N] matrices.
pub fn swiglu_f32(dst $&F32Matrix, gate &F32Matrix, up &F32Matrix) Fence {
    handle := checked(metal_native.swiglu_f32(dst.handle, gate.handle, up.handle)) >>>
    << Fence{handle: handle}
}

// add_f32 computes element-wise a + b over [M, N] matrices.
pub fn add_f32(dst $&F32Matrix, a &F32Matrix, b &F32Matrix) Fence {
    handle := checked(metal_native.add_f32(dst.handle, a.handle, b.handle)) >>>
    << Fence{handle: handle}
}

// layernorm_f32 computes row-wise LayerNorm(x, eps) * weight + bias for x [M, N] and [1, N] affine vectors.
pub fn layernorm_f32(dst $&F32Matrix, x &F32Matrix, weight &F32Matrix, bias &F32Matrix, eps f64) Fence {
    handle := checked(metal_native.layernorm_f32(dst.handle, x.handle, weight.handle, bias.handle, math.float32_bits(eps))) >>>
    << Fence{handle: handle}
}

// gelu_f32 computes element-wise tanh-approximated GELU over [M, N] matrices.
pub fn gelu_f32(dst $&F32Matrix, x &F32Matrix) Fence {
    handle := checked(metal_native.gelu_f32(dst.handle, x.handle)) >>>
    << Fence{handle: handle}
}

// mul_f32 computes element-wise a * b over [M, N] matrices.
pub fn mul_f32(dst $&F32Matrix, a &F32Matrix, b &F32Matrix) Fence {
    handle := checked(metal_native.mul_f32(dst.handle, a.handle, b.handle)) >>>
    << Fence{handle: handle}
}

// scale_f32 multiplies each element of x [M, N] by binary32 scalar alpha.
pub fn scale_f32(dst $&F32Matrix, x &F32Matrix, alpha f64) Fence {
    handle := checked(metal_native.scale_f32(dst.handle, x.handle, math.float32_bits(alpha))) >>>
    << Fence{handle: handle}
}

// rope_f32 applies NeoX split-half rotary position embeddings over [seq_len, n_heads * head_dim].
pub fn rope_f32(dst $&F32Matrix, x &F32Matrix, pos_offset int, head_dim int, theta f64) Fence {
    handle := checked(metal_native.rope_f32(dst.handle, x.handle, pos_offset, head_dim, math.float32_bits(theta))) >>>
    << Fence{handle: handle}
}

// rope_interleaved_f32 applies interleaved even/odd pair rotary position embeddings over [seq_len, n_heads * head_dim].
pub fn rope_interleaved_f32(dst $&F32Matrix, x &F32Matrix, pos_offset int, head_dim int, theta f64) Fence {
    handle := checked(metal_native.rope_interleaved_f32(dst.handle, x.handle, pos_offset, head_dim, math.float32_bits(theta))) >>>
    << Fence{handle: handle}
}

// rope_yarn_f32 applies YaRN NTK-by-parts scaled rotary embeddings (split-half or interleaved, optional partial rope_dim).
pub fn rope_yarn_f32(dst $&F32Matrix, x &F32Matrix, pos_offset int, head_dim int, rope_dim int,
                     interleaved bool, theta f64, scale f64, orig_ctx int,
                     beta_fast f64, beta_slow f64, attn_factor f64) Fence {
    $il := 0
    if interleaved { il = 1 }
    params := [pos_offset, head_dim, rope_dim, il, orig_ctx, math.float32_bits(theta), math.float32_bits(scale), math.float32_bits(beta_fast), math.float32_bits(beta_slow), math.float32_bits(attn_factor)]
    handle := checked(metal_native.rope_yarn_f32(dst.handle, x.handle, &params)) >>>
    << Fence{handle: handle}
}

// causal_attention_f32 computes multi-head causal GQA attention:
// q, dst: [seq_len, n_heads * head_dim]; k, v: [kv_len, n_kv_heads * head_dim].
pub fn causal_attention_f32(dst $&F32Matrix, q &F32Matrix, k &F32Matrix, v &F32Matrix,
                            n_heads int, n_kv_heads int, scale f64) Fence {
    handle := checked(metal_native.causal_attention_f32(dst.handle, q.handle, k.handle, v.handle, n_heads, n_kv_heads, math.float32_bits(scale))) >>>
    << Fence{handle: handle}
}

// qk_norm_f32 applies per-head RMSNorm across x [seq_len, n_heads * head_dim] with weight [1, head_dim].
pub fn qk_norm_f32(dst $&F32Matrix, x &F32Matrix, weight &F32Matrix, n_heads int, eps f64) Fence {
    handle := checked(metal_native.qk_norm_f32(dst.handle, x.handle, weight.handle, n_heads, math.float32_bits(eps))) >>>
    << Fence{handle: handle}
}

// kv_cache_append_f32 writes src [n, kv_dim] into cache [max_seq, kv_dim] starting at row pos_offset.
pub fn kv_cache_append_f32(cache $&F32Matrix, src &F32Matrix, pos_offset int) Fence {
    handle := checked(metal_native.kv_cache_append_f32(cache.handle, src.handle, pos_offset)) >>>
    << Fence{handle: handle}
}

// attention_decode_f32 computes single-token GQA decode attention reading kv_len cached rows from k_cache/v_cache.
pub fn attention_decode_f32(dst $&F32Matrix, q &F32Matrix, k_cache &F32Matrix, v_cache &F32Matrix,
                              kv_len int, n_heads int, n_kv_heads int, scale f64) Fence {
    handle := checked(metal_native.attention_decode_f32(dst.handle, q.handle, k_cache.handle, v_cache.handle, kv_len, n_heads, n_kv_heads, math.float32_bits(scale))) >>>
    << Fence{handle: handle}
}

// embedding_f32 gathers rows by index from table [vocab, dim] into dst [ids.len, dim].
pub fn embedding_f32(dst $&F32Matrix, table &F32Matrix, ids &[]int) Fence {
    handle := checked(metal_native.embedding_f32(dst.handle, table.handle, ids)) >>>
    << Fence{handle: handle}
}

// argmax_f32 writes the per-row argmax column index (as float32) of x [M, N] into dst [M, 1].
pub fn argmax_f32(dst $&F32Matrix, x &F32Matrix) Fence {
    handle := checked(metal_native.argmax_f32(dst.handle, x.handle)) >>>
    << Fence{handle: handle}
}

// add_rmsnorm_f32 fuses dst_sum = a + b and dst_norm = rmsnorm(dst_sum, eps) * weight.
pub fn add_rmsnorm_f32(dst_norm $&F32Matrix, dst_sum $&F32Matrix, a &F32Matrix, b &F32Matrix,
                       weight &F32Matrix, eps f64) Fence {
    handle := checked(metal_native.add_rmsnorm_f32(dst_norm.handle, dst_sum.handle, a.handle, b.handle, weight.handle, math.float32_bits(eps))) >>>
    << Fence{handle: handle}
}

// geglu_f32 computes element-wise GELU(gate) * up over [M, N] matrices.
pub fn geglu_f32(dst $&F32Matrix, gate &F32Matrix, up &F32Matrix) Fence {
    handle := checked(metal_native.geglu_f32(dst.handle, gate.handle, up.handle)) >>>
    << Fence{handle: handle}
}

// silu_f32 computes element-wise SiLU(x) = x / (1 + exp(-x)) over [M, N] matrices.
pub fn silu_f32(dst $&F32Matrix, x &F32Matrix) Fence {
    handle := checked(metal_native.silu_f32(dst.handle, x.handle)) >>>
    << Fence{handle: handle}
}

// log_softmax_f32 computes row-wise log(softmax(x)) over [M, N] matrices.
pub fn log_softmax_f32(dst $&F32Matrix, x &F32Matrix) Fence {
    handle := checked(metal_native.log_softmax_f32(dst.handle, x.handle)) >>>
    << Fence{handle: handle}
}

// moe_topk_f32 routes each token row of logits [M, E] to top-k expert indices and weights [M, k].
pub fn moe_topk_f32(out_idx $&F32Matrix, out_w $&F32Matrix, logits &F32Matrix,
                    k int, use_sigmoid bool, normalize_topk bool, weight_scale f64) Fence {
    $us := 0
    if use_sigmoid { us = 1 }
    $nt := 0
    if normalize_topk { nt = 1 }
    handle := checked(metal_native.moe_topk_f32(out_idx.handle, out_w.handle, logits.handle, k, us, nt, math.float32_bits(weight_scale))) >>>
    << Fence{handle: handle}
}

// moe_weighted_add_f32 reduces expert_outs [M * k, D] with routing weights [M, k] into dst [M, D].
pub fn moe_weighted_add_f32(dst $&F32Matrix, expert_outs &F32Matrix, weights &F32Matrix) Fence {
    handle := checked(metal_native.moe_weighted_add_f32(dst.handle, expert_outs.handle, weights.handle)) >>>
    << Fence{handle: handle}
}

// lora_add_f32 accumulates dst += scale * (x @ A^T) @ B^T over [M, in_dim], A [rank, in_dim], B [out_dim, rank].
pub fn lora_add_f32(dst $&F32Matrix, x &F32Matrix, a &F32Matrix, b &F32Matrix, scale f64) Fence {
    handle := checked(metal_native.lora_add_f32(dst.handle, x.handle, a.handle, b.handle, math.float32_bits(scale))) >>>
    << Fence{handle: handle}
}

// adamw_step_f32 updates param, m_buf, and v_buf in-place on GPU using AdamW moments and weight decay.
pub fn adamw_step_f32(param $&F32Matrix, grad &F32Matrix, m_buf $&F32Matrix, v_buf $&F32Matrix,
                      lr f64, beta1 f64, beta2 f64, eps f64, weight_decay f64, step int) Fence {
    params := [math.float32_bits(lr), math.float32_bits(beta1), math.float32_bits(beta2), math.float32_bits(eps), math.float32_bits(weight_decay), step]
    handle := checked(metal_native.adamw_step_f32(param.handle, grad.handle, m_buf.handle, v_buf.handle, &params)) >>>
    << Fence{handle: handle}
}

// cross_entropy_grad_f32 computes row-wise cross-entropy loss [B, 1] and softmax gradient [B, V] in-place.
pub fn cross_entropy_grad_f32(dlogits $&F32Matrix, losses $&F32Matrix, logits &F32Matrix, targets &F32Matrix) Fence {
    handle := checked(metal_native.cross_entropy_grad_f32(dlogits.handle, losses.handle, logits.handle, targets.handle)) >>>
    << Fence{handle: handle}
}

// rmsnorm_backward_f32 computes dx [R, C] and dw [1, C] from dy [R, C], x [R, C], and weight [1, C].
pub fn rmsnorm_backward_f32(dx $&F32Matrix, dw $&F32Matrix, dy &F32Matrix,
                            x &F32Matrix, weight &F32Matrix, eps f64) Fence {
    handle := checked(metal_native.rmsnorm_backward_f32(dx.handle, dw.handle, dy.handle, x.handle, weight.handle, math.float32_bits(eps))) >>>
    << Fence{handle: handle}
}

// swiglu_backward_f32 computes dgate [R, C] and dup [R, C] from dy [R, C], gate [R, C], and up [R, C].
pub fn swiglu_backward_f32(dgate $&F32Matrix, dup $&F32Matrix, dy &F32Matrix,
                           gate &F32Matrix, up &F32Matrix) Fence {
    handle := checked(metal_native.swiglu_backward_f32(dgate.handle, dup.handle, dy.handle, gate.handle, up.handle)) >>>
    << Fence{handle: handle}
}
