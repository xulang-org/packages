@"github.com/xulang-org/packages/metal"

metal_native #"github.com/xulang-org/packages/metal_native"
#errors
#math

// Host arrays hold canonical uint32 IEEE 754 binary32 bits in each Xu int.
// These owners are distinct from Xu f64 and from integer GPU buffers.
pub struct F32Matrix { handle int }
pub struct F32Snapshot { handle int }

pub fn (d &Device) supports_f32_gemm() bool {
    value := checked(metal_native.device_info(d.handle, 7)) >>>
    << value == 1
}
pub fn (d &Device) matrix_kernel_count() int { << checked(metal_native.device_info(d.handle, 5)) >>> }
pub fn (d &Device) matrix_cache_size() int { << checked(metal_native.device_info(d.handle, 6)) >>> }

// Row-major logical shape; MPS row padding is owned by the runtime.
// Dimensions <=16384; at most 16777216 logical elements per matrix.
pub fn (d &Device) matrix_f32(rows int, columns int) F32Matrix {
    handle := checked(metal_native.matrix_f32_new(d.handle, rows, columns)) >>>
    << F32Matrix{handle: handle}
}
pub fn (m &F32Matrix) rows() int { << checked(metal_native.matrix_f32_info(m.handle, 1)) >>> }
pub fn (m &F32Matrix) columns() int { << checked(metal_native.matrix_f32_info(m.handle, 2)) >>> }
pub fn (m &F32Matrix) row_bytes() int { << checked(metal_native.matrix_f32_info(m.handle, 3)) >>> }

// Exact storage transfer, including NaN payloads. Rejects noncanonical upper
// bits and mismatched lengths before any write; storage is never retained.
pub fn (m $&F32Matrix) write_bits(values &[]int) int {
    << checked(metal_native.matrix_f32_write(m.handle, values)) >>>
}
pub fn (m &F32Matrix) snapshot() F32Snapshot {
    handle := checked(metal_native.matrix_f32_snapshot(m.handle)) >>>
    << F32Snapshot{handle: handle}
}
pub fn (m &F32Matrix) bits() []int {
    count := checked(metal_native.matrix_f32_info(m.handle, 4)) >>>
    $out := []int{}
    for i in 0:count { out.push(0) }
    m.copy_bits($&out) >>>
    << out
}
// Synchronous read into existing elements, without a temporary Snapshot.
// Wait first; rejected reads leave all destination elements unchanged.
pub fn (m &F32Matrix) copy_bits(out $&[]int) int {
    << checked(metal_native.matrix_f32_copy(m.handle, out)) >>>
}
pub fn (m $&F32Matrix) close() int {
    if m.handle == 0 { << 0 }
    checked(metal_native.matrix_f32_close(m.handle)) >>>
    m.handle = 0
    << 0
}
fn (m $&F32Matrix) drop() {
    if m.handle > 0 { metal_native.matrix_f32_release(m.handle) m.handle = 0 }
}

pub fn (s &F32Snapshot) bits() []int {
    bytes := checked(metal_native.snapshot_len(s.handle)) >>>
    if (bytes & 3) != 0 { >>> errors.code(BOUNDS, "metal: snapshot is not a binary32 matrix") }
    $out := []int{}
    for i in 0:bytes/4 { out.push(0) }
    s.copy_bits($&out) >>>
    << out
}
// Writes existing elements only; trailing destination elements stay intact.
pub fn (s &F32Snapshot) copy_bits(out $&[]int) int {
    << checked(metal_native.snapshot_f32_copy(s.handle, out)) >>>
}
pub fn (s $&F32Snapshot) close() int {
    if s.handle == 0 { << 0 }
    checked(metal_native.snapshot_close(s.handle)) >>>
    s.handle = 0
    << 0
}
fn (s $&F32Snapshot) drop() {
    if s.handle > 0 { metal_native.snapshot_close(s.handle) s.handle = 0 }
}

// Explicit MPS C=A*B, alpha=1, beta=0, no transpose. Approximate f32 math:
// reduction order/FMA may differ from sequential CPU evaluation. Inputs must
// be finite normal binary32 values or signed zero; subnormal/nonfinite inputs
// are rejected before dispatch. Results may overflow/underflow in binary32.
// Storage transfer above preserves all bits, without f64 narrowing.
pub fn gemm_f32(dst $&F32Matrix, a &F32Matrix, b &F32Matrix) Fence {
    handle := checked(metal_native.gemm_f32(dst.handle, a.handle, b.handle)) >>>
    << Fence{handle: handle}
}

// gemm_f32_nt computes dst = a @ b^T where a is [M, K], b is [N, K], dst is [M, N].
pub fn gemm_f32_nt(dst $&F32Matrix, a &F32Matrix, b &F32Matrix) Fence {
    handle := checked(metal_native.gemm_f32_nt(dst.handle, a.handle, b.handle)) >>>
    << Fence{handle: handle}
}

// rmsnorm_f32 computes row-wise RMSNorm(x, eps) * weight for x [M, N] and weight [1, N].
pub fn rmsnorm_f32(dst $&F32Matrix, x &F32Matrix, weight &F32Matrix, eps f64) Fence {
    handle := checked(metal_native.rmsnorm_f32(dst.handle, x.handle, weight.handle, math.float32_bits(eps))) >>>
    << Fence{handle: handle}
}

// softmax_f32 computes row-wise numerically stable softmax over x [M, N].
pub fn softmax_f32(dst $&F32Matrix, x &F32Matrix) Fence {
    handle := checked(metal_native.softmax_f32(dst.handle, x.handle)) >>>
    << Fence{handle: handle}
}

// swiglu_f32 computes element-wise SiLU(gate) * up over [M, N] matrices.
pub fn swiglu_f32(dst $&F32Matrix, gate &F32Matrix, up &F32Matrix) Fence {
    handle := checked(metal_native.swiglu_f32(dst.handle, gate.handle, up.handle)) >>>
    << Fence{handle: handle}
}

// add_f32 computes element-wise a + b over [M, N] matrices.
pub fn add_f32(dst $&F32Matrix, a &F32Matrix, b &F32Matrix) Fence {
    handle := checked(metal_native.add_f32(dst.handle, a.handle, b.handle)) >>>
    << Fence{handle: handle}
}

// layernorm_f32 computes row-wise LayerNorm(x, eps) * weight + bias for x [M, N] and [1, N] affine vectors.
pub fn layernorm_f32(dst $&F32Matrix, x &F32Matrix, weight &F32Matrix, bias &F32Matrix, eps f64) Fence {
    handle := checked(metal_native.layernorm_f32(dst.handle, x.handle, weight.handle, bias.handle, math.float32_bits(eps))) >>>
    << Fence{handle: handle}
}

// gelu_f32 computes element-wise tanh-approximated GELU over [M, N] matrices.
pub fn gelu_f32(dst $&F32Matrix, x &F32Matrix) Fence {
    handle := checked(metal_native.gelu_f32(dst.handle, x.handle)) >>>
    << Fence{handle: handle}
}

// mul_f32 computes element-wise a * b over [M, N] matrices.
pub fn mul_f32(dst $&F32Matrix, a &F32Matrix, b &F32Matrix) Fence {
    handle := checked(metal_native.mul_f32(dst.handle, a.handle, b.handle)) >>>
    << Fence{handle: handle}
}

// scale_f32 multiplies each element of x [M, N] by binary32 scalar alpha.
pub fn scale_f32(dst $&F32Matrix, x &F32Matrix, alpha f64) Fence {
    handle := checked(metal_native.scale_f32(dst.handle, x.handle, math.float32_bits(alpha))) >>>
    << Fence{handle: handle}
}

// rope_f32 applies NeoX split-half rotary position embeddings over [seq_len, n_heads * head_dim].
pub fn rope_f32(dst $&F32Matrix, x &F32Matrix, pos_offset int, head_dim int, theta f64) Fence {
    handle := checked(metal_native.rope_f32(dst.handle, x.handle, pos_offset, head_dim, math.float32_bits(theta))) >>>
    << Fence{handle: handle}
}

// causal_attention_f32 computes multi-head causal GQA attention:
// q, dst: [seq_len, n_heads * head_dim]; k, v: [kv_len, n_kv_heads * head_dim].
pub fn causal_attention_f32(dst $&F32Matrix, q &F32Matrix, k &F32Matrix, v &F32Matrix,
                            n_heads int, n_kv_heads int, scale f64) Fence {
    handle := checked(metal_native.causal_attention_f32(dst.handle, q.handle, k.handle, v.handle, n_heads, n_kv_heads, math.float32_bits(scale))) >>>
    << Fence{handle: handle}
}
