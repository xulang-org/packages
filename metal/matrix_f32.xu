@"github.com/xulang-org/packages/metal"

#metal_native
#errors

// Host arrays hold canonical uint32 IEEE 754 binary32 bits in each Xu int.
// These owners are distinct from Xu f64 and from integer GPU buffers.
pub struct F32Matrix { handle int }
pub struct F32Snapshot { handle int }

pub fn (d &Device) supports_f32_gemm() bool {
    value := checked(metal_native.device_info(d.handle, 7)) or >>
    << value == 1
}
pub fn (d &Device) matrix_kernel_count() int { << checked(metal_native.device_info(d.handle, 5)) or >> }
pub fn (d &Device) matrix_cache_size() int { << checked(metal_native.device_info(d.handle, 6)) or >> }

// Row-major logical shape; MPS row padding is owned by the runtime.
// Dimensions <=16384; at most 16777216 logical elements per matrix.
pub fn (d &Device) matrix_f32(rows int, columns int) F32Matrix {
    handle := checked(metal_native.matrix_f32_new(d.handle, rows, columns)) or >>
    << F32Matrix{handle: handle}
}
pub fn (m &F32Matrix) rows() int { << checked(metal_native.matrix_f32_info(m.handle, 1)) or >> }
pub fn (m &F32Matrix) columns() int { << checked(metal_native.matrix_f32_info(m.handle, 2)) or >> }
pub fn (m &F32Matrix) row_bytes() int { << checked(metal_native.matrix_f32_info(m.handle, 3)) or >> }

// Exact storage transfer, including NaN payloads. Rejects noncanonical upper
// bits and mismatched lengths before any write; storage is never retained.
pub fn (m $&F32Matrix) write_bits(values &[]int) int {
    << checked(metal_native.matrix_f32_write(m.handle, values)) or >>
}
pub fn (m &F32Matrix) snapshot() F32Snapshot {
    handle := checked(metal_native.matrix_f32_snapshot(m.handle)) or >>
    << F32Snapshot{handle: handle}
}
pub fn (m &F32Matrix) bits() []int {
    s := m.snapshot() or >>
    << s.bits() or >>
}
pub fn (m $&F32Matrix) close() int {
    if m.handle == 0 { << 0 }
    checked(metal_native.matrix_f32_close(m.handle)) or >>
    m.handle = 0
    << 0
}
fn (m $&F32Matrix) drop() {
    if m.handle > 0 { metal_native.matrix_f32_release(m.handle) m.handle = 0 }
}

pub fn (s &F32Snapshot) bits() []int {
    bytes := checked(metal_native.snapshot_len(s.handle)) or >>
    if (bytes & 3) != 0 { >> errors.code(BOUNDS, "metal: snapshot is not a binary32 matrix") }
    $out := []int{}
    for i in 0:bytes/4 { out.push(0) }
    s.copy_bits($&out) or >>
    << out
}
// Writes existing elements only; trailing destination elements stay intact.
pub fn (s &F32Snapshot) copy_bits(out $&[]int) int {
    << checked(metal_native.snapshot_f32_copy(s.handle, out)) or >>
}
pub fn (s $&F32Snapshot) close() int {
    if s.handle == 0 { << 0 }
    checked(metal_native.snapshot_close(s.handle)) or >>
    s.handle = 0
    << 0
}
fn (s $&F32Snapshot) drop() {
    if s.handle > 0 { metal_native.snapshot_close(s.handle) s.handle = 0 }
}

// Explicit MPS C=A*B, alpha=1, beta=0, no transpose. Approximate f32 math:
// reduction order/FMA may differ from sequential CPU evaluation. Inputs must
// be finite normal binary32 values or signed zero; subnormal/nonfinite inputs
// are rejected before dispatch. Results may overflow/underflow in binary32.
// Storage transfer above preserves all bits, without f64 narrowing.
pub fn gemm_f32(dst $&F32Matrix, a &F32Matrix, b &F32Matrix) Fence {
    handle := checked(metal_native.gemm_f32(dst.handle, a.handle, b.handle)) or >>
    << Fence{handle: handle}
}
