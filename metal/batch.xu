pub fn (b $&Batch) rope_yarn_f32(dst $&F32Matrix, x &F32Matrix, pos_offset int, head_dim int, rope_dim int,
                                 interleaved bool, theta f64, scale f64, orig_ctx int,
                                 beta_fast f64, beta_slow f64, attn_factor f64) int {
    $il := 0
    if interleaved { il = 1 }
    params := [pos_offset, head_dim, rope_dim, il, orig_ctx, math.float32_bits(theta), math.float32_bits(scale), math.float32_bits(beta_fast), math.float32_bits(beta_slow), math.float32_bits(attn_factor)]
    << checked(metal_native.batch_rope_yarn_f32(b.handle, dst.handle, x.handle, &params)) >>>
}
