pub fn (b $&Batch) moe_topk_f32(out_idx $&F32Matrix, out_w $&F32Matrix, logits &F32Matrix,
                                k int, use_sigmoid bool, normalize_topk bool, weight_scale f64) int {
    $us := 0
    if use_sigmoid { us = 1 }
    $nt := 0
    if normalize_topk { nt = 1 }
    << checked(metal_native.batch_moe_topk_f32(b.handle, out_idx.handle, out_w.handle, logits.handle, k, us, nt, math.float32_bits(weight_scale))) >>>
}
