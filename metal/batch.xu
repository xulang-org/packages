@"github.com/xulang-org/packages/metal"

metal_native #"github.com/xulang-org/packages/metal_native"
#errors
#math

// Multi-op command buffer batching: encodes sequential GPU kernels and MPS
// dispatches into a single MTLCommandBuffer submitted on Batch.commit().
pub struct Batch { handle int }

pub fn (d &Device) begin_batch() Batch {
    handle := checked(metal_native.batch_new(d.handle)) >>>
    << Batch{handle: handle}
}

pub fn (b $&Batch) commit() Fence {
    handle := checked(metal_native.batch_commit(b.handle)) >>>
    _ := metal_native.batch_close(b.handle)
    b.handle = 0
    << Fence{handle: handle}
}

pub fn (b $&Batch) close() int {
    if b.handle == 0 { << 0 }
    checked(metal_native.batch_close(b.handle)) >>>
    b.handle = 0
    << 0
}
fn (b $&Batch) drop() {
    if b.handle > 0 { metal_native.batch_release(b.handle) b.handle = 0 }
}

pub fn (b $&Batch) gemm_f32(dst $&F32Matrix, a &F32Matrix, c_rhs &F32Matrix) int {
    << checked(metal_native.batch_gemm_f32(b.handle, dst.handle, a.handle, c_rhs.handle)) >>>
}
pub fn (b $&Batch) gemm_f32_nt(dst $&F32Matrix, a &F32Matrix, c_rhs &F32Matrix) int {
    << checked(metal_native.batch_gemm_f32_nt(b.handle, dst.handle, a.handle, c_rhs.handle)) >>>
}
