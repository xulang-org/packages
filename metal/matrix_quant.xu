// Fused Q4_0 dequantize+dot computing dst = x @ dequant(w)^T in GPU registers.
pub fn gemv_q4_0_f32(dst $&F32Matrix, x &F32Matrix, w &Q4Matrix) Fence {
    handle := checked(metal_native.gemv_q4_0_f32(dst.handle, x.handle, w.handle)) >>>
    << Fence{handle: handle}
}

// Fused Top-K weighted MoE Q4_0 GEMV accumulating weighted expert outputs directly into dst [M, out_dim].
pub fn moe_gemv_q4_0_f32(dst $&F32Matrix, x &F32Matrix, w &Q4Matrix,
                         expert_ids &F32Matrix, expert_weights &F32Matrix, n_experts int) Fence {
    handle := checked(metal_native.moe_gemv_q4_0_f32(dst.handle, x.handle, w.handle, expert_ids.handle, expert_weights.handle, n_experts)) >>>
    << Fence{handle: handle}
}

