pub fn (m &Q4KMatrix) rows() int { << checked(metal_native.matrix_q4_k_info(m.handle, 1)) >>> }
pub fn (m &Q4KMatrix) columns() int { << checked(metal_native.matrix_q4_k_info(m.handle, 2)) >>> }
pub fn (m &Q4KMatrix) byte_len() int { << checked(metal_native.matrix_q4_k_info(m.handle, 3)) >>> }
