pub fn paged_kv_cache_append_f16(pages $&F16Matrix, src &F32Matrix, block_table &F32Matrix,
                                   pos_offset int, block_size int) Fence {
    params := [pos_offset, block_size]
    handle := checked(metal_native.paged_kv_cache_append_f16(pages.handle, src.handle, block_table.handle, &params)) >>>
    << Fence{handle: handle}
}
