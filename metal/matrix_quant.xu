pub fn (m &Q8Matrix) columns() int { << checked(metal_native.matrix_q8_0_info(m.handle, 2)) >>> }
pub fn (m &Q8Matrix) byte_len() int { << checked(metal_native.matrix_q8_0_info(m.handle, 3)) >>> }
pub fn (m $&Q8Matrix) write_bytes(bytes &string) int {
    << checked(metal_native.matrix_q8_0_write(m.handle, bytes)) >>>
