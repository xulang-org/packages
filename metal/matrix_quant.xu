    << Fence{handle: handle}
}

// paged_attention_decode_f16 runs GQA paged KV-cache decode over F16 page pools and float-encoded block_table [B, max_blocks].
pub fn paged_attention_decode_f16(dst $&F32Matrix, q &F32Matrix, k_pages &F16Matrix, v_pages &F16Matrix,
                                    block_table &F32Matrix, kv_len int, block_size int,
                                    n_heads int, n_kv_heads int, scale f64) Fence {
    params := [kv_len, block_size, n_heads, n_kv_heads, math.float32_bits(scale)]
    handle := checked(metal_native.paged_attention_decode_f16(dst.handle, q.handle, k_pages.handle, v_pages.handle, block_table.handle, &params)) >>>
    << Fence{handle: handle}
}

