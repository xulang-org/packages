// Fused Q8_0 dequantize+dot computing dst = x @ dequant(w)^T in GPU registers.
pub fn gemv_q8_0_f32(dst $&F32Matrix, x &F32Matrix, w &Q8Matrix) Fence {
    handle := checked(metal_native.gemv_q8_0_f32(dst.handle, x.handle, w.handle)) >>>
    << Fence{handle: handle}
