// kv_cache_append_f16 converts F32 src [n, kv_dim] into F16 cache [max_seq, kv_dim] at row pos_offset.
pub fn kv_cache_append_f16(cache $&F16Matrix, src &F32Matrix, pos_offset int) Fence {
    handle := checked(metal_native.kv_cache_append_f16(cache.handle, src.handle, pos_offset)) >>>
    << Fence{handle: handle}
}

// attention_decode_f16 runs single-pass online FlashDecode reading F16 K/V caches into F32 dst.
pub fn attention_decode_f16(dst $&F32Matrix, q &F32Matrix, k_cache &F16Matrix, v_cache &F16Matrix,
                              kv_len int, n_heads int, n_kv_heads int, scale f64) Fence {
    handle := checked(metal_native.attention_decode_f16(dst.handle, q.handle, k_cache.handle, v_cache.handle, kv_len, n_heads, n_kv_heads, math.float32_bits(scale))) >>>
    << Fence{handle: handle}
}

pub fn causal_attention_f16(dst $&F32Matrix, q &F32Matrix, k &F16Matrix, v &F16Matrix,
                            n_heads int, n_kv_heads int, scale f64) Fence {
    handle := checked(metal_native.causal_attention_f16(dst.handle, q.handle, k.handle, v.handle, n_heads, n_kv_heads, math.float32_bits(scale))) >>>
    << Fence{handle: handle}
}

// moe_gemv_q4_k_f32 runs fused Q4_K top-k MoE GEMV over expert_ids [M, k] and weights [M, k].
pub fn moe_gemv_q4_k_f32(dst $&F32Matrix, x &F32Matrix, w &Q4KMatrix,
                         expert_ids &F32Matrix, expert_weights &F32Matrix, n_experts int) Fence {
    handle := checked(metal_native.moe_gemv_q4_k_f32(dst.handle, x.handle, w.handle, expert_ids.handle, expert_weights.handle, n_experts)) >>>
    << Fence{handle: handle}
}

// moe_gemv_q6_k_f32 runs fused Q6_K top-k MoE GEMV over expert_ids [M, k] and weights [M, k].
pub fn moe_gemv_q6_k_f32(dst $&F32Matrix, x &F32Matrix, w &Q6KMatrix,
                         expert_ids &F32Matrix, expert_weights &F32Matrix, n_experts int) Fence {
