@"github.com/xulang-org/packages/openai"

#encoding/json
#errors
#net/http
#strconv
#strings
#time
#crypto/tls
transport #github.com/xulang-org/packages/transport

pub const DEFAULT_TIMEOUT_NS = 60000000000

pub struct Client {
    pub base_url string
    pub api_key string
    pub timeout_ns int
    pub max_retries int
    pub extra_headers []string
}

pub struct ToolCall {
    pub id string
    pub kind string
    pub name string
    pub arguments string
}

pub struct ContentPart {
    pub kind string
    pub text string
    pub image_url string
    pub detail string
}

pub struct Message {
    pub role string
    pub content string
    pub parts []ContentPart
    pub tool_call_id string
    pub tool_calls []ToolCall
}

pub struct ToolDef {
    pub name string
    pub description string
    pub parameters_json string
}

pub struct ChatRequest {
    pub model string
    pub messages []Message
    pub tools []ToolDef
    pub temperature f64
    pub has_temperature bool
    pub top_p f64
    pub has_top_p bool
    pub presence_penalty f64
    pub has_presence_penalty bool
    pub frequency_penalty f64
    pub has_frequency_penalty bool
    pub max_tokens int
    pub max_completion_tokens int
    pub seed int
    pub has_seed bool
    pub stop []string
    pub tool_choice string
    pub response_format_json string
    pub extra_body_json string
    pub include_usage bool
}

pub struct CompletionRequest {
    pub model string
    pub prompt string
    pub temperature f64
    pub has_temperature bool
    pub top_p f64
    pub has_top_p bool
    pub max_tokens int
    pub seed int
    pub has_seed bool
    pub stop []string
    pub echo bool
    pub extra_body_json string
}

pub struct CompletionResponse {
    pub id string
    pub model string
    pub text string
    pub finish_reason string
    pub usage Usage
}

pub struct Usage {
    pub prompt_tokens int
    pub completion_tokens int
    pub total_tokens int
}

pub struct ChatResponse {
    pub id string
    pub model string
    pub content string
    pub reasoning_content string
    pub finish_reason string
    pub tool_calls []ToolCall
    pub usage Usage
}

pub struct StreamDelta {
    pub content string
    pub reasoning_content string
    pub finish_reason string
    pub tool_calls []ToolCall
    pub has_usage bool
    pub usage Usage
    pub done bool
}

pub struct EmbedRequest {
    pub model string
    pub inputs []string
}

pub struct EmbedResponse {
    pub model string
    pub embeddings [][]f64
    pub usage Usage
}

pub struct ModelInfo {
    pub id string
    pub object string
}

pub struct ResponsesToolCall {
    pub id string
    pub call_id string
    pub name string
    pub arguments string
}

pub struct ResponsesRequest {
    pub model string
    pub input string
    pub input_json string
    pub instructions string
    pub previous_response_id string
    pub tools []ToolDef
    pub temperature f64
    pub has_temperature bool
    pub top_p f64
    pub has_top_p bool
    pub max_output_tokens int
    pub tool_choice string
    pub extra_body_json string
}

pub struct ResponsesResponse {
    pub id string
    pub model string
    pub status string
    pub output_text string
    pub tool_calls []ResponsesToolCall
    pub usage Usage
}

pub struct ResponsesStreamEvent {
    pub event_type string
    pub text_delta string
    pub response_id string
    pub status string
    pub tool_calls []ResponsesToolCall
    pub has_usage bool
    pub usage Usage
    pub done bool
}

pub struct ImageGenResult {
    pub url string
    pub b64_json string
    pub revised_prompt string
}

pub struct RerankResult {
    pub index int
    pub relevance_score f64
    pub document string
}

pub struct FileObject {
    pub id string
    pub object string
    pub bytes int
    pub created_at int
    pub filename string
    pub purpose string
    pub status string
}

pub struct BatchObject {
    pub id string
    pub object string
    pub endpoint string
    pub input_file_id string
    pub output_file_id string
    pub error_file_id string
    pub completion_window string
    pub status string
    pub created_at int
    pub request_total int
    pub request_completed int
    pub request_failed int
}

pub fn new_client(base_url string, api_key string) Client {
    $url := base_url + ""
    if url.len > 0 && url[url.len - 1] == 47 {
        url = url[0:url.len - 1]
    }
    if url.len == 0 {
        url = "https://api.openai.com"
    }
    << Client{
        base_url: url,
        api_key: api_key,
        timeout_ns: DEFAULT_TIMEOUT_NS,
        max_retries: 0,
        extra_headers: []string{}
    }
}

pub fn new_deepseek_client(api_key string) Client { << new_client("https://api.deepseek.com", api_key) }
pub fn new_openrouter_client(api_key string) Client { << new_client("https://openrouter.ai/api/v1", api_key) }
pub fn new_groq_client(api_key string) Client { << new_client("https://api.groq.com/openai/v1", api_key) }
pub fn new_xai_client(api_key string) Client { << new_client("https://api.x.ai/v1", api_key) }
pub fn new_together_client(api_key string) Client { << new_client("https://api.together.xyz/v1", api_key) }
pub fn new_fireworks_client(api_key string) Client { << new_client("https://api.fireworks.ai/inference/v1", api_key) }
pub fn new_ollama_client(base_url string) Client {
    $u := base_url + ""
    if u.len == 0 { u = "http://127.0.0.1:11434" }
    << new_client(u, "")
}
pub fn new_cohere_client(api_key string) Client { << new_client("https://api.cohere.com/compatibility/v1", api_key) }
pub fn new_qwen_client(api_key string) Client { << new_client("https://dashscope.aliyuncs.com/compatible-mode/v1", api_key) }
pub fn new_mistral_client(api_key string) Client { << new_client("https://api.mistral.ai/v1", api_key) }
pub fn new_minimax_client(api_key string) Client { << new_client("https://api.minimax.chat/v1", api_key) }

pub fn (c $&Client) set_max_retries(n int) {
    if n < 0 {
        c.max_retries = 0
        <<
    }
    c.max_retries = n
}

pub fn (c $&Client) add_header(name string, value string) {
    c.extra_headers.push(name + ": " + value)
}

pub fn (c &Client) clone_client() Client {
    $hdrs := []string{}
    for i in 0:c.extra_headers.len {
        hdrs.push(c.extra_headers[i] + "")
    }
    << Client{
        base_url: c.base_url + "",
        api_key: c.api_key + "",
        timeout_ns: c.timeout_ns,
        max_retries: c.max_retries,
        extra_headers: ~hdrs
    }
}

pub fn responses_input_text_item(role string, text string) string {
    << "{\"type\":\"message\",\"role\":" + json.quote(&role) +
       ",\"content\":[{\"type\":\"input_text\",\"text\":" + json.quote(&text) + "}]}"
}

pub fn responses_function_call_output_item(call_id string, output string) string {
    << "{\"type\":\"function_call_output\",\"call_id\":" + json.quote(&call_id) +
       ",\"output\":" + json.quote(&output) + "}"
}

pub fn responses_input_array(items &[]string) string {
    $out := "["
    for i in 0:items.len {
        if i > 0 { out = out + "," }
        out = out + items[i]
    }
    << out + "]"
}

pub fn text_part(text string) ContentPart {
    << ContentPart{kind: "text", text: text, image_url: "", detail: ""}
}

pub fn image_url_part(url string, detail string) ContentPart {
    << ContentPart{kind: "image_url", text: "", image_url: url, detail: detail}
}

pub fn image_base64_part(mime_type string, b64_data string, detail string) ContentPart {
    << ContentPart{
        kind: "image_url",
        text: "",
        image_url: "data:" + mime_type + ";base64," + b64_data,
        detail: detail
    }
}

pub fn message(role string, content string) Message {
    << Message{role: role, content: content, parts: []ContentPart{}, tool_call_id: "", tool_calls: []ToolCall{}}
}

pub fn message_parts(role string, parts []ContentPart) Message {
    << Message{role: role, content: "", parts: ~parts, tool_call_id: "", tool_calls: []ToolCall{}}
}

pub fn tool_message(tool_call_id string, content string) Message {
    << Message{role: "tool", content: content, parts: []ContentPart{}, tool_call_id: tool_call_id, tool_calls: []ToolCall{}}
}

pub fn json_schema_format(name string, schema_json string, strict bool) string {
    $st := "false"
    if strict { st = "true" }
    $sch := schema_json + ""
    if sch.len == 0 { sch = "{\"type\":\"object\"}" }
    << "{\"type\":\"json_schema\",\"json_schema\":{\"name\":" + json.quote(&name) +
       ",\"strict\":" + st + ",\"schema\":" + sch + "}}"
}

pub fn tool(name string, description string, parameters_json string) ToolDef {
    << ToolDef{name: name, description: description, parameters_json: parameters_json}
}

pub fn chat_request(model string, messages []Message) ChatRequest {
    << ChatRequest{
        model: model,
        messages: ~messages,
        tools: []ToolDef{},
        temperature: 0.0,
        has_temperature: false,
        top_p: 0.0,
        has_top_p: false,
        presence_penalty: 0.0,
        has_presence_penalty: false,
        frequency_penalty: 0.0,
        has_frequency_penalty: false,
        max_tokens: 0,
        max_completion_tokens: 0,
        seed: 0,
        has_seed: false,
        stop: []string{},
        tool_choice: "",
        response_format_json: "",
        extra_body_json: "",
        include_usage: false
    }
}

pub fn new_completion_request(model string, prompt string) CompletionRequest {
    << CompletionRequest{
        model: model,
        prompt: prompt,
        temperature: 0.0,
        has_temperature: false,
        top_p: 0.0,
        has_top_p: false,
        max_tokens: 0,
        seed: 0,
        has_seed: false,
        stop: []string{},
        echo: false,
        extra_body_json: ""
    }
}

pub fn embed_request(model string, inputs []string) EmbedRequest {
    << EmbedRequest{model: model, inputs: ~inputs}
}

pub fn new_responses_request(model string, input string) ResponsesRequest {
    << ResponsesRequest{
        model: model,
        input: input,
        input_json: "",
        instructions: "",
        previous_response_id: "",
        tools: []ToolDef{},
        temperature: 0.0,
        has_temperature: false,
        top_p: 0.0,
        has_top_p: false,
        max_output_tokens: 0,
        tool_choice: "",
        extra_body_json: ""
    }
}

fn join_endpoint_path(base_path string, suffix string) string {
    if base_path.len == 0 || base_path == "/" {
        << suffix
    }
    if base_path[base_path.len - 1] == 47 {
        << base_path[0:base_path.len - 1] + suffix
    }
    // Avoid duplicating /v1 when caller passes http://host/v1
    if strings.has_suffix(&base_path, "/v1") && strings.has_prefix(&suffix, "/v1/") {
        << base_path[0:base_path.len - 3] + suffix
    }
    << base_path + suffix
}

fn default_port_for(raw &string) int {
    if strings.has_prefix(raw, "https://") { << 443 }
    << 80
}

fn build_http_request_ct(method string, ep &transport.Endpoint, suffix string, api_key &string,
                         extra_headers &[]string, content_type string, body &string) string {
    full_path := join_endpoint_path(ep.path, suffix)
    $raw := method + " " + full_path + " HTTP/1.1\r\n"
    raw = raw + "Host: " + ep.host + ":" + str(ep.port) + "\r\n"
    raw = raw + "Accept: application/json, text/event-stream, */*\r\n"
    if api_key.len > 0 {
        raw = raw + "Authorization: Bearer " + *api_key + "\r\n"
    }
    for hi in 0:extra_headers.len {
        raw = raw + extra_headers[hi] + "\r\n"
    }
    if body.len > 0 || method == "POST" {
        $ct := content_type + ""
        if ct.len == 0 { ct = "application/json" }
        raw = raw + "Content-Type: " + ct + "\r\n"
        raw = raw + "Content-Length: " + str(body.len) + "\r\n"
    }
    raw = raw + "Connection: close\r\n\r\n"
    if body.len > 0 {
        raw = raw + *body
    }
    << raw
}

fn build_http_request(method string, ep &transport.Endpoint, suffix string, api_key &string,
                      extra_headers &[]string, body &string) string {
    << build_http_request_ct(method, ep, suffix, api_key, extra_headers, "application/json", body)
}

fn extract_http_error_msg(status int, body &string) string {
    $msg := "openai: HTTP " + str(status)
    doc := json.parse(body)
    if doc.ok() && doc.is_dict(doc.root()) {
        root := doc.root()
        if doc.has(root, "error") {
            enode := doc.get(root, "error") >>> (_) { << msg }
            if doc.is_dict(enode) && doc.has(enode, "message") {
                mnode := doc.get(enode, "message") >>> (_) { << msg }
                if doc.is_string(mnode) {
                    emsg := doc.as_string(mnode) >>> (_) { << msg }
                    if emsg.len > 0 { msg = emsg }
                }
            }
        }
    }
    << msg
}

fn check_http_error(status int, body &string) int {
    if status >= 200 && status < 300 { << 0 }
    msg := extract_http_error_msg(status, body)
    >>> errors.code(status, msg)
}

fn sleep_retry_backoff(attempt int) {
    $shift := attempt
    if shift > 6 { shift = 6 }
    $ms := 25 << shift
    if ms > 2000 { ms = 2000 }
    time.sleep(ms * time.millisecond())
}

fn try_request_raw(ep &transport.Endpoint, raw_req &string, method &string, err_out $&string) http.Response {
    *err_out = ""
    ep_copy := transport.Endpoint{
        scheme: ep.scheme + "",
        host: ep.host + "",
        port: ep.port,
        path: ep.path + "",
        secure: ep.secure
    }
    cfg := tls.new_config(ep_copy.host + "")
    resp := transport.request_raw(ep_copy, cfg, *raw_req + "", *method + "") >>> (err) {
        *err_out = err.msg()
        << http.new_response()
    }
    << resp
}

fn request_raw_ct_retry(c &Client, method string, suffix string, content_type string, body &string) http.Response {
    bu := c.base_url + ""
    ak := c.api_key + ""
    def_port := default_port_for(&bu)
    ep := transport.parse_endpoint(bu + "", def_port) >>>
    raw_req := build_http_request_ct(method + "", &ep, suffix, &ak, &c.extra_headers, content_type + "", body)
    $max_r := c.max_retries
    if max_r < 0 { max_r = 0 }
    $attempt := 0
    for {
        $err_msg := ""
        resp := try_request_raw(&ep, &raw_req, &method, $&err_msg)
        if err_msg.len > 0 {
            if attempt < max_r {
                sleep_retry_backoff(attempt)
                attempt += 1
                ->
            }
            >>> errors.new(err_msg)
        }
        sc := resp.status_code
        if (sc == 429 || sc >= 500) && attempt < max_r {
            sleep_retry_backoff(attempt)
            attempt += 1
            ->
        }
        << resp
    }
    << http.new_response()
}

fn request_raw_retry(c &Client, method string, suffix string, body &string) http.Response {
    << request_raw_ct_retry(c, method, suffix, "application/json", body) >>>
}

fn json_str_or(doc &json.Doc, obj int, key string, def string) string {
    if !doc.is_dict(obj) || !doc.has(obj, key) { << def }
    n := doc.get(obj, key) >>> (_) { << def }
    if doc.is_string(n) {
        << doc.as_string(n) >>> (_) { << def }
    }
    << def
}

fn json_int_or(doc &json.Doc, obj int, key string, def int) int {
    if !doc.is_dict(obj) || !doc.has(obj, key) { << def }
    n := doc.get(obj, key) >>> (_) { << def }
    if doc.is_number(n) {
        << doc.as_int(n) >>> (_) { << def }
    }
    << def
}

fn fmt_float_or(v f64, def string) string {
    << strconv.format_float(v, 102, 4) >>> (_) { << def }
}

fn doc_get_or(doc &json.Doc, obj int, key string) int {
    << doc.get(obj, key) >>> (_) { << -1 }
}

fn doc_at_or(doc &json.Doc, arr int, idx int) int {
    << doc.at(arr, idx) >>> (_) { << -1 }
}

fn conn_read_or(conn $&transport.Conn, max int) string {
    << conn.read(max) >>> (_) { << "" }
}

fn parse_usage(doc &json.Doc, root int) Usage {
    $u := Usage{prompt_tokens: 0, completion_tokens: 0, total_tokens: 0}
    if doc.has(root, "usage") {
        un := doc.get(root, "usage") >>> (_) { << u }
        if doc.is_dict(un) {
            u.prompt_tokens = json_int_or(doc, un, "prompt_tokens", 0)
            u.completion_tokens = json_int_or(doc, un, "completion_tokens", 0)
            u.total_tokens = json_int_or(doc, un, "total_tokens", 0)
        }
    }
    << u
}

fn parse_reasoning(doc &json.Doc, obj int) string {
    r := json_str_or(doc, obj, "reasoning_content", "")
    if r.len > 0 { << r }
    << json_str_or(doc, obj, "reasoning", "")
}

fn parse_tool_calls(doc &json.Doc, msg_obj int) []ToolCall {
    $out := []ToolCall{}
    if !doc.is_dict(msg_obj) || !doc.has(msg_obj, "tool_calls") { << out }
    arr := doc.get(msg_obj, "tool_calls") >>> (_) { << out }
    if !doc.is_list(arr) { << out }
    cnt := doc.count(arr)
    for i in 0:cnt {
        tc := doc.at(arr, i) >>> (_) { -> }
        if !doc.is_dict(tc) { -> }
        id := json_str_or(doc, tc, "id", "")
        kind := json_str_or(doc, tc, "type", "function")
        $name := ""
        $args := ""
        if doc.has(tc, "function") {
            fn_obj := doc.get(tc, "function") >>> (_) { -> }
            name = json_str_or(doc, fn_obj, "name", "")
            args = json_str_or(doc, fn_obj, "arguments", "")
        }
        out.push(ToolCall{id: id, kind: kind, name: name, arguments: args})
    }
    << out
}

fn merge_stream_tool_calls(doc &json.Doc, msg_obj int, acc $&[]ToolCall) []ToolCall {
    $delta_out := []ToolCall{}
    if !doc.is_dict(msg_obj) || !doc.has(msg_obj, "tool_calls") { << delta_out }
    arr := doc.get(msg_obj, "tool_calls") >>> (_) { << delta_out }
    if !doc.is_list(arr) { << delta_out }
    cnt := doc.count(arr)
    for i in 0:cnt {
        tc := doc.at(arr, i) >>> (_) { -> }
        if !doc.is_dict(tc) { -> }
        $idx := json_int_or(doc, tc, "index", i)
        if idx < 0 { idx = 0 }
        id := json_str_or(doc, tc, "id", "")
        raw_kind := json_str_or(doc, tc, "type", "")
        $dkind := raw_kind + ""
        if dkind.len == 0 { dkind = "function" }
        $name := ""
        $args := ""
        if doc.has(tc, "function") {
            fn_obj := doc.get(tc, "function") >>> (_) { -> }
            name = json_str_or(doc, fn_obj, "name", "")
            args = json_str_or(doc, fn_obj, "arguments", "")
        }
        while acc.len <= idx {
            acc.push(ToolCall{id: "", kind: "function", name: "", arguments: ""})
        }
        if id.len > 0 { acc[idx].id = id + "" }
        if raw_kind.len > 0 { acc[idx].kind = raw_kind + "" }
        if name.len > 0 { acc[idx].name = name + "" }
        if args.len > 0 { acc[idx].arguments = acc[idx].arguments + args }
        delta_out.push(ToolCall{id: id, kind: dkind, name: name, arguments: args})
    }
    << delta_out
}

fn append_extra_json_fields(s $&string, raw &string) {
    $t := strings.trim_space(raw)
    if t.len == 0 { << }
    if t.len >= 2 && (t[0] & 255) == 123 && (t[t.len - 1] & 255) == 125 {
        t = strings.trim_space(&t[1:t.len - 1])
    }
    if t.len > 0 {
        *s = *s + "," + t
    }
}

fn encode_chat_body(req &ChatRequest, stream bool) string {
    $s := "{\"model\":" + json.quote(&req.model) + ",\"messages\":["
    for i in 0:req.messages.len {
        if i > 0 { s = s + "," }
        m := &req.messages[i]
        s = s + "{\"role\":" + json.quote(&m.role)
        if m.parts.len > 0 {
            s = s + ",\"content\":["
            for pi in 0:m.parts.len {
                if pi > 0 { s = s + "," }
                p := &m.parts[pi]
                if p.kind == "image_url" {
                    s = s + "{\"type\":\"image_url\",\"image_url\":{\"url\":" + json.quote(&p.image_url)
                    if p.detail.len > 0 {
                        s = s + ",\"detail\":" + json.quote(&p.detail)
                    }
                    s = s + "}}"
                } else {
                    s = s + "{\"type\":\"text\",\"text\":" + json.quote(&p.text) + "}"
                }
            }
            s = s + "]"
        } else {
            s = s + ",\"content\":" + json.quote(&m.content)
        }
        if m.tool_call_id.len > 0 {
            s = s + ",\"tool_call_id\":" + json.quote(&m.tool_call_id)
        }
        if m.tool_calls.len > 0 {
            s = s + ",\"tool_calls\":["
            for j in 0:m.tool_calls.len {
                if j > 0 { s = s + "," }
                tc := &m.tool_calls[j]
                s = s + "{\"id\":" + json.quote(&tc.id) + ",\"type\":\"function\",\"function\":{\"name\":" +
                    json.quote(&tc.name) + ",\"arguments\":" + json.quote(&tc.arguments) + "}}"
            }
            s = s + "]"
        }
        s = s + "}"
    }
    s = s + "]"
    if req.tools.len > 0 {
        s = s + ",\"tools\":["
        for i in 0:req.tools.len {
            if i > 0 { s = s + "," }
            td := &req.tools[i]
            $params := td.parameters_json + ""
            if params.len == 0 { params = "{}" }
            s = s + "{\"type\":\"function\",\"function\":{\"name\":" + json.quote(&td.name) +
                ",\"description\":" + json.quote(&td.description) + ",\"parameters\":" + params + "}}"
        }
        s = s + "]"
    }
    if req.tool_choice.len > 0 {
        if (req.tool_choice[0] & 255) == 123 {
            s = s + ",\"tool_choice\":" + req.tool_choice
        } else {
            s = s + ",\"tool_choice\":" + json.quote(&req.tool_choice)
        }
    }
    if req.has_temperature {
        tf := fmt_float_or(req.temperature, "0.0")
        s = s + ",\"temperature\":" + tf
    }
    if req.has_top_p {
        pf := fmt_float_or(req.top_p, "1.0")
        s = s + ",\"top_p\":" + pf
    }
    if req.has_presence_penalty {
        pp := fmt_float_or(req.presence_penalty, "0.0")
        s = s + ",\"presence_penalty\":" + pp
    }
    if req.has_frequency_penalty {
        fp := fmt_float_or(req.frequency_penalty, "0.0")
        s = s + ",\"frequency_penalty\":" + fp
    }
    if req.max_tokens > 0 {
        s = s + ",\"max_tokens\":" + str(req.max_tokens)
    }
    if req.max_completion_tokens > 0 {
        s = s + ",\"max_completion_tokens\":" + str(req.max_completion_tokens)
    }
    if req.has_seed {
        s = s + ",\"seed\":" + str(req.seed)
    }
    if req.stop.len > 0 {
        s = s + ",\"stop\":["
        for i in 0:req.stop.len {
            if i > 0 { s = s + "," }
            s = s + json.quote(&req.stop[i])
        }
        s = s + "]"
    }
    if req.response_format_json.len > 0 {
        s = s + ",\"response_format\":" + req.response_format_json
    }
    if req.extra_body_json.len > 0 {
        append_extra_json_fields($&s, &req.extra_body_json)
    }
    if stream {
        s = s + ",\"stream\":true"
        if req.include_usage {
            s = s + ",\"stream_options\":{\"include_usage\":true}"
        }
    }
    << s + "}"
}

pub fn (c &Client) list_models() []ModelInfo {
    empty_body := ""
    resp := request_raw_retry(c, "GET", "/v1/models", &empty_body) >>>
    _ := check_http_error(resp.status_code, &resp.body) >>>
    doc := json.parse(&resp.body)
    if !doc.ok() || !doc.is_dict(doc.root()) {
        >>> errors.new("openai: invalid JSON response")
    }
    root := doc.root()
    $out := []ModelInfo{}
    if doc.has(root, "data") {
        arr := doc.get(root, "data") >>>
        if doc.is_list(arr) {
            cnt := doc.count(arr)
            for i in 0:cnt {
                item := doc.at(arr, i) >>>
                if doc.is_dict(item) {
                    out.push(ModelInfo{
                        id: json_str_or(&doc, item, "id", ""),
                        object: json_str_or(&doc, item, "object", "model")
                    })
                }
            }
        }
    }
    << out
}

pub fn (c &Client) chat(req &ChatRequest) ChatResponse {
    body := encode_chat_body(req, false)
    resp := request_raw_retry(c, "POST", "/v1/chat/completions", &body) >>>
    _ := check_http_error(resp.status_code, &resp.body) >>>
    doc := json.parse(&resp.body)
    if !doc.ok() || !doc.is_dict(doc.root()) {
        >>> errors.new("openai: invalid JSON response")
    }
    root := doc.root()
    $out := ChatResponse{
        id: json_str_or(&doc, root, "id", ""),
        model: json_str_or(&doc, root, "model", req.model),
        content: "",
        reasoning_content: "",
        finish_reason: "",
        tool_calls: []ToolCall{},
        usage: parse_usage(&doc, root)
    }
    if doc.has(root, "choices") {
        choices := doc.get(root, "choices") >>>
        if doc.is_list(choices) && doc.count(choices) > 0 {
            ch0 := doc.at(choices, 0) >>>
            out.finish_reason = json_str_or(&doc, ch0, "finish_reason", "")
            if doc.has(ch0, "message") {
                msg_obj := doc.get(ch0, "message") >>>
                out.content = json_str_or(&doc, msg_obj, "content", "")
                out.reasoning_content = parse_reasoning(&doc, msg_obj)
                out.tool_calls = parse_tool_calls(&doc, msg_obj)
            }
        }
    }
    << out
}

fn find_substr_from(s &string, pat &string, start int) int {
    if pat.len <= 0 || start < 0 || start + pat.len > s.len { << -1 }
    limit := s.len - pat.len + 1
    for i in start:limit {
        $eq := true
        for j in 0:pat.len {
            if (*s)[i + j] != (*pat)[j] {
                eq = false
                <-
            }
        }
        if eq { << i }
    }
    << -1
}

fn parse_status_line(head &string) int {
    $sp := -1
    for i in 0:head.len {
        if (*head)[i] == 32 {
            sp = i
            <-
        }
        if (*head)[i] == 10 { <- }
    }
    if sp < 0 || sp + 4 > head.len { << 0 }
    $end := sp + 1
    while end < head.len && (*head)[end] >= 48 && (*head)[end] <= 57 {
        end += 1
    }
    if end == sp + 1 { << 0 }
    code_s := (*head)[sp + 1:end]
    << strconv.atoi(&code_s) >>> (_) { << 0 }
}

fn copy_tcs(src &[]ToolCall) []ToolCall {
    $out := []ToolCall{}
    for i in 0:src.len {
        out.push(ToolCall{
            id: src[i].id + "",
            kind: src[i].kind + "",
            name: src[i].name + "",
            arguments: src[i].arguments + ""
        })
    }
    << out
}

fn close_conn(conn $&transport.Conn) int {
    _ := conn.close() >>> (_) { << 0 }
    << 0
}

fn open_stream_attempt(ep &transport.Endpoint, raw_req &string, timeout_ns int,
                       ok_out $&bool, retriable_out $&bool, err_code_out $&int,
                       err_msg_out $&string, rest_out $&string) transport.Conn {
    *ok_out = false
    *retriable_out = false
    *err_code_out = 0
    *err_msg_out = ""
    *rest_out = ""
    ep_copy := transport.Endpoint{
        scheme: ep.scheme + "",
        host: ep.host + "",
        port: ep.port,
        path: ep.path + "",
        secure: ep.secure
    }
    cfg := tls.new_config(ep_copy.host + "")
    $conn := transport.dial(ep_copy, cfg, timeout_ns) >>> (err) {
        *retriable_out = true
        *err_msg_out = err.msg()
        << transport.closed_conn()
    }
    _ := conn.write_all(*raw_req + "") >>> (err) {
        _ := close_conn($&conn)
        *retriable_out = true
        *err_msg_out = err.msg()
        << transport.closed_conn()
    }

    $buf := ""
    crlf2 := "\r\n\r\n"
    $hdr_end := -1
    while hdr_end < 0 {
        chunk := conn.read(8192) >>> (err) {
            _ := close_conn($&conn)
            *retriable_out = true
            *err_msg_out = err.msg()
            << transport.closed_conn()
        }
        if chunk.len == 0 { <- }
        buf = buf + chunk
        hdr_end = find_substr_from(&buf, &crlf2, 0)
    }
    if hdr_end < 0 {
        _ := close_conn($&conn)
        *retriable_out = true
        *err_msg_out = "openai: incomplete HTTP headers"
        << transport.closed_conn()
    }
    head := buf[0:hdr_end]
    status := parse_status_line(&head)
    $rest := buf[(hdr_end + 4):buf.len]
    if status < 200 || status >= 300 {
        for {
            chunk := conn.read(8192) >>> (_) { <- }
            if chunk.len == 0 { <- }
            rest = rest + chunk
        }
        _ := close_conn($&conn)
        *err_code_out = status
        *err_msg_out = extract_http_error_msg(status, &rest)
        *retriable_out = status == 429 || status >= 500
        << transport.closed_conn()
    }
    *ok_out = true
    *err_code_out = status
    *rest_out = rest
    << conn
}

fn open_stream_retry_suffix(c &Client, suffix string, body &string, rest_out $&string) transport.Conn {
    bu := c.base_url + ""
    ak := c.api_key + ""
    def_port := default_port_for(&bu)
    ep := transport.parse_endpoint(bu + "", def_port) >>>
    raw_req := build_http_request("POST", &ep, suffix, &ak, &c.extra_headers, body)
    $max_r := c.max_retries
    if max_r < 0 { max_r = 0 }
    $attempt := 0
    for {
        $ok := false
        $retriable := false
        $err_code := 0
        $err_msg := ""
        $rest := ""
        $conn := open_stream_attempt(&ep, &raw_req, c.timeout_ns, $&ok, $&retriable, $&err_code, $&err_msg, $&rest)
        if ok {
            *rest_out = rest
            << conn
        }
        _ := close_conn($&conn)
        if retriable && attempt < max_r {
            sleep_retry_backoff(attempt)
            attempt += 1
            ->
        }
        if err_code != 0 {
            >>> errors.code(err_code, err_msg)
        }
        >>> errors.new(err_msg)
    }
    >>> errors.new("openai: stream failed")
}

fn open_stream_retry(c &Client, req &ChatRequest, rest_out $&string) transport.Conn {
    body := encode_chat_body(req, true)
    << open_stream_retry_suffix(c, "/v1/chat/completions", &body, rest_out) >>>
}

fn chat_stream_impl(c &Client, req &ChatRequest, use_cb bool, on_delta fn(StreamDelta) bool,
                    has_ch bool, delta_ch chan StreamDelta) ChatResponse {
    $line_buf := ""
    $conn := open_stream_retry(c, req, $&line_buf) >>>

    $out := ChatResponse{
        id: "",
        model: req.model,
        content: "",
        reasoning_content: "",
        finish_reason: "",
        tool_calls: []ToolCall{},
        usage: Usage{prompt_tokens: 0, completion_tokens: 0, total_tokens: 0}
    }
    $stopped := false
    for {
        $processed := 0
        for {
            $nl := -1
            for i in processed:line_buf.len {
                if line_buf[i] == 10 {
                    nl = i
                    <-
                }
            }
            if nl < 0 { <- }
            $line := line_buf[processed:nl]
            if line.len > 0 && line[line.len - 1] == 13 {
                line = line[0:line.len - 1]
            }
            processed = nl + 1
            if strings.has_prefix(&line, "data:") {
                $payload := line[5:line.len]
                payload = strings.trim_space(&payload)
                if payload == "[DONE]" {
                    if use_cb {
                        sd_done := StreamDelta{
                            content: "", reasoning_content: "", finish_reason: out.finish_reason + "",
                            tool_calls: []ToolCall{}, has_usage: false,
                            usage: out.usage, done: true
                        }
                        _ := on_delta(sd_done)
                    } else if has_ch {
                        sd_done := StreamDelta{
                            content: "", reasoning_content: "", finish_reason: out.finish_reason + "",
                            tool_calls: []ToolCall{}, has_usage: false,
                            usage: out.usage, done: true
                        }
                        delta_ch <- sd_done
                    }
                    stopped = true
                    <-
                }
                if payload.len > 0 {
                    doc := json.parse(&payload)
                    if doc.ok() && doc.is_dict(doc.root()) {
                        root := doc.root()
                        if out.id.len == 0 { out.id = json_str_or(&doc, root, "id", "") }
                        mname := json_str_or(&doc, root, "model", "")
                        if mname.len > 0 { out.model = mname }
                        $delta_content := ""
                        $delta_reasoning := ""
                        $delta_fr := ""
                        $delta_tcs := []ToolCall{}
                        if doc.has(root, "choices") {
                            choices := doc_get_or(&doc, root, "choices")
                            if doc.is_list(choices) && doc.count(choices) > 0 {
                                ch0 := doc_at_or(&doc, choices, 0)
                                $fr := json_str_or(&doc, ch0, "finish_reason", "")
                                if fr.len > 0 {
                                    out.finish_reason = fr
                                    delta_fr = fr
                                }
                                if doc.has(ch0, "delta") {
                                    dn := doc_get_or(&doc, ch0, "delta")
                                    delta_content = json_str_or(&doc, dn, "content", "")
                                    if delta_content.len > 0 {
                                        out.content = out.content + delta_content
                                    }
                                    delta_reasoning = parse_reasoning(&doc, dn)
                                    if delta_reasoning.len > 0 {
                                        out.reasoning_content = out.reasoning_content + delta_reasoning
                                    }
                                    delta_tcs = merge_stream_tool_calls(&doc, dn, $&out.tool_calls)
                                }
                            }
                        }
                        $has_u := false
                        if doc.has(root, "usage") {
                            un := doc_get_or(&doc, root, "usage")
                            if doc.is_dict(un) {
                                has_u = true
                                out.usage = parse_usage(&doc, root)
                            }
                        }
                        if use_cb {
                            sd_cb := StreamDelta{
                                content: delta_content + "", reasoning_content: delta_reasoning + "",
                                finish_reason: delta_fr + "",
                                tool_calls: copy_tcs(&delta_tcs), has_usage: has_u,
                                usage: out.usage, done: false
                            }
                            if !on_delta(sd_cb) {
                                stopped = true
                                <-
                            }
                        } else if has_ch {
                            sd_ch := StreamDelta{
                                content: delta_content + "", reasoning_content: delta_reasoning + "",
                                finish_reason: delta_fr + "",
                                tool_calls: copy_tcs(&delta_tcs), has_usage: has_u,
                                usage: out.usage, done: false
                            }
                            delta_ch <- sd_ch
                        }
                    }
                }
            }
        }
        if stopped { <- }
        if processed > 0 {
            line_buf = line_buf[processed:line_buf.len]
        }
        chunk := conn_read_or($&conn, 8192)
        if chunk.len == 0 { <- }
        line_buf = line_buf + chunk
    }
    _ := close_conn($&conn)
    << out
}

pub fn (c &Client) chat_stream(req &ChatRequest, on_delta fn(StreamDelta) bool) ChatResponse {
    dummy_ch := chan StreamDelta{cap: 1}
    << chat_stream_impl(c, req, true, on_delta, false, dummy_ch) >>>
}

fn ignore_delta(d StreamDelta) bool {
    << true
}

pub fn (c &Client) chat_stream_chan(req &ChatRequest, delta_ch chan StreamDelta) ChatResponse {
    << chat_stream_impl(c, req, false, ignore_delta, true, delta_ch) >>>
}

fn json_f64_or(doc &json.Doc, obj int, key string, def f64) f64 {
    if !doc.is_dict(obj) || !doc.has(obj, key) { << def }
    n := doc.get(obj, key) >>> (_) { << def }
    if doc.is_number(n) {
        << doc.as_f64(n) >>> (_) { << def }
    }
    << def
}

pub fn (c &Client) audio_transcriptions(model string, filename string, audio_bytes &string,
                                      language string, prompt string) string {
    boundary := "xu-openai-boundary-v110"
    $fname := filename + ""
    if fname.len == 0 { fname = "audio.wav" }
    $body := "--" + boundary + "\r\nContent-Disposition: form-data; name=\"model\"\r\n\r\n" + model + "\r\n"
    if language.len > 0 {
        body = body + "--" + boundary + "\r\nContent-Disposition: form-data; name=\"language\"\r\n\r\n" + language + "\r\n"
    }
    if prompt.len > 0 {
        body = body + "--" + boundary + "\r\nContent-Disposition: form-data; name=\"prompt\"\r\n\r\n" + prompt + "\r\n"
    }
    body = body + "--" + boundary + "\r\nContent-Disposition: form-data; name=\"file\"; filename=\"" + fname +
           "\"\r\nContent-Type: application/octet-stream\r\n\r\n" + (*audio_bytes) + "\r\n--" + boundary + "--\r\n"
    resp := request_raw_ct_retry(c, "POST", "/v1/audio/transcriptions", "multipart/form-data; boundary=" + boundary, &body) >>>
    _ := check_http_error(resp.status_code, &resp.body) >>>
    doc := json.parse(&resp.body)
    if doc.ok() && doc.is_dict(doc.root()) && doc.has(doc.root(), "text") {
        << json_str_or(&doc, doc.root(), "text", "")
    }
    << resp.body + ""
}

pub fn (c &Client) audio_speech(model string, voice string, input string, response_format string) string {
    $v := voice + ""
    if v.len == 0 { v = "alloy" }
    $body := "{\"model\":" + json.quote(&model) + ",\"voice\":" + json.quote(&v) + ",\"input\":" + json.quote(&input)
    if response_format.len > 0 {
        body = body + ",\"response_format\":" + json.quote(&response_format)
    }
    body = body + "}"
    resp := request_raw_retry(c, "POST", "/v1/audio/speech", &body) >>>
    _ := check_http_error(resp.status_code, &resp.body) >>>
    << resp.body + ""
}

pub fn (c &Client) images_generate(model string, prompt string, size string, n int) []ImageGenResult {
    $cnt := n
    if cnt <= 0 { cnt = 1 }
    $body := "{\"model\":" + json.quote(&model) + ",\"prompt\":" + json.quote(&prompt) + ",\"n\":" + str(cnt)
    if size.len > 0 {
        body = body + ",\"size\":" + json.quote(&size)
    }
    body = body + "}"
    resp := request_raw_retry(c, "POST", "/v1/images/generations", &body) >>>
    _ := check_http_error(resp.status_code, &resp.body) >>>
    doc := json.parse(&resp.body)
    if !doc.ok() || !doc.is_dict(doc.root()) {
        >>> errors.new("openai: invalid JSON response")
    }
    root := doc.root()
    $out := []ImageGenResult{}
    if doc.has(root, "data") {
        arr := doc.get(root, "data") >>>
        if doc.is_list(arr) {
            dc := doc.count(arr)
            for i in 0:dc {
                item := doc.at(arr, i) >>>
                if doc.is_dict(item) {
                    out.push(ImageGenResult{
                        url: json_str_or(&doc, item, "url", ""),
                        b64_json: json_str_or(&doc, item, "b64_json", ""),
                        revised_prompt: json_str_or(&doc, item, "revised_prompt", "")
                    })
                }
            }
        }
    }
    << out
}

fn doc_as_str_or(doc &json.Doc, node int, def string) string {
    << doc.as_string(node) >>> (_) { << def }
}

pub fn (c &Client) rerank(model string, query string, documents &[]string, top_n int) []RerankResult {
    $body := "{\"model\":" + json.quote(&model) + ",\"query\":" + json.quote(&query) + ",\"documents\":["
    for i in 0:documents.len {
        if i > 0 { body = body + "," }
        d := documents[i] + ""
        body = body + json.quote(&d)
    }
    body = body + "]"
    if top_n > 0 {
        body = body + ",\"top_n\":" + str(top_n)
    }
    body = body + "}"
    resp := request_raw_retry(c, "POST", "/v1/rerank", &body) >>>
    _ := check_http_error(resp.status_code, &resp.body) >>>
    doc := json.parse(&resp.body)
    if !doc.ok() || !doc.is_dict(doc.root()) {
        >>> errors.new("openai: invalid JSON response")
    }
    root := doc.root()
    $out := []RerankResult{}
    if doc.has(root, "results") {
        arr := doc.get(root, "results") >>>
        if doc.is_list(arr) {
            rc := doc.count(arr)
            for i in 0:rc {
                item := doc.at(arr, i) >>>
                if doc.is_dict(item) {
                    idx := json_int_or(&doc, item, "index", i)
                    $dtxt := ""
                    if idx >= 0 && idx < documents.len { dtxt = documents[idx] + "" }
                    if doc.has(item, "document") {
                        dn := doc_get_or(&doc, item, "document")
                        if doc.is_string(dn) {
                            dtxt = doc_as_str_or(&doc, dn, dtxt)
                        } else if doc.is_dict(dn) {
                            dtxt = json_str_or(&doc, dn, "text", dtxt)
                        }
                    }
                    out.push(RerankResult{
                        index: idx,
                        relevance_score: json_f64_or(&doc, item, "relevance_score", 0.0),
                        document: dtxt
                    })
                }
            }
        }
    }
    << out
}

pub fn (c &Client) embeddings(req &EmbedRequest) EmbedResponse {
    $body := "{\"model\":" + json.quote(&req.model) + ",\"input\":["
    for i in 0:req.inputs.len {
        if i > 0 { body = body + "," }
        body = body + json.quote(&req.inputs[i])
    }
    body = body + "]}"
    resp := request_raw_retry(c, "POST", "/v1/embeddings", &body) >>>
    _ := check_http_error(resp.status_code, &resp.body) >>>
    doc := json.parse(&resp.body)
    if !doc.ok() || !doc.is_dict(doc.root()) {
        >>> errors.new("openai: invalid JSON response")
    }
    root := doc.root()
    $embs := [][]f64{}
    if doc.has(root, "data") {
        arr := doc.get(root, "data") >>>
        if doc.is_list(arr) {
            cnt := doc.count(arr)
            for i in 0:cnt {
                item := doc.at(arr, i) >>>
                $vec := []f64{}
                if doc.is_dict(item) && doc.has(item, "embedding") {
                    en := doc.get(item, "embedding") >>>
                    if doc.is_list(en) {
                        vcnt := doc.count(en)
                        for j in 0:vcnt {
                            vn := doc.at(en, j) >>>
                            if doc.is_number(vn) {
                                vec.push(doc.as_f64(vn) >>>)
                            }
                        }
                    }
                }
                embs.push(~vec)
            }
        }
    }
    << EmbedResponse{
        model: json_str_or(&doc, root, "model", req.model),
        embeddings: ~embs,
        usage: parse_usage(&doc, root)
    }
}

pub fn (c &Client) completions(req &CompletionRequest) CompletionResponse {
    $body := "{\"model\":" + json.quote(&req.model) + ",\"prompt\":" + json.quote(&req.prompt)
    if req.has_temperature {
        body = body + ",\"temperature\":" + fmt_float_or(req.temperature, "0.0")
    }
    if req.has_top_p {
        body = body + ",\"top_p\":" + fmt_float_or(req.top_p, "1.0")
    }
    if req.max_tokens > 0 {
        body = body + ",\"max_tokens\":" + str(req.max_tokens)
    }
    if req.has_seed {
        body = body + ",\"seed\":" + str(req.seed)
    }
    if req.stop.len > 0 {
        body = body + ",\"stop\":["
        for i in 0:req.stop.len {
            if i > 0 { body = body + "," }
            body = body + json.quote(&req.stop[i])
        }
        body = body + "]"
    }
    if req.echo {
        body = body + ",\"echo\":true"
    }
    if req.extra_body_json.len > 0 {
        append_extra_json_fields($&body, &req.extra_body_json)
    }
    body = body + "}"
    resp := request_raw_retry(c, "POST", "/v1/completions", &body) >>>
    _ := check_http_error(resp.status_code, &resp.body) >>>
    doc := json.parse(&resp.body)
    if !doc.ok() || !doc.is_dict(doc.root()) {
        >>> errors.new("openai: invalid JSON response")
    }
    root := doc.root()
    $out := CompletionResponse{
        id: json_str_or(&doc, root, "id", ""),
        model: json_str_or(&doc, root, "model", req.model),
        text: "",
        finish_reason: "",
        usage: parse_usage(&doc, root)
    }
    if doc.has(root, "choices") {
        choices := doc.get(root, "choices") >>>
        if doc.is_list(choices) && doc.count(choices) > 0 {
            ch0 := doc.at(choices, 0) >>>
            out.text = json_str_or(&doc, ch0, "text", "")
            out.finish_reason = json_str_or(&doc, ch0, "finish_reason", "")
        }
    }
    << out
}

fn encode_responses_body(req &ResponsesRequest, stream bool) string {
    $s := "{\"model\":" + json.quote(&req.model)
    if req.input_json.len > 0 {
        s = s + ",\"input\":" + req.input_json
    } else {
        s = s + ",\"input\":" + json.quote(&req.input)
    }
    if req.instructions.len > 0 {
        s = s + ",\"instructions\":" + json.quote(&req.instructions)
    }
    if req.previous_response_id.len > 0 {
        s = s + ",\"previous_response_id\":" + json.quote(&req.previous_response_id)
    }
    if req.tools.len > 0 {
        s = s + ",\"tools\":["
        for i in 0:req.tools.len {
            if i > 0 { s = s + "," }
            td := &req.tools[i]
            $params := td.parameters_json + ""
            if params.len == 0 { params = "{}" }
            s = s + "{\"type\":\"function\",\"name\":" + json.quote(&td.name) +
                ",\"description\":" + json.quote(&td.description) + ",\"parameters\":" + params + "}"
        }
        s = s + "]"
    }
    if req.tool_choice.len > 0 {
        if (req.tool_choice[0] & 255) == 123 {
            s = s + ",\"tool_choice\":" + req.tool_choice
        } else {
            s = s + ",\"tool_choice\":" + json.quote(&req.tool_choice)
        }
    }
    if req.has_temperature {
        s = s + ",\"temperature\":" + fmt_float_or(req.temperature, "0.0")
    }
    if req.has_top_p {
        s = s + ",\"top_p\":" + fmt_float_or(req.top_p, "1.0")
    }
    if req.max_output_tokens > 0 {
        s = s + ",\"max_output_tokens\":" + str(req.max_output_tokens)
    }
    if req.extra_body_json.len > 0 {
        append_extra_json_fields($&s, &req.extra_body_json)
    }
    if stream {
        s = s + ",\"stream\":true"
    }
    << s + "}"
}

fn parse_responses_usage(doc &json.Doc, obj int) Usage {
    $u := Usage{prompt_tokens: 0, completion_tokens: 0, total_tokens: 0}
    if !doc.is_dict(obj) || !doc.has(obj, "usage") { << u }
    un := doc_get_or(doc, obj, "usage")
    if !doc.is_dict(un) { << u }
    u.prompt_tokens = json_int_or(doc, un, "input_tokens", 0)
    if u.prompt_tokens == 0 { u.prompt_tokens = json_int_or(doc, un, "prompt_tokens", 0) }
    u.completion_tokens = json_int_or(doc, un, "output_tokens", 0)
    if u.completion_tokens == 0 { u.completion_tokens = json_int_or(doc, un, "completion_tokens", 0) }
    u.total_tokens = json_int_or(doc, un, "total_tokens", 0)
    if u.total_tokens == 0 { u.total_tokens = u.prompt_tokens + u.completion_tokens }
    << u
}

fn copy_resp_tcs(src &[]ResponsesToolCall) []ResponsesToolCall {
    $out := []ResponsesToolCall{}
    for i in 0:src.len {
        out.push(ResponsesToolCall{
            id: src[i].id + "",
            call_id: src[i].call_id + "",
            name: src[i].name + "",
            arguments: src[i].arguments + ""
        })
    }
    << out
}

fn parse_responses_doc(doc &json.Doc, obj int, def_model &string) ResponsesResponse {
    $out := ResponsesResponse{
        id: json_str_or(doc, obj, "id", ""),
        model: json_str_or(doc, obj, "model", *def_model + ""),
        status: json_str_or(doc, obj, "status", ""),
        output_text: json_str_or(doc, obj, "output_text", ""),
        tool_calls: []ResponsesToolCall{},
        usage: parse_responses_usage(doc, obj)
    }
    if doc.is_dict(obj) && doc.has(obj, "output") {
        arr := doc_get_or(doc, obj, "output")
        if arr >= 0 && doc.is_list(arr) {
            $fallback_txt := ""
            cnt := doc.count(arr)
            for i in 0:cnt {
                item := doc_at_or(doc, arr, i)
                if item < 0 || !doc.is_dict(item) { -> }
                itype := json_str_or(doc, item, "type", "")
                if itype == "function_call" {
                    out.tool_calls.push(ResponsesToolCall{
                        id: json_str_or(doc, item, "id", ""),
                        call_id: json_str_or(doc, item, "call_id", ""),
                        name: json_str_or(doc, item, "name", ""),
                        arguments: json_str_or(doc, item, "arguments", "")
                    })
                } else if itype == "message" && doc.has(item, "content") {
                    carr := doc_get_or(doc, item, "content")
                    if carr >= 0 && doc.is_list(carr) {
                        cc := doc.count(carr)
                        for ci in 0:cc {
                            cpart := doc_at_or(doc, carr, ci)
                            if cpart < 0 || !doc.is_dict(cpart) { -> }
                            ptype := json_str_or(doc, cpart, "type", "")
                            if ptype == "output_text" || ptype == "text" {
                                fallback_txt = fallback_txt + json_str_or(doc, cpart, "text", "")
                            }
                        }
                    }
                }
            }
            if out.output_text.len == 0 && fallback_txt.len > 0 {
                out.output_text = fallback_txt
            }
        }
    }
    << out
}

pub fn (c &Client) responses(req &ResponsesRequest) ResponsesResponse {
    body := encode_responses_body(req, false)
    resp := request_raw_retry(c, "POST", "/v1/responses", &body) >>>
    _ := check_http_error(resp.status_code, &resp.body) >>>
    doc := json.parse(&resp.body)
    if !doc.ok() || !doc.is_dict(doc.root()) {
        >>> errors.new("openai: invalid JSON response")
    }
    << parse_responses_doc(&doc, doc.root(), &req.model)
}

fn emit_resp_ev(ev ResponsesStreamEvent, use_cb bool, on_event fn(ResponsesStreamEvent) bool,
                has_ch bool, ch chan ResponsesStreamEvent, stopped $&bool) {
    if has_ch {
        ch <- ResponsesStreamEvent{
            event_type: ev.event_type + "",
            text_delta: ev.text_delta + "",
            response_id: ev.response_id + "",
            status: ev.status + "",
            tool_calls: copy_resp_tcs(&ev.tool_calls),
            has_usage: ev.has_usage,
            usage: ev.usage,
            done: ev.done
        }
    }
    if use_cb {
        ev_cb := ResponsesStreamEvent{
            event_type: ev.event_type + "",
            text_delta: ev.text_delta + "",
            response_id: ev.response_id + "",
            status: ev.status + "",
            tool_calls: copy_resp_tcs(&ev.tool_calls),
            has_usage: ev.has_usage,
            usage: ev.usage,
            done: ev.done
        }
        if !on_event(ev_cb) {
            *stopped = true
        }
    }
}

fn responses_stream_impl(c &Client, req &ResponsesRequest, use_cb bool, on_event fn(ResponsesStreamEvent) bool,
                         has_ch bool, ev_ch chan ResponsesStreamEvent) ResponsesResponse {
    body := encode_responses_body(req, true)
    $line_buf := ""
    $conn := open_stream_retry_suffix(c, "/v1/responses", &body, $&line_buf) >>>
    $out := ResponsesResponse{
        id: "", model: req.model + "", status: "", output_text: "",
        tool_calls: []ResponsesToolCall{},
        usage: Usage{prompt_tokens: 0, completion_tokens: 0, total_tokens: 0}
    }
    $cur_ev := ""
    $stopped := false
    for {
        $processed := 0
        for {
            $nl := -1
            for i in processed:line_buf.len {
                if line_buf[i] == 10 {
                    nl = i
                    <-
                }
            }
            if nl < 0 { <- }
            $line := line_buf[processed:nl]
            if line.len > 0 && line[line.len - 1] == 13 {
                line = line[0:line.len - 1]
            }
            processed = nl + 1
            if strings.has_prefix(&line, "event:") {
                $evn := line[6:line.len]
                cur_ev = strings.trim_space(&evn)
                ->
            }
            if !strings.has_prefix(&line, "data:") { -> }
            $payload := line[5:line.len]
            payload = strings.trim_space(&payload)
            if payload.len == 0 { -> }
            if payload == "[DONE]" {
                stopped = true
                <-
            }
            doc := json.parse(&payload)
            if !doc.ok() || !doc.is_dict(doc.root()) { -> }
            root := doc.root()
            $etype := json_str_or(&doc, root, "type", "")
            if etype.len == 0 { etype = cur_ev + "" }
            $td := ""
            if etype == "response.output_text.delta" {
                td = json_str_or(&doc, root, "delta", "")
                if td.len > 0 { out.output_text = out.output_text + td }
            }
            $ev_tcs := []ResponsesToolCall{}
            if etype == "response.output_item.done" && doc.has(root, "item") {
                in_n := doc_get_or(&doc, root, "item")
                if in_n >= 0 && doc.is_dict(in_n) && json_str_or(&doc, in_n, "type", "") == "function_call" {
                    rtc := ResponsesToolCall{
                        id: json_str_or(&doc, in_n, "id", ""),
                        call_id: json_str_or(&doc, in_n, "call_id", ""),
                        name: json_str_or(&doc, in_n, "name", ""),
                        arguments: json_str_or(&doc, in_n, "arguments", "")
                    }
                    out.tool_calls.push(ResponsesToolCall{
                        id: rtc.id + "", call_id: rtc.call_id + "", name: rtc.name + "", arguments: rtc.arguments + ""
                    })
                    ev_tcs.push(~rtc)
                }
            }
            $has_u := false
            if doc.has(root, "response") {
                rn := doc_get_or(&doc, root, "response")
                if rn >= 0 && doc.is_dict(rn) {
                    parsed := parse_responses_doc(&doc, rn, &req.model)
                    if parsed.id.len > 0 { out.id = parsed.id + "" }
                    if parsed.model.len > 0 { out.model = parsed.model + "" }
                    if parsed.status.len > 0 { out.status = parsed.status + "" }
                    if out.output_text.len == 0 && parsed.output_text.len > 0 {
                        out.output_text = parsed.output_text + ""
                    }
                    if out.tool_calls.len == 0 && parsed.tool_calls.len > 0 {
                        out.tool_calls = copy_resp_tcs(&parsed.tool_calls)
                    }
                    if parsed.usage.total_tokens > 0 || parsed.usage.prompt_tokens > 0 {
                        out.usage = parsed.usage
                        has_u = true
                    }
                }
            }
            emit_resp_ev(ResponsesStreamEvent{
                event_type: etype, text_delta: td, response_id: out.id + "",
                status: out.status + "", tool_calls: ~ev_tcs, has_usage: has_u,
                usage: out.usage, done: false
            }, use_cb, on_event, has_ch, ev_ch, $&stopped)
            if stopped { <- }
        }
        if processed > 0 {
            line_buf = line_buf[processed:line_buf.len]
        }
        if stopped { <- }
        chunk := conn_read_or($&conn, 8192)
        if chunk.len == 0 { <- }
        line_buf = line_buf + chunk
    }
    _ := close_conn($&conn)
    $dstop := false
    emit_resp_ev(ResponsesStreamEvent{
        event_type: "done", text_delta: "", response_id: out.id + "",
        status: out.status + "", tool_calls: copy_resp_tcs(&out.tool_calls),
        has_usage: true, usage: out.usage, done: true
    }, use_cb, on_event, has_ch, ev_ch, $&dstop)
    << out
}

fn ignore_resp_ev(ev ResponsesStreamEvent) bool {
    << true
}

pub fn (c &Client) responses_stream(req &ResponsesRequest, on_event fn(ResponsesStreamEvent) bool) ResponsesResponse {
    dummy_ch := chan ResponsesStreamEvent{cap: 1}
    << responses_stream_impl(c, req, true, on_event, false, dummy_ch) >>>
}

pub fn (c &Client) responses_stream_chan(req &ResponsesRequest, ch chan ResponsesStreamEvent) ResponsesResponse {
    << responses_stream_impl(c, req, false, ignore_resp_ev, true, ch) >>>
}

fn json_bool_or(doc &json.Doc, obj int, key string, def bool) bool {
    if !doc.is_dict(obj) || !doc.has(obj, key) { << def }
    n := doc.get(obj, key) >>> (_) { << def }
    if doc.is_bool(n) {
        << doc.as_bool(n) >>> (_) { << def }
    }
    << def
}

fn parse_file_obj(doc &json.Doc, node int) FileObject {
    << FileObject{
        id: json_str_or(doc, node, "id", ""),
        object: json_str_or(doc, node, "object", "file"),
        bytes: json_int_or(doc, node, "bytes", 0),
        created_at: json_int_or(doc, node, "created_at", 0),
        filename: json_str_or(doc, node, "filename", ""),
        purpose: json_str_or(doc, node, "purpose", ""),
        status: json_str_or(doc, node, "status", "")
    }
}

fn parse_batch_obj(doc &json.Doc, node int) BatchObject {
    $tot := 0
    $comp := 0
    $fail := 0
    if doc.has(node, "request_counts") {
        rc := doc_get_or(doc, node, "request_counts")
        if rc >= 0 && doc.is_dict(rc) {
            tot = json_int_or(doc, rc, "total", 0)
            comp = json_int_or(doc, rc, "completed", 0)
            fail = json_int_or(doc, rc, "failed", 0)
        }
    }
    << BatchObject{
        id: json_str_or(doc, node, "id", ""),
        object: json_str_or(doc, node, "object", "batch"),
        endpoint: json_str_or(doc, node, "endpoint", ""),
        input_file_id: json_str_or(doc, node, "input_file_id", ""),
        output_file_id: json_str_or(doc, node, "output_file_id", ""),
        error_file_id: json_str_or(doc, node, "error_file_id", ""),
        completion_window: json_str_or(doc, node, "completion_window", ""),
        status: json_str_or(doc, node, "status", ""),
        created_at: json_int_or(doc, node, "created_at", 0),
        request_total: tot,
        request_completed: comp,
        request_failed: fail
    }
}

pub fn (c &Client) upload_file(filename string, purpose string, content &string) FileObject {
    boundary := "xu-openai-file-boundary-v112"
    $fname := filename + ""
    if fname.len == 0 { fname = "batch_input.jsonl" }
    $purp := purpose + ""
    if purp.len == 0 { purp = "batch" }
    $body := "--" + boundary + "\r\nContent-Disposition: form-data; name=\"purpose\"\r\n\r\n" + purp + "\r\n"
    body = body + "--" + boundary + "\r\nContent-Disposition: form-data; name=\"file\"; filename=\"" + fname +
           "\"\r\nContent-Type: application/octet-stream\r\n\r\n" + (*content) + "\r\n--" + boundary + "--\r\n"
    resp := request_raw_ct_retry(c, "POST", "/v1/files", "multipart/form-data; boundary=" + boundary, &body) >>>
    _ := check_http_error(resp.status_code, &resp.body) >>>
    doc := json.parse(&resp.body)
    if !doc.ok() || !doc.is_dict(doc.root()) {
        >>> errors.new("openai: invalid JSON response")
    }
    << parse_file_obj(&doc, doc.root())
}

pub fn (c &Client) get_file(file_id string) FileObject {
    empty := ""
    resp := request_raw_retry(c, "GET", "/v1/files/" + file_id, &empty) >>>
    _ := check_http_error(resp.status_code, &resp.body) >>>
    doc := json.parse(&resp.body)
    if !doc.ok() || !doc.is_dict(doc.root()) {
        >>> errors.new("openai: invalid JSON response")
    }
    << parse_file_obj(&doc, doc.root())
}

pub fn (c &Client) list_files(purpose string) []FileObject {
    $suffix := "/v1/files"
    if purpose.len > 0 { suffix = suffix + "?purpose=" + purpose }
    empty := ""
    resp := request_raw_retry(c, "GET", suffix, &empty) >>>
    _ := check_http_error(resp.status_code, &resp.body) >>>
    doc := json.parse(&resp.body)
    if !doc.ok() || !doc.is_dict(doc.root()) {
        >>> errors.new("openai: invalid JSON response")
    }
    root := doc.root()
    $out := []FileObject{}
    if doc.has(root, "data") {
        arr := doc.get(root, "data") >>>
        if doc.is_list(arr) {
            dc := doc.count(arr)
            for i in 0:dc {
                item := doc.at(arr, i) >>>
                if doc.is_dict(item) { out.push(parse_file_obj(&doc, item)) }
            }
        }
    }
    << out
}

pub fn (c &Client) delete_file(file_id string) bool {
    empty := ""
    resp := request_raw_retry(c, "DELETE", "/v1/files/" + file_id, &empty) >>>
    _ := check_http_error(resp.status_code, &resp.body) >>>
    doc := json.parse(&resp.body)
    if doc.ok() && doc.is_dict(doc.root()) {
        << json_bool_or(&doc, doc.root(), "deleted", true)
    }
    << true
}

pub fn (c &Client) get_file_content(file_id string) string {
    empty := ""
    resp := request_raw_retry(c, "GET", "/v1/files/" + file_id + "/content", &empty) >>>
    _ := check_http_error(resp.status_code, &resp.body) >>>
    << resp.body + ""
}

pub fn (c &Client) create_batch(input_file_id string, endpoint string, completion_window string, metadata_json string) BatchObject {
    $ep_path := endpoint + ""
    if ep_path.len == 0 { ep_path = "/v1/chat/completions" }
    $cw := completion_window + ""
    if cw.len == 0 { cw = "24h" }
    $body := "{\"input_file_id\":" + json.quote(&input_file_id) +
             ",\"endpoint\":" + json.quote(&ep_path) +
             ",\"completion_window\":" + json.quote(&cw)
    if metadata_json.len > 0 {
        body = body + ",\"metadata\":" + metadata_json
    }
    body = body + "}"
    resp := request_raw_retry(c, "POST", "/v1/batches", &body) >>>
    _ := check_http_error(resp.status_code, &resp.body) >>>
    doc := json.parse(&resp.body)
    if !doc.ok() || !doc.is_dict(doc.root()) {
        >>> errors.new("openai: invalid JSON response")
    }
    << parse_batch_obj(&doc, doc.root())
}

pub fn (c &Client) get_batch(batch_id string) BatchObject {
    empty := ""
    resp := request_raw_retry(c, "GET", "/v1/batches/" + batch_id, &empty) >>>
    _ := check_http_error(resp.status_code, &resp.body) >>>
    doc := json.parse(&resp.body)
    if !doc.ok() || !doc.is_dict(doc.root()) {
        >>> errors.new("openai: invalid JSON response")
    }
    << parse_batch_obj(&doc, doc.root())
}

pub fn (c &Client) cancel_batch(batch_id string) BatchObject {
    empty_json := "{}"
    resp := request_raw_retry(c, "POST", "/v1/batches/" + batch_id + "/cancel", &empty_json) >>>
    _ := check_http_error(resp.status_code, &resp.body) >>>
    doc := json.parse(&resp.body)
    if !doc.ok() || !doc.is_dict(doc.root()) {
        >>> errors.new("openai: invalid JSON response")
    }
    << parse_batch_obj(&doc, doc.root())
}

pub fn (c &Client) list_batches(limit int) []BatchObject {
    $suffix := "/v1/batches"
    if limit > 0 { suffix = suffix + "?limit=" + str(limit) }
    empty := ""
    resp := request_raw_retry(c, "GET", suffix, &empty) >>>
    _ := check_http_error(resp.status_code, &resp.body) >>>
    doc := json.parse(&resp.body)
    if !doc.ok() || !doc.is_dict(doc.root()) {
        >>> errors.new("openai: invalid JSON response")
    }
    root := doc.root()
    $out := []BatchObject{}
    if doc.has(root, "data") {
        arr := doc.get(root, "data") >>>
        if doc.is_list(arr) {
            dc := doc.count(arr)
            for i in 0:dc {
                item := doc.at(arr, i) >>>
                if doc.is_dict(item) { out.push(parse_batch_obj(&doc, item)) }
            }
        }
    }
    << out
}
