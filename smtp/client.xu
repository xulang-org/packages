@"github.com/xulang-org/packages/smtp"

#net
#strings
#encoding/base64
#errors

pub struct Message {
    pub from string
    pub to string
    pub subject string
    pub body string
}

pub struct SmtpClient {
    pub host string
    pub port int
    pub username string
    pub password string
}

pub struct SmtpResponse {
    pub code int
    pub text string
}

fn safe_close(fd int) {
    if fd >= 0 {
        net.conn_close(fd) or (e) {
            <<
        }
    }
}

fn write_all(fd int, data string) bool {
    mut off := 0
    while off < data.len {
        part := data[off:data.len]
        n := net.conn_write(fd, &part) or (err) {
            >> errors.new("smtp write error: " + err.msg())
        }
        if n <= 0 {
            <-
        }
        off = off + n
    }
    << true
}

fn write_cmd(fd int, cmd string) bool {
    line := cmd + "\r\n"
    << write_all(fd, line)
}

fn read_line(fd int) string {
    mut buf := ""
    while true {
        chunk := net.conn_read(fd, 1) or (err) {
            >> errors.new("smtp read error: " + err.msg())
        }
        if chunk.len == 0 {
            >> errors.new("smtp read unexpected EOF")
        }
        buf = buf + chunk
        if buf.len >= 2 {
            c1 := buf[buf.len - 2] & 255
            c2 := buf[buf.len - 1] & 255
            if c1 == 13 && c2 == 10 {
                <-
            }
        }
    }
    << buf
}

// Reads single-line or multi-line SMTP response:
// 250-first line
// 250-second line
// 250 final line
pub fn read_response(fd int) SmtpResponse {
    mut lines := ""
    mut last_code := 0

    while true {
        line := read_line(fd) or >>
        lines = lines + line

        if line.len >= 3 {
            c_str := line[0:3]
            p_code := parse_int(c_str) or (err) {
                last_code = 0
                <-
            }
            last_code = p_code
        }

        // If line has a hyphen at index 3 (e.g. "250-"), multi-line continues
        if line.len >= 4 && (line[3] & 255) == 45 {
            // continue reading
        } else {
            <-
        }
    }

    << SmtpResponse{
        code: last_code,
        text: lines
    }
}

pub fn new_client(endpoint string) SmtpClient {
    mut ep := endpoint
    prefix_smtp := "smtp://"
    if ep.len >= prefix_smtp.len && ep[0:prefix_smtp.len] == prefix_smtp {
        ep = ep[prefix_smtp.len:ep.len]
    }

    mut host := "127.0.0.1"
    mut port := 1025
    colon := strings.index_of(&ep, ":")
    if colon >= 0 {
        host = ep[0:colon]
        port_str := ep[(colon + 1):ep.len]
        p_val := parse_int(port_str) or (err) {
            port = 1025
            << SmtpClient{host: host, port: 1025, username: "", password: ""}
        }
        port = p_val
    } else {
        if ep.len > 0 {
            host = ep
        }
    }

    << SmtpClient{
        host: host,
        port: port,
        username: "",
        password: ""
    }
}

pub fn (c SmtpClient) connect() int {
    addr := c.host + ":" + str(c.port)
    fd := net.dial(strings.clone(&addr)) or (err) {
        >> errors.new("smtp dial failed: " + err.msg())
    }

    // 1. Read greeting: expects 220
    greet := read_response(fd) or (err) {
        safe_close(fd)
        >> err
    }
    if greet.code != 220 {
        safe_close(fd)
        >> errors.new("smtp invalid greeting code: " + str(greet.code))
    }

    // 2. Send EHLO
    write_cmd(fd, "EHLO xu.local") or (err) {
        safe_close(fd)
        >> err
    }
    ehlo_resp := read_response(fd) or (err) {
        safe_close(fd)
        >> err
    }
    if ehlo_resp.code != 250 {
        safe_close(fd)
        >> errors.new("smtp EHLO rejected: " + str(ehlo_resp.code))
    }

    // 3. Optional AUTH LOGIN
    if c.username.len > 0 {
        write_cmd(fd, "AUTH LOGIN") or (err) {
            safe_close(fd)
            >> err
        }
        auth_resp := read_response(fd) or (err) {
            safe_close(fd)
            >> err
        }
        if auth_resp.code != 334 {
            safe_close(fd)
            >> errors.new("smtp AUTH LOGIN rejected: " + str(auth_resp.code))
        }

        u_b64 := base64.encode_to_string(c.username + "")
        write_cmd(fd, u_b64) or (err) {
            safe_close(fd)
            >> err
        }
        u_resp := read_response(fd) or (err) {
            safe_close(fd)
            >> err
        }
        if u_resp.code != 334 {
            safe_close(fd)
            >> errors.new("smtp username rejected: " + str(u_resp.code))
        }

        p_b64 := base64.encode_to_string(c.password + "")
        write_cmd(fd, p_b64) or (err) {
            safe_close(fd)
            >> err
        }
        p_resp := read_response(fd) or (err) {
            safe_close(fd)
            >> err
        }
        if p_resp.code != 235 {
            safe_close(fd)
            >> errors.new("smtp password authentication failed: " + str(p_resp.code))
        }
    }

    << fd
}

pub fn (c SmtpClient) send_mail_on_fd(fd int, msg Message) bool {
    // 1. MAIL FROM:<from>
    from_cmd := "MAIL FROM:<" + msg.from + ">"
    write_cmd(fd, from_cmd) or >>
    r1 := read_response(fd) or >>
    if r1.code != 250 {
        >> errors.new("smtp MAIL FROM rejected: " + str(r1.code))
    }

    // 2. RCPT TO:<to>
    to_cmd := "RCPT TO:<" + msg.to + ">"
    write_cmd(fd, to_cmd) or >>
    r2 := read_response(fd) or >>
    if r2.code != 250 {
        >> errors.new("smtp RCPT TO rejected: " + str(r2.code))
    }

    // 3. DATA
    write_cmd(fd, "DATA") or >>
    r3 := read_response(fd) or >>
    if r3.code != 354 {
        >> errors.new("smtp DATA command rejected: " + str(r3.code))
    }

    // 4. Send Message Header & Body followed by \r\n.\r\n
    mut content := "From: " + msg.from + "\r\n"
    content = content + "To: " + msg.to + "\r\n"
    content = content + "Subject: " + msg.subject + "\r\n"
    content = content + "MIME-Version: 1.0\r\n"
    content = content + "Content-Type: text/plain; charset=UTF-8\r\n\r\n"
    content = content + msg.body + "\r\n.\r\n"

    write_all(fd, content) or >>
    r4 := read_response(fd) or >>
    if r4.code != 250 {
        >> errors.new("smtp message delivery rejected: " + str(r4.code))
    }

    << true
}

pub fn (c SmtpClient) close_conn(fd int) {
    if fd >= 0 {
        write_cmd(fd, "QUIT") or (e) {
            safe_close(fd)
            <<
        }
        read_response(fd) or (e) {
            safe_close(fd)
            <<
        }
        safe_close(fd)
    }
}
