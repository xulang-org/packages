pub fn swiglu_f32(dev $&Device, dst $&F32Matrix, gate &F32Matrix, up &F32Matrix) int {
    check_same_backend(dev, dst.backend, gate.backend) >>>
    check_same_backend(dev, dst.backend, up.backend) >>>
    n := dst.n_rows * dst.n_cols
    if dev.backend == BACKEND_METAL {
        dm := $&dst.metal_mat[0]
        $f := metal.swiglu_f32(dm, &gate.metal_mat[0], &up.metal_mat[0]) >>>
        << wait_metal($&f) >>>
    }
    if dev.backend == BACKEND_CUDA {
        cd := $&dev.cuda_dev[0]
        dc := $&dst.cuda_buf[0]
        << cd.swiglu_f32(dc, &gate.cuda_buf[0], &up.cuda_buf[0], n) >>>
    }
    if dev.backend == BACKEND_VULKAN {
        gb := gate.bits() >>>
        ub := up.bits() >>>
        $db := dst.bits() >>>
        cpu_swiglu_f32($&db, &gb, &ub)
        << dst.write_bits(&db) >>>
    }
    cpu_swiglu_f32($&dst.cpu_bits, &gate.cpu_bits, &up.cpu_bits)
    << 0
}

pub fn rope_f32(dev $&Device, dst $&F32Matrix, x &F32Matrix, pos_offset int, head_dim int, theta f64) int {
    check_same_backend(dev, dst.backend, x.backend) >>>
    if dev.backend == BACKEND_METAL {
        dm := $&dst.metal_mat[0]
        $f := metal.rope_f32(dm, &x.metal_mat[0], pos_offset, head_dim, theta) >>>
        << wait_metal($&f) >>>
    }
    if head_dim <= 0 { >>> errors.new("gpu: invalid head_dim") }
    n_heads := x.n_cols / head_dim
    if dev.backend == BACKEND_CUDA {
        cd := $&dev.cuda_dev[0]
        dc := $&dst.cuda_buf[0]
        << cd.rope_f32(dc, &x.cuda_buf[0], x.n_rows, n_heads, head_dim, pos_offset, theta) >>>
    }
    if dev.backend == BACKEND_VULKAN {
        xb := x.bits() >>>
        $db := dst.bits() >>>
        cpu_rope_f32($&db, &xb, x.n_rows, n_heads, head_dim, pos_offset, theta)
        << dst.write_bits(&db) >>>
    }
    cpu_rope_f32($&dst.cpu_bits, &x.cpu_bits, x.n_rows, n_heads, head_dim, pos_offset, theta)
    << 0
}

