pub fn rmsnorm_f32(dev $&Device, dst $&F32Matrix, x &F32Matrix, weight &F32Matrix, eps f64) int {
    check_same_backend(dev, dst.backend, x.backend) >>>
    check_same_backend(dev, dst.backend, weight.backend) >>>
    if dev.backend == BACKEND_METAL {
        dm := $&dst.metal_mat[0]
        $f := metal.rmsnorm_f32(dm, &x.metal_mat[0], &weight.metal_mat[0], eps) >>>
        << wait_metal($&f) >>>
    }
    if dev.backend == BACKEND_CUDA {
        cd := $&dev.cuda_dev[0]
        dc := $&dst.cuda_buf[0]
        << cd.rmsnorm_f32(dc, &x.cuda_buf[0], &weight.cuda_buf[0], x.n_rows, x.n_cols, eps) >>>
    }
    if dev.backend == BACKEND_VULKAN {
        xb := x.bits() >>>
        wb := weight.bits() >>>
        $db := dst.bits() >>>
        cpu_rmsnorm_f32($&db, &xb, &wb, x.n_rows, x.n_cols, eps)
        << dst.write_bits(&db) >>>
    }
    cpu_rmsnorm_f32($&dst.cpu_bits, &x.cpu_bits, &weight.cpu_bits, x.n_rows, x.n_cols, eps)
    << 0
}

