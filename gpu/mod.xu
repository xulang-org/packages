fn wait_metal(f $&metal.Fence) int {
    rc := f.wait() >>>
    qclose_metal_fence(f)
    << rc
}

fn check_same_backend(dev &Device, a int, b int) int {
    if dev.closed { >>> errors.new("gpu: device closed") }
    if a != dev.backend || b != dev.backend {
        >>> errors.new("gpu: matrix belongs to a different backend")
    }
    << 0
}

pub fn gemm_f32(dev $&Device, dst $&F32Matrix, a &F32Matrix, b &F32Matrix) int {
    check_same_backend(dev, dst.backend, a.backend) >>>
    check_same_backend(dev, dst.backend, b.backend) >>>
    m := a.n_rows
    k := a.n_cols
    n := b.n_cols
    if dev.backend == BACKEND_METAL {
        dm := $&dst.metal_mat[0]
        $f := metal.gemm_f32(dm, &a.metal_mat[0], &b.metal_mat[0]) >>>
        << wait_metal($&f) >>>
    }
    if dev.backend == BACKEND_CUDA {
        cd := $&dev.cuda_dev[0]
        dc := $&dst.cuda_buf[0]
        << cd.gemm_f32(dc, &a.cuda_buf[0], &b.cuda_buf[0], m, n, k) >>>
    }
    if dev.backend == BACKEND_VULKAN {
        vd := $&dev.vk_dev[0]
        dv := $&dst.vk_buf[0]
        << vd.gemm_f32(dv, &a.vk_buf[0], &b.vk_buf[0], m, n, k) >>>
    }
    cpu_gemm_f32($&dst.cpu_bits, &a.cpu_bits, &b.cpu_bits, m, n, k)
    << 0
}

pub fn gemm_f32_nt(dev $&Device, dst $&F32Matrix, a &F32Matrix, b &F32Matrix) int {
    check_same_backend(dev, dst.backend, a.backend) >>>
    check_same_backend(dev, dst.backend, b.backend) >>>
    m := a.n_rows
    k := a.n_cols
    n := b.n_rows
    if dev.backend == BACKEND_METAL {
        dm := $&dst.metal_mat[0]
        $f := metal.gemm_f32_nt(dm, &a.metal_mat[0], &b.metal_mat[0]) >>>
        << wait_metal($&f) >>>
    }
    if dev.backend == BACKEND_CUDA {
        cd := $&dev.cuda_dev[0]
        dc := $&dst.cuda_buf[0]
        << cd.gemm_f32_nt(dc, &a.cuda_buf[0], &b.cuda_buf[0], m, n, k) >>>
    }
    if dev.backend == BACKEND_VULKAN {
        vd := $&dev.vk_dev[0]
        dv := $&dst.vk_buf[0]
        << vd.gemm_f32_nt(dv, &a.vk_buf[0], &b.vk_buf[0], m, n, k) >>>
    }
    cpu_gemm_f32_nt($&dst.cpu_bits, &a.cpu_bits, &b.cpu_bits, m, n, k)
    << 0
}

pub fn gemm_f32_tn(dev $&Device, dst $&F32Matrix, a &F32Matrix, b &F32Matrix) int {
    check_same_backend(dev, dst.backend, a.backend) >>>
    check_same_backend(dev, dst.backend, b.backend) >>>
    k := a.n_rows
    m := a.n_cols
    n := b.n_cols
    if dev.backend == BACKEND_METAL {
        dm := $&dst.metal_mat[0]
        $f := metal.gemm_f32_tn(dm, &a.metal_mat[0], &b.metal_mat[0]) >>>
        << wait_metal($&f) >>>
    }
    if dev.backend == BACKEND_CUDA {
        cd := $&dev.cuda_dev[0]
        dc := $&dst.cuda_buf[0]
        << cd.gemm_f32_tn(dc, &a.cuda_buf[0], &b.cuda_buf[0], m, n, k) >>>
    }
    if dev.backend == BACKEND_VULKAN {
        vd := $&dev.vk_dev[0]
        dv := $&dst.vk_buf[0]
        << vd.gemm_f32_tn(dv, &a.vk_buf[0], &b.vk_buf[0], m, n, k) >>>
    }
    cpu_gemm_f32_tn($&dst.cpu_bits, &a.cpu_bits, &b.cpu_bits, m, n, k)
    << 0
}

