    if i == 77 { << "xu_metal_native_matrix_q4_0_close" }
    if i == 78 { << "xu_metal_native_matrix_q4_0_release" }
    if i == 79 { << "xu_metal_native_gemv_q4_0_f32" }
    if i == 80 { << "xu_metal_native_batch_gemv_q4_0_f32" }
    << ""
}

fn blob() c_ptr {
    unsafe {
        $p := ffi.process_get(SLOT)
        if !ffi.is_null(p) { << p }
        p = ffi.calloc(BLOB_SIZE)
        if ffi.is_null(p) { << ffi.null() }
        ffi.process_set(SLOT, p)
        << p
    }
}

fn sym(i int) c_ptr {
    unsafe {
        p := blob()
        if ffi.is_null(p) || i < 0 || i >= SYM_COUNT { << ffi.null() }
        << ffi.read_ptr(p, OFF_SYMS + i * 8)
    }
}

fn ensure() bool {
    unsafe {
        p := blob()
        if ffi.is_null(p) { << false }
        if ffi.read_i64(p, OFF_LOADED) != 0 { << true }
        library := open_library()
        if ffi.is_null(library) { << false }
        for n in 0:SYM_COUNT {
            name := sym_name(n)
            f := ffi.dlsym(library, &name)
            if ffi.is_null(f) {
                ffi.dlclose(library)
                << false
            }
            ffi.write_ptr(p, OFF_SYMS + n * 8, f)
        }
        ffi.write_ptr(p, OFF_LIBRARY, library)
        ffi.write_i64(p, OFF_LOADED, 1)
        << true
    }
}

fn open_library() c_ptr {
    unsafe {
        override := os.getenv("XU_METAL_LIBRARY")
        if override.len > 0 {
            << ffi.dlopen_local(&override)
        }
        // Relative names first (cwd / dyld path), then each XUPATH root's metal/native.
        names := ["libxu_metal.dylib", "metal/native/libxu_metal.dylib"]
        for i in 0:names.len {
            n := names[i]
            h := ffi.dlopen_local(&n)
            if !ffi.is_null(h) { << h }
        }
        xupath := os.getenv("XUPATH")
        if xupath.len > 0 {
            $start := 0
            $i := 0
            while i <= xupath.len {
                if i == xupath.len || xupath[i] == 58 { // ':'
                    if i > start {
                        root := xupath[start:i]
                        cand := root + "/metal/native/libxu_metal.dylib"
                        h := ffi.dlopen_local(&cand)
                        if !ffi.is_null(h) { << h }
                    }
                    start = i + 1
                }
                i += 1
            }
        }
        << ffi.null()
    }
}

// Host-side i64 span: copy into a temporary C buffer. Packages cannot use
// rt_addr/desc_ptr; the bridge never retains the pointer past the call.
fn i64_span_copy_in(values &[]int) c_ptr {
    unsafe {
        span := ffi.calloc(16)
        if ffi.is_null(span) { << ffi.null() }
        ffi.write_i64(span, 0, values.len)
        if values.len == 0 {
            ffi.write_ptr(span, 8, ffi.null())
            << span
        }
        data := ffi.calloc(values.len * 8)
        if ffi.is_null(data) {
            ffi.free(span)
            << ffi.null()
        }
        for i in 0:values.len { ffi.write_i64(data, i * 8, values[i]) }
        ffi.write_ptr(span, 8, data)
        << span
    }
}

fn free_span(span c_ptr) {
    unsafe {
        if ffi.is_null(span) { << }
        data := ffi.read_ptr(span, 8)
        if !ffi.is_null(data) { ffi.free(data) }
        ffi.free(span)
    }
}

fn i64_span_alloc(len int) c_ptr {
    unsafe {
        span := ffi.calloc(16)
        if ffi.is_null(span) { << ffi.null() }
        ffi.write_i64(span, 0, len)
        if len == 0 {
            ffi.write_ptr(span, 8, ffi.null())
            << span
        }
        data := ffi.calloc(len * 8)
        if ffi.is_null(data) {
            ffi.free(span)
            << ffi.null()
        }
        ffi.write_ptr(span, 8, data)
        << span
    }
}

fn span_copy_out(span c_ptr, values $&[]int) {
    unsafe {
        if ffi.is_null(span) { << }
        data := ffi.read_ptr(span, 8)
        if ffi.is_null(data) { << }
        for i in 0:values.len { values[i] = ffi.read_i64(data, i * 8) }
    }
}

fn u8_span_copy_in_str(s &string) c_ptr {
    unsafe {
        span := ffi.calloc(16)
        if ffi.is_null(span) { << ffi.null() }
        ffi.write_i64(span, 0, s.len)
        if s.len == 0 {
            ffi.write_ptr(span, 8, ffi.null())
            << span
        }
        data := ffi.calloc(s.len)
        if ffi.is_null(data) {
            ffi.free(span)
            << ffi.null()
        }
        for i in 0:s.len { ffi.write_u8(data, i, u8((*s)[i])) }
        ffi.write_ptr(span, 8, data)
        << span
    }
}

pub fn available() int {
    if !ensure() { << 0 }
    unsafe { << xm_available(sym(0)) }
}
pub fn abi_version() int {
    if !ensure() { << 2 }
    unsafe { << xm_abi_version(sym(1)) }
}
pub fn live_handles() int {
    if !ensure() { << 0 }
    unsafe { << xm_live_handles(sym(2)) }
}
pub fn device_new() int {
    if !ensure() { << XM_UNAVAILABLE }
    unsafe { << xm_device_new(sym(3)) }
}
pub fn device_close(device int) int {
    if !ensure() { << XM_UNAVAILABLE }
    unsafe { << xm_device_close(sym(4), device) }
}
pub fn device_release(device int) int {
    if !ensure() { << XM_UNAVAILABLE }
    unsafe { << xm_device_release(sym(5), device) }
}
pub fn device_info(device int, key int) int {
    if !ensure() { << XM_UNAVAILABLE }
    unsafe { << xm_device_info(sym(6), device, key) }
}
pub fn device_name(device int) int {
    if !ensure() { << XM_UNAVAILABLE }
    unsafe { << xm_device_name(sym(7), device) }
}
pub fn buffer_new(device int, words int, dtype int) int {
    if !ensure() { << XM_UNAVAILABLE }
    unsafe { << xm_buffer_new(sym(8), device, words, dtype) }
}
pub fn buffer_put(buffer int, index int, value int) int {
    if !ensure() { << XM_UNAVAILABLE }
    unsafe { << xm_buffer_put(sym(9), buffer, index, value) }
}
pub fn buffer_write(buffer int, offset int, source &[]int, first int, count int) int {
    if !ensure() { << XM_UNAVAILABLE }
    unsafe {
        span := i64_span_copy_in(source)
        if ffi.is_null(span) { << -7 }
        rc := xm_buffer_write(sym(10), buffer, offset, span, first, count)
        free_span(span)
        << rc
    }
}
pub fn buffer_snapshot(buffer int) int {
    if !ensure() { << XM_UNAVAILABLE }
    unsafe { << xm_buffer_snapshot(sym(11), buffer) }
}
pub fn buffer_close(buffer int) int {
    if !ensure() { << XM_UNAVAILABLE }
    unsafe { << xm_buffer_close(sym(12), buffer) }
}
pub fn buffer_release(buffer int) int {
    if !ensure() { << XM_UNAVAILABLE }
    unsafe { << xm_buffer_release(sym(13), buffer) }
}
pub fn snapshot_len(snapshot int) int {
    if !ensure() { << XM_UNAVAILABLE }
    unsafe { << xm_snapshot_len(sym(14), snapshot) }
}
pub fn snapshot_byte(snapshot int, index int) int {
    if !ensure() { << XM_UNAVAILABLE }
    unsafe { << xm_snapshot_byte(sym(15), snapshot, index) }
}
pub fn snapshot_low(snapshot int, index int) int {
    if !ensure() { << XM_UNAVAILABLE }
    unsafe { << xm_snapshot_low(sym(16), snapshot, index) }
}
pub fn snapshot_high(snapshot int, index int) int {
    if !ensure() { << XM_UNAVAILABLE }
    unsafe { << xm_snapshot_high(sym(17), snapshot, index) }
}
pub fn snapshot_copy(snapshot int, first int, destination $&[]int, offset int, count int) int {
    if !ensure() { << XM_UNAVAILABLE }
    unsafe {
        span := i64_span_alloc(destination.len)
        if ffi.is_null(span) { << -7 }
        rc := xm_snapshot_copy(sym(18), snapshot, first, span, offset, count)
        if rc >= 0 { span_copy_out(span, destination) }
        free_span(span)
        << rc
    }
}
pub fn snapshot_close(snapshot int) int {
    if !ensure() { << XM_UNAVAILABLE }
    unsafe { << xm_snapshot_close(sym(19), snapshot) }
}
pub fn madd_i64(dst int, a int, b int, factor int, words int) int {
    if !ensure() { << XM_UNAVAILABLE }
    unsafe { << xm_madd_i64(sym(20), dst, a, b, factor, words) }
}
pub fn fence_wait(fence int) int {
    if !ensure() { << XM_UNAVAILABLE }
    unsafe { << xm_fence_wait(sym(21), fence) }
}
pub fn fence_close(fence int) int {
    if !ensure() { << XM_UNAVAILABLE }
    unsafe { << xm_fence_close(sym(22), fence) }
}
pub fn fence_dispose(fence int) int {
    if !ensure() { << XM_UNAVAILABLE }
    unsafe { << xm_fence_dispose(sym(23), fence) }
