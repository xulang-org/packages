fn sym_name(i int) string {
    if i == 0 { << "xu_metal_native_available" }
    if i == 1 { << "xu_metal_native_abi_version" }
    if i == 2 { << "xu_metal_native_live_handles" }
    if i == 3 { << "xu_metal_native_device_new" }
    if i == 4 { << "xu_metal_native_device_close" }
    if i == 5 { << "xu_metal_native_device_release" }
    if i == 6 { << "xu_metal_native_device_info" }
    if i == 7 { << "xu_metal_native_device_name" }
    if i == 8 { << "xu_metal_native_buffer_new" }
    if i == 9 { << "xu_metal_native_buffer_put" }
    if i == 10 { << "xu_metal_native_buffer_write" }
    if i == 11 { << "xu_metal_native_buffer_snapshot" }
    if i == 12 { << "xu_metal_native_buffer_close" }
    if i == 13 { << "xu_metal_native_buffer_release" }
    if i == 14 { << "xu_metal_native_snapshot_len" }
    if i == 15 { << "xu_metal_native_snapshot_byte" }
    if i == 16 { << "xu_metal_native_snapshot_low" }
    if i == 17 { << "xu_metal_native_snapshot_high" }
    if i == 18 { << "xu_metal_native_snapshot_copy" }
    if i == 19 { << "xu_metal_native_snapshot_close" }
    if i == 20 { << "xu_metal_native_madd_i64" }
    if i == 21 { << "xu_metal_native_fence_wait" }
    if i == 22 { << "xu_metal_native_fence_close" }
    if i == 23 { << "xu_metal_native_fence_dispose" }
    if i == 24 { << "xu_metal_native_matrix_f32_new" }
    if i == 25 { << "xu_metal_native_matrix_f32_info" }
    if i == 26 { << "xu_metal_native_matrix_f32_write" }
    if i == 27 { << "xu_metal_native_matrix_f32_snapshot" }
    if i == 28 { << "xu_metal_native_matrix_f32_copy" }
    if i == 29 { << "xu_metal_native_matrix_f32_close" }
    if i == 30 { << "xu_metal_native_matrix_f32_release" }
    if i == 31 { << "xu_metal_native_snapshot_f32_copy" }
    if i == 32 { << "xu_metal_native_gemm_f32" }
    if i == 33 { << "xu_metal_native_gemm_f32_nt" }
    if i == 34 { << "xu_metal_native_rmsnorm_f32" }
