@"github.com/xulang-org/packages/metal_native"
// Xu FFI front-end for the Metal ObjC bridge (libxu_metal.dylib).
// bridge.m remains the Metal/MPS implementation; this package replaces the
// packed metal.xulib import with dlopen + dynamic calls (same shape as
// #internal/sdl → libSDL3).

#ffi
#os

const SLOT = 2
const OFF_LIBRARY = 0
const OFF_LOADED = 8
const OFF_SYMS = 16
const SYM_COUNT = 81
const BLOB_SIZE = 664

const XM_UNAVAILABLE = -1

extern "C" fn xm_available(fn_ptr c_ptr) int = dynamic
extern "C" fn xm_abi_version(fn_ptr c_ptr) int = dynamic
extern "C" fn xm_live_handles(fn_ptr c_ptr) int = dynamic
extern "C" fn xm_device_new(fn_ptr c_ptr) int = dynamic
