@"github.com/xulang-org/packages/elasticsearch"

#net
#net/http
#crypto/tls
#errors
#strings
transport #github.com/xulang-org/packages/transport

pub struct Response {
    pub status_code int
    pub body string
}

pub struct Client {
    pub host string
    pub port int
    pub secure bool
}

fn parse_int_def(s string, def int) int {
    if s.len == 0 {
        << def
    }
    n := parse_int(s) or (err) {
        << def
    }
    << n
}

fn parse_endpoint(raw string) Client {
    if strings.has_prefix(&raw, "https://") {
        ep := transport.parse_endpoint(raw, 9200) or (err) {
            << Client{host: "127.0.0.1", port: 9200, secure: true}
        }
        << Client{host: ep.host, port: ep.port, secure: true}
    }
    $ep := raw
    prefix_http := "http://"
    if ep.len >= prefix_http.len && ep[0:prefix_http.len] == prefix_http {
        ep = ep[prefix_http.len:ep.len]
    }
    $host := "127.0.0.1"
    $port := 9200
    $colon := -1
    $i := 0
    while i < ep.len {
        if (ep[i] & 255) == 58 { // ':'
            colon = i
            <-
        }
        i = i + 1
    }
    if colon >= 0 {
        host = ep[0:colon]
        p_str := ep[(colon + 1):ep.len]
        port = parse_int_def(p_str, 9200)
    } else {
        if ep.len > 0 {
            host = ep
        }
    }
    << Client{host: host, port: port, secure: false}
}

pub fn new_client(endpoint string) Client {
    << parse_endpoint(endpoint)
}

fn safe_close(fd int) {
    if fd >= 0 {
        net.conn_close(fd) or (e) {
            <<
        }
    }
}

pub fn (c $&Client) request(method string, path string, body string) Response {
    if c.secure {
        $p := path
        if p.len == 0 || (p[0] & 255) != 47 { p = "/" + p }
        $req := method + " " + p + " HTTP/1.1\r\n"
        req = req + "Host: " + c.host + ":" + str(c.port) + "\r\n"
        req = req + "User-Agent: xu-elasticsearch/1.0\r\n"
        req = req + "Accept: application/json\r\n"
        req = req + "Content-Type: application/json\r\n"
        req = req + "Connection: close\r\n"
        if body.len > 0 { req = req + "Content-Length: " + str(body.len) + "\r\n" }
        req = req + "\r\n"
        if body.len > 0 { req = req + body }
        ep := transport.Endpoint{scheme: "https", host: c.host + "", port: c.port, path: "", secure: true}
        cfg := tls.new_config(c.host + "")
        resp := transport.request_raw(ep, cfg, req, method + "") or >>
        << Response{status_code: resp.status_code, body: resp.body}
    }
    addr := c.host + ":" + str(c.port)
    fd := net.dial(strings.clone(&addr)) or (err) {
        >> errors.new("elasticsearch: dial failed: " + err.msg())
    }
    $reusable := false
    result := c.request_on_fd(fd, method, path, body, $&reusable) or (err) {
        safe_close(fd)
        >> err
    }
    safe_close(fd)
    << result
}

fn (c $&Client) request_at(fd int, method string, path string, body string, reusable $&bool) Response {
    if c.secure {
        *reusable = false
        << c.request(method, path, body) or >>
    }
    if fd < 0 { << c.request(method, path, body) or >> }
    << c.request_on_fd(fd, method, path, body, reusable) or >>
}

fn (c $&Client) request_on_fd(fd int, method string, path string, body string, reusable $&bool) Response {
    *reusable = false

    $p := path
    if p.len == 0 || (p[0] & 255) != 47 {
        p = "/" + p
    }

    $req := method + " " + p + " HTTP/1.1\r\n"
    req = req + "Host: " + c.host + ":" + str(c.port) + "\r\n"
    req = req + "User-Agent: xu-elasticsearch/1.0\r\n"
    req = req + "Accept: application/json\r\n"
    req = req + "Content-Type: application/json\r\n"
    req = req + "Connection: keep-alive\r\n"
    if body.len > 0 {
        req = req + "Content-Length: " + str(body.len) + "\r\n"
    }
    req = req + "\r\n"
    if body.len > 0 {
        req = req + body
    }

    // Write request
    $off := 0
    while off < req.len {
        part := req[off:req.len]
        n := net.conn_write(fd, &part) or (err) {
            >> errors.new("elasticsearch: write failed: " + err.msg())
        }
        if n <= 0 {
            >> errors.new("elasticsearch: connection closed during write")
        }
        off = off + n
    }

    resp := http.read_response(fd, method + "") or (err) {
        >> err
    }
    *reusable = resp.status_code >= 200 && resp.status_code < 300 && resp.reusable(method)
    << Response{status_code: resp.status_code, body: resp.body}
}

pub fn (c $&Client) ping() bool {
    $reusable := false
    << c.ping_at(-1, $&reusable)
}

fn (c $&Client) ping_at(fd int, reusable $&bool) bool {
    resp := c.request_at(fd, "GET", "/", "", reusable) or (err) {
        << false
    }
    << resp.status_code == 200
}

pub fn (c $&Client) info() string {
    $reusable := false
    << c.info_at(-1, $&reusable) or >>
}

fn (c $&Client) info_at(fd int, reusable $&bool) string {
    resp := c.request_at(fd, "GET", "/", "", reusable) or >>
    if resp.status_code != 200 { >> errors.new("elasticsearch: info failed with status " + str(resp.status_code) + ": " + resp.body) }
    << resp.body
}
