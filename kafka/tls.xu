@"github.com/xulang-org/packages/kafka"

#crypto/tls
#errors
transport #github.com/xulang-org/packages/transport

pub struct TlsClient {
    pub conn transport.Conn
    pub host string
    pub port int
}

pub fn tls_connect(endpoint string, default_port int) TlsClient {
    raw := endpoint + ""
    ep := transport.parse_endpoint(raw + "", default_port) or >>
    cfg := tls.new_config(ep.host + "")
    << tls_connect_config(raw + "", default_port, cfg) or >>
}

pub fn tls_connect_config(endpoint string, default_port int, cfg tls.Config) TlsClient {
    $ep := transport.parse_endpoint(endpoint, default_port) or >>
    ep.scheme = "tls"
    ep.secure = true
    host := ep.host + ""
    port := ep.port
    tc := transport.dial(ep, cfg, transport.DEFAULT_TIMEOUT_NS) or >>
    << TlsClient{conn: tc, host: host, port: port}
}

pub fn (c $&TlsClient) write_all(data string) int {
    $tc := $&c.conn
    << tc.write_all(data) or >>
}

pub fn (c $&TlsClient) read(max int) string {
    $tc := $&c.conn
    << tc.read(max) or >>
}

pub fn (c $&TlsClient) read_exact(need int) string {
    if need < 0 || need > transport.MAX_MESSAGE_BYTES { >> errors.new("kafka: invalid TLS read length") }
    $out := ""
    while out.len < need {
        part := c.read(need - out.len) or >>
        if part.len == 0 { >> errors.new("kafka: TLS connection closed") }
        out = out + part
    }
    << out
}

pub fn (c $&TlsClient) close() int {
    $tc := $&c.conn
    << tc.close() or >>
}

pub fn (c $&TlsClient) set_deadline(t_ns int) int {
    $tc := $&c.conn
    $tls_c := $&tc.tls_conn
    << tls_c.set_deadline(t_ns) or >>
}

pub fn (c $&TlsClient) set_read_deadline(t_ns int) int {
    $tc := $&c.conn
    $tls_c := $&tc.tls_conn
    << tls_c.set_read_deadline(t_ns) or >>
}

pub fn (c $&TlsClient) set_write_deadline(t_ns int) int {
    $tc := $&c.conn
    $tls_c := $&tc.tls_conn
    << tls_c.set_write_deadline(t_ns) or >>
}
