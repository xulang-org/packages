@"github.com/xulang-org/packages/sqlite"

#database/sql/driver
#context
#strings

pub struct SqliteDriver {
    pub tag int
    pub path string
}

struct SqliteState {
    pub path string
    pub closed int
    pub tx int
    pub tx_seq int
    pub tx_err string
    pub read_only bool
    pub open_err string
    pub handle int
}

pub struct SqliteConn {
    pub st chan SqliteState
}

pub struct SqliteStmt {
    pub st chan SqliteState
    pub q string
}

pub struct SqliteTx {
    pub st chan SqliteState
    pub id int
    pub err string
}

fn take_st(c &SqliteConn) SqliteState {
    << <- c.st
}

fn put_st(c &SqliteConn, s SqliteState) {
    c.st <- s
}

// ===== driver.Driver / Connector =====

fn (d SqliteDriver) open(name string) driver.Conn {
    mut p := strings.clone(&name)
    if p.len == 0 {
        p = ":memory:"
    }
    initial := start_session(p)
    ch := chan SqliteState{cap: 1}
    ch <- initial
    << driver.Conn(SqliteConn{st: ch})
}

fn (d SqliteDriver) dup() driver.Driver {
    << driver.Driver(SqliteDriver{tag: d.tag, path: d.path + ""})
}

fn (d SqliteDriver) driver() driver.Driver {
    << driver.Driver(SqliteDriver{tag: d.tag, path: d.path + ""})
}

fn (d SqliteDriver) connect(ctx &context.Context) driver.Conn {
    _ := ctx
    << d.open(d.path + "")
}

// ===== driver.Conn =====

fn state_error(st &SqliteState) string {
    if st.open_err.len > 0 { << st.open_err + "" }
    if st.closed != 0 { << "sqlite: connection closed" }
    if st.tx_err.len > 0 { << st.tx_err + "" }
    << ""
}

fn (c SqliteConn) ping() string {
    mut st := take_st(&c)
    mut e := state_error(&st)
    if e.len == 0 { e = session_command(mut &st, "SELECT 1") }
    put_st(&c, st)
    << e
}

fn (c SqliteConn) exec(query string, args []driver.NamedValue) driver.ExecResult {
    mut st := take_st(&c)
    e := state_error(&st)
    if e.len > 0 { put_st(&c, st)
        << driver.exec_err(e) }
    reply := session_reply_safe(mut &st, query, &args)
    result := parse_exec_reply(&reply)
    put_st(&c, st)
    << result
}

fn (c SqliteConn) query(query string, args []driver.NamedValue) driver.RowsResult {
    mut st := take_st(&c)
    e := state_error(&st)
    if e.len > 0 { put_st(&c, st)
        << driver.rows_err(e) }
    reply := session_reply_safe(mut &st, query, &args)
    result := parse_rows_reply(&reply)
    put_st(&c, st)
    << result
}

fn (c SqliteConn) close() string {
    mut st := take_st(&c)
    e := stop_session(mut &st)
    put_st(&c, st)
    << e
}

fn (c SqliteConn) dup() driver.Conn {
    << driver.Conn(SqliteConn{st: c.st})
}

fn (c SqliteConn) prepare(query string) driver.Stmt {
    << driver.Stmt(SqliteStmt{st: c.st, q: strings.clone(&query)})
}

fn (c SqliteConn) prepare_context(ctx &context.Context, query string) driver.Stmt {
    _ := ctx
    << c.prepare(query)
}

fn (c SqliteConn) begin() driver.Tx {
    << c.begin_tx(0, false)
}

fn (c SqliteConn) begin_tx(level int, read_only bool) driver.Tx {
    mut st := take_st(&c)
    if st.tx != 0 { put_st(&c, st)
        << driver.Tx(SqliteTx{st: c.st, id: -1, err: "sqlite: transaction already active"}) }
    st.tx_seq += 1
    id := st.tx_seq
    mut e := state_error(&st)
    if e.len == 0 && level != 0 && level != 6 { e = "sqlite: unsupported isolation level" }
    if e.len == 0 && read_only {
        e = session_command(mut &st, "PRAGMA query_only=ON")
        if e.len == 0 { st.read_only = true }
    }
    if e.len == 0 { e = session_command(mut &st, "BEGIN") }
    if e.len == 0 { st.tx = id
        st.read_only = read_only }
    else {
        if st.read_only {
            cleanup := session_command(mut &st, "PRAGMA query_only=OFF")
            if cleanup.len == 0 { st.read_only = false }
        }
        st.tx_err = e + ""
    }
    put_st(&c, st)
    << driver.Tx(SqliteTx{st: c.st, id: id, err: e})
}

fn (c SqliteConn) reset_session(ctx &context.Context) string {
    _ := ctx
    mut st := take_st(&c)
    mut e := ""
    if st.open_err.len > 0 { e = st.open_err + "" }
    else if st.closed != 0 { e = "sqlite: connection closed" }
    else {
        if st.tx != 0 {
            e = session_command(mut &st, "ROLLBACK")
            if e.len == 0 { st.tx = 0 }
        }
        if e.len == 0 && st.read_only {
            e = session_command(mut &st, "PRAGMA query_only=OFF")
            if e.len == 0 { st.read_only = false }
        }
        if e.len == 0 { st.tx_err = "" }
    }
    put_st(&c, st)
    << e
}

fn (c SqliteConn) is_valid() bool {
    st := take_st(&c)
    closed := st.closed
    put_st(&c, st)
    << closed == 0
}

// ===== driver.Stmt =====

// SQLite supports positional and named parameters, quoted text and comments.
// Let SQLite validate arity instead of counting question marks in SQL text.
fn (s SqliteStmt) num_input() int {
    << -1
}

fn (s SqliteStmt) exec(args []driver.NamedValue) driver.ExecResult {
    conn := SqliteConn{st: s.st}
    << conn.exec(s.q, args)
}

fn (s SqliteStmt) query(args []driver.NamedValue) driver.RowsResult {
    conn := SqliteConn{st: s.st}
    << conn.query(s.q, args)
}

fn (s SqliteStmt) close() string {
    << ""
}

// ===== driver.Tx =====

fn finish_tx(t &SqliteTx, command string) string {
    if t.id < 0 { << t.err + "" }
    conn := SqliteConn{st: t.st}
    mut st := take_st(&conn)
    if t.err.len > 0 {
        if st.tx_seq == t.id { st.tx_err = "" }
        put_st(&conn, st)
        << t.err + ""
    }
    if st.tx != t.id { put_st(&conn, st)
        << "sqlite: transaction already finished" }
    mut e := state_error(&st)
    if e.len == 0 { e = session_command(mut &st, command) }
    if e.len == 0 {
        st.tx = 0
        if st.read_only { e = session_command(mut &st, "PRAGMA query_only=OFF") }
        st.read_only = false
    }
    put_st(&conn, st)
    << e
}

fn (t SqliteTx) commit() string { << finish_tx(&t, "COMMIT") }
fn (t SqliteTx) rollback() string { << finish_tx(&t, "ROLLBACK") }
