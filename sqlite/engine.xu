@"github.com/xulang-org/packages/sqlite"

#database/sql/driver
#sqlite_native
#time
#strings

// Native calls are synchronous. Connection state serializes its transaction.
struct QueryReply {
    pub err string
    pub columns []string
    pub cells []string
    pub last_id int
    pub affected int
}

fn native_buffer(text &string) int {
    handle := sqlite_native.buffer_new(text.len)
    if handle == 0 { << 0 }
    mut off := 0
    while off < text.len {
        mut word := 0
        mut count := 0
        while count < 8 && off + count < text.len {
            word = word | ((text[off + count] & 255) << (count * 8))
            count += 1
        }
        if sqlite_native.buffer_put(handle, off, word, count) != 0 {
            sqlite_native.buffer_free(handle)
            << 0
        }
        off += count
    }
    << handle
}

fn native_blob(bytes &[]u8) int {
    handle := sqlite_native.buffer_new(bytes.len)
    if handle == 0 { << 0 }
    mut off := 0
    while off < bytes.len {
        mut word := 0
        mut count := 0
        while count < 8 && off + count < bytes.len {
            word = word | (int(bytes[off + count]) << (count * 8))
            count += 1
        }
        if sqlite_native.buffer_put(handle, off, word, count) != 0 {
            sqlite_native.buffer_free(handle)
            << 0
        }
        off += count
    }
    << handle
}

fn native_bytes(handle int) []u8 {
    if handle == 0 { << []u8{} }
    length := sqlite_native.buffer_len(handle)
    if length < 0 { sqlite_native.buffer_free(handle)
        << []u8{} }
    mut bytes := []u8{}
    mut off := 0
    while off < length {
        word := sqlite_native.buffer_get(handle, off)
        mut count := 0
        while count < 8 && off + count < length {
            bytes.push(u8((word >> (count * 8)) & 255))
            count += 1
        }
        off += count
    }
    sqlite_native.buffer_free(handle)
    << bytes
}

fn native_text(handle int) string {
    bytes := native_bytes(handle)
    mut ints := []int{}
    for i in 0:bytes.len { ints.push(int(bytes[i])) }
    << string_from_bytes(ints)
}

fn db_error_text(handle int) string {
    message := native_text(sqlite_native.error(handle))
    << "sqlite: " + message
}

fn stop_session(st &mut SqliteState) string {
    rc := sqlite_native.close(st.handle)
    if rc != 0 { << db_error_text(st.handle) }
    st.handle = 0
    st.closed = 1
    st.tx = 0
    << ""
}

fn start_session(path string) SqliteState {
    mut st := SqliteState{path: path + "", closed: 0, tx: 0, tx_seq: 0, tx_err: "", read_only: false, open_err: "", handle: 0}
    buffer := native_buffer(&path)
    if buffer == 0 { st.open_err = "sqlite: path allocation failed or exceeds 16 MiB"
        st.closed = 1
        << st }
    st.handle = sqlite_native.open(buffer)
    sqlite_native.buffer_free(buffer)
    if st.handle == 0 { st.open_err = "sqlite: open failed: invalid path or allocation failure" }
    else if sqlite_native.status(st.handle) != 0 { st.open_err = db_error_text(st.handle) }
    if st.open_err.len > 0 { stop_session(mut &st) }
    << st
}

// A driver temp is consumed by `as`. Decode each argument once, even when
// multiple SQLite indices refer to the same named argument.
struct BindArg {
    kind int
    value int
    buffer int
}

fn prepare_binding(args &[]driver.NamedValue, i int) BindArg {
    if args[i].value is int { value := args[i].value as int
        << BindArg{kind: 1, value: value, buffer: 0} }
    if args[i].value is bool { value := args[i].value as bool
        if value { << BindArg{kind: 1, value: 1, buffer: 0} }
        << BindArg{kind: 1, value: 0, buffer: 0} }
    if args[i].value is f64 { value := args[i].value as f64
        encoded := driver.encode_value(value)
        text := encoded[2:encoded.len] + ""
        << BindArg{kind: 2, value: 0, buffer: native_buffer(&text)} }
    if args[i].value is []u8 { value := args[i].value as []u8
        << BindArg{kind: 4, value: 0, buffer: native_blob(&value)} }
    if args[i].value is string { value := args[i].value as string
        << BindArg{kind: 3, value: 0, buffer: native_buffer(&value)} }
    if args[i].value is time.Time { value := args[i].value as time.Time
        text := value.format_rfc3339()
        << BindArg{kind: 3, value: 0, buffer: native_buffer(&text)} }
    << BindArg{kind: 0, value: 0, buffer: 0}
}

fn bind_index(stmt int, index int, values &[]BindArg, i int) int {
    kind := values[i].kind
    if kind == 0 { << sqlite_native.bind_null(stmt, index) }
    if kind == 1 { << sqlite_native.bind_int(stmt, index, values[i].value) }
    if values[i].buffer == 0 { << 7 }
    if kind == 2 { << sqlite_native.bind_float(stmt, index, values[i].buffer) }
    if kind == 4 { << sqlite_native.bind_buffer(stmt, index, values[i].buffer, 1) }
    << sqlite_native.bind_buffer(stmt, index, values[i].buffer, 0)
}

fn bind_parameters(stmt int, args &[]driver.NamedValue) string {
    count := sqlite_native.parameter_count(stmt)
    mut named := 0
    for i in 0:args.len { if args[i].name.len > 0 { named += 1 } }
    if named > 0 && named != args.len { << "sqlite: mixed named and positional parameters" }
    if named == 0 && count != args.len { << "sqlite: incorrect parameter count" }
    mut values := []BindArg{}
    for i in 0:args.len { values.push(prepare_binding(args, i)) }
    result := bind_prepared(stmt, count, named > 0, args, &values)
    for i in 0:values.len { sqlite_native.buffer_free(values[i].buffer) }
    << result
}

fn bind_prepared(stmt int, count int, named bool, args &[]driver.NamedValue, values &[]BindArg) string {
    if !named {
        for i in 0:args.len {
            if bind_index(stmt, i + 1, values, i) != 0 { << "sqlite: parameter binding failed" }
        }
        << ""
    }
    // Repeated SQL names share an index; different prefixes may use several.
    for index in 1:count + 1 {
        token := sqlite_native.parameter_name(stmt, index)
        if token == 0 { << "sqlite: named arguments require named SQL parameters" }
        name := native_text(token)
        key := name[1:name.len] + ""
        mut found := -1
        for i in 0:args.len { if args[i].name == key { found = i } }
        if found < 0 { << "sqlite: missing named parameter: " + key }
        if bind_index(stmt, index, values, found) != 0 { << "sqlite: parameter binding failed" }
    }
    << ""
}

fn column_value(stmt int, column int) string {
    kind := sqlite_native.column_type(stmt, column)
    if kind == 1 { << driver.encode_value(sqlite_native.column_int(stmt, column)) }
    if kind == 2 {
        buffer := sqlite_native.column_float(stmt, column)
        if buffer == 0 { << "" }
        text := native_text(buffer)
        << "f:" + text
    }
    if kind == 3 {
        buffer := sqlite_native.column_buffer(stmt, column, 0)
        if buffer == 0 { << "" }
        value := native_text(buffer)
        << driver.encode_value(value)
    }
    if kind == 4 {
        buffer := sqlite_native.column_buffer(stmt, column, 1)
        if buffer == 0 { << "" }
        value := native_bytes(buffer)
        << driver.encode_value(value)
    }
    if kind == 5 { << "n:" }
    << ""
}

fn session_query(st &mut SqliteState, query string, args &[]driver.NamedValue) QueryReply {
    buffer := native_buffer(&query)
    if buffer == 0 { << query_error("sqlite: SQL allocation failed or exceeds 16 MiB") }
    stmt := sqlite_native.prepare(st.handle, buffer)
    sqlite_native.buffer_free(buffer)
    if stmt == 0 {
        if sqlite_native.status(st.handle) != 0 { << query_error(db_error_text(st.handle)) }
        if args.len > 0 { << query_error("sqlite: incorrect parameter count") }
        << QueryReply{err: "", columns: []string{}, cells: []string{}, last_id: 0, affected: 0}
    }
    reply := read_statement(st, stmt, args)
    sqlite_native.finalize(stmt)
    << reply
}

fn read_statement(st &mut SqliteState, stmt int, args &[]driver.NamedValue) QueryReply {
    bound := bind_parameters(stmt, args)
    if bound.len > 0 { << query_error(bound) }
    mut columns := []string{}
    mut cells := []string{}
    mut size := 0
    count := sqlite_native.column_count(stmt)
    for i in 0:count {
        buffer := sqlite_native.column_name(stmt, i)
        if buffer == 0 { << query_error("sqlite: column name allocation failed") }
        name := native_text(buffer)
        size += name.len
        columns.push(name)
    }
    before := sqlite_native.total_changes(st.handle)
    mut rc := sqlite_native.step(stmt)
    while rc == 100 {
        for i in 0:count {
            cell := column_value(stmt, i)
            if cell.len == 0 { << query_error("sqlite: invalid column or result buffer exceeds 16 MiB") }
            size += cell.len
            if size > 16777216 { << query_error("sqlite: result snapshot exceeds 16 MiB") }
            cells.push(cell)
        }
        rc = sqlite_native.step(stmt)
    }
    if rc != 101 { << query_error(db_error_text(st.handle)) }
    mut affected := 0
    if sqlite_native.total_changes(st.handle) > before { affected = sqlite_native.changes(st.handle) }
    << QueryReply{err: "", columns: columns, cells: cells, last_id: sqlite_native.last_id(st.handle), affected: affected}
}

fn query_error(message string) QueryReply {
    stable := strings.clone(&message)
    reply := QueryReply{err: stable, columns: []string{}, cells: []string{}, last_id: 0, affected: 0}
    << reply
}

fn session_reply_safe(st &mut SqliteState, query string, args &[]driver.NamedValue) QueryReply {
    << session_query(st, query, args)
}

fn session_command(st &mut SqliteState, query string) string {
    args := []driver.NamedValue{}
    reply := session_reply_safe(st, query, &args)
    << strings.clone(&reply.err)
}

fn parse_exec_reply(d &QueryReply) driver.ExecResult {
    if d.err.len > 0 { << driver.exec_err(d.err + "") }
    << driver.exec_ok(d.last_id, d.affected)
}

fn parse_rows_reply(d &QueryReply) driver.RowsResult {
    if d.err.len > 0 { << driver.rows_err(d.err + "") }
    mut cols := []string{}
    mut cells := []string{}
    for i in 0:d.columns.len { cols.push(d.columns[i] + "") }
    for i in 0:d.cells.len { cells.push(d.cells[i] + "") }
    ncols := cols.len
    << driver.RowsResult{columns: cols, cells: cells, ncols: ncols, err: ""}
}
