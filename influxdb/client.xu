@"github.com/xulang-org/packages/influxdb"

#net
#net/http
#crypto/tls
#errors
#strings
transport #github.com/xulang-org/packages/transport

pub struct Response {
    pub status_code int
    pub body string
}

pub struct Client {
    pub host string
    pub port int
    pub secure bool
    pub token string
    pub org string
    pub bucket string
}

fn parse_int_def(s string, def int) int {
    if s.len == 0 {
        << def
    }
    n := parse_int(s) or (err) {
        << def
    }
    << n
}

fn safe_close(fd int) {
    if fd >= 0 {
        net.conn_close(fd) or (e) {
            <<
        }
    }
}

fn parse_endpoint(raw string) []string {
    if strings.has_prefix(&raw, "https://") {
        ep := transport.parse_endpoint(raw, 8086) or (err) { << ["127.0.0.1", "8086", "true"] }
        << [ep.host, str(ep.port), "true"]
    }
    mut ep := raw
    prefix_http := "http://"
    if ep.len >= prefix_http.len && ep[0:prefix_http.len] == prefix_http {
        ep = ep[prefix_http.len:ep.len]
    }
    mut host := "127.0.0.1"
    mut port := 8086
    mut colon := -1
    mut i := 0
    while i < ep.len {
        if (ep[i] & 255) == 58 {
            colon = i
            <-
        }
        i = i + 1
    }
    if colon >= 0 {
        host = ep[0:colon]
        p_str := ep[(colon + 1):ep.len]
        port = parse_int_def(p_str, 8086)
    } else {
        if ep.len > 0 {
            host = ep
        }
    }
    << [host, str(port), "false"]
}

pub fn new_client(endpoint string, token string, org string, bucket string) Client {
    ep_parts := parse_endpoint(endpoint)
    host := ep_parts[0]
    port := parse_int_def(ep_parts[1], 8086)
    << Client{
        host: host,
        port: port,
        secure: ep_parts[2] == "true",
        token: token,
        org: org,
        bucket: bucket
    }
}

pub fn (c &mut Client) request(method string, path string, body string, content_type string, accept string) Response {
    if c.secure {
        mut p := path
        if p.len == 0 || (p[0] & 255) != 47 { p = "/" + p }
        mut req := method + " " + p + " HTTP/1.1\r\n"
        req = req + "Host: " + c.host + ":" + str(c.port) + "\r\n"
        if c.token.len > 0 { req = req + "Authorization: Token " + c.token + "\r\n" }
        if content_type.len > 0 { req = req + "Content-Type: " + content_type + "\r\n" }
        if accept.len > 0 { req = req + "Accept: " + accept + "\r\n" }
        req = req + "Content-Length: " + str(body.len) + "\r\n"
        req = req + "Connection: close\r\n\r\n"
        if body.len > 0 { req = req + body }
        ep := transport.Endpoint{scheme: "https", host: c.host + "", port: c.port, path: "", secure: true}
        cfg := tls.new_config(c.host + "")
        resp := transport.request_raw(ep, cfg, req, method + "") or >>
        << Response{status_code: resp.status_code, body: resp.body}
    }
    addr := c.host + ":" + str(c.port)
    fd := net.dial(strings.clone(&addr)) or (err) {
        >> errors.new("influxdb: dial failed: " + err.msg())
    }
    mut reusable := false
    result := c.request_on_fd(fd, method, path, body, content_type, accept, mut &reusable) or (err) {
        safe_close(fd)
        >> err
    }
    safe_close(fd)
    << result
}

fn (c &mut Client) request_at(fd int, method string, path string, body string, content_type string, accept string, reusable &mut bool) Response {
    if c.secure {
        *reusable = false
        << c.request(method, path, body, content_type, accept) or >>
    }
    if fd < 0 { << c.request(method, path, body, content_type, accept) or >> }
    << c.request_on_fd(fd, method, path, body, content_type, accept, reusable) or >>
}

fn (c &mut Client) request_on_fd(fd int, method string, path string, body string, content_type string, accept string, reusable &mut bool) Response {
    *reusable = false

    mut p := path
    if p.len == 0 || (p[0] & 255) != 47 {
        p = "/" + p
    }

    mut req := method + " " + p + " HTTP/1.1\r\n"
    req = req + "Host: " + c.host + ":" + str(c.port) + "\r\n"
    if c.token.len > 0 {
        req = req + "Authorization: Token " + c.token + "\r\n"
    }
    if content_type.len > 0 {
        req = req + "Content-Type: " + content_type + "\r\n"
    }
    if accept.len > 0 {
        req = req + "Accept: " + accept + "\r\n"
    }
    req = req + "Content-Length: " + str(body.len) + "\r\n"
    req = req + "Connection: keep-alive\r\n\r\n"
    if body.len > 0 {
        req = req + body
    }

    mut off := 0
    while off < req.len {
        part := req[off:req.len]
        n := net.conn_write(fd, &part) or (err) {
            >> errors.new("influxdb: write failed: " + err.msg())
        }
        if n <= 0 {
            >> errors.new("influxdb: connection closed during write")
        }
        off = off + n
    }

    resp := http.read_response(fd, method + "") or (err) {
        >> err
    }
    *reusable = resp.status_code >= 200 && resp.status_code < 300 && resp.reusable(method)
    << Response{status_code: resp.status_code, body: resp.body}
}
