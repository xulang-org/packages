@"github.com/xulang-org/packages/influxdb"

#strings
#errors

pub struct Tag {
    pub key string
    pub val string
}

pub struct Field {
    pub key string
    pub val string
}

pub struct Point {
    pub measurement string
    pub tags []Tag
    pub fields []Field
    pub timestamp int
}

pub fn new_point(measurement string) Point {
    << Point{
        measurement: measurement,
        tags: []Tag{},
        fields: []Field{},
        timestamp: 0
    }
}

fn escape_line_tag(s &string) string {
    $out := ""
    $i := 0
    while i < s.len {
        c := s[i] & 255
        if c == 32 || c == 44 || c == 61 {
            out.push_byte(92)
        }
        out.push_byte(c)
        i = i + 1
    }
    << out
}

fn escape_string_field(s &string) string {
    $out := ""
    $i := 0
    while i < s.len {
        c := s[i] & 255
        if c == 34 || c == 92 {
            out.push_byte(92)
        }
        out.push_byte(c)
        i = i + 1
    }
    << out
}

pub fn (p $&Point) add_tag(key string, val string) {
    p.tags.push(Tag{key: escape_line_tag(&key), val: escape_line_tag(&val)})
}

pub fn (p $&Point) add_field_string(key string, val string) {
    // Strings in Line Protocol must be double quoted and escaped
    p.fields.push(Field{key: escape_line_tag(&key), val: "\"" + escape_string_field(&val) + "\""})
}

pub fn (p $&Point) add_field_int(key string, val int) {
    // Integers in Line Protocol are followed by 'i'
    p.fields.push(Field{key: key, val: str(val) + "i"})
}

pub fn (p $&Point) add_field_float(key string, val string) {
    p.fields.push(Field{key: key, val: val})
}

pub fn (p $&Point) add_field_bool(key string, val bool) {
    $b := "false"
    if val {
        b = "true"
    }
    p.fields.push(Field{key: key, val: b})
}

pub fn (p $&Point) set_timestamp(ts int) {
    p.timestamp = ts
}

pub fn (p &Point) to_line() string {
    $line := p.measurement
    $i := 0
    while i < p.tags.len {
        line = line + "," + p.tags[i].key + "=" + p.tags[i].val
        i = i + 1
    }
    line = line + " "
    $j := 0
    while j < p.fields.len {
        if j > 0 {
            line = line + ","
        }
        line = line + p.fields[j].key + "=" + p.fields[j].val
        j = j + 1
    }
    if p.timestamp > 0 {
        line = line + " " + str(p.timestamp)
    }
    << line
}

pub fn (c $&Client) write_point(point Point) bool {
    $reusable := false
    << c.write_point_at(-1, point, $&reusable) or >>
}

fn (c $&Client) write_point_at(fd int, point Point, reusable $&bool) bool {
    line := point.to_line()
    << c.write_line_at(fd, line, reusable)
}

pub fn (c $&Client) write_line(line string) bool {
    $reusable := false
    << c.write_line_at(-1, line, $&reusable) or >>
}

fn (c $&Client) write_line_at(fd int, line string, reusable $&bool) bool {
    << c.write_raw_at(fd, line, reusable)
}

pub fn (c $&Client) write_raw(lines string) bool {
    $reusable := false
    << c.write_raw_at(-1, lines, $&reusable) or >>
}

fn (c $&Client) write_raw_at(fd int, lines string, reusable $&bool) bool {
    path := "/api/v2/write?org=" + c.org + "&bucket=" + c.bucket + "&precision=ns"
    resp := c.request_at(fd, "POST", path, lines, "text/plain; charset=utf-8", "application/json", reusable) or (err) {
        >> err
    }
    if resp.status_code == 204 || (resp.status_code >= 200 && resp.status_code < 300) {
        << true
    }
    >> errors.new("influxdb write failed with status " + str(resp.status_code) + ": " + resp.body)
}
