    << d.dispatch(p, &bufs, &sizes, &push, ceil_div(n, 64), 1, 1) >>>
}

pub fn (d $&VulkanDevice) scale_f32(dst $&VulkanBuffer, x &VulkanBuffer, n int, alpha f64) int {
    if n == 0 { << 0 }
    if d.pipe_scale.len == 0 {
        spv := spv_scale_f32()
        d.pipe_scale.push(d.create_pipeline(&spv, 2, 16) >>>)
    }
    p := &d.pipe_scale[0]
    bufs := [int(dst.handle), int(x.handle)]
    sizes := [dst.byte_len, x.byte_len]
    push := [n, math.float32_bits(alpha), 0, 0]
    << d.dispatch(p, &bufs, &sizes, &push, ceil_div(n, 64), 1, 1) >>>
}

pub fn (d $&VulkanDevice) gemm_f32(dst $&VulkanBuffer, a &VulkanBuffer, b &VulkanBuffer, m int, n int, k int) int {
    if m == 0 || n == 0 || k == 0 { << 0 }
