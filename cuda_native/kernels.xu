@"github.com/xulang-org/packages/cuda_native"

// Embedded pure CUDA C kernels (header-free so NVRTC compiles without toolkit headers).
pub fn llm_kernels_source() string {
    $s := ""
    s.push_str("__device__ inline float xu_half_to_f32(unsigned short h) {\n")
    s.push_str("    unsigned int sign = ((unsigned int)(h & 0x8000u)) << 16;\n")
    s.push_str("    unsigned int exp = (h >> 10) & 0x1Fu;\n")
    s.push_str("    unsigned int mant = h & 0x03FFu;\n")
    s.push_str("    unsigned int bits = 0;\n")
    s.push_str("    if (exp == 0u) {\n")
    s.push_str("        if (mant == 0u) {\n")
    s.push_str("            bits = sign;\n")
    s.push_str("        } else {\n")
    s.push_str("            int e = -14;\n")
    s.push_str("            unsigned int m = mant;\n")
    s.push_str("            while ((m & 0x0400u) == 0u) { m <<= 1; e -= 1; }\n")
    s.push_str("            m &= 0x03FFu;\n")
    s.push_str("            bits = sign | ((unsigned int)(e + 127) << 23) | (m << 13);\n")
    s.push_str("        }\n")
    s.push_str("    } else if (exp == 0x1Fu) {\n")
    s.push_str("        bits = sign | 0x7F800000u | (mant << 13);\n")
    s.push_str("    } else {\n")
    s.push_str("        bits = sign | ((exp + 112u) << 23) | (mant << 13);\n")
    s.push_str("    }\n")
    s.push_str("    return __uint_as_float(bits);\n")
    s.push_str("}\n\n")

    s.push_str("extern \"C\" __global__ void xu_add_f32(const float* a, const float* b, float* dst, int n) {\n")
    s.push_str("    int i = blockIdx.x * blockDim.x + threadIdx.x;\n")
    s.push_str("    if (i < n) dst[i] = a[i] + b[i];\n")
    s.push_str("}\n\n")

    s.push_str("extern \"C\" __global__ void xu_mul_f32(const float* a, const float* b, float* dst, int n) {\n")
    s.push_str("    int i = blockIdx.x * blockDim.x + threadIdx.x;\n")
    s.push_str("    if (i < n) dst[i] = a[i] * b[i];\n")
    s.push_str("}\n\n")

    s.push_str("extern \"C\" __global__ void xu_scale_f32(const float* x, float* dst, int n, float alpha) {\n")
    s.push_str("    int i = blockIdx.x * blockDim.x + threadIdx.x;\n")
    s.push_str("    if (i < n) dst[i] = x[i] * alpha;\n")
    s.push_str("}\n\n")

    s.push_str("extern \"C\" __global__ void xu_rmsnorm_f32(const float* x, const float* w, float* dst, int rows, int cols, float eps) {\n")
    s.push_str("    int r = blockIdx.x;\n")
    s.push_str("    if (r >= rows) return;\n")
    s.push_str("    const float* xr = x + r * cols;\n")
    s.push_str("    float* dr = dst + r * cols;\n")
    s.push_str("    float ss = 0.0f;\n")
    s.push_str("    for (int c = 0; c < cols; ++c) { float v = xr[c]; ss += v * v; }\n")
    s.push_str("    float inv = rsqrtf(ss / (float)cols + eps);\n")
    s.push_str("    for (int c = threadIdx.x; c < cols; c += blockDim.x) dr[c] = xr[c] * inv * w[c];\n")
    s.push_str("}\n\n")

    s.push_str("extern \"C\" __global__ void xu_softmax_f32(const float* x, float* dst, int rows, int cols) {\n")
    s.push_str("    int r = blockIdx.x;\n")
    s.push_str("    if (r >= rows) return;\n")
    s.push_str("    const float* xr = x + r * cols;\n")
    s.push_str("    float* dr = dst + r * cols;\n")
    s.push_str("    float mx = xr[0];\n")
    s.push_str("    for (int c = 1; c < cols; ++c) { if (xr[c] > mx) mx = xr[c]; }\n")
    s.push_str("    float sum = 0.0f;\n")
    s.push_str("    for (int c = 0; c < cols; ++c) { float e = expf(xr[c] - mx); dr[c] = e; sum += e; }\n")
    s.push_str("    float inv = 1.0f / sum;\n")
    s.push_str("    for (int c = 0; c < cols; ++c) dr[c] *= inv;\n")
    s.push_str("}\n\n")

    s.push_str("extern \"C\" __global__ void xu_swiglu_f32(const float* gate, const float* up, float* dst, int n) {\n")
    s.push_str("    int i = blockIdx.x * blockDim.x + threadIdx.x;\n")
    s.push_str("    if (i < n) {\n")
    s.push_str("        float g = gate[i];\n")
    s.push_str("        float silu = g / (1.0f + expf(-g));\n")
    s.push_str("        dst[i] = silu * up[i];\n")
    s.push_str("    }\n")
    s.push_str("}\n\n")

    s.push_str("extern \"C\" __global__ void xu_rope_f32(const float* x, float* dst, int seq_len, int n_heads, int head_dim, int pos_off, float log_theta) {\n")
    s.push_str("    int half_d = head_dim >> 1;\n")
    s.push_str("    int j = blockIdx.x * blockDim.x + threadIdx.x;\n")
    s.push_str("    int h = blockIdx.y;\n")
    s.push_str("    int r = blockIdx.z;\n")
    s.push_str("    if (j < half_d && h < n_heads && r < seq_len) {\n")
    s.push_str("        float freq = expf(-log_theta * ((float)(2 * j) / (float)head_dim));\n")
    s.push_str("        float angle = (float)(pos_off + r) * freq;\n")
    s.push_str("        float c = cosf(angle), s = sinf(angle);\n")
    s.push_str("        int base = (r * n_heads + h) * head_dim;\n")
    s.push_str("        float v0 = x[base + j];\n")
    s.push_str("        float v1 = x[base + half_d + j];\n")
    s.push_str("        dst[base + j] = v0 * c - v1 * s;\n")
    s.push_str("        dst[base + half_d + j] = v0 * s + v1 * c;\n")
    s.push_str("    }\n")
    s.push_str("}\n\n")

    s.push_str("extern \"C\" __global__ void xu_gemm_f32(const float* a, const float* b, float* dst, int m, int n, int k) {\n")
    s.push_str("    int col = blockIdx.x * blockDim.x + threadIdx.x;\n")
    s.push_str("    int row = blockIdx.y * blockDim.y + threadIdx.y;\n")
    s.push_str("    if (row < m && col < n) {\n")
    s.push_str("        float acc = 0.0f;\n")
    s.push_str("        for (int p = 0; p < k; ++p) acc += a[row * k + p] * b[p * n + col];\n")
    s.push_str("        dst[row * n + col] = acc;\n")
    s.push_str("    }\n")
    s.push_str("}\n\n")

    s.push_str("extern \"C\" __global__ void xu_gemm_f32_nt(const float* a, const float* b, float* dst, int m, int n, int k) {\n")
    s.push_str("    int col = blockIdx.x * blockDim.x + threadIdx.x;\n")
    s.push_str("    int row = blockIdx.y * blockDim.y + threadIdx.y;\n")
    s.push_str("    if (row < m && col < n) {\n")
    s.push_str("        float acc = 0.0f;\n")
    s.push_str("        for (int p = 0; p < k; ++p) acc += a[row * k + p] * b[col * k + p];\n")
    s.push_str("        dst[row * n + col] = acc;\n")
    s.push_str("    }\n")
    s.push_str("}\n\n")

    s.push_str("extern \"C\" __global__ void xu_gemm_f32_tn(const float* a, const float* b, float* dst, int m, int n, int k) {\n")
    s.push_str("    int col = blockIdx.x * blockDim.x + threadIdx.x;\n")
    s.push_str("    int row = blockIdx.y * blockDim.y + threadIdx.y;\n")
    s.push_str("    if (row < m && col < n) {\n")
    s.push_str("        float acc = 0.0f;\n")
    s.push_str("        for (int p = 0; p < k; ++p) acc += a[p * m + row] * b[p * n + col];\n")
    s.push_str("        dst[row * n + col] = acc;\n")
    s.push_str("    }\n")
    s.push_str("}\n\n")

    s.push_str("extern \"C\" __global__ void xu_gemv_q4_0_f32(const float* x, const unsigned char* w, float* dst, int rows, int cols, int m_cnt) {\n")
    s.push_str("    int n = blockIdx.x * blockDim.x + threadIdx.x;\n")
    s.push_str("    int m = blockIdx.y;\n")
    s.push_str("    if (n >= rows || m >= m_cnt) return;\n")
    s.push_str("    int n_blocks = cols >> 5;\n")
    s.push_str("    const unsigned char* wrow = w + n * n_blocks * 18;\n")
    s.push_str("    const float* xrow = x + m * cols;\n")
    s.push_str("    float acc = 0.0f;\n")
    s.push_str("    for (int b = 0; b < n_blocks; ++b) {\n")
    s.push_str("        const unsigned char* blk = wrow + b * 18;\n")
    s.push_str("        float d = xu_half_to_f32((unsigned short)blk[0] | ((unsigned short)blk[1] << 8));\n")
    s.push_str("        const float* xp = xrow + (b << 5);\n")
    s.push_str("        float bsum = 0.0f;\n")
    s.push_str("        for (int j = 0; j < 16; ++j) {\n")
    s.push_str("            unsigned char bv = blk[2 + j];\n")
    s.push_str("            bsum += (float)((int)(bv & 15u) - 8) * xp[j] + (float)((int)(bv >> 4) - 8) * xp[16 + j];\n")
    s.push_str("        }\n")
    s.push_str("        acc += bsum * d;\n")
    s.push_str("    }\n")
    s.push_str("    dst[m * rows + n] = acc;\n")
    s.push_str("}\n\n")

    s.push_str("extern \"C\" __global__ void xu_gemv_q8_0_f32(const float* x, const unsigned char* w, float* dst, int rows, int cols, int m_cnt) {\n")
    s.push_str("    int n = blockIdx.x * blockDim.x + threadIdx.x;\n")
    s.push_str("    int m = blockIdx.y;\n")
    s.push_str("    if (n >= rows || m >= m_cnt) return;\n")
    s.push_str("    int n_blocks = cols >> 5;\n")
    s.push_str("    const unsigned char* wrow = w + n * n_blocks * 34;\n")
    s.push_str("    const float* xrow = x + m * cols;\n")
    s.push_str("    float acc = 0.0f;\n")
    s.push_str("    for (int b = 0; b < n_blocks; ++b) {\n")
    s.push_str("        const unsigned char* blk = wrow + b * 34;\n")
    s.push_str("        float d = xu_half_to_f32((unsigned short)blk[0] | ((unsigned short)blk[1] << 8));\n")
    s.push_str("        const float* xp = xrow + (b << 5);\n")
    s.push_str("        float bsum = 0.0f;\n")
    s.push_str("        for (int j = 0; j < 32; ++j) bsum += (float)((signed char)blk[2 + j]) * xp[j];\n")
    s.push_str("        acc += bsum * d;\n")
    s.push_str("    }\n")
    s.push_str("    dst[m * rows + n] = acc;\n")
    s.push_str("}\n\n")

    s.push_str("extern \"C\" __global__ void xu_gemv_q4_k_f32(const float* x, const unsigned char* w, float* dst, int rows, int cols, int m_cnt) {\n")
    s.push_str("    int n = blockIdx.x * blockDim.x + threadIdx.x;\n")
    s.push_str("    int m = blockIdx.y;\n")
    s.push_str("    if (n >= rows || m >= m_cnt) return;\n")
    s.push_str("    int n_blocks = cols >> 8;\n")
    s.push_str("    const unsigned char* wrow = w + n * n_blocks * 144;\n")
    s.push_str("    const float* xrow = x + m * cols;\n")
    s.push_str("    float acc = 0.0f;\n")
    s.push_str("    for (int b = 0; b < n_blocks; ++b) {\n")
    s.push_str("        const unsigned char* blk = wrow + b * 144;\n")
    s.push_str("        float d = xu_half_to_f32((unsigned short)blk[0] | ((unsigned short)blk[1] << 8));\n")
    s.push_str("        float dmin = xu_half_to_f32((unsigned short)blk[2] | ((unsigned short)blk[3] << 8));\n")
    s.push_str("        const unsigned char* sc = blk + 4;\n")
    s.push_str("        const unsigned char* qs = blk + 16;\n")
    s.push_str("        const float* xp_base = xrow + (b << 8);\n")
    s.push_str("        for (int c = 0; c < 4; ++c) {\n")
    s.push_str("            int is0 = c << 1, is1 = is0 + 1;\n")
    s.push_str("            unsigned char sc1, m1, sc2, m2;\n")
    s.push_str("            if (c < 2) { sc1 = sc[is0] & 63u; m1 = sc[is0 + 4] & 63u; sc2 = sc[is1] & 63u; m2 = sc[is1 + 4] & 63u; }\n")
    s.push_str("            else {\n")
    s.push_str("                sc1 = (sc[is0 + 4] & 15u) | ((sc[is0 - 4] >> 6) << 4);\n")
    s.push_str("                m1  = (sc[is0 + 4] >> 4)  | ((sc[is0]     >> 6) << 4);\n")
    s.push_str("                sc2 = (sc[is1 + 4] & 15u) | ((sc[is1 - 4] >> 6) << 4);\n")
    s.push_str("                m2  = (sc[is1 + 4] >> 4)  | ((sc[is1]     >> 6) << 4);\n")
    s.push_str("            }\n")
    s.push_str("            float d1 = d * (float)sc1, min1 = dmin * (float)m1;\n")
    s.push_str("            float d2 = d * (float)sc2, min2 = dmin * (float)m2;\n")
    s.push_str("            const float* xp = xp_base + (c << 6);\n")
    s.push_str("            for (int l = 0; l < 32; ++l) {\n")
    s.push_str("                unsigned char qv = qs[(c << 5) + l];\n")
    s.push_str("                acc += (d1 * (float)(qv & 15u) - min1) * xp[l] + (d2 * (float)(qv >> 4) - min2) * xp[32 + l];\n")
    s.push_str("            }\n")
    s.push_str("        }\n")
    s.push_str("    }\n")
    s.push_str("    dst[m * rows + n] = acc;\n")
    s.push_str("}\n\n")

    s.push_str("extern \"C\" __global__ void xu_gemv_q5_k_f32(const float* x, const unsigned char* w, float* dst, int rows, int cols, int m_cnt) {\n")
    s.push_str("    int n = blockIdx.x * blockDim.x + threadIdx.x;\n")
    s.push_str("    int m = blockIdx.y;\n")
    s.push_str("    if (n >= rows || m >= m_cnt) return;\n")
    s.push_str("    int n_blocks = cols >> 8;\n")
    s.push_str("    const unsigned char* wrow = w + n * n_blocks * 176;\n")
    s.push_str("    const float* xrow = x + m * cols;\n")
    s.push_str("    float acc = 0.0f;\n")
    s.push_str("    for (int b = 0; b < n_blocks; ++b) {\n")
    s.push_str("        const unsigned char* blk = wrow + b * 176;\n")
    s.push_str("        float d = xu_half_to_f32((unsigned short)blk[0] | ((unsigned short)blk[1] << 8));\n")
    s.push_str("        float dmin = xu_half_to_f32((unsigned short)blk[2] | ((unsigned short)blk[3] << 8));\n")
    s.push_str("        const unsigned char* sc = blk + 4;\n")
    s.push_str("        const unsigned char* qh = blk + 16;\n")
    s.push_str("        const unsigned char* qs = blk + 48;\n")
    s.push_str("        const float* xp_base = xrow + (b << 8);\n")
    s.push_str("        for (int c = 0; c < 4; ++c) {\n")
    s.push_str("            int is0 = c << 1, is1 = is0 + 1;\n")
    s.push_str("            unsigned char sc1, m1, sc2, m2;\n")
    s.push_str("            if (c < 2) { sc1 = sc[is0] & 63u; m1 = sc[is0 + 4] & 63u; sc2 = sc[is1] & 63u; m2 = sc[is1 + 4] & 63u; }\n")
    s.push_str("            else {\n")
    s.push_str("                sc1 = (sc[is0 + 4] & 15u) | ((sc[is0 - 4] >> 6) << 4);\n")
    s.push_str("                m1  = (sc[is0 + 4] >> 4)  | ((sc[is0]     >> 6) << 4);\n")
    s.push_str("                sc2 = (sc[is1 + 4] & 15u) | ((sc[is1 - 4] >> 6) << 4);\n")
    s.push_str("                m2  = (sc[is1 + 4] >> 4)  | ((sc[is1]     >> 6) << 4);\n")
    s.push_str("            }\n")
    s.push_str("            float d1 = d * (float)sc1, min1 = dmin * (float)m1;\n")
    s.push_str("            float d2 = d * (float)sc2, min2 = dmin * (float)m2;\n")
    s.push_str("            unsigned int hm0 = 1u << is0, hm1 = 1u << is1;\n")
    s.push_str("            const float* xp = xp_base + (c << 6);\n")
    s.push_str("            for (int l = 0; l < 32; ++l) {\n")
    s.push_str("                unsigned char qhb = qh[l];\n")
    s.push_str("                unsigned char qv = qs[(c << 5) + l];\n")
    s.push_str("                unsigned int q0 = (qv & 15u) | ((qhb & hm0) != 0 ? 16u : 0u);\n")
    s.push_str("                unsigned int q1 = (qv >> 4)  | ((qhb & hm1) != 0 ? 16u : 0u);\n")
    s.push_str("                acc += (d1 * (float)q0 - min1) * xp[l] + (d2 * (float)q1 - min2) * xp[32 + l];\n")
    s.push_str("            }\n")
    s.push_str("        }\n")
    s.push_str("    }\n")
    s.push_str("    dst[m * rows + n] = acc;\n")
    s.push_str("}\n\n")

    s.push_str("extern \"C\" __global__ void xu_gemv_q6_k_f32(const float* x, const unsigned char* w, float* dst, int rows, int cols, int m_cnt) {\n")
    s.push_str("    int n = blockIdx.x * blockDim.x + threadIdx.x;\n")
    s.push_str("    int m = blockIdx.y;\n")
    s.push_str("    if (n >= rows || m >= m_cnt) return;\n")
    s.push_str("    int n_blocks = cols >> 8;\n")
    s.push_str("    const unsigned char* wrow = w + n * n_blocks * 210;\n")
    s.push_str("    const float* xrow = x + m * cols;\n")
    s.push_str("    float acc = 0.0f;\n")
    s.push_str("    for (int b = 0; b < n_blocks; ++b) {\n")
    s.push_str("        const unsigned char* blk = wrow + b * 210;\n")
    s.push_str("        float d = xu_half_to_f32((unsigned short)blk[208] | ((unsigned short)blk[209] << 8));\n")
    s.push_str("        const unsigned char* ql = blk;\n")
    s.push_str("        const unsigned char* qh = blk + 128;\n")
    s.push_str("        const unsigned char* sc = blk + 192;\n")
    s.push_str("        const float* xp_base = xrow + (b << 8);\n")
    s.push_str("        float bsum = 0.0f;\n")
    s.push_str("        for (int h = 0; h < 2; ++h) {\n")
    s.push_str("            const unsigned char* qlp = ql + (h << 6);\n")
    s.push_str("            const unsigned char* qhp = qh + (h << 5);\n")
    s.push_str("            const unsigned char* scp = sc + (h << 3);\n")
    s.push_str("            const float* yp = xp_base + (h << 7);\n")
    s.push_str("            for (int l = 0; l < 32; ++l) {\n")
    s.push_str("                int is_idx = l >> 4;\n")
    s.push_str("                unsigned char ql0 = qlp[l], ql1 = qlp[32 + l], qhv = qhp[l];\n")
    s.push_str("                int q1 = (int)((ql0 & 15u) | ((qhv & 3u) << 4)) - 32;\n")
    s.push_str("                int q2 = (int)((ql1 & 15u) | (((qhv >> 2) & 3u) << 4)) - 32;\n")
    s.push_str("                int q3 = (int)(((ql0 >> 4) & 15u) | (((qhv >> 4) & 3u) << 4)) - 32;\n")
    s.push_str("                int q4 = (int)(((ql1 >> 4) & 15u) | (((qhv >> 6) & 3u) << 4)) - 32;\n")
    s.push_str("                bsum += (float)((int)((signed char)scp[is_idx]) * q1) * yp[l]\n")
    s.push_str("                      + (float)((int)((signed char)scp[is_idx + 2]) * q2) * yp[l + 32]\n")
    s.push_str("                      + (float)((int)((signed char)scp[is_idx + 4]) * q3) * yp[l + 64]\n")
    s.push_str("                      + (float)((int)((signed char)scp[is_idx + 6]) * q4) * yp[l + 96];\n")
    s.push_str("            }\n")
    s.push_str("        }\n")
    s.push_str("        acc += d * bsum;\n")
    s.push_str("    }\n")
    s.push_str("    dst[m * rows + n] = acc;\n")
    s.push_str("}\n")
    << s
}
